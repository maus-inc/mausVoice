+++ b/patches/coreaudio-rs-0.11.3/src/audio_unit/input_buffer.rs
@@ -0,0 +1,73 @@
+//! Storage owned by an input callback, independently of CoreAudio's byte count.
+
+use std::convert::TryFrom;
+
+pub(super) fn buffer_byte_size(frames: u32, sample_bytes: usize, channels: u32) -> Option<u32> {
+    let bytes = u32::try_from(sample_bytes).ok()?;
+    frames.checked_mul(bytes)?.checked_mul(channels)
+}
+
+pub(super) struct InputBuffer {
+    bytes: Vec<u8>,
+}
+
+impl InputBuffer {
+    pub(super) fn new(len: usize) -> Self {
+        Self {
+            bytes: vec![0; len],
+        }
+    }
+
+    pub(super) fn resize(&mut self, len: usize) {
+        self.bytes.resize(len, 0);
+    }
+
+    pub(super) fn len(&self) -> usize {
+        self.bytes.len()
+    }
+
+    pub(super) fn as_mut_ptr(&mut self) -> *mut u8 {
+        self.bytes.as_mut_ptr()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{buffer_byte_size, InputBuffer};
+
+    #[test]
+    fn byte_size_rejects_overflow_before_allocating() {
+        assert_eq!(buffer_byte_size(0, 4, 2), Some(0));
+        assert_eq!(buffer_byte_size(128, 4, 2), Some(1024));
+        assert_eq!(buffer_byte_size(u32::MAX, 1, 1), Some(u32::MAX));
+        assert_eq!(buffer_byte_size(u32::MAX, 2, 1), None);
+        assert_eq!(buffer_byte_size(u32::MAX, 1, 2), None);
+        #[cfg(target_pointer_width = "64")]
+        assert_eq!(buffer_byte_size(1, u32::MAX as usize + 1, 1), None);
+    }
+
+    #[test]
+    fn grows_and_shrinks_without_reconstructing_allocation_metadata() {
+        let mut buffer = InputBuffer::new(5);
+        unsafe { *buffer.as_mut_ptr() = 7 };
+        buffer.resize(113);
+        assert_eq!(buffer.len(), 113);
+        assert_eq!(buffer.bytes[0], 7);
+        assert!(buffer.bytes[5..].iter().all(|byte| *byte == 0));
+        buffer.resize(2);
+        buffer.resize(19);
+        assert_eq!(buffer.bytes[0], 7);
+        assert!(buffer.bytes[2..].iter().all(|byte| *byte == 0));
+        // The Vec retains its real capacity, even if native reports a different
+        // mDataByteSize; dropping it must not invent a deallocation layout.
+        assert!(buffer.bytes.capacity() >= 19);
+    }
+
+    #[test]
+    fn zero_length_can_grow_and_be_dropped() {
+        let mut buffer = InputBuffer::new(0);
+        buffer.resize(32);
+        assert_eq!(buffer.bytes, vec![0; 32]);
+        buffer.resize(0);
+    }
+}
diff --git a/patches/coreaudio-rs-0.11.3/src/audio_unit/listener_registry.rs b/patches/coreaudio-rs-0.11.3/src/audio_unit/listener_registry.rs
new file mode 100644
index 00000000..24a9a819
--- /dev/null
+++ b/patches/coreaudio-rs-0.11.3/src/audio_unit/listener_registry.rs
@@ -0,0 +1,65 @@
+//! Non-reused identities for CoreAudio callbacks that may arrive late.
+use std::any::Any;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex, OnceLock};
+
+type State = dyn Any + Send + Sync;
+
+fn entries() -> &'static Mutex<HashMap<usize, Arc<State>>> {
+    static ENTRIES: OnceLock<Mutex<HashMap<usize, Arc<State>>>> = OnceLock::new();
+    ENTRIES.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+pub(super) fn insert<T: Any + Send + Sync>(state: Arc<T>) -> Option<usize> {
+    static NEXT: AtomicUsize = AtomicUsize::new(1);
+    let token = NEXT
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |id| id.checked_add(1))
+        .ok()?;
+    entries()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .insert(token, state);
+    Some(token)
+}
+
+pub(super) fn get<T: Any + Send + Sync>(token: usize) -> Option<Arc<T>> {
+    entries()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .get(&token)
+        .cloned()?
+        .downcast::<T>()
+        .ok()
+}
+
+pub(super) fn remove(token: usize) {
+    let state = entries()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .remove(&token);
+    // Drop outside the registry lock, so a destructor cannot deadlock it.
+    drop(state);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{get, insert, remove};
+    use std::sync::Arc;
+
+    #[test]
+    fn retired_tokens_are_not_reused_and_inflight_state_stays_alive() {
+        let original = Arc::new(17_u32);
+        let token = insert(Arc::clone(&original)).unwrap();
+        let inflight = get::<u32>(token).unwrap();
+        assert!(get::<u64>(token).is_none());
+        remove(token);
+        assert!(get::<u32>(token).is_none());
+        drop(original);
+        assert_eq!(*inflight, 17);
+        let next = insert(Arc::new(23_u32)).unwrap();
+        assert_ne!(token, next);
+        assert_eq!(*get::<u32>(next).unwrap(), 23);
+        remove(next);
+    }
+}
diff --git a/patches/coreaudio-rs-0.11.3/src/audio_unit/macos_device_name.rs b/patches/coreaudio-rs-0.11.3/src/audio_unit/macos_device_name.rs
new file mode 100644
