+    fn ptr(&self) -> *const alsa::snd_pcm_status_t { self.0.value.as_ptr() as *const alsa::snd_pcm_status_t }
+    fn ptr_mut(&mut self) -> *mut alsa::snd_pcm_status_t { self.0.value.as_mut_ptr() as *mut alsa::snd_pcm_status_t }
