+  background: #ff6363;
+}
+
+.rc-actions-sep {
+  width: 1px;
+  height: 14px;
+  background: var(--rc-line);
+}
+
+/* Keycaps read light over the dark window */
+.rc-stage .ss-key {
+  background: rgba(250, 250, 252, 0.94);
+  color: #1c1c1e;
+  box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.12), 0 6px 16px rgba(0, 0, 0, 0.35);
+}
+
+.rc-heads {
+  display: grid;
+}
+
+.rc-head {
+  grid-area: 1 / 1;
+  opacity: 0;
+  transition: opacity 0.12s ease;
+}
+
+.rc-head[data-show] {
+  opacity: 1;
+  transition: opacity 0.2s ease 0.06s;
+}
diff --git a/.agents/skills/stageshow/examples/reorder/index.tsx b/.agents/skills/stageshow/examples/reorder/index.tsx
new file mode 100644
index 00000000..dc2eb5f3
--- /dev/null
+++ b/.agents/skills/stageshow/examples/reorder/index.tsx
@@ -0,0 +1,94 @@
+import { Bar, Check, Icon, Row, Stage, Text, Window, type Act } from '../../kit'
+import './reorder.css'
+
+// Drag to reorder: a launch checklist. Beats: the cursor takes the fourth
+// item by its grip, lifts it, carries it up; the rows it passes make room;
+// it drops into second place. Plays once; the still is the payoff.
+//
+// What makes a reorder read as one gesture:
+// - Every row sits at its slot by a transform, never by the list's flow, so
+//   rows move by gliding, and the lifted row can be anywhere without the
+//   others reflowing under it.
+// - The lifted row follows the cursor 1:1 (no transition while dragging),
+//   scaled up a touch with a lift shadow; the rows it passes glide a slot to
+//   make room as its middle crosses theirs.
+// - On release it glides from where the hand left it into its slot; it never
+//   jumps to the slot first.
+// - Only the moved item and the item it passes say anything; the rest are
+//   placeholder rows with the same anatomy.
+//
+// Real strings: the title and the two items that trade places.
+
+const H = 48
+const ITEMS = [
+  { id: 'a', label: null, w: 150 },
+  { id: 'b', label: 'Write the changelog', w: 0 },
+  { id: 'c', label: null, w: 120 },
+  { id: 'd', label: 'Record the demo video', w: 0 },
+  { id: 'e', label: null, w: 136 },
+]
+
+type S = { order: string[]; lifted: string | null; dy: number }
+
+const initial: S = { order: ['a', 'b', 'c', 'd', 'e'], lifted: null, dy: 0 }
+const poster: S = { order: ['a', 'd', 'b', 'c', 'e'], lifted: null, dy: 0 }
+
+async function script(a: Act<S>) {
+  await a.wait(800)
+  a.mark('grab')
+  const grip = a.rect('grip-d')
+  const from = { x: grip.x + grip.width / 2, y: grip.y + grip.height / 2 }
+  await a.move(from)
+  await a.wait(200)
+  let order = initial.order
+  await a.drag(
+    { x: from.x + 6, y: from.y - 2 * H },
+    (at) => {
+      const dy = at.y - from.y
+      // The lifted row's middle decides its slot
+      const slot = Math.max(0, Math.min(4, Math.round((3 * H + dy) / H)))
+      const rest = initial.order.filter((id) => id !== 'd')
+      order = [...rest.slice(0, slot), 'd', ...rest.slice(slot)]
+      a.put({ lifted: 'd', dy, order })
+    },
+    { duration: 900 },
+  )
+  a.mark('drop')
+  a.put({ lifted: null, dy: 0, order })
+  await a.wait(400)
+  await a.move({ x: from.x + 70, y: from.y + 40 })
+  await a.wait(2200)
+}
+
+export default function Reorder() {
+  return (
+    <Stage width={520} height={360} compact={{ below: 520, width: 358, height: 380 }} initial={initial} poster={poster} script={script} play="once" cursor={{ at: { x: 480, y: 330 } }} className="ro">
+      {(s) => (
+        <Window title="Launch checklist" className="ro-win">
+          <div className="ro-list" style={{ height: ITEMS.length * H }}>
+            {ITEMS.map((item) => {
+              const slot = s.order.indexOf(item.id)
+              const lifted = s.lifted === item.id
+              // The lifted row rides the cursor from where it started
+              const y = lifted ? initial.order.indexOf(item.id) * H + s.dy : slot * H
+              return (
+                <div key={item.id} className="ro-slot" data-lifted={lifted || undefined} style={{ transform: `translateY(${y}px)` }}>
+                  <Row
+                    pad={10}
+                    className="ro-row"
+                    lead={<Check on={false} />}
+                    title={item.label ? <Text className="ro-label">{item.label}</Text> : <Bar w={item.w} h={8} r={4} tone={3} />}
+                  >
+                    <span className="ro-grip" data-target={`grip-${item.id}`} data-cursor="grab">
+                      <Icon name="grip" size={16} />
+                    </span>
+                  </Row>
+                </div>
+              )
+            })}
+          </div>
+        </Window>
+      )}
+    </Stage>
+  )
+}
diff --git a/.agents/skills/stageshow/examples/reorder/reorder.css b/.agents/skills/stageshow/examples/reorder/reorder.css
new file mode 100644
index 00000000..5688c4d8
--- /dev/null
+++ b/.agents/skills/stageshow/examples/reorder/reorder.css
@@ -0,0 +1,76 @@
+.ro .ss-stage {
+  overflow: hidden;
+  background: var(--ss-well);
+}
+
+/* Pinned top and sides, off the bottom just past the last row */
+.ro-win {
+  position: absolute;
+  top: 28px;
+  left: 60px;
+  width: 400px;
+  height: 360px;
+}
+
+.ro-list {
+  position: relative;
+  margin: 12px 14px;
+}
+
+/* Each row sits at its slot by a transform and glides between slots */
+.ro-slot {
+  position: absolute;
+  top: 0;
+  right: 0;
+  left: 0;
+  height: 48px;
+  will-change: transform;
+  transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+/* Lifted: on the cursor, no lag; above the rest, a touch larger, a lift
+   shadow. The scale and shadow ease in; the position never does */
+.ro-slot[data-lifted] {
+  z-index: 2;
+  transition: none;
+}
+
+.ro-row {
+  height: 44px;
+  /* The 16px ring sits 14px from the top, the bottom and the left; the
+     grip's dots mirror it on the right */
+  padding: 0 14px;
+  border-radius: 10px;
+  background: var(--ss-surface);
+  transition: box-shadow 0.25s ease, scale 0.25s cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+.ro-slot[data-lifted] .ro-row {
+  scale: 1.02;
+  box-shadow: var(--ss-shadow-lift);
+}
+
+.ro-label {
+  color: var(--ss-text-strong);
+  font-size: 13px;
+}
+
+.ro-grip {
+  display: grid;
+  place-items: center;
+  /* The dots' ink sits as far from the row's right edge as the ring's
+     ink does from its left */
+  width: 16px;
+  margin-right: -4px;
+  /* No taller than the row's content box, or the grid track grows and
+     everything in the row sits low */
+  height: 24px;
+  color: var(--ss-text);
+  opacity: 0.6;
+}
+
+/* Narrow: a gutter each side */
+.ro .ss-stage[data-layout='compact'] .ro-win {
+  left: 16px;
+  width: 326px;
+}
diff --git a/.agents/skills/stageshow/examples/ruled-bento/grid.css b/.agents/skills/stageshow/examples/ruled-bento/grid.css
