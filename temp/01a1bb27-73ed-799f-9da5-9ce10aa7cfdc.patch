@@ -0,0 +1,112 @@
+.hero-grid {
+  position: relative;
+  width: 100%;
+  max-width: 680px;
+  min-width: 0;
+  margin: 0 auto;
+  aspect-ratio: 680 / 758;
+  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+  --hg-paper: #f4f4f3;
+  --hg-night: #111113;
+
+  & .hg-tile { position: absolute; margin: 0; overflow: hidden; border-radius: 12px; background: var(--hg-paper); }
+  & .ss-stage { overflow: hidden; }
+  & .hg-draft .ss-stage { background: transparent; }
+  & .hg-draft-sheet {
+    position: absolute; inset: 0; overflow: hidden; font-size: 17px; font-weight: 500; color: #232326;
+    background-image: linear-gradient(#0000000b 1px, transparent 1px), linear-gradient(90deg, #0000000b 1px, transparent 1px);
+    background-size: 16px 16px;
+  }
+  & .hg-draft-sheet > * { position: absolute; box-sizing: border-box; }
+  & .hg-draft-sheet[data-compact] { font-size: 14px; }
+  & :is(.hg-segments, .hg-stepper, .hg-search, .hg-task-list, .hg-frequency, .hg-wheel-button) {
+    background: #fff; box-shadow: 0 0 0 .5px #00000019, 0 2px 6px -2px #00000014;
+  }
+  /* The kit's Segmented in this sheet's look: a soft accent thumb */
+  & .hg-segments { grid-template-rows: 1fr; padding: 4px; border-radius: 16px; }
+  & .hg-segments .ss-seg__thumb { top: 4px; bottom: 4px; left: 4px; width: calc((100% - 8px) / 3); border-radius: 11px; background: var(--ss-accent-soft); box-shadow: none; transition: transform 350ms cubic-bezier(.16,1,.3,1); }
+  & .hg-segments .ss-seg__option { height: auto; padding: 0; font: inherit; color: #77777a; transition: color 200ms; }
+  & .hg-segments .ss-seg__option[data-on] { color: var(--ss-accent); }
+  & .hg-switch { display: flex; scale: 1.6; transform-origin: 0 0; }
+  & [data-compact] .hg-switch { scale: 1.35; }
+  & .hg-stepper { display: flex; align-items: center; gap: 4px; padding: 0 8px 0 16px; border-radius: 16px; }
+  & .hg-secondary { color: #77777a; margin-right: 4px; }
+  & .hg-stepper-key { display: grid; place-items: center; flex: none; width: 28px; height: 32px; }
+  & .hg-gap { min-width: 26px; text-align: center; font-variant-numeric: tabular-nums; }
+  & .hg-search { display: flex; align-items: center; gap: 10px; padding: 0 14px; border-radius: 14px; color: #8b8b8e; }
+  & .hg-search svg { flex: none; }
+  & .hg-task-list { display: flex; flex-direction: column; gap: 4px; padding: 8px 16px; border-radius: 16px; }
+  & .hg-task { display: flex; flex: none; align-items: center; gap: 12px; height: 36px; }
+  & [data-compact] .hg-task { gap: 8px; height: 30px; }
+  & .hg-task .ss-check { flex: none; }
+  & .hg-publish { display: grid; place-items: center; grid-template-areas: 'stack'; border-radius: 14px; background: var(--ss-accent); color: #fff; box-shadow: 0 6px 14px -8px #00000040; }
+  & .hg-layer { grid-area: stack; display: inline-flex; align-items: center; gap: 6px; opacity: 0; filter: blur(2px); transition: opacity 250ms ease, filter 250ms ease; text-box: trim-both cap alphabetic; }
+  & .hg-layer[data-on] { opacity: 1; filter: none; transition-delay: 80ms; }
+  & .hg-publish .ss-check__ring { stroke: rgb(255 255 255 / .45); }
+  & .hg-publish .ss-check__arc { stroke: #fff; }
+  & .hg-publish .ss-check__fill { fill: #fff; }
+  & .hg-publish .ss-check__tick { stroke: var(--ss-accent); }
