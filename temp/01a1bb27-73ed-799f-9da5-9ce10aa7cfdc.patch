@@ -0,0 +1,430 @@
+/* Raycast, dark appearance, floating over a blurred desktop. */
+
+.rc-stage .ss-stage {
+  overflow: hidden;
+  background: #191b2e;
+  --rc-text: #ececee;
+  --rc-text-2: #8e8e93;
+  --rc-icon: #a1a1a6;
+  --rc-line: rgba(255, 255, 255, 0.08);
+  --rc-sel: rgba(255, 255, 255, 0.09);
+}
+
+.rc-desktop {
+  position: absolute;
+  inset: 0;
+  --rc-x: 56px;
+  --rc-y: 72px;
+  --rc-w: 648px;
+  --rc-h: 460px;
+  --rc-search: 18px;
+  --rc-list-w: 40%;
+}
+
+.rc-desktop[data-layout="compact"] {
+  --rc-x: 16px;
+  --rc-y: 40px;
+  --rc-w: 368px;
+  --rc-h: 420px;
+  --rc-search: 16px;
+  --rc-list-w: 46%;
+}
+
+/* A macOS wallpaper, out of focus */
+.rc-wallpaper {
+  position: absolute;
+  inset: -80px;
+  background:
+    radial-gradient(40% 50% at 22% 30%, #7b5cff 0%, transparent 70%),
+    radial-gradient(35% 45% at 80% 22%, #ff7a59 0%, transparent 70%),
+    radial-gradient(45% 55% at 70% 85%, #2f6bff 0%, transparent 70%),
+    radial-gradient(40% 40% at 15% 90%, #c2417e 0%, transparent 70%),
+    linear-gradient(160deg, #2a1f63 0%, #16224d 55%, #0f1530 100%);
+  filter: blur(36px) saturate(1.1);
+}
+
+.rc-wallpaper::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: rgba(8, 10, 24, 0.18);
+}
+
+.rc-menubar {
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  height: 24px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 0 14px;
+  background: rgba(10, 12, 30, 0.22);
+  backdrop-filter: blur(20px);
+}
+
+.rc-menubar-left,
+.rc-menubar-right {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+}
+
+.rc-menubar-right {
+  gap: 12px;
+}
+
+/* The Raycast window: no title bar, vibrancy over the desktop */
+.rc-window {
+  position: absolute;
+  left: var(--rc-x);
+  top: var(--rc-y);
+  width: var(--rc-w);
+  height: var(--rc-h);
+  border-radius: 12px;
+  overflow: hidden;
+  background: rgba(30, 30, 33, 0.8);
+  backdrop-filter: blur(40px) saturate(1.6);
+  box-shadow:
+    inset 0 0 0 1px rgba(255, 255, 255, 0.1),
+    0 0 0 0.5px rgba(0, 0, 0, 0.6),
+    0 30px 70px -10px rgba(0, 0, 0, 0.55),
+    0 12px 28px -12px rgba(0, 0, 0, 0.5);
+  color: var(--rc-text);
+  font-family: var(--ss-font);
+}
+
+.rc-page {
+  position: absolute;
+  inset: 0 0 40px 0;
+  display: flex;
+  flex-direction: column;
+  opacity: 0;
+  transform: translateY(4px);
+  pointer-events: none;
+  transition: opacity 0.16s ease, transform 0.16s ease;
+}
+
+.rc-page[data-show] {
+  opacity: 1;
+  transform: none;
+  transition: opacity 0.24s ease 0.06s, transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) 0.06s;
+}
+
+/* Search bar */
+.rc-search {
+  flex-shrink: 0;
+  height: 56px;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 0 20px;
+  border-bottom: 1px solid var(--rc-line);
+}
+
+.rc-input {
+  position: relative;
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  align-items: center;
+  font-size: var(--rc-search);
+  line-height: 1.3;
+  white-space: nowrap;
+}
+
+.rc-query {
+  color: var(--rc-text);
+}
+
+.rc-caret {
+  flex-shrink: 0;
+  width: 2px;
+  height: calc(var(--rc-search) + 3px);
+  margin-left: 1px;
+  border-radius: 1px;
+  background: #ff6363;
+  animation: ss-caret 1.06s steps(1) 0.5s infinite;
+}
+
+.rc-placeholder {
+  position: absolute;
+  left: 4px;
+  color: #6e6e73;
+  transition: opacity 0.12s ease;
+}
+
+.rc-placeholder[data-hidden] {
+  opacity: 0;
+  transition: none;
+}
+
+.rc-back {
+  flex-shrink: 0;
+  display: grid;
+  place-items: center;
+  width: 26px;
+  height: 26px;
+  border-radius: 7px;
+  background: rgba(255, 255, 255, 0.1);
+  color: #c7c7cc;
+}
+
+.rc-dropdown {
+  flex-shrink: 0;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  height: 28px;
+  padding: 0 8px 0 10px;
+  border-radius: 7px;
+  background: rgba(255, 255, 255, 0.06);
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
+  font-size: 13px;
+  color: #c7c7cc;
+}
+
+.rc-dropdown svg {
+  color: var(--rc-icon);
+}
+
+/* Lists */
+.rc-list {
+  flex: 1;
+  min-height: 0;
+  padding: 4px 8px;
+}
+
+.rc-section {
+  padding: 10px 10px 6px;
+  font-size: 12px;
+  line-height: 1.3;
+  font-weight: 600;
+  color: var(--rc-text-2);
+}
+
+.rc-filter.ss-collapse {
+  transition: grid-template-rows 0.22s cubic-bezier(0.3, 0.75, 0.1, 1) 0.04s, opacity 0.12s ease;
+}
+
+.rc-filter.ss-collapse[data-open] {
+  transition: grid-template-rows 0.24s cubic-bezier(0.3, 0.75, 0.1, 1), opacity 0.2s ease 0.04s;
+}
+
+.rc-row {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  height: 40px;
+  padding: 0 10px;
+  border-radius: 8px;
+  font-size: 14px;
+  line-height: 1.3;
+  white-space: nowrap;
+  transition: background-color 0.12s ease;
+}
+
+.rc-row[data-selected] {
+  background: var(--rc-sel);
+}
+
+.rc-tile {
+  flex-shrink: 0;
+  display: grid;
+  place-items: center;
+  width: 20px;
+  height: 20px;
+  border-radius: 5px;
+  color: #fff;
+  box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.18);
+}
+
+.rc-title {
+  color: var(--rc-text);
+}
+
+.rc-sub,
+.rc-acc {
+  color: var(--rc-text-2);
+}
+
+.rc-acc {
+  font-size: 13px;
+}
+
+.rc-spacer {
+  flex: 1;
+}
+
+/* Clipboard History */
+.rc-split {
+  flex: 1;
+  min-height: 0;
+  display: flex;
+}
+
+.rc-entries {
+  flex-shrink: 0;
+  width: var(--rc-list-w);
+  padding: 4px 8px;
+  border-right: 1px solid var(--rc-line);
+}
+
+.rc-entry-icon {
+  flex-shrink: 0;
+  color: var(--rc-icon);
+}
+
+.rc-swatch {
+  flex-shrink: 0;
+  width: 14px;
+  height: 14px;
+  margin: 0 0.5px;
+  border-radius: 50%;
+  background: #ff6363;
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15);
+}
+
+.rc-clamp {
+  min-width: 0;
+  overflow: hidden;
