+  { depth: 2, icon: 'frame', w: 0, name: 'Button' },
+  { depth: 2, icon: 'image', w: 34 },
+  { depth: 0, icon: 'frame', w: 40 },
+  { depth: 0, icon: 'frame', w: 50 },
+  { depth: 0, icon: 'frame', w: 38 },
+]
