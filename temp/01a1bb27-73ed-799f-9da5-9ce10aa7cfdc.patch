+async fn finalize_cleared_database(pool: &sqlx::SqlitePool) -> Result<(), sqlx::Error> {
+    let mut connection = pool.acquire().await?;
+    sqlx::query("VACUUM").execute(&mut *connection).await?;
+    let mode: String = sqlx::query_scalar("PRAGMA journal_mode")
+        .fetch_one(&mut *connection)
+        .await?;
+    if mode.eq_ignore_ascii_case("persist") {
+        // PERSIST leaves old page images in the journal after VACUUM. SQLite
+        // removes that journal when this connection switches to DELETE mode.
+        for (pragma, expected) in [
+            ("PRAGMA journal_mode = DELETE", "delete"),
+            ("PRAGMA journal_mode = PERSIST", "persist"),
+        ] {
+            let actual: String = sqlx::query_scalar(pragma)
+                .fetch_one(&mut *connection)
+                .await?;
+            if !actual.eq_ignore_ascii_case(expected) {
+                return Err(sqlx::Error::Protocol(format!(
+                    "SQLite journal mode change to {expected} returned {actual}"
+                )));
+            }
+        }
+    }
+    // VACUUM writes new WAL frames but does not discard earlier frames, which
+    // can still contain deleted transcripts. A busy reader can prevent a
+    // truncating checkpoint even when SQLite returns a successful query.
+    let (busy, _, _): (i64, i64, i64) = sqlx::query_as("PRAGMA wal_checkpoint(TRUNCATE)")
+        .fetch_one(&mut *connection)
+        .await?;
+    if busy != 0 {
+        return Err(sqlx::Error::Protocol(
+            "SQLite WAL checkpoint was blocked by another connection".to_string(),
+        ));
+    }
+    Ok(())
+}
