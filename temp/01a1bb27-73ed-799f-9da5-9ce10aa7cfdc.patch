diff --git a/scripts/ci/updater-trust-anchor.mjs b/scripts/ci/updater-trust-anchor.mjs
new file mode 100644
index 00000000..5a7938f1
--- /dev/null
+++ b/scripts/ci/updater-trust-anchor.mjs
@@ -0,0 +1,87 @@
+#!/usr/bin/env node
+
+import { createHash } from "node:crypto";
+import { lstatSync, readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+
+const PLATFORMS = ["macos", "windows", "linux"];
+const digest = (key) => createHash("sha256").update(key, "utf8").digest("hex");
+
+const requireKey = (key) => {
+  if (typeof key !== "string" || key.length === 0) {
+    throw new Error("Updater public key is missing");
+  }
+  return key;
+};
+
+export const captureTrustAnchor = ({ configPath, outputPath, publicKey }) => {
+  const expected = requireKey(publicKey);
+  let config;
+  try {
+    config = JSON.parse(readFileSync(configPath, "utf8"));
+  } catch {
+    // JSON parser errors can include a fragment of the public-key value.
+    throw new Error("Build updater configuration is unreadable or invalid");
+  }
+  const actual = config?.plugins?.updater?.pubkey;
+  if (config?.bundle?.createUpdaterArtifacts !== true || actual !== expected) {
+    throw new Error(
+      "Build configuration does not contain the expected updater public key",
+    );
+  }
+  // Only a digest is exported; do not place the secret value in artifacts or logs.
+  writeFileSync(outputPath, `${digest(actual)}\n`, { flag: "wx" });
+};
+
+export const verifyTrustAnchors = ({ artifactsDir, publicKey }) => {
+  const expected = digest(requireKey(publicKey));
+  for (const platform of PLATFORMS) {
+    const name = `updater-anchor-${platform}`;
+    const file = join(artifactsDir, name, `${name}.sha256`);
+    let contents;
+    try {
+      const info = lstatSync(file);
+      if (!info.isFile() || info.isSymbolicLink() || info.size > 128)
+        throw new Error("not a small regular file");
+      contents = readFileSync(file, "utf8").trim();
+    } catch {
+      throw new Error(
+        `Missing or unreadable updater trust-anchor evidence for ${platform}`,
+      );
+    }
+    if (!/^[0-9a-f]{64}$/.test(contents) || contents !== expected) {
+      throw new Error(`Updater trust-anchor mismatch for ${platform}`);
+    }
+  }
+};
+
+if (
+  process.argv[1] &&
+  import.meta.url === pathToFileURL(process.argv[1]).href
+) {
+  try {
+    if (process.argv[2] === "capture") {
+      if (!PLATFORMS.includes(process.env.RELEASE_PLATFORM))
+        throw new Error("Invalid release platform");
+      const filename = `updater-anchor-${process.env.RELEASE_PLATFORM}.sha256`;
+      captureTrustAnchor({
+        configPath: "apps/desktop/src-tauri/tauri.conf.json",
+        outputPath: join(process.env.RUNNER_TEMP, filename),
+        publicKey: process.env.UPDATER_PUBLIC_KEY,
+      });
+      console.log("Recorded updater trust-anchor evidence");
+    } else if (process.argv[2] === "verify") {
+      verifyTrustAnchors({
+        artifactsDir: process.env.ARTIFACTS_DIR ?? "dist",
+        publicKey: process.env.UPDATER_PUBLIC_KEY,
+      });
+      console.log("Updater trust-anchor evidence matches all platform builds");
+    } else {
+      throw new Error("Expected capture or verify");
+    }
+  } catch (error) {
+    console.error(error instanceof Error ? error.message : String(error));
+    process.exit(1);
+  }
+}
