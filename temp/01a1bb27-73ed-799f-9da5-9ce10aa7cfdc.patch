diff --git a/apps/desktop/scripts/forward-child-result.mjs b/apps/desktop/scripts/forward-child-result.mjs
new file mode 100644
index 00000000..6ff62d28
--- /dev/null
+++ b/apps/desktop/scripts/forward-child-result.mjs
@@ -0,0 +1,13 @@
+export const forwardChildResult = (child, errorMessage, runtime = process) => {
+  child.on("exit", (code, signal) => {
+    if (signal) {
+      runtime.kill(runtime.pid, signal);
+      return;
+    }
+    runtime.exit(code ?? 0);
+  });
+  child.on("error", (error) => {
+    console.error(errorMessage, error);
+    runtime.exit(1);
+  });
+};
