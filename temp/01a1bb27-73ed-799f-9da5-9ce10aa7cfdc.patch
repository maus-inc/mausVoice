+import { AudioWaveform } from "./AudioWaveform";
+
+ensureUiHarness();
+
+it("resets paths and opacity on size changes and when animation stops", async () => {
+  const host = document.createElement("div");
+  document.body.append(host);
+  const root = createRoot(host);
+  vi.stubGlobal(
+    "requestAnimationFrame",
+    vi.fn(() => 1),
+  );
+  vi.stubGlobal("cancelAnimationFrame", vi.fn());
+  try {
+    await act(async () =>
+      root.render(
+        <AudioWaveform
+          levels={[]}
+          active
+          width={100}
+          height={20}
+          baselineOffset={2}
+        />,
+      ),
+    );
+    const paths = [...host.querySelectorAll("path")];
+    expect(paths.map((path) => path.getAttribute("d"))).toEqual(
+      Array(3).fill("M 0 12 L 100 12"),
+    );
+    paths.forEach((path) => {
+      path.setAttribute("d", "changed");
+      path.setAttribute("opacity", "0");
+    });
+    await act(async () =>
+      root.render(
+        <AudioWaveform
+          levels={[]}
+          active
+          width={120}
+          height={30}
+          baselineOffset={2}
+        />,
+      ),
+    );
+    expect(paths.map((path) => path.getAttribute("d"))).toEqual(
+      Array(3).fill("M 0 17 L 120 17"),
+    );
+    paths.forEach((path) => {
+      path.setAttribute("d", "changed");
+      path.setAttribute("opacity", "0");
+    });
+    await act(async () =>
+      root.render(
+        <AudioWaveform
+          levels={[]}
+          active={false}
+          width={120}
+          height={30}
+          baselineOffset={2}
+        />,
+      ),
+    );
+    expect(paths.map((path) => path.getAttribute("d"))).toEqual(
+      Array(3).fill("M 0 17 L 120 17"),
+    );
+    expect(paths.map((path) => path.getAttribute("opacity"))).toEqual([
+      "1",
+      "0.78",
+      "0.56",
+    ]);
+    expect(cancelAnimationFrame).toHaveBeenCalled();
+  } finally {
+    act(() => root.unmount());
+    vi.unstubAllGlobals();
+    host.remove();
+  }
+});
