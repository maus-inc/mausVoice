+
+.ln-chip__dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+}
+
+.ln-chip__dot[data-tone="0"] { background: #eb5757; }
+.ln-chip__dot[data-tone="1"] { background: #bb87fc; }
+.ln-chip__dot[data-tone="2"] { background: #4ea7fc; }
