+  box-shadow: 0 1px 2px rgba(60, 64, 67, 0.3), 0 1px 3px 1px rgba(60, 64, 67, 0.15);
+  font-size: 14px;
+  font-weight: 500;
+  color: var(--gc-text);
+}
+
+.gc-create .gc-icon {
+  color: var(--gc-text-2);
+}
+
+.gc-create-plus {
