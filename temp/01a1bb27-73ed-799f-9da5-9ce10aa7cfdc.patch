+}
+
+.ln-tools {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.ln-tool {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  min-width: 26px;
+  height: 26px;
+  border-radius: 13px;
