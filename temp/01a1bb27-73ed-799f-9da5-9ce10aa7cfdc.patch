+}
+
+.cr-handle[data-side='n'] { top: -4px; }
+.cr-handle[data-side='s'] { bottom: -4px; }
+
+.cr-handle[data-side='w'],
+.cr-handle[data-side='e'] {
+  top: 6px;
+  bottom: 6px;
+  width: 8px;
+}
+
+.cr-handle[data-side='w'] { left: -4px; }
+.cr-handle[data-side='e'] { right: -4px; }
+
+.cr-handle:is([data-side='nw'], [data-side='ne'], [data-side='sw'], [data-side='se']) {
+  z-index: 2;
+  width: 8px;
+  height: 8px;
+  border: 1.5px solid #0d99ff;
+  border-radius: 1.5px;
+  background: #fff;
+}
+
+.cr-handle[data-side='nw'] { left: -4px; top: -4px; }
+.cr-handle[data-side='ne'] { right: -4px; top: -4px; }
+.cr-handle[data-side='sw'] { left: -4px; bottom: -4px; }
