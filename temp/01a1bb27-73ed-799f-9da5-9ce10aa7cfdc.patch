+/// Maximum JSON payload size in bytes, excluding the newline delimiter.
+pub(crate) const MAX_FRAME_BYTES: usize = 4 * 1024 * 1024;
+
+/// Read at most one bounded newline-delimited UTF-8 frame.
+pub(crate) async fn read_frame<R: AsyncBufRead + Unpin>(
+    reader: &mut R,
+) -> std::io::Result<Option<String>> {
+    let mut bytes = Vec::new();
+    reader
+        .take((MAX_FRAME_BYTES + 2) as u64)
+        .read_until(b'\n', &mut bytes)
+        .await?;
+    if bytes.is_empty() {
+        return Ok(None);
+    }
+    let terminated = bytes.last() == Some(&b'\n');
+    let payload_len = bytes.len() - usize::from(terminated);
+    if payload_len > MAX_FRAME_BYTES {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "remote frame exceeds size limit",
+        ));
+    }
+    if terminated {
+        bytes.pop();
+    }
+    if bytes.last() == Some(&b'\r') {
+        bytes.pop();
+    }
+    String::from_utf8(bytes)
+        .map(Some)
+        .map_err(|err| std::io::Error::new(std::io::ErrorKind::InvalidData, err))
+}
 
