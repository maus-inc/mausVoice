+import assert from "node:assert/strict";
+import { execFileSync, spawnSync } from "node:child_process";
+import {
+  mkdtempSync,
+  mkdirSync,
+  readFileSync,
+  rmSync,
+  writeFileSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { it } from "node:test";
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), "../..");
+const workflow = readFileSync(
+  join(root, ".github/workflows/release.yml"),
+  "utf8",
+);
+const match = workflow.match(
+  /- name: Publish cask to tap\n[\s\S]*?        run: \|\n((?:          .*\n|\n)*)/,
+);
+assert.ok(match, "publish cask shell step exists");
+const block = match[1]
+  .split("\n")
+  .map((line) => (line.startsWith("          ") ? line.slice(10) : line))
+  .join("\n");
+const git = (cwd, ...args) =>
+  execFileSync("git", args, { cwd, stdio: "pipe", encoding: "utf8" }).trim();
+
+function fixture(run) {
+  const dir = mkdtempSync(join(tmpdir(), "cask-publish-"));
+  try {
+    const remote = join(dir, "tap.git");
+    const source = join(dir, "source");
+    git(dir, "init", "--bare", "--initial-branch=main", remote);
+    git(dir, "init", "--initial-branch=main", source);
+    git(source, "config", "user.name", "Test");
+    git(source, "config", "user.email", "test@example.test");
+    mkdirSync(join(source, "Casks"));
+    writeFileSync(join(source, "Casks/mausvoice-desktop.rb"), "old cask\n");
+    git(source, "add", ".");
+    git(source, "commit", "-m", "initial");
+    git(source, "remote", "add", "origin", remote);
+    git(source, "push", "origin", "main");
+    const cask = join(dir, "cask.rb");
+    const work = join(dir, "work");
+    writeFileSync(cask, "new cask\n");
+    const shell = block
+      .replace(
+        'REPO_URL="https://x-access-token:${TOKEN}@github.com/maus-inc/homebrew-mausvoice.git"',
+        'REPO_URL="$TEST_REPO_URL"',
+      )
+      .replaceAll("/tmp/tap", work)
+      .replaceAll("/tmp/mausvoice-desktop.rb", cask);
+    assert.ok(!shell.includes("github.com/maus-inc/homebrew-mausvoice.git"));
+    const execute = (options = {}) =>
+      spawnSync("bash", ["-eo", "pipefail", "-c", shell], {
+        cwd: dir,
+        encoding: "utf8",
+        env: {
+          ...process.env,
+          VERSION: "1.2.3",
+          TEST_REPO_URL: options.remote ?? remote,
+          ...options.env,
+        },
+      });
+    run({ dir, remote, cask, execute });
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+it("runs the cask publication regression tests for workflow changes", () => {
+  const docs = readFileSync(
+    join(root, ".github/workflows/test-docs.yml"),
+    "utf8",
+  );
+  assert.ok(docs.includes('- ".github/workflows/release.yml"'));
+  assert.ok(docs.includes('- "scripts/ci/cask-publish.test.mjs"'));
+  assert.ok(docs.includes("run: node --test scripts/ci/cask-publish.test.mjs"));
+});
+
+it("publishes a changed cask and accepts an unchanged cask", () =>
+  fixture(({ remote, execute }) => {
+    const first = execute();
+    assert.equal(first.status, 0, first.stderr);
+    assert.equal(
+      git(remote, "show", "main:Casks/mausvoice-desktop.rb"),
+      "new cask",
+    );
+    const second = execute();
+    assert.equal(second.status, 0, second.stderr);
+    assert.match(second.stdout, /Cask unchanged/);
+  }));
+
+it(
+  "fails when the cask commit fails instead of claiming it is unchanged",
+  { skip: process.platform === "win32" },
+  () =>
+    fixture(({ dir, remote, execute }) => {
+      const hooks = join(dir, "hooks");
+      mkdirSync(hooks);
+      writeFileSync(join(hooks, "pre-commit"), "#!/bin/sh\nexit 1\n", {
+        mode: 0o755,
+      });
+      const result = execute({
+        env: {
+          GIT_CONFIG_COUNT: "1",
+          GIT_CONFIG_KEY_0: "core.hooksPath",
+          GIT_CONFIG_VALUE_0: hooks,
+        },
+      });
+      assert.notEqual(result.status, 0, result.stdout + result.stderr);
+      assert.equal(
+        git(remote, "show", "main:Casks/mausvoice-desktop.rb"),
+        "old cask",
+      );
+    }),
+);
+
+it(
+  "fails when the remote rejects a push",
+  { skip: process.platform === "win32" },
+  () =>
+    fixture(({ remote, execute }) => {
+      writeFileSync(
+        join(remote, "hooks", "pre-receive"),
+        "#!/bin/sh\nexit 1\n",
+        { mode: 0o755 },
+      );
+      const result = execute();
