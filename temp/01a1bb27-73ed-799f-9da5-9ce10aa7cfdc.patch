+/* Slack, Aubergine theme. One purple family for the chrome, Slack's own
+   neutral grays for the content, Slack blue only on what the user did. */
+
+.sl {
+  --sl-aub: #3f0e40;
+  --sl-side: #522653;
+  --sl-aub-raise: #5f3360;
+  --sl-on-aub: #e7dbe8;
+  --sl-on-aub-soft: #c9b5ca;
+  --sl-ink: #1d1c1d;
+  --sl-ink-2: #616061;
+  --sl-ink-3: #868686;
+  --sl-line: #e2e2e2;
+  --sl-line-2: #d0d0d0;
+  --sl-hover: #f6f6f6;
+  --sl-blue: #1264a3;
+  --sl-blue-line: #1d9bd1;
+  --sl-blue-soft: #e8f5fa;
+  --sl-green: #007a5a;
+  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
+}
+
+.sl .ss-stage {
+  overflow: hidden;
+  background: var(--ss-well);
+}
+
+.sl-grow {
+  flex: 1;
+}
+
+.sl-i {
+  display: block;
+  flex-shrink: 0;
+}
+
+/* ---- Window and top bar ---- */
+
+.sl-win {
+  position: absolute;
+  left: 40px;
+  top: 40px;
+  width: 860px;
+  height: 560px;
+  background: var(--sl-aub);
+  box-shadow: var(--ss-shadow-hero);
+}
+
+.sl-win .ss-window__bar {
+  position: relative;
+  background: var(--sl-aub);
+  border-bottom: none;
+  color: var(--sl-on-aub-soft);
+}
+
+.sl-win .ss-window__spacer {
+  flex: 1;
+}
+
+.sl-top__nav {
+  display: flex;
+  gap: 12px;
+  margin-left: 26px;
+}
+
+.sl-top__search {
+  position: absolute;
+  top: 7px;
+  left: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  width: 380px;
+  height: 24px;
+  margin-left: -190px;
+  border-radius: 6px;
+  background: var(--sl-aub-raise);
+  color: var(--sl-on-aub);
+  font-size: 12.5px;
+}
+
+.sl-top__help {
+  display: flex;
+  color: var(--sl-on-aub-soft);
+}
+
+.sl-body {
+  display: flex;
+  height: 100%;
+  background: var(--sl-aub);
+}
+
+/* ---- Rail ---- */
+
+.sl-rail {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  flex-shrink: 0;
+  gap: 12px;
+  width: 68px;
+  padding: 4px 0 14px;
+}
+
+.sl-rail__ws {
+  display: grid;
+  place-items: center;
+  width: 36px;
+  height: 36px;
+  margin-bottom: 4px;
+  border-radius: 9px;
+  background: #f3eaf3;
+  color: var(--sl-aub);
+  font-size: 17px;
+  font-weight: 800;
+}
+
+.sl-rail__item {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 3px;
+  color: var(--sl-on-aub);
+}
+
+.sl-rail__btn {
+  display: grid;
+  place-items: center;
+  width: 36px;
+  height: 36px;
+  border-radius: 9px;
+}
+
+.sl-rail__item[data-active] .sl-rail__btn {
+  background: var(--sl-aub-raise);
