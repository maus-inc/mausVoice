+
+.ln-avatar[data-face="0"] { background: #c08a6a; color: #fff; }
+.ln-avatar[data-face="1"] { background: #6f8fae; color: #fff; }
+.ln-avatar[data-face="2"] { background: #8d7fae; color: #fff; }
+
+/* The unassigned mark and the avatar share one slot and crossfade; the
+   avatar's disc grows a touch as it arrives while its initial only fades
+   (a letter that ends a scale hops as it lands) */
+.ln-who__swap {
+  display: grid;
+  width: 18px;
+  height: 18px;
+}
+
+.ln-who__swap > * {
+  grid-area: 1 / 1;
+  transition: opacity 0.35s ease, scale 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
+}
+
+.ln-who__me {
+  position: relative;
+  isolation: isolate;
+  opacity: 0;
+  background: none;
+}
+
+.ln-who__me::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  border-radius: inherit;
+  background: var(--ss-accent);
+  scale: 0.6;
+  transition: scale 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
