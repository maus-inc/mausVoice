+  }
+
+  .fx-body {
+    display: grid;
+    gap: 22px;
+    padding: 24px 20px 0;
+  }
+
+  /* The body needs no fade: the opening card reveals it, full, as it grows */
+
+  /* The about block and the running timer share one fixed lane */
+  .fx-panel {
+    display: grid;
+    height: 150px;
+  }
+
+  .fx-about,
