index 00000000..70d83b3d
--- /dev/null
+++ b/.agents/skills/stageshow/kit/controls/Draft.css
@@ -0,0 +1,90 @@
+/* Draft */
+
+@layer stageshow {
+  .ss-draft {
+    --ss-draft-pad-y: 7px;
+    --ss-draft-pad-x: 10px;
+    --ss-draft-ring: var(--ss-accent);
+    --ss-draft-radius: var(--ss-radius-sm);
+
+    position: relative;
+    display: block;
+    min-width: 0;
+  }
+
+  /* Arriving in its typing state, nothing about it eases, even a margin or
+     padding set on the Draft itself: !important inside the layer outranks the
+     page's own transition. Leaving (on post) eases as the page sets it. */
+  .ss-draft[data-editing] {
+    transition: none !important;
+  }
+
+  .ss-draft__box {
+    display: block;
+    box-sizing: border-box;
+    padding: 0;
+    border-radius: var(--ss-draft-radius);
+    /* The ring is drawn inside the box, so it never reaches past the column */
+    box-shadow: inset 0 0 0 1.5px transparent;
+    transition: padding 0.35s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease;
+  }
+
+  /* Typing: the box takes its shape at once; only the way out eases */
+  .ss-draft[data-editing] > .ss-draft__box {
+    padding: var(--ss-draft-pad-y) var(--ss-draft-pad-x);
+    box-shadow: inset 0 0 0 1.5px var(--ss-draft-ring);
+    transition: none;
+  }
+
+  .ss-draft__words {
+    position: relative;
+    display: grid;
+  }
+
+  .ss-draft__size,
+  .ss-draft__typed,
+  .ss-draft__ph {
+    grid-area: 1 / 1;
+    min-width: 0;
+    overflow-wrap: anywhere;
+  }
+
+  .ss-draft__size {
+    visibility: hidden;
+  }
+
+  .ss-draft__ph {
+    color: var(--ss-text-faint);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    opacity: 0;
+    transition: opacity 0.12s ease;
+    pointer-events: none;
+  }
+
+  .ss-draft[data-editing][data-empty] .ss-draft__ph {
+    opacity: 1;
+  }
+
+  /* It leaves the moment the first letter lands, never under it */
+  .ss-draft:not([data-empty]) .ss-draft__ph {
+    transition: none;
+  }
+
+  /* Solid while typing (each keystroke remounts it), blinking once it rests */
+  .ss-draft__caret {
+    display: inline-block;
+    width: 1.5px;
+    height: 1.1em;
+    margin-left: 1px;
+    vertical-align: -0.2em;
+    border-radius: 1px;
+    background: var(--ss-draft-ring);
+    animation: ss-draft-caret 1.06s steps(1) 0.5s infinite;
+  }
+
+  @keyframes ss-draft-caret {
+    50% { opacity: 0; }
+  }
+}
diff --git a/.agents/skills/stageshow/kit/controls/Draft.tsx b/.agents/skills/stageshow/kit/controls/Draft.tsx
new file mode 100644
index 00000000..2508273e
--- /dev/null
+++ b/.agents/skills/stageshow/kit/controls/Draft.tsx
@@ -0,0 +1,45 @@
+import type { HTMLAttributes } from 'react'
+import './Draft.css'
+
+export interface DraftProps extends Omit<HTMLAttributes<HTMLDivElement>, 'children'> {
+  /** The words typed so far. Drive it with act.type(). */
+  value: string
+  /** The finished comment. Its height is held from the first keystroke, so
+   * the card never grows a line mid-typing. */
+  full?: string
+  /** Typing: the box and caret show. Off: the words sit as the posted comment. */
+  editing: boolean
+  placeholder?: string
+}
+
+/**
+ * A comment being written that becomes the posted comment in place: a reply
+ * box in a thread, a note on a doc, a message before it sends. Put it in the
+ * column the comment's words belong to (under the name, beside the avatar);
+ * it fills that column, so while typing the box's edges sit on it (the
+ * name's left edge, the buttons' right), never hanging past it.
+ *
+ * While editing, the words sit padded inside the box. It takes that shape at
+ * once (a card arriving in its typing state doesn't ease into it); on post the
+ * box fades and the padding eases away, so the words glide onto the column
+ * and the height closes with them. Nothing changes that can't animate. The
+ * caret sits solid while typing and blinks once it rests.
+ */
+export function Draft({ value, full, editing, placeholder, className, ...rest }: DraftProps) {
+  return (
+    <div {...rest} className={`ss-draft${className ? ` ${className}` : ''}`} data-editing={editing || undefined} data-empty={!value || undefined}>
+      {/* The box is the kit's own element, so a transition or padding set on
+          the Draft (its margins, its font) can't make it ease in on its own */}
+      <span className="ss-draft__box">
+        <span className="ss-draft__words">
+          {full != null && <span className="ss-draft__size" aria-hidden>{full}</span>}
+          <span className="ss-draft__typed">
+            {value}
+            {editing && <span key={value.length} className="ss-draft__caret" />}
+          </span>
+          {placeholder && <span className="ss-draft__ph" aria-hidden>{placeholder}</span>}
+        </span>
+      </span>
+    </div>
+  )
+}
diff --git a/.agents/skills/stageshow/kit/controls/Field.css b/.agents/skills/stageshow/kit/controls/Field.css
new file mode 100644
index 00000000..9fe2ef13
--- /dev/null
+++ b/.agents/skills/stageshow/kit/controls/Field.css
@@ -0,0 +1,201 @@
+/* Field */
+
+@layer stageshow {
+  /* The box never grows past the width it was given: a chip opening, or any
+     content, clips inside the text area instead of pushing the trailing
+     control and the box edge out into whatever sits next to the field */
+  .ss-field {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr);
+    gap: 6px;
+  }
+
+  .ss-field__label {
+    font-size: 11.5px;
+    font-weight: 500;
+    color: var(--ss-text-strong);
+  }
+
+  /* The ring is a shadow, so focusing never moves the text */
+  .ss-field__box {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    height: var(--ss-control);
+    padding: 0 11px;
+    border-radius: var(--ss-radius-md);
+    background: var(--ss-surface);
+    box-shadow: inset 0 0 0 1px var(--ss-ink-4), 0 0 0 0 transparent;
+    font-size: 13px;
+    color: var(--ss-text-strong);
+    transition: box-shadow 0.2s ease, padding 0.35s cubic-bezier(0.45, 0, 0.1, 1);
+  }
+
+  /* A chip sits the same distance from every edge of the field: the box gives
+     up its left padding to the chip's own, at the same pace, so the text
+     inside never moves while the chip opens around it */
+  .ss-field__box:has(.ss-field__value[data-chip]) {
+    padding-left: calc((var(--ss-control) - 24px) / 2);
+  }
+
+  .ss-field[data-focused] .ss-field__box {
+    box-shadow: inset 0 0 0 1px var(--ss-accent), 0 0 0 3px var(--ss-accent-soft);
+  }
+
+  .ss-field[data-status="error"] .ss-field__box {
+    box-shadow: inset 0 0 0 1px var(--ss-danger), 0 0 0 3px var(--ss-danger-soft);
+  }
+
+  .ss-field__text {
+    position: relative;
+    display: flex;
+    flex: 1;
+    align-items: center;
+    min-width: 0;
+    height: 100%;
+    overflow: hidden;
+    white-space: pre;
+  }
+
+  /* Leaves the moment the first character lands; fades back when emptied */
+  .ss-field__placeholder {
+    position: absolute;
+    top: 50%;
+    left: 0;
+    color: var(--ss-text-faint);
+    translate: 0 -50%;
+    transition: opacity 0.2s ease;
+  }
+
+  .ss-field[data-filled] .ss-field__placeholder {
+    opacity: 0;
+    transition: none;
+  }
+
+  .ss-field__value[data-password] {
+    letter-spacing: 1.5px;
+  }
+
+  /* Committed as a chip in place: the text never swaps or changes weight; the
+     surface fades in around it, the padding opens it out, and the x grows in
+     beside it. Cleared, the whole chip fades holding its text. */
+  .ss-field__value {
+    display: inline-flex;
+    flex: none;
+    align-items: center;
+    height: 24px;
+    padding: 0;
+    border-radius: var(--ss-radius-pill);
+    background-color: transparent;
+    /* Released once it has faded: out of sight, so nothing needs to move */
+    transition: none;
+  }
+
+  /* Centered on the cap height, not the line box (which reads low) or the
+     x-height (which reads high once the words have ascenders: an email, a
+     name). Cap to baseline is what a real text field centers. The
+     placeholder is centered the same way, so they share a line. */
+  .ss-field__chars,
+  .ss-field__placeholder {
+    line-height: 1;
+    text-box: trim-both cap alphabetic;
+  }
+
+  .ss-field__chars {
+    display: block;
+  }
+
+  .ss-field__value[data-chip] {
+    padding: 0 calc(11px - (var(--ss-control) - 24px) / 2);
+    background-color: var(--ss-chip-bg, var(--ss-accent-soft));
+    color: var(--ss-chip-text, var(--ss-text-strong));
+    transition:
+      padding 0.35s cubic-bezier(0.45, 0, 0.1, 1),
+      background-color 0.3s ease,
+      color 0.3s ease;
+  }
+
+  .ss-field__value[data-chip][data-removable] {
+    padding-right: 4px;
+  }
+
+  .ss-field__value[data-leaving] {
+    opacity: 0;
+    transition: opacity 0.25s ease;
+  }
+
+  /* The placeholder waits for a cleared chip to finish fading, never crossing it */
+  .ss-field:has(.ss-field__value[data-leaving]) .ss-field__placeholder {
+    opacity: 0;
+    transition: none;
+  }
+
+  .ss-field__x {
+    display: inline-grid;
+    flex: none;
+    place-items: center;
+    /* Always whole: it slides out from under the text's end by margin, so its
+       icon is never sliced while the chip opens */
+    width: 16px;
+    height: 16px;
+    margin-left: -16px;
+    border-radius: 50%;
+    color: inherit;
+    opacity: 0;
+    transition: background-color 0.15s ease;
+  }
+
+  .ss-field__value[data-chip] .ss-field__x {
+    margin-left: 4px;
+    opacity: 0.75;
+    transition:
+      margin 0.35s cubic-bezier(0.45, 0, 0.1, 1),
+      opacity 0.25s ease 0.12s,
+      background-color 0.15s ease;
+  }
+
+  .ss-field__x[data-hover] {
+    opacity: 1;
+    background-color: var(--ss-ink-2);
+    transition-duration: 0s;
+  }
+
+  .ss-field__value[data-chip] + .ss-field__caret {
+    margin-left: 6px;
+  }
+
+  /* Solid while typing (each keystroke remounts it), blinking once it rests */
+  .ss-field__caret {
+    flex-shrink: 0;
+    transition: margin 0.35s cubic-bezier(0.45, 0, 0.1, 1);
+    width: 1.5px;
+    height: 16px;
+    margin-left: 1px;
+    border-radius: 1px;
+    background: var(--ss-accent);
+    animation: ss-caret 1.06s steps(1) 0.5s infinite;
+  }
+
+  @keyframes ss-caret {
+    50% { opacity: 0; }
+  }
+
+  .ss-field__ok {
+    flex-shrink: 0;
+  }
+
+  .ss-field__ok path {
+    fill: none;
+    stroke: var(--ss-success);
+    stroke-width: 2;
+    stroke-linecap: round;
+    stroke-linejoin: round;
+    stroke-dasharray: 1;
+    /* Drawn at rest, so a still (animations off) still shows it */
+    animation: ss-draw 0.35s cubic-bezier(0.65, 0, 0.35, 1) both;
+  }
+
+  @keyframes ss-draw {
+    from { stroke-dashoffset: 1; }
+  }
+}
