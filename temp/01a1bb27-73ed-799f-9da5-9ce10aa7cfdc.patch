+import { beforeEach, expect, it, vi } from "vitest";
+import type { ApiKey, OpenRouterModel } from "@maus-inc/types";
+import { INITIAL_APP_STATE } from "../state/app.state";
+import { getAppState, produceAppState, setAppState } from "../store";
+import {
+  beginLocalDataClear,
+  LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY,
+} from "../utils/local-data-write-gate";
+
+const mocks = vi.hoisted(() => ({ fetch: vi.fn(), getRepo: vi.fn() }));
+vi.mock("../repos/openrouter.repo", () => ({
+  getOpenRouterRepo: mocks.getRepo,
+}));
+vi.mock("./api-key.actions", () => ({ updateApiKey: vi.fn() }));
+import {
+  clearOpenRouterModels,
+  loadOpenRouterModels,
+} from "./openrouter.actions";
+
+const key = (id: string): ApiKey => ({
+  id,
+  name: id,
+  provider: "openrouter",
+  createdAt: "2026-01-01",
+  keyFull: `secret-${id}`,
+});
+const model = (id: string) => ({ id, name: id }) as OpenRouterModel;
+const deferred = <T>() => {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>((r) => {
+    resolve = r;
+  });
+  return { promise, resolve };
+};
+const select = (id: string) =>
+  produceAppState((draft) => {
+    draft.settings.aiPostProcessing.selectedApiKeyId = id;
+  });
+beforeEach(() => {
+  setAppState(structuredClone(INITIAL_APP_STATE), true);
+  produceAppState((draft) => {
+    draft.apiKeyById.a = key("a");
+    draft.apiKeyById.b = key("b");
+  });
+  mocks.fetch.mockReset();
+  mocks.getRepo.mockReset().mockReturnValue({ fetchModels: mocks.fetch });
+  clearOpenRouterModels();
+});
+
+it("does not publish models for a key that is no longer selected", async () => {
+  select("a");
+  const pending = deferred<OpenRouterModel[]>();
+  mocks.fetch.mockReturnValueOnce(pending.promise);
+  const loading = loadOpenRouterModels();
+  select("b");
+  pending.resolve([model("old")]);
+  await loading;
+  expect(getAppState().settings.openRouterModels).toEqual([]);
+  expect(getAppState().settings.openRouterModelsStatus).not.toBe("success");
+});
+
+it("does not let an older request overwrite a newer key's models", async () => {
+  select("a");
+  const first = deferred<OpenRouterModel[]>();
+  const second = deferred<OpenRouterModel[]>();
+  mocks.fetch
+    .mockReturnValueOnce(first.promise)
+    .mockReturnValueOnce(second.promise);
+  const a = loadOpenRouterModels();
+  select("b");
+  const b = loadOpenRouterModels();
+  second.resolve([model("new")]);
+  await b;
+  first.resolve([model("old")]);
+  await a;
+  expect(getAppState().settings.openRouterModels.map((m) => m.id)).toEqual([
+    "new",
+  ]);
+});
+
+it("does not restore models after an explicit cache clear", async () => {
+  select("a");
+  const pending = deferred<OpenRouterModel[]>();
+  mocks.fetch.mockReturnValueOnce(pending.promise);
+  const loading = loadOpenRouterModels();
+  clearOpenRouterModels();
+  pending.resolve([model("old")]);
+  await loading;
+  expect(getAppState().settings.openRouterModels).toEqual([]);
+  expect(getAppState().settings.openRouterModelsStatus).toBe("idle");
+});
+
+it("does not publish a response after a privacy clear", async () => {
+  select("a");
+  const pending = deferred<OpenRouterModel[]>();
+  mocks.fetch.mockReturnValueOnce(pending.promise);
+  const loading = loadOpenRouterModels();
+  const release = await beginLocalDataClear();
+  localStorage.removeItem(LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY);
+  release();
+  pending.resolve([model("old")]);
