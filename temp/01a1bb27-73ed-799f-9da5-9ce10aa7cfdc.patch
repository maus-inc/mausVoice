+
+.sl-divider__pill {
+  position: relative;
+  display: grid;
+  place-items: center;
+  height: 26px;
+  padding: 0 14px;
+  border: 1px solid var(--sl-line-2);
+  border-radius: 13px;
+  background: #fff;
+}
+
+/* ---- Messages ---- */
+
+.sl-msg {
+  position: relative;
+  display: grid;
+  grid-template-columns: 36px minmax(0, 1fr);
+  column-gap: 10px;
+  margin: 0 8px;
+  padding: 10px 12px;
+  border-radius: 8px;
+  transition: background 0.14s ease;
