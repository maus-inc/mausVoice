@@ -0,0 +1,52 @@
+import { Bar, Stage, Text, Window } from '../../kit'
+import './mono.css'
+
+// Monochrome customers: three customers' sites side by side in grayscale,
+// fading out at the foot. A still, for a "built on" or showcase section.
+//
+// What makes a wall of other people's products read as one picture:
+// - One treatment for all of them: grayscale and a little lift in contrast.
+//   Their brand colors would fight each other and the page's own accent.
+// - Same height, same top, one gap, every site whole across: each has a real
+//   headline, and the stage may only cut filler. It is the row of windows
+//   layout, quiet: no focus, no hero shadow.
+// - Fade at the foot with a mask (framing.md's fade crop), over filler, so
+//   the row sinks into the page instead of stopping at a line.
+// - Each site has one real line, its own headline, so they read as
+//   different products; everything else is placeholder at the right sizes.
+//
+// Real strings: the three URLs and headlines.
+
+const SITES = [
+  { url: 'lumen.studio', head: 'Light for small rooms', hue: '#d97706', tone: 'warm' },
+  { url: 'halvorsen.co', head: 'Accounting, without the paperwork', hue: '#2563eb', tone: 'cool' },
+  { url: 'tidepool.app', head: 'Swim lessons, booked in a tap', hue: '#059669', tone: 'fresh' },
+]
+
+export default function Monochrome() {
+  return (
+    <Stage width={720} height={320} compact={{ below: 600, width: 358, height: 320 }} className="mn">
+      {() => (
+        <div className="mn-fade">
+          <div className="mn-row">
+            {SITES.map((site) => (
+              <Window key={site.url} url={site.url} className="mn-win">
+                <div className="mn-site" style={{ ['--mn-hue' as string]: site.hue }}>
+                  <div className="mn-nav">
+                    <Bar w={18} h={18} r={5} style={{ background: site.hue }} />
+                    <Bar w={40} h={6} r={3} tone={2} />
+                    <Bar w={34} h={6} r={3} tone={2} />
+                  </div>
+                  <Text className="mn-head">{site.head}</Text>
+                  <Bar w={150} h={7} r={3.5} tone={2} />
+                  <span className="mn-cta" />
+                  <div className="mn-hero" />
+                </div>
+              </Window>
+            ))}
+          </div>
+        </div>
+      )}
+    </Stage>
+  )
+}
diff --git a/.agents/skills/stageshow/examples/monochrome/mono.css b/.agents/skills/stageshow/examples/monochrome/mono.css
new file mode 100644
index 00000000..1b4151b5
--- /dev/null
+++ b/.agents/skills/stageshow/examples/monochrome/mono.css
@@ -0,0 +1,98 @@
+.mn .ss-stage {
+  overflow: hidden;
+  background: var(--ss-well);
+}
+
+/* The fade: a mask on a wrapper, so the windows keep their shadows and the
+   row dissolves into whatever ground it sits on */
+.mn-fade {
+  position: absolute;
+  inset: 0;
+  -webkit-mask-image: linear-gradient(#000 55%, transparent 96%);
+  mask-image: linear-gradient(#000 55%, transparent 96%);
+}
+
+/* Three at one height and top, whole across, centered */
+.mn-row {
+  position: absolute;
+  top: 36px;
+  left: 50%;
+  display: grid;
+  grid-template-columns: repeat(3, 212px);
+  gap: 20px;
+  translate: -50% 0;
+}
+
+.mn-win {
+  height: 320px;
+  /* One treatment for every customer */
+  filter: grayscale(1) contrast(1.05);
+}
+
+.mn-site {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  align-content: start;
+  gap: 10px;
+  height: 100%;
+  padding: 14px 18px;
+  background: var(--ss-surface);
+}
+
+.mn-nav {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  margin-bottom: 14px;
+}
+
+.mn-head {
+  white-space: normal;
+  text-wrap: balance;
+  color: var(--ss-text-strong);
+  font-size: 16px;
+  font-weight: 600;
+  line-height: 1.25;
+  letter-spacing: -0.01em;
+}
+
+.mn-cta {
+  width: 84px;
+  height: 26px;
+  margin-top: 4px;
+  border-radius: 7px;
+  background: var(--mn-hue);
+}
+
+.mn-hero {
+  height: 90px;
+  margin-top: 8px;
+  border-radius: 8px;
+  background: linear-gradient(135deg, var(--mn-hue), color-mix(in srgb, var(--mn-hue) 40%, #fff));
+}
+
+/* Narrow: two sites, both whole, the third left out */
+.mn .ss-stage[data-layout='compact'] .mn-row {
+  grid-template-columns: repeat(2, 155px);
+  gap: 16px;
+}
+
+.mn .ss-stage[data-layout='compact'] .mn-win:nth-child(3) {
+  display: none;
+}
+
+.mn .ss-stage[data-layout='compact'] .mn-site {
+  padding: 12px 14px;
+}
+
+.mn .ss-stage[data-layout='compact'] .mn-head {
+  font-size: 14px;
+}
+
+.mn .ss-stage[data-layout='compact'] .mn-head {
+  font-size: 13px;
+}
+
+.mn-site > .ss-bar {
+  max-width: 100%;
+}
diff --git a/.agents/skills/stageshow/examples/notion/index.tsx b/.agents/skills/stageshow/examples/notion/index.tsx
new file mode 100644
index 00000000..895fbc93
--- /dev/null
+++ b/.agents/skills/stageshow/examples/notion/index.tsx
@@ -0,0 +1,321 @@
+import {
+  Check as Tick,
+  ChevronDown,
+  ChevronsRight,
+  Ellipsis,
+  FileText,
+  GripVertical,
+  Heading1,
+  Heading2,
+  Heading3,
+  House,
+  Inbox,
+  List,
+  ListOrdered,
+  Plus,
+  Search,
+  SquareCheck,
+  Star,
+  Type,
+} from "lucide-react";
+import type { LucideIcon } from "lucide-react";
+import {
+  Bar,
+  Menu,
+  Popover,
+  Stage,
+  Text,
+  Window,
+  type Act,
+  type Layout,
+} from "../../kit";
+import "./notion.css";
+
+// Notion's slash command. Beats: click into an empty line, press "/", the
+// block menu opens, pick "To-do list", type a task, tick it off. The finished
+// task stays checked until the host's Replay starts on the empty line.
+// Real words: the page title, the placeholder, the menu, the task.
+
+type S = {
+  focus: boolean;
+  slash: boolean;
+  menu: boolean;
+  active: number | undefined;
+  todo: boolean;
+  task: string;
+  typing: boolean;
+  done: boolean;
+};
+
+const initial: S = {
+  focus: false,
+  slash: false,
+  menu: false,
+  active: 0,
+  todo: false,
+  task: "",
+  typing: false,
+  done: false,
+};
+
+const TITLE = "Launch plan";
+const TASK = "Send launch email";
+
+type Item = { label: string; hint: string; icon: LucideIcon };
+const ITEMS: Item[] = [
+  { label: "Text", hint: "", icon: Type },
+  { label: "Heading 1", hint: "#", icon: Heading1 },
+  { label: "Heading 2", hint: "##", icon: Heading2 },
+  { label: "Heading 3", hint: "###", icon: Heading3 },
+  { label: "Bulleted list", hint: "-", icon: List },
+  { label: "Numbered list", hint: "1.", icon: ListOrdered },
+  { label: "To-do list", hint: "[]", icon: SquareCheck },
+];
+const TODO = ITEMS.findIndex((i) => i.label === "To-do list");
+
+async function script(a: Act<S>) {
+  await a.wait(500);
+
+  // Click into the empty line under the paragraph
+  await a.click({ at: "line", x: 0.72, y: 0.5 });
+  await a.set({ focus: true });
+  await a.wait(600);
+
+  // "/" opens the block menu, its first row selected
+  a.mark("slash");
+  await a.key("/");
+  await a.set({ slash: true });
+  await a.wait(90);
+  await a.set({ menu: true });
+  await a.wait(800);
+
+  // The pointer takes over the selection, then runs down to To-do list
+  await a.move({ at: "item-0", x: 0.62, y: 0.55 });
+  await a.set({ active: undefined });
+  await a.wait(200);
+  await a.move({ at: `item-${TODO}`, x: 0.62, y: 0.6 });
+  await a.wait(350);
+  a.mark("pick");
+  await a.click();
+  await a.set({ menu: false, todo: true });
+  await a.wait(650);
+
+  // Type the task
+  await a.set({ typing: true });
+  await a.type("task", TASK, { interval: 65 });
+  await a.set({ typing: false });
+  await a.wait(500);
+
+  // Tick it off
+  await a.click({ at: "check", x: 0.72, y: 0.78 });
+  a.mark("tick");
+  await a.set({ done: true, focus: false });
+  await a.wait(2200);
+
+  // Step away and keep the completed task visible. Replay is the reset.
+  await a.move({ at: "rest", x: 0.5, y: 0.5 });
+  a.mark("done");
+}
+
+function Sidebar() {
+  return (
+    <div className="nt-side">
+      <div className="nt-ws">
+        <span className="nt-ws__mark">B</span>
+        <Bar w={74} h={7} tone={4} />
+        <ChevronDown size={13} strokeWidth={2} className="nt-ico-faint" />
+      </div>
+      <div className="nt-nav">
+        {[
+          { Icon: Search, w: 40 },
+          { Icon: House, w: 34 },
+          { Icon: Inbox, w: 38 },
+        ].map(({ Icon, w }, i) => (
+          <div key={i} className="nt-nav__row">
+            <Icon size={16} strokeWidth={1.75} className="nt-ico" />
+            <Bar w={w} h={6} tone={3} />
+          </div>
+        ))}
+      </div>
+      <div className="nt-section">
+        <Bar w={36} h={5} tone={2} />
+      </div>
+      <div className="nt-nav">
+        {[62, 0, 48, 70, 54].map((w, i) => (
+          <div
+            key={i}
+            className="nt-nav__row"
+            data-active={w === 0 || undefined}
+          >
+            <FileText size={16} strokeWidth={1.75} className="nt-ico" />
+            {w === 0 ? (
+              <Text className="nt-nav__label">{TITLE}</Text>
+            ) : (
+              <Bar w={w} h={6} tone={3} />
+            )}
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+function Crumb({ compact }: { compact: boolean }) {
+  return (
+    <span className="nt-crumb">
+      {compact && (
+        <ChevronsRight
+          size={16}
+          strokeWidth={1.75}
+          className="nt-ico nt-crumb__toggle"
+        />
+      )}
+      <FileText size={14} strokeWidth={1.75} className="nt-ico" />
+      <Text className="nt-crumb__label">{TITLE}</Text>
+    </span>
+  );
+}
+
+function Tools() {
+  return (
+    <span className="nt-tools">
+      <span className="nt-share">Share</span>
+      <Star size={16} strokeWidth={1.75} className="nt-ico" />
+      <Ellipsis size={16} strokeWidth={1.75} className="nt-ico" />
+    </span>
+  );
+}
+
+function Page({ s }: { s: S }) {
+  return (
+    <div className="nt-page">
+      <div className="nt-title">{TITLE}</div>
+      <div className="nt-block">
+        <Bar w="92%" h={7} tone={3} />
+      </div>
+      <div className="nt-block">
+        <Bar w="58%" h={7} tone={3} />
+      </div>
+
+      {/* The line the story happens on: a text line that becomes a to-do */}
+      <div className="nt-line" data-target="line" data-cursor="ibeam">
+        <span className="nt-handle" aria-hidden>
+          <Plus size={16} strokeWidth={1.75} />
+          <GripVertical size={16} strokeWidth={1.75} />
+        </span>
+
+        <div className="nt-layer nt-text" data-show={!s.todo || undefined}>
+          {s.slash && <span className="nt-slash">/</span>}
+          <span
+            className="nt-caret"
+            data-show={(s.focus && !s.todo) || undefined}
+          />
+          <span
+            className="nt-placeholder"
+            data-show={(s.focus && !s.slash) || undefined}
+          >
+            Press ‘/’ for commands
+          </span>
+        </div>
+
+        <div
+          className="nt-layer nt-todo"
+          data-show={s.todo || undefined}
+          data-done={s.done || undefined}
+        >
+          <span className="nt-box" data-target="check" data-cursor="hand">
+            <Tick size={12} strokeWidth={3.25} />
+          </span>
+          <span className="nt-todo__text">
+            {s.task}
+            <span
+              className="nt-caret"
+              data-show={(s.focus && s.todo) || undefined}
+              data-typing={s.typing || undefined}
+            />
+            <span
+              className="nt-placeholder"
+              data-show={(s.focus && !s.task) || undefined}
+            >
+              To-do
+            </span>
+          </span>
+        </div>
+
+        <Popover show={s.menu} className="nt-menu" origin="top left">
+          <div className="nt-menu__head">Basic blocks</div>
+          <Menu
+            className="nt-items"
+            value={s.active}
+            targets={ITEMS.map((_, i) => `item-${i}`)}
+            items={ITEMS.map(({ label, hint, icon: Icon }) => (
+              <>
+                <span className="nt-menu__icon">
+                  <Icon size={18} strokeWidth={1.75} />
+                </span>
+                <span className="nt-menu__label">{label}</span>
+                <span className="nt-menu__hint">{hint}</span>
+              </>
+            ))}
+          />
+        </Popover>
+      </div>
+
+      <div className="nt-block nt-h2">
+        <Bar w={120} h={10} tone={4} />
+      </div>
+      <div className="nt-block">
+        <Bar w="84%" h={7} tone={3} />
+      </div>
+      <div className="nt-block">
+        <Bar w="66%" h={7} tone={3} />
+      </div>
+    </div>
+  );
+}
+
+function Scene({ s, layout }: { s: S; layout: Layout }) {
+  const compact = layout === "compact";
+  const page = <Page s={s} />;
+  return (
+    <>
+      {compact ? (
+        <Window className="nt-window" lead={<Crumb compact />}>
+          {page}
+        </Window>
+      ) : (
+        <Window
+          className="nt-window"
+          sidebar={<Sidebar />}
+          sidebarWidth={224}
+          lead={<Crumb compact={false} />}
+          toolbar={<Tools />}
+        >
+          {page}
+        </Window>
+      )}
+      {/* Where the pointer rests between loops, over the page's empty right side */}
+      <span className="nt-rest" data-target="rest" />
+    </>
+  );
+}
+
+export default function NotionSlash() {
+  return (
+    <Stage
+      play="once"
+      width={720}
+      height={538}
+      compact={{ below: 600, width: 400, height: 494 }}
+      initial={initial}
+      poster={{ ...initial, todo: true, task: TASK, done: true }}
+      script={script}
+      cursor={{ at: { at: "rest", x: 0.5, y: 0.5 } }}
+      keys={{ wide: "bottom-left", compact: "bottom-right" }}
+      accent="#2383e2"
+      className="nt"
+    >
+      {(s, _rect, layout) => <Scene s={s} layout={layout} />}
+    </Stage>
+  );
+}
diff --git a/.agents/skills/stageshow/examples/notion/notion.css b/.agents/skills/stageshow/examples/notion/notion.css
new file mode 100644
index 00000000..5e843984
--- /dev/null
+++ b/.agents/skills/stageshow/examples/notion/notion.css
@@ -0,0 +1,417 @@
+/* Notion, light. One warm neutral family (Notion's rgb(55,53,47) ink), its
+   blue for the thing acted on. Gutter: 40px wide, 20px compact. */
+
+.nt .ss-stage {
+  --gutter: 40px;
+  --nt-ink: #37352f;
+  --nt-ink-2: #787774;
+  --nt-ink-3: #a5a4a0;
+  --nt-side: #f8f8f7;
+
+  --ss-ink-1: rgba(55, 53, 47, 0.04);
+  --ss-ink-2: rgba(55, 53, 47, 0.06);
+  --ss-ink-3: rgba(55, 53, 47, 0.09);
+  --ss-ink-4: rgba(55, 53, 47, 0.13);
+  --ss-ink-5: rgba(55, 53, 47, 0.2);
+  --ss-line: rgba(55, 53, 47, 0.09);
+  --ss-line-faint: rgba(55, 53, 47, 0.05);
+  --ss-text: var(--nt-ink-2);
+  --ss-text-strong: var(--nt-ink);
+  --ss-text-faint: var(--nt-ink-3);
+  --ss-icon: #91918e;
+  --ss-icon-faint: #c3c2bf;
+  --ss-canvas: var(--nt-side);
+  --ss-well: #ecebe8;
+  --ss-font: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, sans-serif;
+
+  overflow: hidden;
+  background: var(--ss-well);
+}
+
+.nt .ss-stage[data-layout="compact"] {
+  --gutter: 20px;
+}
+
+/* Pinned top-left, runs off the right (the page's empty margin) and the bottom */
+.nt-window {
+  position: absolute;
+  top: var(--gutter);
+  left: var(--gutter);
+  width: 820px;
+  height: 600px;
+  border-radius: 10px;
+  box-shadow: var(--ss-shadow-hero);
+}
+
+.ss-stage[data-layout="compact"] .nt-window {
+  width: 460px;
+  height: 520px;
+  background: #fff;
+}
+
+.ss-stage[data-layout="compact"] .nt-window > .ss-window__bar {
+  background: #fff;
+}
+
+.nt-window .ss-window__main > .ss-window__bar,
+.ss-stage[data-layout="compact"] .nt-window > .ss-window__bar {
+  border-bottom-color: transparent;
+}
+
+.nt-ico {
+  flex-shrink: 0;
+  color: var(--ss-icon);
+}
+
+.nt-ico-faint {
+  flex-shrink: 0;
+  color: var(--ss-icon-faint);
+}
+
+/* ---- Sidebar ---- */
+
+.nt-side {
+  display: flex;
+  flex-direction: column;
+  padding: 2px 8px;
+}
+
+.nt-ws {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  height: 30px;
+  padding: 0 8px;
+  margin-bottom: 4px;
+}
+
+.nt-ws__mark {
+  display: grid;
+  place-items: center;
+  width: 20px;
+  height: 20px;
+  border-radius: 4px;
+  background: #e3e2df;
+  color: var(--nt-ink-2);
+  font-size: 11px;
+  font-weight: 600;
+}
+
+.nt-nav {
+  display: flex;
+  flex-direction: column;
+  gap: 1px;
+}
+
+.nt-nav__row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  height: 30px;
+  padding: 0 8px;
+  border-radius: 6px;
+}
+
+.nt-nav__row[data-active] {
+  background: rgba(55, 53, 47, 0.06);
+}
+
+.nt-nav__label {
+  font-size: 14px;
+  font-weight: 500;
+  color: var(--nt-ink);
+}
+
+.nt-section {
+  display: flex;
+  align-items: center;
+  height: 30px;
+  padding: 0 8px;
+  margin-top: 14px;
+}
+
+/* ---- Top bar ---- */
+
+.nt-crumb {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.ss-stage[data-layout="compact"] .nt-crumb {
+  margin-left: 12px;
+}
+
+.nt-crumb__toggle {
+  margin-right: 6px;
+}
+
+.nt-crumb__label {
+  font-size: 13px;
+  color: var(--nt-ink);
+}
+
+.nt-tools {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+}
+
+.nt-share {
+  font-size: 13px;
+  color: var(--nt-ink);
+}
+
+/* ---- Page ---- */
+
+.nt-page {
+  padding: 34px 96px 0 96px;
+  color: var(--nt-ink);
+}
+
+.ss-stage[data-layout="compact"] .nt-page {
+  padding: 26px 40px 0 52px;
+}
+
+.nt-title {
+  margin: 0 0 12px;
+  font-size: 32px;
+  font-weight: 700;
+  line-height: 1.2;
+  letter-spacing: -0.01em;
+}
+
+.ss-stage[data-layout="compact"] .nt-title {
+  font-size: 28px;
+}
+
+.nt-block {
+  display: flex;
+  align-items: center;
+  height: 30px;
+}
+
+.nt-h2 {
+  height: 40px;
+  margin-top: 10px;
+}
+
+.nt-line {
+  position: relative;
+  height: 30px;
+  font-size: 16px;
+  line-height: 24px;
+}
+
+/* Notion's block handle: + and the drag dots, shown while the block is hovered */
+.nt-handle {
+  position: absolute;
+  top: 3px;
+  left: -46px;
+  display: flex;
+  gap: 2px;
+  color: var(--ss-icon-faint);
+  opacity: 0;
+  transition: opacity 0.2s ease;
+}
+
+.nt-line[data-hover] .nt-handle {
+  opacity: 1;
+}
+
+.nt-layer {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  align-items: center;
+  opacity: 0;
+  transition: opacity 0.18s ease;
+}
+
+.nt-layer[data-show] {
+  opacity: 1;
+}
+
+.nt-slash {
+  white-space: pre;
+}
+
+.nt-placeholder {
+  color: var(--nt-ink-3);
+  white-space: nowrap;
+  opacity: 0;
+  transition: opacity 0.12s ease;
+}
+
+.nt-placeholder[data-show] {
+  opacity: 1;
+}
+
+/* A text caret: solid while typing, blinking at rest */
+.nt-caret {
+  display: inline-block;
+  flex-shrink: 0;
+  width: 1.5px;
+  height: 20px;
+  margin: 0 1px 0 0;
+  background: var(--nt-ink);
+  opacity: 0;
+  vertical-align: middle;
+}
+
+.nt-caret[data-show] {
+  animation: nt-blink 1.06s steps(1, end) infinite;
