+
+it("starts with the latest enabled preference and port after reconciliation", async () => {
+  setAppState((state) => ({
+    ...state,
+    userPrefs: {
+      ...createDefaultPreferences(),
+      remoteReceiverAutoStart: true,
+      remoteReceiverPort: 1234,
+    },
+  }));
+  mocks.get.mockResolvedValue(status(false));
+  mocks.start.mockResolvedValue(status(true));
+  let finish!: () => void;
+  mocks.reconcile.mockReturnValueOnce(
+    new Promise<void>((resolve) => {
+      finish = resolve;
+    }),
+  );
+  const init = initializeRemoteReceiver();
+  await vi.waitFor(() => expect(mocks.reconcile).toHaveBeenCalledOnce());
