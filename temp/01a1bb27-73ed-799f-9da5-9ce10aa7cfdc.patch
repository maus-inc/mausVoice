+import { beforeEach, expect, it, vi } from "vitest";
+import { createAgentRunState } from "../state/agent.state";
+import { INITIAL_APP_STATE } from "../state/app.state";
+import { getAppState, produceAppState, setAppState } from "../store";
+import {
+  beginLocalDataClear,
+  LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY,
+} from "../utils/local-data-write-gate";
+
+const mocks = vi.hoisted(() => ({ setAlwaysAllow: vi.fn() }));
+vi.mock("../tools", () => ({
+  createTool: () => ({ setAlwaysAllow: mocks.setAlwaysAllow }),
+}));
+vi.mock("../repos", () => ({
+  getToolRepo: () => ({ listToolInfos: vi.fn() }),
+}));
+import { requestToolPermission, resolveToolPermission } from "./tool.actions";
+
+beforeEach(() => {
+  setAppState(structuredClone(INITIAL_APP_STATE), true);
+  mocks.setAlwaysAllow.mockReset();
+  produceAppState((draft) => {
+    draft.toolInfoById.terminal = {
+      id: "terminal",
+    } as (typeof draft.toolInfoById)[string];
+    draft.agentStateByConversationId.c = createAgentRunState("chat");
+  });
+});
+
+const pending = () => {
+  const id = requestToolPermission(
+    "terminal",
+    { command: "test" },
+    "c",
+    "call",
+  );
+  produceAppState((draft) => {
+    draft.agentStateByConversationId.c.toolCalls.push({
+      toolCallId: "call",
+      toolName: "terminal",
+      params: {},
+      status: "awaiting-permission",
+      permissionId: id,
+    });
+  });
+  return id;
+};
+
+it("does not turn a denial into an always-allow grant", () => {
+  const id = pending();
+  resolveToolPermission(id, "denied", { alwaysAllow: true });
+  expect(getAppState().toolPermissionById[id].status).toBe("denied");
+  expect(mocks.setAlwaysAllow).not.toHaveBeenCalled();
+});
+
+it("rejects an expired approval and does not grant future calls", () => {
+  const id = pending();
+  produceAppState((draft) => {
+    draft.toolPermissionById[id].createdAt = Date.now() - 60_001;
+  });
+  resolveToolPermission(id, "allowed", { alwaysAllow: true });
+  expect(getAppState().toolPermissionById[id].status).toBe("denied");
+  expect(mocks.setAlwaysAllow).not.toHaveBeenCalled();
+});
+
+it("rejects approval after the agent run has been aborted or replaced", () => {
+  const id = pending();
+  produceAppState((draft) => {
+    draft.agentStateByConversationId.c.aborted = true;
+  });
+  resolveToolPermission(id, "allowed", { alwaysAllow: true });
+  expect(getAppState().toolPermissionById[id].status).toBe("denied");
+  expect(mocks.setAlwaysAllow).not.toHaveBeenCalled();
+});
+
+it("does not grant from a permission that no longer belongs to the live call", () => {
+  const id = pending();
+  produceAppState((draft) => {
+    draft.agentStateByConversationId.c.toolCalls = [];
+  });
+  resolveToolPermission(id, "allowed", { alwaysAllow: true });
+  expect(getAppState().toolPermissionById[id].status).toBe("denied");
+  expect(mocks.setAlwaysAllow).not.toHaveBeenCalled();
+});
+
+it("grants only once for a current pending permission", () => {
+  const id = pending();
+  resolveToolPermission(id, "allowed", { alwaysAllow: true });
+  resolveToolPermission(id, "allowed", { alwaysAllow: true });
+  expect(getAppState().toolPermissionById[id].status).toBe("allowed");
+  expect(mocks.setAlwaysAllow).toHaveBeenCalledOnce();
+  expect(mocks.setAlwaysAllow).toHaveBeenCalledWith(
+    { command: "test" },
+    true,
+    "conversation:c",
+  );
+});
+
+it("does not turn malformed overlay status into an approval or grant", () => {
+  const id = pending();
+  resolveToolPermission(id, "unknown" as never, { alwaysAllow: true });
+  expect(getAppState().toolPermissionById[id].status).toBe("pending");
+  expect(mocks.setAlwaysAllow).not.toHaveBeenCalled();
+});
+
+it("rejects approval during a local-data clear", async () => {
+  const id = pending();
+  const release = await beginLocalDataClear();
+  try {
+    resolveToolPermission(id, "allowed", { alwaysAllow: true });
+    expect(getAppState().toolPermissionById[id].status).toBe("denied");
+    expect(mocks.setAlwaysAllow).not.toHaveBeenCalled();
+  } finally {
+    localStorage.removeItem(LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY);
+    release();
+  }
+});
+
+it("does not grant future permission from a truthy non-boolean flag", () => {
+  const id = pending();
+  resolveToolPermission(id, "allowed", { alwaysAllow: "yes" as never });
+  expect(getAppState().toolPermissionById[id].status).toBe("allowed");
+  expect(mocks.setAlwaysAllow).not.toHaveBeenCalled();
+});
+
+it("rejects approval when the owning run has already finished", () => {
+  const id = pending();
+  produceAppState((draft) => {
+    draft.agentStateByConversationId.c.status = "done";
+  });
+  resolveToolPermission(id, "allowed", { alwaysAllow: true });
+  expect(getAppState().toolPermissionById[id].status).toBe("denied");
+  expect(mocks.setAlwaysAllow).not.toHaveBeenCalled();
+});
