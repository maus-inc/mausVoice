+import { toFile } from "openai";
+import {
+  runSdkTranscription,
+  type SdkTranscriptionBody,
+  type TranscribeAudioOutput,
+} from "./transcription.utils";
+
+export const transcribeUploadedAudio = async (
+  transcribe: (body: SdkTranscriptionBody) => Promise<unknown>,
+  options: Omit<SdkTranscriptionBody, "file"> & {
+    blob: ArrayBuffer | Buffer;
+    ext: string;
+  },
+): Promise<TranscribeAudioOutput> => {
+  const { blob, ext, ...params } = options;
+  const file = await toFile(blob, `audio.${ext}`);
+  return runSdkTranscription(transcribe, { file, ...params });
+};
