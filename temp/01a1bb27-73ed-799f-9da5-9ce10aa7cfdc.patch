+import { beforeEach, expect, it, vi } from "vitest";
+import type { ApiKey } from "@maus-inc/types";
+import { INITIAL_APP_STATE } from "../state/app.state";
+import { getAppState, produceAppState, setAppState } from "../store";
+
+const mocks = vi.hoisted(() => ({
+  update: vi.fn(),
+  error: vi.fn(),
+  queued: vi.fn(),
+  list: vi.fn(),
+}));
+vi.mock("./api-key.actions", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("./api-key.actions")>();
+  return {
+    ...actual,
+    updateApiKeyFromCurrent: (
+      ...args: Parameters<typeof actual.updateApiKeyFromCurrent>
+    ) => {
+      mocks.queued();
+      return actual.updateApiKeyFromCurrent(...args);
+    },
+  };
+});
+vi.mock("../repos", () => ({
+  getApiKeyRepo: () => ({
+    updateApiKey: mocks.update,
+    listApiKeys: mocks.list,
+  }),
+}));
+vi.mock("./app.actions", () => ({ showErrorSnackbar: mocks.error }));
+vi.mock("./user.actions", () => ({ updateUserPreferences: vi.fn() }));
+import {
+  toggleOpenRouterFavoriteModel,
+  updateOpenRouterProviderRouting,
+} from "./openrouter.actions";
+
+const key: ApiKey = {
+  id: "k",
+  name: "key",
+  provider: "openrouter",
+  keyFull: "secret",
+  createdAt: "2026-01-01",
+  openRouterConfig: { favoriteModels: [] },
+};
+beforeEach(() => {
+  setAppState(structuredClone(INITIAL_APP_STATE), true);
+  produceAppState((draft) => {
+    draft.apiKeyById.k = key;
+    draft.settings.apiKeys = [key];
+  });
+  mocks.update.mockReset();
+  mocks.error.mockReset();
+  mocks.queued.mockReset();
+  mocks.list.mockReset();
+});
+
+it("composes favorite toggles with a routing update that is still saving", async () => {
+  let finish!: () => void;
+  mocks.update.mockImplementationOnce(async (payload) => {
+    await new Promise<void>((resolve) => {
+      finish = resolve;
+    });
+    return { ...key, openRouterConfig: payload.openRouterConfig };
+  });
+  mocks.update.mockImplementationOnce(async (payload) => ({
+    ...key,
+    openRouterConfig: payload.openRouterConfig,
+  }));
+  const routing = updateOpenRouterProviderRouting("k", {
+    allow_fallbacks: false,
+  });
+  await vi.waitFor(() => expect(finish).toBeDefined());
+  const favorite = toggleOpenRouterFavoriteModel("k", "model-a");
+  await vi.waitFor(() => expect(mocks.queued).toHaveBeenCalledTimes(2));
+  finish();
+  await Promise.all([routing, favorite]);
+  expect(getAppState().apiKeyById.k.openRouterConfig).toEqual({
+    favoriteModels: ["model-a"],
+    providerRouting: { allow_fallbacks: false },
+  });
+});
+
+it("composes two overlapping favorite toggles", async () => {
+  let finish!: () => void;
+  mocks.update.mockImplementationOnce(async (payload) => {
+    await new Promise<void>((resolve) => {
+      finish = resolve;
+    });
+    return { ...key, openRouterConfig: payload.openRouterConfig };
+  });
+  mocks.update.mockImplementationOnce(async (payload) => ({
+    ...key,
+    openRouterConfig: payload.openRouterConfig,
+  }));
+  const first = toggleOpenRouterFavoriteModel("k", "a");
+  await vi.waitFor(() => expect(finish).toBeDefined());
+  const second = toggleOpenRouterFavoriteModel("k", "b");
+  await vi.waitFor(() => expect(mocks.queued).toHaveBeenCalledTimes(2));
+  finish();
+  await Promise.all([first, second]);
+  expect(getAppState().apiKeyById.k.openRouterConfig?.favoriteModels).toEqual([
+    "a",
+    "b",
+  ]);
+});
+
+it("reconciles an update that committed despite a failed response before the next toggle", async () => {
+  const committed = { ...key, openRouterConfig: { favoriteModels: ["a"] } };
+  mocks.update.mockRejectedValueOnce(new Error("lost response"));
+  mocks.list.mockResolvedValueOnce([committed]);
+  mocks.update.mockImplementationOnce(async (payload) => ({
+    ...committed,
+    openRouterConfig: payload.openRouterConfig,
+  }));
+  const logger = vi.spyOn(console, "error").mockImplementation(() => undefined);
+  try {
+    await expect(toggleOpenRouterFavoriteModel("k", "a")).rejects.toThrow(
+      "Failed to update API key.",
+    );
+    await toggleOpenRouterFavoriteModel("k", "b");
+    expect(mocks.list).toHaveBeenCalledOnce();
+    expect(getAppState().apiKeyById.k.openRouterConfig?.favoriteModels).toEqual(
+      ["a", "b"],
+    );
+  } finally {
+    logger.mockRestore();
+  }
+});
+
+it("does not write a stale config when reconciliation fails, and retries later", async () => {
+  const committed = { ...key, openRouterConfig: { favoriteModels: ["a"] } };
+  mocks.update.mockRejectedValueOnce(new Error("lost response"));
+  mocks.list
+    .mockRejectedValueOnce(new Error("read failed"))
+    .mockResolvedValueOnce([committed]);
+  mocks.update.mockImplementationOnce(async (payload) => ({
+    ...committed,
+    openRouterConfig: payload.openRouterConfig,
+  }));
+  const logger = vi.spyOn(console, "error").mockImplementation(() => undefined);
+  try {
+    await expect(toggleOpenRouterFavoriteModel("k", "a")).rejects.toThrow(
+      "Failed to update API key.",
+    );
+    await expect(toggleOpenRouterFavoriteModel("k", "b")).rejects.toThrow(
+      "Failed to reload API key.",
+    );
+    expect(mocks.update).toHaveBeenCalledTimes(1);
+    await toggleOpenRouterFavoriteModel("k", "b");
+    expect(mocks.list).toHaveBeenCalledTimes(2);
+    expect(getAppState().apiKeyById.k.openRouterConfig?.favoriteModels).toEqual(
+      ["a", "b"],
+    );
+  } finally {
+    logger.mockRestore();
+  }
+});
+
+it("does not recreate a key that disappeared before reconciliation", async () => {
+  mocks.update.mockRejectedValueOnce(new Error("lost response"));
+  mocks.list.mockResolvedValueOnce([]);
+  const logger = vi.spyOn(console, "error").mockImplementation(() => undefined);
+  try {
+    await expect(toggleOpenRouterFavoriteModel("k", "a")).rejects.toThrow(
+      "Failed to update API key.",
+    );
+    await toggleOpenRouterFavoriteModel("k", "b");
+    expect(mocks.update).toHaveBeenCalledTimes(1);
+    expect(getAppState().apiKeyById.k).toBeUndefined();
+    expect(getAppState().settings.apiKeys).toEqual([]);
+  } finally {
+    logger.mockRestore();
+  }
+});
