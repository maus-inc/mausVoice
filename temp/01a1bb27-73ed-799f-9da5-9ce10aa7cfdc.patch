@@ -0,0 +1,51 @@
+import { getAppState } from "../store";
+import { getMyUserPreferences } from "../utils/user.utils";
+import {
+  getReceiverPreferenceVersion,
+  isReceiverPreferenceVersionCurrent,
+} from "../utils/remote-receiver-intent.utils";
+import {
+  getLocalDataClearGeneration,
+  isLocalDataClearRequested,
+} from "../utils/local-data-write-gate";
+import {
+  loadPairedRemoteDevices,
+  reconcileMissingRemoteTarget,
+} from "./paired-remote-device.actions";
+import {
+  getRemoteReceiverMutationVersion,
+  isRemoteReceiverMutationVersionCurrent,
+  refreshRemoteReceiverStatus,
+  startRemoteReceiver,
+} from "./remote-receiver.actions";
+
+/** Reconcile startup state without undoing a later explicit receiver action. */
+export const initializeRemoteReceiver = async (): Promise<void> => {
+  const clearGeneration = getLocalDataClearGeneration();
+  const receiverVersion = getRemoteReceiverMutationVersion();
+  const preferenceVersion = getReceiverPreferenceVersion();
+  const isCurrent = () =>
+    !isLocalDataClearRequested() &&
+    clearGeneration === getLocalDataClearGeneration();
+  if (!isCurrent()) return;
+
+  const devicesLoaded = await loadPairedRemoteDevices();
+  if (!isCurrent()) return;
+  await refreshRemoteReceiverStatus();
+  if (!isCurrent()) return;
+  if (devicesLoaded) await reconcileMissingRemoteTarget();
+  if (!isCurrent()) return;
+
+  // Read preferences after reconciliation, not before its potentially slow
+  // write. Start immediately after the checks, without another await.
+  const state = getAppState();
+  const prefs = getMyUserPreferences(state);
+  if (
+    prefs?.remoteReceiverAutoStart &&
+    !state.remoteReceiverStatus?.enabled &&
+    isRemoteReceiverMutationVersionCurrent(receiverVersion) &&
+    isReceiverPreferenceVersionCurrent(preferenceVersion)
+  ) {
+    await startRemoteReceiver(prefs.remoteReceiverPort ?? null);
+  }
+};
