+        assert_eq!(super::macos_hog::get_hogging_pid(1), Ok(-1));
+        assert_eq!(super::macos_hog::toggle_hog_mode(1), Ok(123));
+        let f = sys::FIXTURE.lock().unwrap();
+        assert_eq!(f.get_count, 2);
+        assert_eq!(f.set_count, 1);
+        assert_eq!(f.set_value, -1);
