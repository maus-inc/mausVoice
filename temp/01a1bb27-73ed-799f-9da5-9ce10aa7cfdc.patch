diff --git a/apps/desktop/src/hooks/stream.hooks.test.tsx b/apps/desktop/src/hooks/stream.hooks.test.tsx
new file mode 100644
index 00000000..c43f94f9
--- /dev/null
+++ b/apps/desktop/src/hooks/stream.hooks.test.tsx
@@ -0,0 +1,104 @@
+// @vitest-environment jsdom
+import { act, createElement } from "react";
+import { createRoot } from "react-dom/client";
+import { Observable, Subject } from "rxjs";
+import { describe, expect, it, vi } from "vitest";
+import { useStreamWithSideEffects } from "./stream.hooks";
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (error: unknown) => void;
+  const promise = new Promise<T>((ok, fail) => {
+    resolve = ok;
+    reject = fail;
+  });
+  return { promise, resolve, reject };
+}
+
+describe("stream effect ownership", () => {
+  it("does not subscribe when an asynchronous builder resolves after unmount", async () => {
+    const pending = deferred<Observable<number>>();
+    const subscribe = vi.fn();
+    const observed = vi.fn();
+    const root = createRoot(document.createElement("div"));
+    const Probe = () => {
+      useStreamWithSideEffects({
+        builder: () => pending.promise,
+        dependencies: [],
+        onSuccess: observed,
+      });
+      return null;
+    };
+    await act(async () => {
+      root.render(createElement(Probe));
+    });
+    await act(async () => {
+      root.unmount();
+    });
+    await act(async () => {
+      pending.resolve(new Observable(subscribe));
+      await pending.promise;
+    });
+    expect(subscribe).not.toHaveBeenCalled();
+    expect(observed).not.toHaveBeenCalled();
+  });
+
+  it("retires a pending builder on dependency change and unsubscribes the current stream", async () => {
+    const pending = deferred<Observable<number>>();
+    const oldSubscribe = vi.fn();
+    const current = new Subject<number>();
+    const observed = vi.fn();
+    const root = createRoot(document.createElement("div"));
+    const Probe = ({ generation }: { generation: number }) => {
+      useStreamWithSideEffects({
+        builder: () => (generation === 0 ? pending.promise : current),
+        dependencies: [generation],
+        onSuccess: observed,
+      });
+      return null;
+    };
+    await act(async () => {
+      root.render(createElement(Probe, { generation: 0 }));
+    });
+    await act(async () => {
+      root.render(createElement(Probe, { generation: 1 }));
+    });
+    await act(async () => {
+      pending.resolve(new Observable(oldSubscribe));
+      await pending.promise;
+      current.next(7);
+    });
+    expect(oldSubscribe).not.toHaveBeenCalled();
+    expect(observed).toHaveBeenCalledWith(7);
+    expect(current.observed).toBe(true);
+    await act(async () => {
+      root.unmount();
+    });
+    expect(current.observed).toBe(false);
+  });
+
+  it("ignores a retired builder rejection", async () => {
+    const pending = deferred<Observable<number>>();
+    const failed = vi.fn();
+    const root = createRoot(document.createElement("div"));
+    const Probe = () => {
+      useStreamWithSideEffects({
+        builder: () => pending.promise,
+        dependencies: [],
+        onError: failed,
+      });
+      return null;
+    };
+    await act(async () => {
+      root.render(createElement(Probe));
+    });
+    await act(async () => {
+      root.unmount();
+    });
+    await act(async () => {
+      pending.reject(new Error("late"));
+      await pending.promise.catch(() => {});
+    });
+    expect(failed).not.toHaveBeenCalled();
+  });
+});
