+  supersede: vi.fn(),
+}));
+vi.mock("@tauri-apps/api/core", () => ({ invoke: mocks.invoke }));
+vi.mock("../actions/edit-watch.actions", () => ({
+  beginEditWatch: mocks.begin,
+  supersedeEditWatchWithoutInsertion: mocks.supersede,
+}));
+vi.mock("../store", () => ({
+  getAppState: () => ({ appTargetById: {}, supportsPasteKeybinds: "none" }),
+}));
+vi.mock("./user.utils", () => ({
+  getMyUserPreferences: () => ({
+    insertionMethod: "paste",
+    handsFreeDelayMs: 0,
+  }),
+}));
+vi.mock("./overlay.utils", () => ({
+  sendPillFlashMessage: vi.fn(),
+  sendPillStageText: vi.fn(),
+}));
+vi.mock("./log.utils", () => ({ getLogger: () => ({ info: vi.fn() }) }));
+vi.mock("../i18n/intl", () => ({
+  getIntl: () => ({
+    formatMessage: (value: { defaultMessage: string }) => value.defaultMessage,
+  }),
+}));
+
+import { routeTranscriptOutput } from "./output-routing.utils";
+
+beforeEach(() => vi.clearAllMocks());
+
+it("does not watch an unrelated focused field when final text was only copied", async () => {
+  mocks.invoke.mockResolvedValueOnce("copied_to_clipboard");
+  await expect(
+    routeTranscriptOutput({
+      text: "some words",
+      mode: "dictation",
+      currentAppId: null,
+    }),
+  ).resolves.toMatchObject({ delivered: true });
+  expect(mocks.begin).not.toHaveBeenCalled();
+  expect(mocks.supersede).toHaveBeenCalledOnce();
+});
+
+it("starts the watch when a final dictation was pasted", async () => {
+  mocks.invoke.mockResolvedValueOnce("pasted");
+  await routeTranscriptOutput({
+    text: "some words",
+    mode: "dictation",
+    currentAppId: null,
+  });
+  expect(mocks.begin).toHaveBeenCalledWith("some words");
+  expect(mocks.supersede).not.toHaveBeenCalled();
+});
+
+it("does not start or supersede a watch for a copied interim segment", async () => {
+  mocks.invoke.mockResolvedValueOnce("copied_to_clipboard");
+  await expect(
+    routeTranscriptOutput({
+      text: "some words",
+      mode: "dictation",
+      currentAppId: null,
+      isInterim: true,
+    }),
+  ).resolves.toMatchObject({ delivered: false });
+  expect(mocks.begin).not.toHaveBeenCalled();
+  expect(mocks.supersede).not.toHaveBeenCalled();
+});
