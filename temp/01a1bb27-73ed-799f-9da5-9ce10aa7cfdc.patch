+    (perspective) => {
+      const camera = { tilt: 58, spin: -30, roll: 12, perspective };
+      const rayAt = createPixelRayFactory(120, 110, 200, camera);
+      for (const [x, y] of [
+        [0, 0],
+        [120, 110],
+        [240, 220],
