+ensureUiHarness();
+let container: HTMLDivElement;
+let root: Root;
+const render = (baseUrl: string, apiKey: string) =>
+  act(() =>
+    root.render(
+      createElement(OllamaModelPicker, {
+        baseUrl,
+        apiKey,
+        selectedModel: null,
+        onModelSelect: vi.fn(),
+      }),
+    ),
+  );
+beforeEach(() => {
+  mocks.availability.mockReset();
+  mocks.models.mockReset();
+  container = document.createElement("div");
+  document.body.appendChild(container);
+  root = createRoot(container);
+});
+afterEach(() => {
+  act(() => root.unmount());
+  container.remove();
+  vi.useRealTimers();
+});
+
+it("does not show an old endpoint's models while its replacement is pending", async () => {
+  mocks.availability.mockResolvedValueOnce(true);
+  mocks.models.mockResolvedValueOnce(["old-model"]);
+  render("http://one", "first");
+  await act(async () => {
+    await Promise.resolve();
+    await Promise.resolve();
+  });
+  expect(container.textContent).toContain("old-model");
+  let finish!: (value: boolean) => void;
+  mocks.availability.mockImplementationOnce(
+    () =>
+      new Promise((resolve) => {
+        finish = resolve;
+      }),
+  );
+  render("http://two", "second");
+  expect(container.textContent).not.toContain("old-model");
+  expect(container.textContent).toContain("Checking Ollama connection");
+  const signal = mocks.availability.mock.calls[1]![0]!;
+  mocks.availability.mockImplementationOnce(() => new Promise(() => {}));
+  render("http://one", "first");
+  expect(signal.aborted).toBe(true);
+  expect(container.textContent).not.toContain("old-model");
+  await act(async () => {
+    finish(true);
+    await Promise.resolve();
+  });
+  expect(mocks.models).toHaveBeenCalledTimes(1);
+});
+
+it("keeps the selector disabled while the model list is pending and times out", async () => {
+  vi.useFakeTimers();
+  mocks.availability.mockResolvedValueOnce(true);
+  let finish!: (value: string[]) => void;
+  mocks.models.mockImplementationOnce(
+    () =>
+      new Promise((resolve) => {
+        finish = resolve;
+      }),
+  );
+  const log = vi.spyOn(console, "error").mockImplementation(() => {});
+  try {
+    render("http://one", "first");
+    await act(async () => {
+      await Promise.resolve();
+    });
+    expect(container.textContent).toContain("Checking Ollama connection");
+    const signal = mocks.models.mock.calls[0]![0]!;
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(10_000);
+    });
+    expect(signal.aborted).toBe(true);
+    expect(container.textContent).toContain("Unable to connect");
+    await act(async () => {
+      finish(["late-model"]);
+      await Promise.resolve();
+    });
+    expect(container.textContent).not.toContain("late-model");
+  } finally {
+    log.mockRestore();
+  }
+});
+
+it("does not log opaque request errors", async () => {
+  mocks.availability.mockRejectedValueOnce(
+    new Error("opaque-credential-value"),
+  );
+  const log = vi.spyOn(console, "error").mockImplementation(() => {});
+  try {
+    render("http://one", "first");
+    await act(async () => {
+      await Promise.resolve();
+    });
+    expect(log).toHaveBeenCalledWith("Failed to fetch Ollama models");
+    expect(JSON.stringify(log.mock.calls)).not.toContain(
+      "opaque-credential-value",
+    );
+  } finally {
+    log.mockRestore();
+  }
+});
