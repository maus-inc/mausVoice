+import type { Hotkey } from "@maus-inc/types";
+import { beforeEach, expect, it, vi } from "vitest";
+import { INITIAL_APP_STATE } from "../../state/app.state";
+import { getAppState, produceAppState, setAppState } from "../../store";
+import {
+  enqueueHotkeyWrite,
+  markOptimisticHotkeyWrite,
+} from "../../utils/hotkey-write-queue";
+import {
+  beginLocalDataClear,
+  LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY,
+} from "../../utils/local-data-write-gate";
+
+const mocks = vi.hoisted(() => ({ replace: vi.fn(), sync: vi.fn() }));
+vi.mock("../../repos", () => ({
+  getHotkeyRepo: () => ({ replaceStyleHotkeys: mocks.replace }),
+}));
+vi.mock("../../utils/keyboard.utils", () => ({
+  SWITCH_TO_STYLE_HOTKEY_PREFIX: "switch-to-style:",
+  syncHotkeyCombosToNative: mocks.sync,
+}));
+import { saveStyleHotkeys } from "./save-style-hotkeys";
+const original: Hotkey = {
+  id: "one",
+  actionName: "switch-to-style:t",
+  keys: ["A"],
+};
+const saved: Hotkey = { ...original, keys: ["B"] };
+const newer: Hotkey = { ...original, keys: ["C"] };
+beforeEach(() => {
+  setAppState(structuredClone(INITIAL_APP_STATE), true);
+  produceAppState((draft) => {
+    draft.hotkeyById.one = original;
+    draft.settings.hotkeyIds = ["one"];
+  });
+  mocks.replace.mockReset().mockResolvedValue([saved]);
+  mocks.sync.mockReset().mockResolvedValue(undefined);
+});
+
+it("does not overwrite a newer optimistic edit while replacement is pending", async () => {
+  let finish!: (value: Hotkey[]) => void;
+  mocks.replace.mockImplementationOnce(
+    () =>
+      new Promise((resolve) => {
+        finish = resolve;
+      }),
+  );
+  const saving = saveStyleHotkeys([saved]);
+  await vi.waitFor(() => expect(mocks.replace).toHaveBeenCalledOnce());
+  markOptimisticHotkeyWrite(newer.actionName, newer.id);
+  produceAppState((draft) => {
+    draft.hotkeyById.one = newer;
+  });
+  const later = enqueueHotkeyWrite(async () => undefined);
+  finish([saved]);
+  await Promise.all([saving, later]);
+  expect(getAppState().hotkeyById.one.keys).toEqual(["C"]);
+});
+
+it("waits for earlier shortcut writes before replacing the group", async () => {
+  let finish!: () => void;
+  const prior = enqueueHotkeyWrite(
+    () =>
+      new Promise<void>((resolve) => {
+        finish = resolve;
+      }),
+  );
+  await vi.waitFor(() => expect(finish).toBeDefined());
+  const saving = saveStyleHotkeys([saved]);
+  await new Promise((resolve) => setTimeout(resolve, 0));
+  const calls = mocks.replace.mock.calls.length;
+  finish();
+  await Promise.all([prior, saving]);
+  expect(calls).toBe(0);
+});
+
+it("holds the clear barrier through replacement and native sync", async () => {
+  let finish!: () => void;
+  mocks.sync.mockImplementationOnce(
+    () =>
+      new Promise<void>((resolve) => {
+        finish = resolve;
+      }),
+  );
+  const saving = saveStyleHotkeys([saved]);
+  await vi.waitFor(() => expect(mocks.sync).toHaveBeenCalledOnce());
+  let clearReady = false;
+  const clearing = beginLocalDataClear().then((release) => {
+    clearReady = true;
+    return release;
+  });
+  await Promise.resolve();
+  const premature = clearReady;
+  finish();
+  await saving;
+  const release = await clearing;
+  localStorage.removeItem(LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY);
+  release();
+  expect(premature).toBe(false);
+});
+
+it("preserves a newer optimistic deletion during replacement", async () => {
+  let finish!: (value: Hotkey[]) => void;
+  mocks.replace.mockImplementationOnce(
+    () =>
+      new Promise((resolve) => {
+        finish = resolve;
+      }),
+  );
+  const saving = saveStyleHotkeys([saved]);
+  await vi.waitFor(() => expect(mocks.replace).toHaveBeenCalledOnce());
+  markOptimisticHotkeyWrite(original.actionName, original.id);
+  produceAppState((draft) => {
+    delete draft.hotkeyById.one;
+    draft.settings.hotkeyIds = [];
+  });
+  const later = enqueueHotkeyWrite(async () => undefined);
+  finish([saved]);
+  await Promise.all([saving, later]);
+  expect(getAppState().hotkeyById.one).toBeUndefined();
+  expect(getAppState().settings.hotkeyIds).not.toContain("one");
+});
+
+it("reports a native sync failure without rolling back the committed replacement", async () => {
+  mocks.sync.mockRejectedValueOnce(new Error("sync failed"));
+  await expect(saveStyleHotkeys([saved])).rejects.toThrow("sync failed");
+  expect(getAppState().hotkeyById.one.keys).toEqual(["B"]);
+});
