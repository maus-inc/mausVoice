+    transition: opacity 0.2s ease, transform 0.3s var(--tg-ui);
+  }
+
+  .tg-ticks__one,
+  .tg-ticks__two {
+    stroke-dasharray: 1;
+    stroke-dashoffset: 1;
+    transition: stroke-dashoffset 0.3s cubic-bezier(0.25, 1, 0.5, 1);
+  }
+
+  .tg-ticks:not([data-state='clock']) .tg-ticks__clock {
+    opacity: 0;
+    transform: scale(0.6);
+  }
+
+  .tg-ticks:not([data-state='clock']) .tg-ticks__one,
+  .tg-ticks[data-state='read'] .tg-ticks__two {
+    stroke-dashoffset: 0;
+  }
+
+  /* A photo fills its bubble; the time rides on it in a dark pill */
+  .tg-photo > .ss-bubble {
+    padding: 2px;
+    --b: #fff;
+  }
+
+  .tg-photo .ss-bubble__text {
+    position: relative;
+  }
+
+  .tg-photo__img {
+    display: block;
+    width: 252px;
+    height: 168px;
+    object-fit: cover;
+    object-position: center 40%;
+    border-radius: 16px;
+  }
+
+  .tg-photo__time,
+  .tg-big__time {
+    position: absolute;
+    right: 8px;
+    bottom: 8px;
+    padding: 2px 7px;
+    border-radius: 10px;
+    background: rgba(0, 0, 0, 0.32);
+    color: #fff;
+    font-size: 12px;
+    line-height: 16px;
+    letter-spacing: 0;
+  }
+
+  /* A lone emoji is the message: big, no bubble, its time in a pill */
+  .tg-big > .ss-bubble {
+    --b: transparent;
+    margin-left: 6px;
+    padding: 0 0 4px;
+  }
+
+  .tg-big .ss-bubble__tail {
+    display: none;
+  }
+
+  .tg-big .ss-bubble__text {
+    position: relative;
+    width: 112px;
+  }
+
+  .tg-emoji {
+    display: block;
+    font-size: 84px;
+    line-height: 100px;
+    text-align: center;
+    will-change: transform;
+    transform-origin: 50% 80%;
+    animation: tg-emoji 1.6s cubic-bezier(0.25, 0.8, 0.25, 1) both;
+  }
+
+  .tg-big__time {
+    right: -46px;
+    bottom: 2px;
+    background: rgba(40, 70, 40, 0.3);
+  }
+
+  /* The date: a small tinted pill in the middle of the wallpaper */
+  .tg-date {
+    align-self: center;
+    margin: 8px 0;
+    padding: 3px 10px;
+    border-radius: 12px;
+    background: rgba(40, 70, 40, 0.28);
+    color: #fff;
+    font-size: 13px;
+    font-weight: 600;
+    line-height: 16px;
+  }
+
+  /* ---- The composer: attach, the field, mic or send ---- */
+  .tg-compose {
+    position: relative;
+    z-index: 1;
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    margin: 0 12px 40px;
+  }
+
+  .tg-round {
+    display: grid;
+    flex: none;
+    place-items: center;
+    width: 44px;
+    height: 44px;
+    border-radius: 50%;
+    color: #6d7279;
+  }
+
+  .tg-field {
+    position: relative;
+    display: flex;
+    flex: 1;
+    align-items: center;
+    min-width: 0;
+    height: 44px;
+    padding: 0 10px 0 16px;
+    border-radius: 22px;
+    font-size: 17px;
+    letter-spacing: -0.02em;
+  }
+
+  .tg-field__text {
+    flex: 1;
+    min-width: 0;
+    color: var(--tg-ink);
+    white-space: nowrap;
+  }
+
+  .tg-caret {
+    display: inline-block;
+    width: 2px;
+    height: 21px;
+    margin-left: 1px;
+    border-radius: 1px;
+    background: var(--tg-blue);
+    vertical-align: -4px;
+  }
+
+  .tg-field__ph {
+    position: absolute;
+    left: 16px;
+    color: #a2a6ab;
+    pointer-events: none;
+    /* Comes back once the sent words have lifted clear of the field */
+    transition: opacity 0.2s ease 0.3s;
+  }
+
+  .tg-field__ph[data-hide] {
+    opacity: 0;
+    transition: opacity 0.12s ease;
+  }
+
+  .tg-field__icon {
+    display: grid;
+    flex: none;
+    place-items: center;
+    color: #8a8f95;
+  }
+
+  /* Mic and send share one place: the mic shrinks away as send grows in */
+  .tg-action {
+    position: relative;
+    display: grid;
+    flex: none;
+    width: 44px;
+    height: 44px;
+
+    > * {
+      grid-area: 1 / 1;
+    }
+  }
+
+  .tg-mic {
+    transition: opacity 0.18s ease, transform 0.3s var(--tg-ui);
+  }
+
+  .tg-mic[data-off] {
+    opacity: 0;
+    transform: scale(0.5);
+  }
+
+  .tg-send {
+    display: grid;
+    place-items: center;
+    border-radius: 50%;
+    background: var(--tg-blue);
+    color: #fff;
+    opacity: 0;
+    transform: scale(0.5);
+    transition: opacity 0.18s ease, transform 0.3s var(--tg-ui);
+  }
+
+  .tg-send[data-on] {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+/* A lone emoji arrives as Telegram's animated ones do: it grows in, then
+   waves twice and settles */
+@keyframes tg-emoji {
+  0% {
+    transform: scale(0.55);
+  }
+  30% {
+    transform: scale(1);
+  }
+  45% {
+    transform: rotate(-9deg);
+  }
+  60% {
+    transform: rotate(7deg);
+  }
+  75% {
+    transform: rotate(-4deg);
+  }
+  100% {
+    transform: none;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .tg .tg-emoji {
+    animation: none;
+  }
+}
