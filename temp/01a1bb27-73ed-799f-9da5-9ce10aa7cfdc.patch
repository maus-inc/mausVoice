+/* BrandMark */
+
+@layer stageshow {
+  .ss-brand {
+    display: inline-flex;
+    flex: none;
+    align-items: center;
+    justify-content: center;
+    overflow: hidden;
+  }
+
+  .ss-brand[data-tile] {
+    background: var(--ss-surface);
+    box-shadow: inset 0 0 0 1px var(--ss-line);
+  }
+
+  .ss-brand[data-tile][data-light-tile] {
+    background: #fff;
+    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 8%);
+  }
+
+  /* Logos are optically smaller than their tile, aspect kept */
+  .ss-brand img {
+    display: block;
+    flex: none;
+    min-width: 0;
+    min-height: 0;
+    width: 62%;
+    height: 62%;
+    object-fit: contain;
+  }
+
+  .ss-brand__initial {
+    color: var(--ss-text-strong);
+    font-weight: 600;
+  }
+}
+
+@layer stageshow {
+  /* Bare, the mark is the whole footprint */
+  .ss-brand:not([data-tile]) img {
+    width: 100%;
+    height: 100%;
+  }
+}
diff --git a/.agents/skills/stageshow/kit/parts/BrandMark.tsx b/.agents/skills/stageshow/kit/parts/BrandMark.tsx
