+    println!("Connected {:?} to {:?}", subs.get_sender(), subs.get_dest());
+
+    // Send a note!
+    let note = EvNote { channel: 0, note: 64, duration: 100, velocity: 100, off_velocity: 64 };
+    let mut e = Event::new(EventType::Noteon, &note);
+    e.set_subs();
+    e.set_direct();
+    e.set_source(sport);
