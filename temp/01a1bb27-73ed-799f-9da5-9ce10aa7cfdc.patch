@@ -0,0 +1,467 @@
+import { beforeEach, expect, it, vi } from "vitest";
+import { INITIAL_APP_STATE } from "../state/app.state";
+import {
+  getAppState,
+  produceAppState,
+  setAppState,
+  useAppStore,
+} from "../store";
+import {
+  beginLocalDataClear,
+  LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY,
+} from "../utils/local-data-write-gate";
+import type { LocalSidecarDevice } from "../sidecars";
+import type { LocalTranscriptionModelStatusMap } from "../state/settings.state";
+
+const mocks = vi.hoisted(() => ({
+  devices: vi.fn(),
+  statuses: vi.fn(),
+  select: vi.fn(),
+  error: vi.fn(),
+  download: vi.fn(),
+  pause: vi.fn(),
+  cancel: vi.fn(),
+  deleteModel: vi.fn(),
+}));
+vi.mock("../sidecars", () => ({
+  getLocalTranscriptionSidecarManager: () => ({
+    listAvailableDevices: mocks.devices,
+    listModelStatuses: mocks.statuses,
+    downloadModel: mocks.download,
+    pauseModelDownload: mocks.pause,
+    cancelModelDownload: mocks.cancel,
+    deleteModel: mocks.deleteModel,
+  }),
+}));
+vi.mock("./user.actions", () => ({
+  setPreferredTranscriptionDevice: mocks.select,
+}));
+vi.mock("./app.actions", () => ({ showErrorSnackbar: mocks.error }));
+import {
+  downloadLocalTranscriptionModel,
+  pauseLocalTranscriptionModelDownload,
+  cancelLocalTranscriptionModelDownload,
+  deleteLocalTranscriptionModel,
+  refreshLocalTranscriptionDevices,
+  refreshLocalTranscriptionModelStatuses,
+} from "./settings-local-transcription.actions";
+
+const deferred = <T>() => {
+  let resolve!: (value: T) => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<T>((r, j) => {
+    resolve = r;
+    reject = j;
+  });
+  return { promise, resolve, reject };
+};
+const device = (id: string, mode: "cpu" | "gpu") =>
+  ({ id, mode, name: id }) as LocalSidecarDevice;
+const statuses = (label: string) =>
+  ({
+    tiny: { model: "tiny", downloaded: true, valid: true, path: label },
+  }) as unknown as LocalTranscriptionModelStatusMap;
+beforeEach(() => {
+  setAppState(structuredClone(INITIAL_APP_STATE), true);
+  mocks.devices.mockReset();
+  mocks.statuses.mockReset();
+  mocks.select.mockReset().mockResolvedValue(undefined);
+  mocks.error.mockReset();
+  mocks.download.mockReset();
+  mocks.pause.mockReset();
+  mocks.cancel.mockReset();
+  mocks.deleteModel.mockReset();
+});
+
+it("does not overwrite a device chosen while enumeration was in flight", async () => {
+  const pending = deferred<LocalSidecarDevice[]>();
+  mocks.devices.mockReturnValueOnce(pending.promise);
+  produceAppState((draft) => {
+    draft.settings.aiTranscription.device = "gpu:old";
+  });
+  const loading = refreshLocalTranscriptionDevices();
+  produceAppState((draft) => {
+    draft.settings.aiTranscription.device = "gpu:new";
+  });
+  pending.resolve([device("cpu", "cpu")]);
+  await loading;
+  expect(mocks.select).not.toHaveBeenCalled();
+  expect(getAppState().settings.aiTranscription.device).toBe("gpu:new");
+});
+
+it("does not let older device enumeration replace newer results or loading status", async () => {
+  const first = deferred<LocalSidecarDevice[]>(),
+    second = deferred<LocalSidecarDevice[]>();
+  mocks.devices
+    .mockReturnValueOnce(first.promise)
+    .mockReturnValueOnce(second.promise);
+  const a = refreshLocalTranscriptionDevices(),
+    b = refreshLocalTranscriptionDevices();
+  second.resolve([device("new", "cpu")]);
+  await b;
+  first.resolve([device("old", "cpu")]);
+  await a;
+  expect(
+    getAppState().settings.aiTranscription.availableDevices.map((d) => d.id),
+  ).toEqual(["new"]);
+});
+
+it("does not replace a newer model-status snapshot with an older one", async () => {
+  const first = deferred<LocalTranscriptionModelStatusMap>(),
+    second = deferred<LocalTranscriptionModelStatusMap>();
+  mocks.statuses
+    .mockReturnValueOnce(first.promise)
+    .mockReturnValueOnce(second.promise);
+  const a = refreshLocalTranscriptionModelStatuses(),
+    b = refreshLocalTranscriptionModelStatuses();
+  second.resolve(statuses("new"));
+  await b;
+  first.resolve(statuses("old"));
+  await a;
+  expect(
+    getAppState().settings.aiTranscription.localModelManagement.modelStatuses,
+  ).toEqual(statuses("new"));
+});
+
+it("does not publish device or model snapshots from before a clear", async () => {
+  const d = deferred<LocalSidecarDevice[]>(),
+    s = deferred<LocalTranscriptionModelStatusMap>();
+  mocks.devices.mockReturnValueOnce(d.promise);
+  mocks.statuses.mockReturnValueOnce(s.promise);
+  const devices = refreshLocalTranscriptionDevices(),
+    models = refreshLocalTranscriptionModelStatuses();
+  const release = await beginLocalDataClear();
+  localStorage.removeItem(LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY);
+  release();
+  d.resolve([device("old", "cpu")]);
+  s.resolve(statuses("old"));
+  await Promise.all([devices, models]);
+  expect(getAppState().settings.aiTranscription.availableDevices).toEqual([]);
+  expect(
+    getAppState().settings.aiTranscription.localModelManagement
+      .modelStatusesLoaded,
+  ).toBe(false);
+  expect(mocks.select).not.toHaveBeenCalled();
+});
+
+it("does not report an old failure after switching out of local mode", async () => {
+  const pending = deferred<LocalSidecarDevice[]>();
+  mocks.devices.mockReturnValueOnce(pending.promise);
+  const loading = refreshLocalTranscriptionDevices();
+  produceAppState((draft) => {
+    draft.settings.aiTranscription.mode = "api";
+  });
+  pending.reject(new Error("old"));
+  await loading;
+  expect(mocks.error).not.toHaveBeenCalled();
+});
+
+it("keeps loading while the newer device read is still pending", async () => {
+  const first = deferred<LocalSidecarDevice[]>(),
+    second = deferred<LocalSidecarDevice[]>();
+  mocks.devices
+    .mockReturnValueOnce(first.promise)
+    .mockReturnValueOnce(second.promise);
+  const a = refreshLocalTranscriptionDevices(),
+    b = refreshLocalTranscriptionDevices();
+  first.reject(new Error("older error"));
+  await a;
+  expect(getAppState().settings.aiTranscription.availableDevicesLoading).toBe(
+    true,
+  );
+  expect(mocks.error).not.toHaveBeenCalled();
+  second.resolve([device("cpu", "cpu")]);
+  await b;
+  expect(getAppState().settings.aiTranscription.availableDevicesLoading).toBe(
+    false,
+  );
+});
+
+it("does not publish model status after switching to another compute backend", async () => {
+  const pending = deferred<LocalTranscriptionModelStatusMap>();
+  mocks.statuses.mockReturnValueOnce(pending.promise);
+  const loading = refreshLocalTranscriptionModelStatuses();
+  produceAppState((draft) => {
+    draft.settings.aiTranscription.device = "gpu:0";
+  });
+  pending.resolve(statuses("cpu"));
+  await loading;
+  expect(
+    getAppState().settings.aiTranscription.localModelManagement
+      .modelStatusesLoaded,
+  ).toBe(false);
+  expect(
+    getAppState().settings.aiTranscription.localModelManagement
+      .modelStatusesLoading,
+  ).toBe(false);
+});
+
+it("does not start sidecar reads when the shared clear marker is present", async () => {
+  localStorage.setItem(LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY, "pending");
+  try {
+    expect(await refreshLocalTranscriptionDevices()).toBeNull();
+    expect(await refreshLocalTranscriptionModelStatuses()).toBeNull();
+    expect(mocks.devices).not.toHaveBeenCalled();
+    expect(mocks.statuses).not.toHaveBeenCalled();
+  } finally {
+    localStorage.removeItem(LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY);
+  }
+});
+
+it("suppresses duplicate model downloads before the first progress callback", async () => {
+  const pending = deferred<null>();
+  mocks.download.mockReturnValueOnce(pending.promise);
+  const first = downloadLocalTranscriptionModel("tiny");
+  const second = downloadLocalTranscriptionModel("tiny");
+  expect(mocks.download).toHaveBeenCalledTimes(1);
+  pending.resolve(null);
+  await Promise.all([first, second]);
+});
+
+it("releases a model's download reservation after a failure", async () => {
+  mocks.download
+    .mockRejectedValueOnce(new Error("network"))
+    .mockResolvedValueOnce(null);
