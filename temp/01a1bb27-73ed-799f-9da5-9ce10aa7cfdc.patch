+/* Fly */
+
+@layer stageshow {
+  .ss-fly {
+    position: absolute;
+    /* Above popovers and menus: what flies usually leaves one */
+    z-index: 30;
+    pointer-events: none;
+  }
+
+  /* The flyer fills its box exactly: no line box under an inline child (which
+     sat it a few px low, then the real element snapped up on landing), and
+     children sized 100% get the full height */
+  .ss-fly > div,
+  .ss-fly__lift {
+    width: 100%;
+    height: 100%;
+  }
+
+  .ss-fly__lift {
+    display: flex;
+  }
+
+  .ss-fly__lift > * {
+    flex: 1 1 auto;
+    max-width: 100%;
+    max-height: 100%;
+  }
+
+  /* held: it buds off what it leaves, fading in where it sits (a value
+     chip's words lie exactly over the value's), never popping in whole */
+  .ss-fly[data-held]:not([data-go]) .ss-fly__lift {
+    animation: ss-fly-bud 0.2s ease-out both;
+  }
+
+  @keyframes ss-fly-bud {
+    from { opacity: 0; }
+  }
+
+  /* A small lift mid-flight that is gone before it lands */
+  .ss-fly[data-go] .ss-fly__lift {
+    animation-name: ss-fly-lift;
+    animation-timing-function: cubic-bezier(0.33, 1, 0.68, 1);
+    animation-fill-mode: both;
+  }
+
+  @keyframes ss-fly-lift {
+    30% { transform: scale(1.12); filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.18)); }
+    85%, 100% { transform: none; filter: none; }
+  }
+}
