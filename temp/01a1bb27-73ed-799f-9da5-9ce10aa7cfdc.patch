@@ -0,0 +1,99 @@
+// @vitest-environment jsdom
+import type { ChatMessage } from "@maus-inc/types";
+import { afterEach, expect, it, vi } from "vitest";
+const mocks = vi.hoisted(() => ({ update: vi.fn(), invoke: vi.fn() }));
+vi.mock("@tauri-apps/api/window", () => ({
+  getCurrentWindow: () => ({ label: "main" }),
+}));
+vi.mock("@tauri-apps/api/core", () => ({ invoke: mocks.invoke }));
+vi.mock("./chat-message.actions", () => ({
+  createChatMessage: vi.fn(),
+  updateChatMessage: mocks.update,
+}));
+vi.mock("../utils/log.utils", () => ({
+  getLogger: () => ({ warning: vi.fn() }),
+}));
+vi.mock("../i18n/intl", () => ({
+  getIntl: () => ({
+    formatMessage: (value: { defaultMessage: string }) => value.defaultMessage,
+  }),
+}));
+import { copyPendingPasteReview } from "./pending-paste-review.actions";
+import {
+  beginLocalDataClear,
+  LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY,
+} from "../utils/local-data-write-gate";
+
+const message: ChatMessage = {
+  id: "pending",
+  conversationId: "conv",
+  role: "system",
+  content: "",
+  createdAt: "2026-01-01T00:00:00.000Z",
+  metadata: {
+    type: "pending-paste-review",
+    toolName: "paste",
+    toolCallState: "awaiting-manual-paste",
+    text: "secret",
+    status: "pending",
+  },
+};
+afterEach(() => {
+  window.localStorage.removeItem(LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY);
+  vi.clearAllMocks();
+});
+it("does not copy a saved review when a clear starts while its write is pending", async () => {
+  let finish!: (value: ChatMessage) => void;
+  mocks.update.mockReturnValueOnce(
+    new Promise<ChatMessage>((resolve) => {
+      finish = resolve;
+    }),
+  );
+  mocks.invoke.mockResolvedValue(undefined);
+  const copying = copyPendingPasteReview(message, "secret");
+  const clear = beginLocalDataClear();
+  finish(message);
+  const result = await Promise.allSettled([copying, clear]);
+  const released = result[1];
+  try {
+    expect(result[0]).toMatchObject({
+      status: "rejected",
+      reason: { message: "Local data is being cleared." },
+    });
+    expect(mocks.invoke).not.toHaveBeenCalled();
+    expect(mocks.update).toHaveBeenCalledTimes(1);
+    expect(released.status).toBe("fulfilled");
+  } finally {
+    window.localStorage.removeItem(LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY);
+    if (released.status === "fulfilled") released.value();
+  }
+});
+
+it("waits for an already-started clipboard write before finishing clear", async () => {
+  mocks.update.mockResolvedValue(message);
+  let finish!: () => void;
+  mocks.invoke.mockReturnValueOnce(
+    new Promise<void>((resolve) => {
+      finish = resolve;
+    }),
+  );
+  const copying = copyPendingPasteReview(message, "secret");
+  await vi.waitFor(() => expect(mocks.invoke).toHaveBeenCalledOnce());
+  let clearFinished = false;
+  const clear = beginLocalDataClear().then((release) => {
+    clearFinished = true;
+    return release;
+  });
+  await Promise.resolve();
+  expect(clearFinished).toBe(false);
+  finish();
+  const result = await Promise.allSettled([copying, clear]);
+  try {
+    expect(result[0].status).toBe("rejected");
+    expect(mocks.update).toHaveBeenCalledTimes(1);
+    expect(result[1].status).toBe("fulfilled");
+  } finally {
+    window.localStorage.removeItem(LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY);
+    if (result[1].status === "fulfilled") result[1].value();
+  }
+});
