+}
+
+.gc-mini {
+  margin-top: 18px;
+  padding: 0 2px;
+}
+
+.gc-mini-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  height: 28px;
+  padding-left: 6px;
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--gc-text);
+}
+
+.gc-mini-nav {
+  display: flex;
+  gap: 8px;
+}
+
+.gc-mini-grid {
+  display: grid;
+  grid-template-columns: repeat(7, 24px);
+  justify-content: space-between;
+  row-gap: 1px;
+  margin-top: 4px;
+}
+
+.gc-mini-dow,
