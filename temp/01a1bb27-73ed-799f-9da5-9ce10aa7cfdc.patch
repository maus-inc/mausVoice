@@ -0,0 +1,149 @@
+import { beforeEach, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({
+  invoke: vi.fn(),
+  state: {
+    dictationBacklog: [] as string[],
+    dictationBacklogNonce: 0,
+    appTargetById: {},
+    supportsPasteKeybinds: "none",
+  },
+}));
+vi.mock("@tauri-apps/api/core", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@tauri-apps/api/core")>()),
+  invoke: mocks.invoke,
+}));
+vi.mock("../store", () => ({
+  getAppState: () => mocks.state,
+  produceAppState: (update: (state: typeof mocks.state) => void) =>
+    update(mocks.state),
+}));
+vi.mock("./user.utils", () => ({
+  getMyUserPreferences: () => ({ insertionMethod: "paste" }),
+}));
+vi.mock("./overlay.utils", () => ({
+  sendPillFlashMessage: vi.fn(),
+  sendPillStageText: vi.fn(),
+}));
+vi.mock("./log.utils", () => ({
+  getLogger: () => ({ info: vi.fn(), warning: vi.fn() }),
+}));
+vi.mock("../i18n/intl", () => ({
+  getIntl: () => ({
+    formatMessage: (d: { defaultMessage: string }) => d.defaultMessage,
+  }),
+}));
+
+import {
+  appendToDictationBacklog,
+  clearDictationBacklog,
+  drainDictationBacklog,
+} from "./output-routing.utils";
+
+const deferred = () => {
+  let resolve!: (outcome: string) => void;
+  let reject!: (reason: Error) => void;
+  const promise = new Promise<string>((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+  return { promise, resolve, reject };
+};
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.invoke.mockReset();
+  mocks.state.dictationBacklog = [];
+  mocks.state.dictationBacklogNonce = 0;
+});
+
+it("keeps segments appended during a successful backlog delivery", async () => {
+  const delivery = deferred();
+  mocks.invoke.mockReturnValueOnce(delivery.promise);
+  appendToDictationBacklog("old");
+  const drain = drainDictationBacklog();
+  appendToDictationBacklog("new");
+  delivery.resolve("pasted");
+  expect(await drain).toEqual({ delivered: true, copiedToClipboard: false });
+  expect(mocks.state.dictationBacklog).toEqual(["new"]);
+});
+
+it("does not remove a replacement backlog that happens to have the same text", async () => {
+  const delivery = deferred();
+  mocks.invoke.mockReturnValueOnce(delivery.promise);
+  appendToDictationBacklog("same");
+  const drain = drainDictationBacklog();
+  clearDictationBacklog();
+  appendToDictationBacklog("same");
+  delivery.resolve("pasted");
+  await drain;
+  expect(mocks.state.dictationBacklog).toEqual(["same"]);
+});
+
+it("leaves the backlog intact if delivery fails", async () => {
+  const delivery = deferred();
+  mocks.invoke.mockReturnValueOnce(delivery.promise);
+  appendToDictationBacklog("old");
+  const drain = drainDictationBacklog();
+  appendToDictationBacklog("new");
+  delivery.reject(new Error("paste failed"));
+  await expect(drain).rejects.toThrow("paste failed");
+  expect(mocks.state.dictationBacklog).toEqual(["old", "new"]);
+});
+
+it("an overlapping drain cannot consume a later identical segment", async () => {
+  const first = deferred();
+  mocks.invoke.mockReturnValueOnce(first.promise);
+  appendToDictationBacklog("same");
+  const a = drainDictationBacklog();
+  const b = drainDictationBacklog();
+  appendToDictationBacklog("same");
+  expect(await b).toEqual({ delivered: false, copiedToClipboard: false });
+  expect(mocks.invoke).toHaveBeenCalledTimes(1);
+  first.resolve("pasted");
+  await a;
+  expect(mocks.state.dictationBacklog).toEqual(["same"]);
+});
+
+it("declines an overlapping drain before it can deliver the same snapshot", async () => {
+  const first = deferred();
+  mocks.invoke.mockReturnValue(first.promise);
+  appendToDictationBacklog("hello");
+  const active = drainDictationBacklog();
+  const duplicate = await drainDictationBacklog("new segment");
+  expect(duplicate).toEqual({ delivered: false, copiedToClipboard: false });
+  expect(mocks.invoke).toHaveBeenCalledTimes(1);
+  first.resolve("pasted");
+  await active;
+});
+
+it("allows a new backlog to drain while an older invalidated drain is still pending", async () => {
+  const first = deferred();
+  const second = deferred();
+  mocks.invoke
+    .mockReturnValueOnce(first.promise)
+    .mockReturnValueOnce(second.promise);
+  appendToDictationBacklog("old");
+  const old = drainDictationBacklog();
+  clearDictationBacklog();
+  appendToDictationBacklog("new");
+  const fresh = drainDictationBacklog();
+  expect(mocks.invoke).toHaveBeenCalledTimes(2);
+  second.resolve("pasted");
+  await fresh;
+  first.resolve("pasted");
+  await old;
+  expect(mocks.state.dictationBacklog).toEqual([]);
+});
+
+it("allows a retry after the active drain rejects", async () => {
+  mocks.invoke
+    .mockRejectedValueOnce(new Error("paste failed"))
+    .mockResolvedValueOnce("pasted");
+  appendToDictationBacklog("retry");
+  await expect(drainDictationBacklog()).rejects.toThrow("paste failed");
+  await expect(drainDictationBacklog()).resolves.toEqual({
+    delivered: true,
+    copiedToClipboard: false,
+  });
+  expect(mocks.state.dictationBacklog).toEqual([]);
+});
