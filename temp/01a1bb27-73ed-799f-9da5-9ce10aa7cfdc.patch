@@ -0,0 +1,100 @@
+import type { IntlShape } from "react-intl";
+import type { SaveCorrectedTranscriptResult } from "../actions/auto-learn.actions";
+
+/** Describe the completed correction without hiding partial glossary outcomes. */
+export const correctionFeedback = (
+  intl: IntlShape,
+  {
+    learnedTerms,
+    failedTerms,
+    dictionarySuppressed,
+    learningIncomplete,
+  }: SaveCorrectedTranscriptResult,
+): { message: string; mode: "success" | "error" } => {
+  if (learningIncomplete) {
+    return {
+      message: intl.formatMessage({
+        defaultMessage:
+          "Transcript updated, but dictionary learning could not be completed.",
+      }),
+      mode: "error",
+    };
+  }
+  const added = learnedTerms.length;
+  if (dictionarySuppressed && failedTerms > 0) {
+    return {
+      message: intl.formatMessage(
+        {
+          defaultMessage:
+            "Privacy mode interrupted dictionary learning after errors. Added {added, plural, one {# word} other {# words}} ({failed} failed); remaining words were skipped.",
+        },
+        { added, failed: failedTerms },
+      ),
+      mode: "error",
+    };
+  }
+  if (dictionarySuppressed && added > 0) {
+    return {
+      message: intl.formatMessage(
+        {
+          defaultMessage:
+            "Privacy mode interrupted dictionary learning. Added {added, plural, one {# word} other {# words}} to your dictionary; remaining words were skipped.",
+        },
+        { added },
+      ),
+      mode: "success",
+    };
+  }
+  if (dictionarySuppressed) {
+    return {
+      message: intl.formatMessage({
+        defaultMessage:
+          "Privacy mode prevented dictionary learning. Transcript updated without adding words.",
+      }),
+      mode: "success",
+    };
+  }
+  if (added === 1 && failedTerms === 0) {
+    return {
+      message: intl.formatMessage(
+        { defaultMessage: 'Added "{term}" to your dictionary' },
+        { term: learnedTerms[0] },
+      ),
+      mode: "success",
+    };
+  }
+  if (added > 0 && failedTerms === 0) {
+    return {
+      message: intl.formatMessage(
+        { defaultMessage: "Added {count} words to your dictionary" },
+        { count: added },
+      ),
+      mode: "success",
+    };
+  }
+  if (added > 0 && failedTerms > 0) {
+    return {
+      message: intl.formatMessage(
+        {
+          defaultMessage:
+            "Added {added} words to your dictionary ({failed} failed)",
+        },
+        { added, failed: failedTerms },
+      ),
+      mode: "success",
+    };
+  }
+  if (failedTerms > 0) {
+    return {
+      message: intl.formatMessage({
+        defaultMessage:
+          "Transcript updated, but the corrected words could not be added to your dictionary.",
+      }),
+      mode: "error",
+    };
+  }
+  return {
+    message: intl.formatMessage({ defaultMessage: "Transcript updated" }),
+    mode: "success",
+  };
+};
