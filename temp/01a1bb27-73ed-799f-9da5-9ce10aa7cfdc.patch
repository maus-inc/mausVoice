+  .crs-note-remove { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 5px; color: var(--ss-text); transition: background 160ms ease, color 160ms ease; }
+  .crs-note-remove[data-hover] { background: var(--ss-ink-1); color: var(--ss-text-strong); }
