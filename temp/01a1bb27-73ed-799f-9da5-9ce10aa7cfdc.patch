+test("audit rejects new findings but not inherited findings", (t) => {
+  const dir = mkdtempSync(resolve(tmpdir(), "mausvoice-fallow-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  const git = (...args) =>
+    execFileSync("git", args, { cwd: dir, stdio: "pipe" });
+  const audit = (base) => {
