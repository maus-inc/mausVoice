+  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.04);
+  font-family: Inter, system-ui, -apple-system, sans-serif;
+}
+
+/* The same scene in Linear's refreshed dark theme: warm-neutral grays, no
+   blue cast, depth from lighter surfaces. */
+.ln-stage .ss-stage[data-theme="dark"] {
+  --ss-well: #0b0b0b;
+  --ss-canvas: #0e0e0e;
+  --ss-chrome: #0e0e0e;
+  --ss-surface: #121212;
+  --ss-raised: #1c1c1c;
+  --ss-line: #222221;
+  --ss-text: #8d8d8a;
+  --ss-text-strong: #ededec;
+  --ss-text-faint: #636361;
+  --ss-icon: #8d8d8a;
+  --ss-icon-faint: #4d4d4b;
+  --ss-accent-soft: rgba(94, 106, 210, 0.24);
+
+  --ln-nav-text: #a3a3a0;
+  --ln-nav-active: #1c1c1c;
+  --ln-row-hover: #191919;
+  --ln-tile: #ededec;
+  --ln-tile-text: #0e0e0e;
+  --ln-team-tile: #262626;
+  --ln-team-text: #c4c4c1;
+  --ln-tab-active: #1f1f1f;
+  --ln-chip-line: #2a2a29;
+  --ln-pri-off: #444442;
+  --ln-pri-on: #a3a3a0;
+  --ln-ring-todo: #a8a8a5;
+  --ln-ring-backlog: #696967;
+  --ln-progress: #f0bf00;
+  --ln-done: #5e6ad2;
+  --ln-done-mark: #121212;
+  --ln-unassigned: #696967;
+  --ln-scrim: rgba(0, 0, 0, 0.28);
+  --ln-cmd-line: #2a2a29;
+  --ln-cmd-active: #2a2a29;
+  --ln-cmd-text: #d2d2cf;
+  --ln-cmd-chip: #282827;
+  --ln-cmd-chip-title: #c8c8c5;
+  --ln-key-line: #333332;
+  --ln-key-active: #3a3a39;
+  --ln-caret: #ededec;
+  --ln-cmd-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08), 0 24px 60px -12px rgba(0, 0, 0, 0.7), 0 8px 20px -8px rgba(0, 0, 0, 0.5);
+  --ln-panel-shadow: 0 0 0 1px var(--ss-line);
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
+}
+
+.ln-icon {
+  flex-shrink: 0;
+  color: var(--ss-icon);
+}
+
+/* ---- Window: pinned a gutter in, runs off the bottom ---- */
+
+.ln-window {
+  position: absolute;
+  top: var(--gutter);
+  left: var(--gutter);
+  width: 860px;
+  height: 500px;
+  background: var(--ss-canvas);
+  box-shadow: var(--ss-shadow-hero);
+}
+
+[data-layout="compact"] .ln-window {
+  top: 16px;
+  left: 16px;
+  width: 388px;
+  height: 360px;
+}
+
+/* Without the sidebar there is no frame around the panel: the whole window
+   is the content surface */
+.ln-window:not([data-kind="sidebar"]),
+.ln-window:not([data-kind="sidebar"]) .ss-window__bar {
+  background: var(--ss-surface);
+}
+
+.ln-window .ss-window__side {
+  border-right: 0;
+}
+
+/* Linear's content sits in an inset panel inside the frame */
+.ln-window[data-kind="sidebar"] .ss-window__main {
+  margin: 8px 8px 0 0;
+  border-radius: 10px 10px 0 0;
+  /* The edge is a shadow, so the panel's own box meets the sidebar exactly */
+  box-shadow: var(--ln-panel-shadow);
+  overflow: hidden;
+}
+
+.ln-window .ss-window__bar {
+  gap: 10px;
+  background: transparent;
+}
+
+/* ---- Sidebar: dimmed, so the list leads ---- */
+
+.ln-side {
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+  padding: 2px 10px 0;
+}
+
+.ln-workspace {
