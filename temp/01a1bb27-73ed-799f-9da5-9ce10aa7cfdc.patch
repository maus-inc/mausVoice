+
+  /* Workout art: soft, photographic light in one warm family */
+  .fx-art--tempo {
+    background:
+      radial-gradient(70% 90% at 85% 15%, #ffb071 0%, transparent 60%),
+      radial-gradient(80% 80% at 10% 100%, #c2361a 0%, transparent 70%),
