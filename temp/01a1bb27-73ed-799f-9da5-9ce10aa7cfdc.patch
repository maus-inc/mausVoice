+/* Toast */
+
+@layer stageshow {
+  .ss-toast {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    padding: 8px 12px;
+    border-radius: var(--ss-radius-lg);
+    background: #1c1c1f;
+    box-shadow: var(--ss-shadow-satellite);
+    color: #fff;
+    font-size: 12px;
+    opacity: 0;
+    /* Rises by margin on a layer it keeps: the equal and opposite margins move
+       it the same whether it's placed by its top, its bottom or the flow, and
+       nothing around it moves. The layer moves box and text as one picture;
+       without it the text steps whole pixels inside the gliding box */
+    will-change: transform;
+    margin-block: var(--ss-toast-rise, 10px) calc(-1 * var(--ss-toast-rise, 10px));
+    transition: opacity 0.35s ease, margin 0.6s cubic-bezier(0.22, 1, 0.36, 1);
+  }
+
+  .ss-toast[data-show] { opacity: 1; margin-block: 0; }
+
+  .ss-toast__icon { display: grid; opacity: 0.8; }
+
+  .ss-toast__action { margin-left: 6px; color: rgba(255, 255, 255, 0.6); font-weight: 500; }
+
+  [data-theme='dark'] .ss-toast,
+  .ss-stage[data-theme='dark'] .ss-toast {
+    background: var(--ss-raised);
+    color: var(--ss-text-strong);
+  }
+}
diff --git a/.agents/skills/stageshow/kit/parts/Toast.tsx b/.agents/skills/stageshow/kit/parts/Toast.tsx
new file mode 100644
index 00000000..16280174
--- /dev/null
+++ b/.agents/skills/stageshow/kit/parts/Toast.tsx
@@ -0,0 +1,22 @@
+import type { CSSProperties, ReactNode } from 'react'
+import { useLook } from '../looks'
+import './Toast.css'
+
+/**
+ * A confirmation that rises in from the bottom of whatever it sits in: "Snoozed
+ * until 8:00 AM", "Link copied". Dark pill on light themes, raised surface on
+ * dark. Position its container where the product shows toasts; it stays in
+ * the DOM and fades, so it never pops.
+ */
+export function Toast({ show, icon, children, action, className, style, ...rest }: { show: boolean; icon?: ReactNode; children: ReactNode; action?: ReactNode; className?: string; style?: CSSProperties } & Record<`data-${string}`, unknown>) {
+  const { fidelity } = useLook()
+  // Minimal: words become a placeholder line, as everywhere else
+  if (fidelity === 'minimal' && typeof children === 'string') children = <span className="ss-bar" style={{ width: Math.min(160, children.length * 5.5), height: 6, borderRadius: 3, background: 'var(--ss-ink-3)', display: 'inline-block' }} />
+  return (
+    <div {...rest} className={`ss-toast${className ? ` ${className}` : ''}`} data-show={show || undefined} style={style} role="status">
+      {icon && <span className="ss-toast__icon">{icon}</span>}
+      <span>{children}</span>
+      {action && <span className="ss-toast__action">{action}</span>}
+    </div>
+  )
+}
