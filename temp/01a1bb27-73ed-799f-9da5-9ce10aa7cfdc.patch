+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { execFileSync } from "node:child_process";
+import {
+  mkdtempSync,
+  mkdirSync,
+  readFileSync,
+  rmSync,
+  symlinkSync,
+  writeFileSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join, resolve, win32 } from "node:path";
+import { fileURLToPath } from "node:url";
+import { it } from "node:test";
+import { computeSkillFolderHash } from "./skill-hash.mjs";
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), "../..");
+
+it("hashes nested paths identically with Windows and POSIX separators", () => {
+  const dir = mkdtempSync(join(tmpdir(), "skill-hash-"));
+  try {
+    mkdirSync(join(dir, "nested"));
+    writeFileSync(join(dir, "SKILL.md"), "line one\nline two\n");
+    writeFileSync(join(dir, "nested", "reference.md"), "reference\n");
+    const expected = createHash("sha256")
+      .update("nested/reference.md")
+      .update("reference\n")
+      .update("SKILL.md")
+      .update("line one\nline two\n")
+      .digest("hex");
+    assert.equal(computeSkillFolderHash(dir), expected);
+    assert.equal(computeSkillFolderHash(dir, win32), expected);
+    writeFileSync(join(dir, "nested", "reference.md"), "changed\n");
+    assert.notEqual(computeSkillFolderHash(dir), expected);
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+it(
+  "rejects links inside a locked skill and a linked skill root",
+  { skip: process.platform === "win32" },
+  () => {
+    const dir = mkdtempSync(join(tmpdir(), "skill-links-"));
+    try {
+      const skill = join(dir, "skill");
+      mkdirSync(skill);
+      writeFileSync(join(skill, "SKILL.md"), "trusted");
+      const original = computeSkillFolderHash(skill);
+      symlinkSync(join(dir, "missing"), join(skill, "extra.md"));
+      assert.throws(
+        () => computeSkillFolderHash(skill),
+        /unsupported|symbolic/i,
+      );
+      rmSync(join(skill, "extra.md"));
+      symlinkSync(dir, join(skill, "extra-directory"), "dir");
+      assert.throws(
+        () => computeSkillFolderHash(skill),
+        /unsupported|symbolic/i,
+      );
+      rmSync(join(skill, "extra-directory"));
+      symlinkSync(skill, join(dir, "linked-skill"));
+      assert.throws(
+        () => computeSkillFolderHash(join(dir, "linked-skill")),
+        /unsupported|symbolic/i,
+      );
+      assert.equal(computeSkillFolderHash(skill), original);
+    } finally {
+      rmSync(dir, { recursive: true, force: true });
+    }
+  },
+);
+
+it("keeps vendored skill bytes unchanged in an autocrlf checkout", () => {
+  const dir = mkdtempSync(join(tmpdir(), "skill-checkout-"));
+  const git = (...args) =>
+    execFileSync("git", args, { cwd: dir, stdio: "pipe" });
+  try {
+    git("init", "-q");
+    git("config", "core.autocrlf", "true");
+    writeFileSync(
+      join(dir, ".gitattributes"),
+      readFileSync(join(root, ".gitattributes")),
+    );
+    mkdirSync(join(dir, ".agents", "skills", "example"), { recursive: true });
+    const path = ".agents/skills/example/SKILL.md";
+    const original = Buffer.from("first\nsecond\n");
+    writeFileSync(join(dir, path), original);
+    git("add", ".gitattributes", path);
+    rmSync(join(dir, path));
+    git("checkout-index", "-f", "--", path);
+    assert.deepEqual(readFileSync(join(dir, path)), original);
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
