+    static TEST_LOCK: Mutex<()> = Mutex::new(());
+    fn fixture(queried: u32, returned: u32, status: i32, values: &[u32]) {
+        let mut f = sys::FIXTURE.lock().unwrap();
+        f.queried = queried;
+        f.returned = returned;
+        f.status = status;
+        f.query_status = 0;
