+/** Construct a fresh multipart body for each upload or format retry. */
+export const createTranscriptionForm = ({
+  blob,
+  ext,
+  model,
+  prompt,
+  language,
+}: {
+  blob: ArrayBuffer;
+  ext: string;
+  model: string;
+  prompt?: string;
+  language?: string;
+}): FormData => {
+  const form = new FormData();
+  form.append(
+    "file",
+    new Blob([blob], { type: `audio/${ext}` }),
+    `audio.${ext}`,
+  );
+  form.append("model", model);
+  if (prompt) form.append("prompt", prompt);
+  if (language && language !== "auto") form.append("language", language);
+  return form;
+};
