+/** Use only the bytes in the supplied view, never the rest of its backing pool. */
+export const exactAudioBuffer = (audio: ArrayBuffer | Buffer): ArrayBuffer =>
+  audio instanceof ArrayBuffer ? audio : Uint8Array.from(audio).buffer;
