+}
+
+.wk-figure {
+  height: 150px;
+  margin: 4px 0 12px;
+  border: 1px solid var(--wk-border-soft);
+}
+
+/* ---- Compact (narrow containers) ---- */
+
+.ss-stage[data-layout="compact"] .wk-window {
+  --gutter: 16px;
+}
+.ss-stage[data-layout="compact"] .wk-page {
