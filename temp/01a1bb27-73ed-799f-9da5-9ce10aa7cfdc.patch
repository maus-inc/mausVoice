+
+.ln-nav[data-active] {
+  background: var(--ln-nav-active);
+}
+
+.ln-nav__label,
+.ln-team__name {
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--ss-text-strong);
+}
+
+.ln-team__name {
+  color: var(--ln-nav-text);
+}
+
+.ln-team {
+  gap: 9px;
+}
+
+.ln-team .ln-icon {
+  margin-left: -3px;
+}
+
+.ln-sub {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding-left: 14px;
+}
+
+.ln-icon--on {
+  color: var(--ss-text-strong);
+}
+
+/* ---- Header ---- */
+
+.ln-crumbs {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-left: 2px;
+}
+
+[data-layout="compact"] .ln-crumbs {
+  margin-left: 12px;
+}
+
+.ln-crumbs__team {
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--ss-text-strong);
+}
+
+/* Compact, rounded tabs that don't span the bar */
+.ln-tabs {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  margin-left: 10px;
+}
+
+.ln-tab {
+  display: flex;
+  align-items: center;
+  height: 24px;
+  padding: 0 10px;
+  border-radius: 12px;
