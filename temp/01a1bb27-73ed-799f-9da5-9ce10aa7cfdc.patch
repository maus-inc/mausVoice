+
+/* Shared work branches once, then each destination receives its own result. */
+.an-asset-source { position: absolute; padding: 13px; border: 1px solid #dfe3e8; border-radius: 6px; background: #fff; box-shadow: 0 1px 2px #17202e05, 0 4px 12px #17202e04; }
