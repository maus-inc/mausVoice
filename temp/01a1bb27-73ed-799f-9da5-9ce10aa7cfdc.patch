diff --git a/scripts/ci/direct-invocation.mjs b/scripts/ci/direct-invocation.mjs
new file mode 100644
index 00000000..cbcd4274
--- /dev/null
+++ b/scripts/ci/direct-invocation.mjs
@@ -0,0 +1,23 @@
+import { pathToFileURL } from "node:url";
+
+// URL conversion encodes delimiters and handles drive-letter paths on Windows.
+export function isDirectInvocation(
+  moduleUrl,
+  scriptPath,
+  windows = process.platform === "win32",
+) {
+  return (
+    Boolean(scriptPath) &&
+    moduleUrl === pathToFileURL(scriptPath, { windows }).href
+  );
+}
+
+export async function runIfDirect(moduleUrl, main) {
+  if (!isDirectInvocation(moduleUrl, process.argv[1])) return;
+  try {
+    await main();
+  } catch (error) {
+    console.error(error.message);
+    process.exit(1);
+  }
+}
