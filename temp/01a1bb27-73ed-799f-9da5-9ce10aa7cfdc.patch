+      hover(null)
+      await tween(opts?.duration ?? 700, (t) => {
+        const e = entering(t)
+        const p = { x: from.x + (end.x - from.x) * e, y: from.y + (end.y - from.y) * e }
+        place(p)
+        auto(p)
+      })
+      check()
+      hover(targetEl(to))
+    },
