+
+export const isRemoteReceiverMutationVersionCurrent = (
+  version: number,
+): boolean =>
+  version === receiverMutationVersion && activeReceiverMutations === 0;
+
+// Changes only when a start/stop is admitted, allowing a caller to check
+// whether its own awaited stop was superseded by a later explicit command.
+export const getRemoteReceiverIntentVersion = (): number =>
+  receiverIntentVersion;
+
+export const isRemoteReceiverIntentCurrent = (version: number): boolean =>
