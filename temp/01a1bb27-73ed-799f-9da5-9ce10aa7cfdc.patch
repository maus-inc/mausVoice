+import { describe, expect, it, vi } from "vitest";
+import type { StopRecordingResponse } from "../types/transcription-session.types";
+import type {
+  PauseChunkedPretranscriber,
+  PretranscriptionResult,
+} from "./pause-chunked-pretranscriber";
+
+const logger = vi.hoisted(() => ({ warning: vi.fn(), info: vi.fn() }));
+vi.mock("../utils/log.utils", () => ({ getLogger: () => logger }));
+import { finishSessionPretranscription } from "./session-pretranscription.utils";
+
+const audio = { samples: [], sampleRate: 16000 } as StopRecordingResponse;
+const pretranscriber = (
+  count: number,
+  result: PretranscriptionResult | null,
+) => {
+  const finish = vi.fn(async () => result);
+  return {
+    finish,
+    value: {
+      chunkCount: count,
+      finish,
+    } as unknown as PauseChunkedPretranscriber,
+  };
+};
+
+describe("finishSessionPretranscription", () => {
+  it("skips finishing when there is no pretranscriber or no completed span", async () => {
+    const empty = pretranscriber(0, null);
+    expect(
+      await finishSessionPretranscription(null, audio, "batch"),
+    ).toBeNull();
+    expect(
+      await finishSessionPretranscription(empty.value, audio, "batch"),
+    ).toBeNull();
+    expect(empty.finish).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    [
+      "batch",
+      "Batch session: pretranscription unusable, transcribing the whole recording",
+    ],
+    [
+      "local-session",
+      "[local-session] pretranscription unusable, transcribing the whole recording",
+    ],
+  ] as const)("logs the correct fallback for %s", async (label, message) => {
+    logger.warning.mockClear();
+    const item = pretranscriber(1, null);
+    expect(
+      await finishSessionPretranscription(item.value, audio, label),
+    ).toBeNull();
+    expect(item.finish).toHaveBeenCalledWith(audio);
+    expect(logger.warning).toHaveBeenCalledWith(message);
+  });
+
+  it("returns the completed result intact", async () => {
+    const result = {
+      text: "Hello",
+      metadata: {},
+      warnings: ["notice"],
+      chunkCount: 1,
+    } as PretranscriptionResult;
+    const item = pretranscriber(1, result);
+    expect(
+      await finishSessionPretranscription(item.value, audio, "batch"),
+    ).toBe(result);
+  });
+});
