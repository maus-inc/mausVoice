+}));
+vi.mock("../../actions/remote-receiver.actions", () => ({
+  refreshRemoteReceiverStatus: async () => ({
+    deviceId: "desktop-1",
+    deviceName: "Test",
+  }),
+}));
+vi.mock("../../actions/remote-transcript.actions", () => ({
+  handleRemoteFinalTextReceived: mock.deliver,
+}));
+import { SessionSideEffects } from "./SessionSideEffects";
+
+ensureUiHarness();
+afterEach(() => {
+  mock.listener = null;
+  mock.current = null;
+  vi.clearAllMocks();
+  setAppState(structuredClone(INITIAL_APP_STATE), true);
+});
+
+it.each([
+  "newer timestamp",
+  "changed text",
+  "unchanged",
+  "mutated snapshot",
+] as const)(
+  "conditionally consumes a paste when the server has %s",
+  async (scenario) => {
+    const state = structuredClone(INITIAL_APP_STATE);
+    state.initialized = true;
+    state.auth = {
+      uid: "user-1",
+      email: "x@example.com",
+      displayName: "Test",
+      providers: ["test"],
+    };
+    setAppState(state, true);
+    let finish!: (delivered: boolean) => void;
+    mock.deliver.mockReturnValueOnce(
+      new Promise<boolean>((resolve) => {
+        finish = resolve;
+      }),
+    );
+    mock.transaction.mockImplementation(async (_ref, update) => {
+      const next = update(mock.current);
+      if (next !== undefined) mock.current = next;
+      return { committed: next !== undefined };
+    });
+    const container = document.createElement("div");
+    document.body.append(container);
+    const root = createRoot(container);
+    try {
+      await act(async () => {
+        root.render(<SessionSideEffects />);
+      });
+      await vi.waitFor(() => expect(mock.listener).not.toBeNull());
+      const older = {
+        ...mock.current,
+        pasteText: "older",
+        pasteTimestamp: Date.now() + 1_000,
+      };
+      const current =
+        scenario === "newer timestamp"
+          ? { ...older, pasteTimestamp: older.pasteTimestamp + 1 }
+          : scenario === "changed text"
+            ? { ...older, pasteText: "newer" }
+            : older;
+      mock.current = older;
+      const snapshot = { ...older };
+      mock.listener!({ val: () => snapshot });
+      expect(mock.deliver).toHaveBeenCalledOnce();
+      if (scenario === "mutated snapshot") snapshot.pasteTimestamp += 99;
+      mock.current = current;
+      await act(async () => {
+        finish(true);
+        await Promise.resolve();
+      });
+      expect(mock.current).toEqual(
+        scenario === "unchanged" || scenario === "mutated snapshot"
+          ? { ...older, pasteText: null, pasteTimestamp: null }
+          : current,
+      );
+      expect(mock.transaction).toHaveBeenCalledOnce();
+      expect(mock.transaction).toHaveBeenCalledWith(
+        { path: "session/user-1/desktop-1" },
+        expect.any(Function),
+        { applyLocally: false },
+      );
+      const retry = mock.transaction.mock.calls[0][1] as (
+        value: unknown,
+      ) => unknown;
+      expect(retry(null)).toBeUndefined();
+      if (scenario === "unchanged") {
+        const releaseClear = await beginLocalDataClear();
+        try {
+          expect(retry(older)).toBeUndefined();
+        } finally {
+          window.localStorage.removeItem(LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY);
+          releaseClear();
+        }
+      }
+    } finally {
+      act(() => root.unmount());
+      container.remove();
+    }
+  },
+);
