+++ b/.agents/skills/stageshow/examples/ruled-bento/grid.css
@@ -0,0 +1,541 @@
+/* All rules belong to this example, including its responsive variants. */
+.ruled-bento {
+  /* Halite's features section: a ruled grid on dark. Everything nests under
+     &. One rounded container; the rules are the container's own
+     color showing through 1px gaps between the cells. Each picture is its own
+     Stage at 1:1, pinned to its cell's bottom and cropped by the cell. */
+    --pad: 28px;
+    --ground: #08090a;
+    --cell: #0c0d0f;
+    --rule: #1d1e22;
+    --panel: #131417;
+    --panel-edge: #232429;
+    --ink: #f2f3f5;
+    --ink-2: #8b8f98;
+    --ink-3: #5c5f67;
+    --accent: #f5a524;
+    container-type: inline-size;
+    /* No padding of its own: on a page, the grid spans the content column */
+    box-sizing: border-box;
+    background: transparent;
+    font-family: var(--rb-font, inherit);
+    -webkit-font-smoothing: antialiased;
+
+  & .rb-grid {
+    display: grid;
+    gap: 1px;
+    max-width: 984px;
+    margin: 0 auto;
+    overflow: hidden;
+    box-sizing: border-box;
+    border: 1px solid var(--rule);
+    border-radius: 18px;
+    background: var(--rule);
+    grid-template-columns: minmax(0, 1fr);
+    grid-template-rows: 420px 250px 320px 350px 270px;
+    grid-template-areas: 'hero' 'stat' 'map' 'restore' 'orm';
+  }
+
+  /* A docs column or a tablet: the hero across, a pair, then two bands */
+  @container (min-width: 600px) {
+    & .rb-grid {
+      grid-template-columns: repeat(2, minmax(0, 1fr));
+      grid-template-rows: 390px 320px 300px 250px;
+      grid-template-areas: 'hero hero' 'stat map' 'restore restore' 'orm orm';
+    }
+  }
+
+  /* A homepage: 2 + 1, 1 + 2, then the full-width band */
+  @container (min-width: 900px) {
+    & .rb-grid {
+      grid-template-columns: repeat(3, minmax(0, 1fr));
+      grid-template-rows: 390px 320px 220px;
+      grid-template-areas: 'hero hero stat' 'map restore restore' 'orm orm orm';
+    }
+  }
+
+  @container (max-width: 599px) {
+    & .rb-grid {
+      --pad: 24px;
+    }
+  }
+
+  /* ---- The cell: one frame for all five ---- */
+
+  & .rb-cell {
+    position: relative;
+    overflow: hidden;
+    background: var(--cell);
+  }
+
+  & .rb-cell--hero { grid-area: hero; }
+  & .rb-cell--stat { grid-area: stat; }
+  & .rb-cell--map { grid-area: map; }
+  & .rb-cell--restore { grid-area: restore; }
+  & .rb-cell--orm { grid-area: orm; }
+
+  & .rb-copy {
+    position: relative;
+    z-index: 1;
+    max-width: 400px;
+    margin: 0;
+    padding: 26px var(--pad) 0;
+    font-size: 17px;
+    line-height: 24px;
+    letter-spacing: -0.012em;
+    color: var(--ink-2);
+    text-wrap: pretty;
+  }
+
+  & .rb-copy b {
+    font-weight: 600;
+    color: var(--ink);
+  }
+
+  & .rb-cell--hero .rb-copy,
+  & .rb-cell--restore .rb-copy {
+    max-width: 470px;
+  }
+
+  & .rb-cell--orm .rb-copy {
+    max-width: 760px;
+  }
+
+  /* ---- Pictures: pinned to the cell's bottom ---- */
+
+  & .rb-picture {
+    position: absolute;
+    bottom: 0;
+  }
+
+  & .rb-picture--hero,
+  & .rb-picture--restore,
+  & .rb-picture--map {
+    left: 0;
+    width: 100%;
+  }
+
+  & .rb-picture--orm {
+    /* Half the cell: the band spans the grid, which is the container less nothing on a page */
+    --half: min(50cqw, 492px);
+    left: 50%;
+    /* The rows drift, so they soften into the cell at both sides */
+    -webkit-mask-image: linear-gradient(90deg, transparent calc(50% - var(--half)), #000 calc(50% - var(--half) + 72px), #000 calc(50% + var(--half) - 72px), transparent calc(50% + var(--half)));
+    mask-image: linear-gradient(90deg, transparent calc(50% - var(--half)), #000 calc(50% - var(--half) + 72px), #000 calc(50% + var(--half) - 72px), transparent calc(50% + var(--half)));
+    width: 1200px;
+    margin-left: -600px;
+  }
+
+  & .rb-stage .ss-stage {
+    overflow: hidden;
+    background: transparent;
+  }
+
+  /* ---- Create (hero): the one window ---- */
+
+  & .rb-term {
+    position: absolute;
+    top: 18px;
+    left: var(--pad);
+    width: calc(100% + 40px);
+    height: 330px;
+    --ss-term-bg: #141518;
+    --ss-term-path: var(--ink-3);
+    --ss-term-sigil: var(--accent);
+    --ss-term-dim: #6a6d75;
+    --ss-term-ok: #5fd49a;
+    box-shadow:
+      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
+      0 24px 48px -16px rgba(0, 0, 0, 0.7);
+  }
+
+  & .rb-term__body {
+    gap: 6px;
+    padding: 8px 20px 20px;
+    font-size: 13px;
+    line-height: 20px;
+    color: #c9cbd1;
+  }
+
+
+  /* Output arrives line by line, once */
+  & .rb-out {
+    opacity: 0;
+    transform: translateY(4px);
+    will-change: transform;
+    transition: opacity 0.35s ease, transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
+    transition-delay: calc(var(--i) * 0.42s + 0.1s);
+  }
+
+  & .rb-term[data-on] .rb-out {
+    opacity: 1;
+    transform: none;
+  }
+
+  /* The ready line waits for the bar */
+  & .rb-ready { transition-delay: 1.9s; }
+  & .rb-url { transition-delay: 2.15s; }
+  & .rb-term .rb-out.ss-term__prompt { transition-delay: 2.4s; }
+
+  & .rb-migrate {
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    width: calc(var(--rb-picture-width) - var(--pad) - 60px);
+    white-space: nowrap;
+  }
+
+  & .rb-meter {
+    position: relative;
+    width: 220px;
+    flex: 0 1 220px;
+    min-width: 30px;
+    height: 6px;
+    overflow: hidden;
+    border-radius: 3px;
+    background: #24262b;
+  }
+
+  & .rb-term[data-layout='compact'] .rb-meter {
+    flex-basis: 120px;
+  }
+
+  /* The kit Meter in the terminal's accent, filling in step with the count */
+  & .rb-meter .ss-meter__fill {
+    background: var(--accent);
+    transition-duration: 1s;
+  }
+
+  & .rb-count {
+    flex: none;
+    font-variant-numeric: tabular-nums;
+  }
+
+  & .rb-count .ss-count {
+    display: inline-block;
+    min-width: 2ch;
+    text-align: right;
+  }
+
+  /* ---- Reads (stat) ---- */
+
+  & .rb-stat {
+    display: flex;
+    flex-direction: column;
+    box-sizing: border-box;
+    height: 100%;
+    padding: 26px var(--pad) 30px;
+  }
+
+  & .rb-stat-lead {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    font-size: 17px;
+    line-height: 24px;
+    letter-spacing: -0.012em;
+    font-weight: 600;
+    color: var(--ink);
+  }
+
+  & .rb-bolt {
+    color: var(--accent);
+  }
+
+  & .rb-stat-number {
+    display: block;
+    margin-top: auto;
+    font-size: 84px;
+    line-height: 1;
+    font-weight: 600;
+    letter-spacing: -0.045em;
+    color: var(--ink);
+    font-variant-numeric: tabular-nums;
+  }
+
+  & .rb-stat-unit {
+    margin-left: 4px;
+    font-size: 40px;
+    letter-spacing: -0.02em;
+    color: var(--ink-2);
+  }
+
+  & .rb-stat-label {
+    max-width: 230px;
+    margin-top: 14px;
+    font-size: 15px;
+    line-height: 21px;
+    color: var(--ink-2);
+    text-wrap: pretty;
+  }
+
+  /* ---- Regions (diagram) ---- */
+
+  & .rb-map {
+    position: absolute;
+    inset: 0;
+    /* A dot field for ground, fading out toward the stage's edges */
+    background-image: radial-gradient(circle at center, #23252a 1px, transparent 1.4px);
+    background-size: 12px 12px;
+    background-position: 4px 2px;
+    -webkit-mask-image: radial-gradient(70% 80% at 50% 55%, #000 45%, transparent 100%);
+    mask-image: radial-gradient(70% 80% at 50% 55%, #000 45%, transparent 100%);
+  }
+
+  & .rb-map__lines {
+    position: absolute;
+    inset: 0;
+    overflow: visible;
+  }
+
+  & .rb-arc {
+    fill: none;
+    stroke: #2b2d33;
+    stroke-width: 1;
+  }
+
+  & .rb-arc--lit {
+    stroke: var(--accent);
+    stroke-width: 1.25;
+    stroke-dasharray: 1;
+    stroke-dashoffset: 1;
+    transition: stroke-dashoffset 0.9s cubic-bezier(0.45, 0, 0.2, 1);
+    transition-delay: calc(var(--i) * 0.09s);
+  }
+
+  & .rb-map[data-on] .rb-arc--lit {
+    stroke-dashoffset: 0;
+  }
+
+  & .rb-node {
+    position: absolute;
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    height: 24px;
+    padding: 0 9px 0 8px;
+    border-radius: 12px;
+    background: var(--panel);
+    box-shadow: inset 0 0 0 1px var(--panel-edge);
+    font: 500 11px/1 var(--ss-mono);
+    color: #b4b7be;
+    /* Centered on its point by the dot, not the pill */
+    transform: translate(-14px, -50%);
+  }
+
+  & .rb-node__dot {
+    width: 6px;
+    height: 6px;
+    border-radius: 3px;
+    background: #3a3c43;
+    transition: background-color 0.25s ease;
+    transition-delay: calc(var(--i) * 0.09s + 0.75s);
+  }
+
+  & .rb-map[data-on] .rb-node__dot {
+    background: var(--accent);
+  }
+
+  & .rb-node[data-primary] {
+    color: var(--ink);
+    box-shadow: inset 0 0 0 1px #3a3328;
+  }
+
+  & .rb-node[data-primary] .rb-node__dot {
+    background: var(--accent);
+    box-shadow: 0 0 0 3px rgba(245, 165, 36, 0.22);
+  }
+
+  /* ---- Restore (component) ---- */
+
+  & .rb-restore {
+    position: absolute;
+    top: 6px;
+    left: var(--pad);
+    box-sizing: border-box;
+    width: calc(100% + 40px);
+    height: 250px;
+    padding: 20px 22px;
+    border-radius: 14px;
+    background: var(--panel);
+    box-shadow: inset 0 0 0 1px var(--panel-edge);
+  }
+
+  & .rb-restore[data-layout='compact'] {
+    padding: 18px;
+  }
+
+  & .rb-restore__head {
+    display: grid;
+    grid-template-columns: auto auto;
+    align-items: center;
+    justify-content: start;
+    gap: 4px 14px;
+  }
+
+  & .rb-restore[data-layout='compact'] .rb-restore__head {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  & .rb-restore__label {
+    font-size: 13px;
+    color: var(--ink-2);
+  }
+
+  & .rb-restore__time {
+    font: 500 20px/26px var(--ss-mono);
+    letter-spacing: -0.02em;
+    color: var(--ink);
+    font-variant-numeric: tabular-nums;
+  }
+
+  /* The time turns as the handle lands, not before */
+  & .rb-restore[data-on] .ss-states__item[data-on] {
+    transition-delay: 0.95s, 0.95s, 0.95s;
+  }
+
+  & .rb-restore[data-on] .ss-states__item:not([data-on]) {
+    transition-delay: 0.85s, 0.85s, 1s;
+  }
+
+  & .rb-track {
+    --gutter: 3px;
+    position: relative;
+    display: grid;
+    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
+    align-items: end;
+    gap: var(--gutter);
+    height: 84px;
+    margin-top: 52px;
+    /* The handle travels along this, in cells */
+    --cell-w: calc((100% + var(--gutter)) / var(--n));
+  }
+
+  & .rb-restore .rb-track {
+    /* Stop the track short of the crop so its end reads as now */
+    margin-right: calc(var(--pad) + 40px);
+  }
+
+  & .rb-track__bar {
+    border-radius: 2px;
+    background: #34363d;
+    transition: background-color 0.4s ease 0.6s;
+  }
+
+  /* Everything after the restore point dims once the handle passes it */
+  & .rb-restore[data-on] .rb-track__bar[data-after] {
+    background: #1e1f23;
+  }
+
+  & .rb-event {
+    position: absolute;
+    top: -22px;
+    bottom: 0;
+    left: calc(var(--cell-w) * (var(--drop) + 1.5) - var(--gutter) / 2);
+    width: 2px;
+    margin-left: -1px;
+    border-radius: 1px;
+    background: #f0605a;
+  }
+
+  & .rb-event__tag {
+    position: absolute;
+    top: -26px;
+    left: 8px;
+    height: 20px;
+    padding: 0 7px;
+    border-radius: 6px;
+    background: #3a1a1a;
+    font: 500 11px/20px var(--ss-mono);
+    color: #f6918c;
+    white-space: nowrap;
+  }
+
+  & .rb-restore[data-layout="wide"] .rb-event__tag { left: auto; right: 8px; }
+
+  /* The handle: starts at now, slides back to just before the drop */
+  & .rb-handle {
+    position: absolute;
+    top: -14px;
+    bottom: -6px;
+    left: 100%;
+    width: 2px;
+    margin-left: -1px;
+    border-radius: 1px;
+    background: var(--accent);
+    will-change: transform;
+    transition: left 1s cubic-bezier(0.45, 0, 0.15, 1) 0.1s;
+  }
+
+  & .rb-handle::before {
+    content: '';
+    position: absolute;
+    top: -5px;
+    left: 50%;
+    width: 12px;
+    height: 12px;
+    margin-left: -6px;
+    border-radius: 6px;
+    background: var(--accent);
+    box-shadow: 0 0 0 3px var(--panel);
+  }
+
+  & .rb-restore[data-on] .rb-handle {
+    left: calc(var(--cell-w) * var(--drop) - var(--gutter) / 2);
+  }
+
+  & .rb-axis {
+    position: relative;
+    height: 14px;
+    margin-top: 10px;
+    font: 11px/14px var(--ss-mono);
+    color: var(--ink-3);
+  }
+
+  & .rb-restore .rb-axis {
+    margin-right: calc(var(--pad) + 40px);
+  }
+
+  & .rb-axis span {
+    position: absolute;
+    left: calc((100% + 3px) / var(--n) * var(--at));
+  }
+
+  /* ---- Drivers (collection) ---- */
+
+  & .rb-rows {
+    position: absolute;
+    inset: 0;
+    display: flex;
+    flex-direction: column;
+    gap: 12px;
+    padding-top: 14px;
+  }
+
+  & .rb-row {
+    display: flex;
+    justify-content: center;
+    gap: 12px;
+    transform: translateX(var(--off));
+    will-change: transform;
+    transition: transform 2.4s cubic-bezier(0.25, 0.8, 0.25, 1);
+  }
+
+  & .rb-rows[data-on] .rb-row {
+    transform: translateX(calc(var(--off) + var(--dir) * 56px));
+  }
+
+  & .rb-chip {
+    display: inline-flex;
+    align-items: center;
+    flex: none;
+    height: 40px;
+    padding: 0 16px;
+    border-radius: 10px;
+    background: var(--panel);
+    box-shadow: inset 0 0 0 1px var(--panel-edge);
+    font: 500 13px/1 var(--ss-mono);
+    color: #b4b7be;
+    white-space: nowrap;
+  }
+}
diff --git a/.agents/skills/stageshow/examples/ruled-bento/index.tsx b/.agents/skills/stageshow/examples/ruled-bento/index.tsx
new file mode 100644
index 00000000..58224ddb
--- /dev/null
+++ b/.agents/skills/stageshow/examples/ruled-bento/index.tsx
@@ -0,0 +1,347 @@
+import { useEffect, useLayoutEffect, useRef, useState, type ReactNode } from 'react'
+import { Count, Icon, Meter, Prompt, Caret, Stage, States, Window, useReducedMotion } from '../../kit'
+import type { Act, Layout } from '../../kit'
+import './grid.css'
+
+// A ruled bento on dark: the features section of Halite, an invented edge
+// database. One rounded container, 1px rules between the cells, no gaps,
+// mixed spans (2 + 1, then 1 + 2, then a full-width band), the way Linear,
+// Framer and Raycast's developer page set theirs.
+//
+//   Tile      Span   Kind        The one thing                         Moves
+//   Create    2 × 1  Hero UI     `halite create`, the only window      the migration bar fills, Ready prints
+//   Reads     1 × 1  Stat        "4ms" at the median                   counts down from 120
+//   Regions   1 × 1  Diagram     a primary and six replicas            the lines draw out, replicas light
+//   Restore   2 × 1  Component   the restore scrubber                  the handle slides back past the bad drop
+//   Drivers   3 × 1  Collection  ORM names, bleeding off both sides    the rows drift apart
+//
+// Two of five tiles are UI, one window. Across and down, no kind sits next
+// to itself. Each picture is its own Stage at 1:1, pinned to its cell's
+// bottom; the copy is page text. Each cell plays one beat, once, 110ms
+// after the one before it in reading order.
+
+const STEP = 110
+const LEAD = 450
+
+type Beat = { on: boolean; fill?: boolean }
+const before: Beat = { on: false }
+const after: Beat = { on: true, fill: true }
+const beat = (i: number) => async (a: Act<Beat>) => {
+  await a.wait(LEAD + i * STEP)
+  await a.set({ on: true })
+}
+
+function Tile({ area, title, children, picture }: { area: string; title: ReactNode; children?: ReactNode; picture?: ReactNode }) {
+  return (
+    <section className={`rb-cell rb-cell--${area}`} data-crop>
+      {title ? (
+        <p className="rb-copy">
+          {title} {children}
+        </p>
+      ) : (
+        children
+      )}
+      {picture}
+    </section>
+  )
+}
+
+// Measure the tile, not the page: a wide page can still contain a narrow tile.
+function usePictureWidth() {
+  const ref = useRef<HTMLDivElement>(null)
+  const [width, setWidth] = useState(340)
+  useLayoutEffect(() => {
+    const node = ref.current
+    if (!node) return
+    const measure = () => setWidth(node.clientWidth)
+    measure()
+    const observer = new ResizeObserver(measure)
+    observer.observe(node)
+    return () => observer.disconnect()
+  }, [])
+  return [ref, width] as const
+}
+
+/* ---------------- Create (hero) ---------------- */
+
+// The hero's one beat: the output prints, and the bar fills once its line is in
+const create = async (a: Act<Beat>) => {
+  await a.wait(LEAD)
+  await a.set({ on: true })
+  await a.wait(800)
+  await a.set({ on: true, fill: true })
+}
+
+function Terminal({ on, fill, layout }: { on: boolean; fill?: boolean; layout: Layout }) {
+  const wide = layout === 'wide'
+  return (
+    <Window chrome="terminal" lights="grey" title={wide ? 'demo — zsh' : undefined} className="rb-term" body={{ 'data-crop': '' }} data-on={on || undefined} data-fill={fill || undefined} data-layout={layout}>
+      <div className="ss-term rb-term__body">
+        <Prompt path="~/demo">halite create shop</Prompt>
+        <div className="rb-out" style={{ ['--i' as string]: 0 }}>
+          <span className="dim">Created</span> shop <span className="dim">in</span> iad1
+        </div>
+        <div className="rb-out rb-migrate" style={{ ['--i' as string]: 1 }}>
+          <span className="dim">Migrating</span>
+          <Meter className="rb-meter" value={fill ? 1 : 0} />
+          <span className="rb-count">
+            <Count value={fill ? 14 : 0} duration={1000} />
+            <span className="dim">/14</span>
+          </span>
+        </div>
+        <div className="rb-out rb-ready" style={{ ['--i' as string]: 2 }}>
+          <span className="ok">✓</span> Ready <span className="dim">in 1.9s</span>
+        </div>
+        <div className="rb-out rb-url" style={{ ['--i' as string]: 3 }}>
+          <span className="dim">{wide ? 'DATABASE_URL  ' : ''}</span>
+          {wide ? 'halite://shop.demo.example' : 'halite://shop.demo…'}
+        </div>
+        <Prompt path="~/demo" className="rb-out" style={{ ['--i' as string]: 4 }}>
+          <Caret />
+        </Prompt>
+      </div>
+    </Window>
+  )
+}
+
+function Create() {
+  const [ref, width] = usePictureWidth()
+  return (
+    <Tile
+      area="hero"
+      title={<b>A database in one command.</b>}
+      picture={
+        <div ref={ref} className="rb-picture rb-picture--hero" style={{ ['--rb-picture-width' as string]: `${width}px` }}>
+          <Stage<Beat> width={width} height={300} theme="dark" initial={before} poster={after} play="once" script={create} className="rb-stage">
+            {(s) => <Terminal on={s.on} fill={s.fill} layout={width < 600 ? 'compact' : 'wide'} />}
+          </Stage>
+        </div>
+      }
+    >
+      Halite provisions it, runs your migrations and hands back a URL.
+    </Tile>
+  )
+}
+
+/* ---------------- Reads (stat) ---------------- */
+
+function useInView<T extends Element>(delay: number) {
+  const ref = useRef<T>(null)
+  const [seen, setSeen] = useState(false)
+  useEffect(() => {
+    const el = ref.current
+    if (!el) return
+    let t = 0
+    const io = new IntersectionObserver(([e]) => {
+      if (!e.isIntersecting) return
+      io.disconnect()
+      t = window.setTimeout(() => setSeen(true), delay)
+    }, { threshold: 0.4 })
+    io.observe(el)
+    return () => {
+      io.disconnect()
+      clearTimeout(t)
+    }
+  }, [delay])
+  return [ref, seen] as const
+}
+
+function Reads() {
+  const reduced = useReducedMotion()
+  const [ref, seen] = useInView<HTMLDivElement>(LEAD + STEP)
+  return (
+    <Tile area="stat" title={null}>
+      <div ref={ref} className="rb-stat">
+        <span className="rb-stat-lead">
+          <Icon name="bolt" filled size={16} className="rb-bolt" />
+          Reads in
+        </span>
+        <span className="rb-stat-number">
+          <Count value={seen || reduced ? 4 : 0} duration={1300} />
+          <span className="rb-stat-unit">ms</span>
+        </span>
+        <span className="rb-stat-label">at the median, from the replica nearest each user.</span>
+      </div>
+    </Tile>
+  )
+}
+
+/* ---------------- Regions (diagram) ---------------- */
+
+// Rough world positions on a 380 × 236 stage, the primary in Virginia
+// Every pill stays inside x 46 to 334, the part the narrowest cell shows
+const PRIMARY = { id: 'iad1', x: 124, y: 96 }
+const REPLICAS = [
+  { id: 'sfo1', x: 62, y: 58 },
+  { id: 'gru1', x: 148, y: 196 },
+  { id: 'lhr1', x: 196, y: 40 },
+  { id: 'fra1', x: 232, y: 86 },
+  { id: 'sin1', x: 270, y: 146 },
+  { id: 'syd1', x: 286, y: 204 },
+]
+
+function arc(a: { x: number; y: number }, b: { x: number; y: number }) {
+  // A gentle bow above the straight line, more for longer runs
+  const mx = (a.x + b.x) / 2
+  const my = (a.y + b.y) / 2
+  const d = Math.hypot(b.x - a.x, b.y - a.y)
+  return `M${a.x} ${a.y} Q${mx} ${my - d * 0.22} ${b.x} ${b.y}`
+}
+
+function Regions() {
+  const [ref, width] = usePictureWidth()
+  // Keep the region names native-size while moving their points inward.
+  const point = (p: typeof PRIMARY) => ({ ...p, x: width < 360 ? 38 + (p.x - 62) / 224 * (width - 106) : p.x + (width - 380) / 2 })
+  const primary = point(PRIMARY)
+  const replicas = REPLICAS.map(point)
+  return (
+    <Tile
+      area="map"
+      title={<b>Replicas near every user.</b>}
+      picture={
+        <div ref={ref} className="rb-picture rb-picture--map">
+          <Stage<Beat> width={width} height={236} theme="dark" initial={before} poster={after} play="once" script={beat(2)} className="rb-stage">
+            {(s) => (
+              <div className="rb-map" data-on={s.on || undefined}>
+                <svg className="rb-map__lines" width={width} height={236} aria-hidden>
+                  {replicas.map((r, i) => (
+                    <g key={r.id} style={{ ['--i' as string]: i }}>
+                      <path d={arc(primary, r)} className="rb-arc" />
+                      <path d={arc(primary, r)} className="rb-arc rb-arc--lit" pathLength={1} />
+                    </g>
+                  ))}
+                </svg>
+                <span className="rb-node" data-primary style={{ left: primary.x, top: primary.y }}>
+                  <span className="rb-node__dot" />
+                  {PRIMARY.id}
+                </span>
+                {replicas.map((r, i) => (
+                  <span key={r.id} className="rb-node" style={{ left: r.x, top: r.y, ['--i' as string]: i }}>
+                    <span className="rb-node__dot" />
+                    {r.id}
+                  </span>
+                ))}
+              </div>
+            )}
+          </Stage>
+        </div>
+      }
+    >
+      Reads never cross an ocean.
+    </Tile>
+  )
+}
+
+/* ---------------- Restore (component) ---------------- */
+
+// Write activity per minute, 13:00 to 14:40: varied, with a quiet lunch dip
+const WRITES = Array.from({ length: 50 }, (_, i) => {
+  const base = 0.38 + 0.3 * Math.sin(i * 0.37) * Math.cos(i * 0.11) + 0.18 * Math.sin(i * 1.7)
+  const dip = i > 14 && i < 22 ? 0.45 : 1
+  return Math.max(0.12, Math.min(1, base * dip + 0.12))
+})
+// Two minutes a bar from 13:00: the handle stops at 14:02, the table went at 14:04
+const DROP = 31
+
+function Restore() {
+  const [ref, width] = usePictureWidth()
+  const layout = width < 600 ? 'compact' : 'wide'
+  return (
+    <Tile
+      area="restore"
+      title={<b>Undo the bad migration.</b>}
+      picture={
+        <div ref={ref} className="rb-picture rb-picture--restore">
+          <Stage<Beat> width={width} height={layout === 'compact' ? 236 : 216} theme="dark" initial={before} poster={after} play="once" script={beat(3)} className="rb-stage">
+            {(s) => {
+              const wide = layout === 'wide'
+              const bars = wide ? WRITES : WRITES.slice(22, 46)
+              const drop = wide ? DROP : DROP - 22
+              return (
+                <div className="rb-restore" data-on={s.on || undefined} data-layout={layout}>
+                  <div className="rb-restore__head">
+                    <span className="rb-restore__label">Restore shop to</span>
+                    <States
+                      value={s.on ? 'then' : 'now'}
+                      align="start"
+                      className="rb-restore__time"
+                      states={{ now: 'Now', then: '14:02:59' }}
+                    />
+                  </div>
+                  <div className="rb-track" style={{ ['--n' as string]: bars.length, ['--drop' as string]: drop }}>
+                    {bars.map((h, i) => (
+                      <span key={i} className="rb-track__bar" data-after={i >= drop || undefined} style={{ height: `${Math.round(h * 100)}%` }} />
+                    ))}
+                    <span className="rb-event">
+                      <span className="rb-event__tag">DROP TABLE carts</span>
+                    </span>
+                    <span className="rb-handle" />
+                  </div>
+                  <div className="rb-axis" style={{ ['--n' as string]: bars.length }}>
+                    {(wide ? [['13:00', 0], ['13:30', 15], ['14:00', 30]] : [['13:50', 3], ['14:10', 13]]).map(([t, at]) => (
+                      <span key={t} style={{ ['--at' as string]: at }}>{t}</span>
+                    ))}
+                  </div>
+                </div>
+              )
+            }}
+          </Stage>
+        </div>
+      }
+    >
+      Rewind to any second in the last 30 days.
+    </Tile>
+  )
+}
+
+/* ---------------- Drivers (collection) ---------------- */
+
+const ROWS = [
+  ['ecto', 'prisma', 'drizzle', 'kysely', 'sqlalchemy', 'gorm', 'diesel', 'sequelize', 'typeorm', 'exposed'],
+  ['knex', 'active record', 'sqlx', 'django', 'jooq', 'ent', 'mikro-orm', 'hibernate', 'pgx', 'slonik'],
+  ['dapper', 'peewee', 'objection', 'bun', 'sqlc', 'psycopg', 'tortoise', 'doctrine', 'ebean', 'room'],
+]
+
+function Drivers() {
+  return (
+    <Tile
+      area="orm"
+      title={<b>Bring your ORM.</b>}
+      picture={
+        <div className="rb-picture rb-picture--orm">
+          <Stage<Beat> width={1200} height={150} theme="dark" initial={before} poster={after} play="once" script={beat(4)} className="rb-stage">
+            {(s) => (
+              <div className="rb-rows" data-on={s.on || undefined}>
+                {ROWS.map((row, r) => (
+                  <div key={r} className="rb-row" style={{ ['--dir' as string]: r % 2 ? 1 : -1, ['--off' as string]: `${[-40, -96, -12][r]}px` }}>
+                    {row.map((name) => (
+                      <span key={name} className="rb-chip">
+                        {name}
+                      </span>
+                    ))}
+                  </div>
+                ))}
+              </div>
+            )}
+          </Stage>
+        </div>
+      }
+    >
+      Halite speaks the Postgres wire protocol, so your driver already works.
+    </Tile>
+  )
+}
+
+export default function RuledBento() {
+  return (
+    <div className="ruled-bento">
+      <div className="rb-grid">
+        <Create />
+        <Reads />
+        <Regions />
+        <Restore />
+        <Drivers />
+      </div>
+    </div>
+  )
+}
diff --git a/.agents/skills/stageshow/examples/share/index.tsx b/.agents/skills/stageshow/examples/share/index.tsx
new file mode 100644
index 00000000..e9f2955d
--- /dev/null
+++ b/.agents/skills/stageshow/examples/share/index.tsx
@@ -0,0 +1,221 @@
+import { Check as Tick, ChevronDown, FileText, Lock } from 'lucide-react'
+import { Avatar, Bar, Collapse, Facepile, Field, Menu, Popover, Roll, Row, Stage, Text, Window, type Act, type Layout } from '../../kit'
+import './share.css'
+
+// A document editor's Share popover. Beats: Share opens the popover over the
+// document, an email is typed and committed as a chip with Enter, the role
+// menu sets Can edit, Invite drops the new person in at the top of the access
+// list. Share closes the popover; the list is reset while it is out of sight.
+//
+// What makes it hold up frame by frame:
+// - The popover is measured from the Share button: its right edge is the
+//   button's right edge, its top 8px below it. Nothing is hard-coded.
+// - The role picker sits inside the field, as wide as its longest label, so
+//   Can view to Can edit moves nothing; only the word changes. The field is
+//   wide enough for the whole email as text and as a chip.
+// - The role menu opens under its trigger and runs to the popover's inner
+//   edge, so it covers the role column whole: no word peeks out beside it.
+// - The document behind is placeholder bars, so the popover's edge only ever
+//   crosses filler, never a word.
+// - Every person is the same two-line Row, the new one included.
+// - The Enter keycap shows over the document, clear of the popover.
+//
+// Real strings: the title, the popover's labels, the email, the roles and the
+// people. The document behind is placeholder.
+
+type S = {
+  open: boolean
+  email: string
+  typing: boolean
+  chip: boolean
+  menu: boolean
+  role: string
+  hover: number | undefined
+  added: boolean
+}
+
+const initial: S = { open: false, email: '', typing: false, chip: false, menu: false, role: 'Can view', hover: undefined, added: false }
+
+// The still is the payoff: the popover open with the new person added
+const poster: S = { ...initial, open: true, added: true }
+
+const DOC = 'Launch brief'
+const EMAIL = 'priya@lumen.co'
+const ROLES = ['Can view', 'Can comment', 'Can edit']
+const EDIT = ROLES.indexOf('Can edit')
+
+async function script(a: Act<S>) {
+  await a.wait(600)
+
+  // 1. Share opens the popover; the field takes focus
+  a.mark('open')
+  await a.click({ at: 'share', x: 0.5, y: 0.55 })
+  await a.set({ open: true })
+  await a.wait(700)
+
+  // 2. Type the email, then Enter commits it as a chip in place
+  a.mark('type')
+  await a.click({ at: 'field', x: 0.3, y: 0.5 })
+  await a.set({ typing: true })
+  await a.type('email', EMAIL, { interval: 55 })
+  await a.set({ typing: false })
+  await a.wait(250)
+  await a.key('enter')
+  await a.set({ chip: true })
+  await a.wait(600)
+
+  // 3. The role menu: open it, run down to Can edit, pick it
+  a.mark('role')
+  await a.click({ at: 'role', x: 0.45, y: 0.5 })
+  await a.set({ menu: true })
+  await a.wait(450)
+  await a.move({ at: `role-${EDIT}`, x: 0.4, y: 0.55 })
+  await a.wait(300)
+  await a.click()
+  await a.set({ menu: false, role: 'Can edit' })
+  await a.wait(500)
+
+  // 4. Invite: the person drops in at the top of the list, then the field
+  //    clears. Two beats: one cause, one effect at a time, so the eye follows
+  //    the chip into the list before the field empties behind it
+  a.mark('invite')
+  await a.click({ at: 'invite', x: 0.5, y: 0.55 })
+  await a.set({ added: true })
+  await a.wait(350)
+  await a.set({ chip: false, email: '', role: 'Can view' })
+  await a.wait(1850)
+
+  // 5. Share again closes it; the list resets out of sight
+  a.mark('close')
+  await a.click({ at: 'share', x: 0.5, y: 0.55 })
+  await a.set({ open: false })
+  await a.wait(450)
+  await a.snap({ added: false })
+  await a.wait(500)
+}
+
+type Geo = { win: { x: number; y: number; w: number; h: number }; pop: number }
+
+// Wide: one 24px gutter above and either side of the window, which runs off
+// the bottom. Compact: the same at the column's width, a narrower popover.
+const GEO: Record<Layout, Geo> = {
+  wide: { win: { x: 24, y: 24, w: 432, h: 360 }, pop: 344 },
+  compact: { win: { x: 16, y: 20, w: 326, h: 400 }, pop: 310 },
+}
+
+export default function ShareDemo() {
+  return (
+    <Stage<S>
+      width={480}
+      height={340}
+      compact={{ below: 440, width: 358, height: 380 }}
+      initial={initial}
+      poster={poster}
+      script={script}
+      keys={{ wide: 'bottom-left', compact: 'bottom-left' }}
+      cursor={{ at: { at: 'doc', x: 0.3, y: 0.6 } }}
+      className="sh"
+    >
+      {(s, rect, layout) => {
+        const g = GEO[layout]
+        const share = rect('share')
+        const pop = { left: share.x + share.width - g.pop, top: share.y + share.height + 8, width: g.pop }
+        return (
+          <>
+            <Window
+              className="sh-window"
+              style={{ left: g.win.x, top: g.win.y, width: g.win.w, height: g.win.h }}
+              lead={
+                <span className="sh-lead">
+                  <FileText size={15} strokeWidth={1.75} />
+                  <span>{DOC}</span>
+                </span>
+              }
+              toolbar={
+                <span className="sh-tools">
+                  <Facepile names={['Maya Chen', 'Leo Park']} size={22} overlap={3} />
+                  <span className="sh-share" data-target="share" data-cursor="pointer" data-on={s.open || undefined}>
+                    <Lock size={12} strokeWidth={2.25} />
+                    Share
+                  </span>
+                </span>
+              }
+              body={{ className: 'sh-body', 'data-crop': true }}
+            >
+              <div className="sh-doc" data-target="doc">
+                <Bar w={180} h={12} tone={3} className="sh-doc__title" />
+                <Bar w={300} h={7} tone={2} />
+                <Bar w={340} h={7} tone={2} />
+                <Bar w={250} h={7} tone={2} />
+                <span className="sh-doc__gap" />
+                <Bar w={320} h={7} tone={2} />
+                <Bar w={280} h={7} tone={2} />
+              </div>
+            </Window>
+
+            <Popover show={s.open} origin="top right" className="sh-pop" style={pop}>
+              <div className="sh-pop__head">
+                <Text className="sh-pop__title">{`Share “${DOC}”`}</Text>
+              </div>
+              <div className="sh-invite">
+                <Field
+                  className="sh-field"
+                  value={s.email}
+                  chip={s.chip}
+                  focused={s.open && !s.added && !s.menu}
+                  placeholder={layout === 'wide' ? 'Add people by email' : 'Add by email'}
+                  box={{ 'data-target': 'field' }}
+                  trailing={
+                    <span className="sh-role">
+                      <span className="sh-role__hit" data-target="role" data-cursor="pointer" data-on={s.menu || undefined}>
+                        <Roll variant="fade" align="end">{s.role}</Roll>
+                        <ChevronDown size={12} strokeWidth={2.25} />
+                      </span>
+                    </span>
+                  }
+                />
+                <span className="sh-invite__btn" data-target="invite" data-cursor="pointer" data-ready={s.chip || undefined}>
+                  Invite
+                </span>
+              </div>
+              <div className="sh-access">
+                <div className="sh-access__label">People with access</div>
+                <div className="sh-people">
+                  <Collapse open={s.added} reveal="drop">
+                    <Person name="Priya Shah" email={EMAIL} role="Can edit" />
+                  </Collapse>
+                  <Person name="Maya Chen" email="maya@lumen.co" role="Owner" />
+                  <Person name="Leo Park" email="leo@lumen.co" role="Can view" />
+                </div>
+              </div>
+              <Popover show={s.menu} origin="top left" className="sh-menu" style={roleMenu(rect, pop)}>
+                <Menu
+                  items={ROLES.map((r) => (
+                    <span className="sh-menu__item" key={r}>
+                      <span className="sh-menu__tick">{r === s.role && <Tick size={12} strokeWidth={2.5} />}</span>
+                      {r}
+                    </span>
+                  ))}
+                  targets={ROLES.map((_, i) => `role-${i}`)}
+                />
+              </Popover>
+            </Popover>
+          </>
+        )
+      }}
+    </Stage>
+  )
+}
+
+/** The role menu sits 6px under the field, from its trigger's left edge to
+ *  6px past the popover's inner edge (over the role column), in the popover's own coordinates. */
+function roleMenu(rect: (name: string) => { x: number; y: number; width: number; height: number }, pop: { left: number; top: number; width: number }) {
+  const r = rect('role')
+  const f = rect('field')
+  const left = r.x - pop.left - 4
+  return { left, top: f.y - pop.top + f.height + 6, width: pop.width - 10 - left }
+}
+
+function Person({ name, email, role }: { name: string; email: string; role: string }) {
+  return <Row className="sh-person" pad={6} lead={<Avatar name={name} size={28} />} title={name} subtitle={email} meta={<span className="sh-person__role">{role}</span>} />
+}
