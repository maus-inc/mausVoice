+/* All rules belong to this example, including its responsive variants. */
+.sp {
+  & .ss-stage {
+    --ss-accent: #635bff;
+    --ss-accent-2: #e15bff;
+    --ss-accent-soft: rgba(99, 91, 255, 0.1);
+    /* A travel curve chosen for this payout story, not a universal preset. */
+    --sp-ease: cubic-bezier(0.45, 0, 0.1, 1);
+    overflow: hidden;
+    border-radius: 14px;
+    background: #f6f8fb;
+    font: 12px/1.4 var(--ss-font);
+    color: var(--ss-text-strong);
+  }
+
+  .sp-wash {
+    position: absolute;
+    inset: 0;
+    background: radial-gradient(50% 60% at 100% 0%, rgba(99, 91, 255, 0.16), transparent 70%);
+  }
+
+  .sp-strong { font-weight: 600; }
+  .sp-muted { color: var(--ss-text); }
+
+  /* Reveals centered, then slides aside to make room */
+  .sp-balance {
+    position: absolute;
+    top: 40px;
+    left: 170px;
+    display: grid;
+    gap: 10px;
+    width: 300px;
+    height: 400px;
+    padding: 22px 22px 0;
+    border-radius: 12px;
+    background: var(--ss-surface);
+    box-shadow: var(--ss-shadow-hero);
+    opacity: 0;
+    --sp-x: 0px;
+    --sp-y: 24px;
+    transform: translate(var(--sp-x), var(--sp-y));
+    align-content: start;
+    /* A retained layer carries the type through both the rise and travel. */
+    will-change: transform;
+    transition: opacity 0.9s ease, transform 1.2s var(--sp-ease);
+  }
+
+  .sp-balance[data-in] { opacity: 1; --sp-y: 0px; }
+  .sp-balance[data-aside] { --sp-x: -130px; }
+
+  .sp-total {
+    margin: 2px 0 2px;
+    font-size: 26px;
+    font-weight: 600;
+    letter-spacing: -0.02em;
+    font-variant-numeric: tabular-nums;
+  }
+
+  .sp-head {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    margin-top: 14px;
+    padding-bottom: 6px;
+    border-bottom: 1px solid var(--ss-line);
+  }
+
+  .sp-row {
+    display: grid;
+    grid-template-columns: 22px 1fr auto auto;
+    align-items: center;
+    gap: 10px;
+    height: 38px;
+    border-bottom: 1px solid var(--ss-line-faint);
+    position: relative;
+    transform: translateY(10px);
+    opacity: 0;
+    will-change: transform;
+    transition: opacity 0.7s ease, transform 0.9s var(--sp-ease);
+  }
+
+  .sp-row[data-in] { opacity: 1; transform: translateY(0); transition-timing-function: ease, cubic-bezier(0.25, 0.8, 0.25, 1); }
+
+  .sp-bank {
+    width: 22px;
+    height: 22px;
+    border-radius: 6px;
+    background: var(--ss-ink-1);
+    box-shadow: inset 0 0 0 1px var(--ss-line);
+  }
+
+  .sp-amount { font-variant-numeric: tabular-nums; }
+
+  .sp-paid {
+    padding: 2px 7px;
+    transition: background 0.4s ease, color 0.4s ease;
+    border-radius: 6px;
+    background: var(--ss-success-soft);
+    color: var(--ss-success-text);
+    font-size: 10.5px;
+    font-weight: 500;
+  }
+
+  /* Arrives from the side it ends up on, a beat behind the balance moving.
+     One gutter from the balance, the same gutter to the stage edge. */
+  .sp-instant {
+    position: absolute;
+    top: 40px;
+    left: 364px;
+    display: grid;
+    gap: 16px;
+    width: 236px;
+    padding: 20px;
+    border-radius: 12px;
+    background: var(--ss-raised);
+    box-shadow: var(--ss-shadow-satellite);
+    opacity: 0;
+    transform: translateX(32px);
+    will-change: transform;
+    transition: opacity 0.8s ease 0.2s, transform 1.1s var(--sp-ease) 0.2s;
+  }
+
+  .sp-instant[data-in] { opacity: 1; transform: translateX(0); transition-timing-function: ease, cubic-bezier(0.25, 0.8, 0.25, 1); }
+
+  /* Its contents follow it in, 70ms apart */
+  .sp-instant > * {
+    position: relative;
+    transform: translateY(8px);
+    opacity: 0;
+    will-change: transform;
+    transition: opacity 0.6s ease, transform 0.9s var(--sp-ease);
+    transition-delay: calc(0.45s + var(--i) * 70ms);
+  }
+
+  .sp-instant[data-in] > * { opacity: 1; transform: translateY(0); transition-timing-function: ease, cubic-bezier(0.25, 0.8, 0.25, 1); }
+
+  .sp-instant__head { display: flex; align-items: center; gap: 10px; }
+
+  .sp-instant__mark {
+    display: grid;
+    place-items: center;
+    width: 28px;
+    height: 28px;
+    border-radius: 8px;
+    background: var(--ss-accent-soft);
+    color: var(--ss-accent);
+  }
+
+  .sp-instant__amount { font-size: 24px; font-weight: 600; letter-spacing: -0.02em; }
+
+  .sp-fields { display: grid; }
+
+  .sp-field {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    height: 36px;
+    border-top: 1px solid var(--ss-line-faint);
+  }
+
+  .sp-dest { display: flex; align-items: center; gap: 8px; }
+  .sp-bank--sm { width: 18px; height: 18px; border-radius: 5px; }
+
+  .sp-button {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    gap: 7px;
+    height: 36px;
+    margin-top: 2px;
+    border-radius: 9px;
+    background: var(--ss-accent);
+    color: #fff;
+    font-weight: 500;
+    position: relative;
+    isolation: isolate;
+  }
+
+  /* Any blend of purple and green passes through teal, so the change is quick
+     enough (about 200ms) that the in-between never registers */
+  .sp-button::before {
+    content: '';
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    border-radius: inherit;
+    background: var(--ss-success, #22c55e);
+    opacity: 0;
+    transition: opacity 0.2s ease;
+  }
+
+  .sp-button[data-sent]::before { opacity: 1; }
+
+  .sp-button { display: grid; }
+
+  .sp-state {
+    display: flex;
+    grid-area: 1 / 1;
+    align-items: center;
+    justify-self: center;
+    gap: 7px;
+    opacity: 0;
+    filter: blur(2px);
+    position: relative;
+    transform: translateY(4px);
+    will-change: transform;
+    transition: opacity 0.18s ease, filter 0.18s ease, transform 0.18s ease;
+  }
+
+  /* The outgoing state is gone before the next arrives */
+  .sp-state[data-on] {
+    opacity: 1;
+    filter: none;
+    transform: translateY(0);
+    transition: opacity 0.35s ease 0.12s, filter 0.35s ease 0.12s, transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1) 0.12s;
+  }
+
+  .sp-note {
+    position: absolute;
+    padding: 5px 9px;
+    border-radius: 7px;
+    background: var(--ss-text-strong);
+    color: var(--ss-surface);
+    font-size: 11px;
+    opacity: 0;
+    transform: translateY(8px);
+    will-change: transform;
+    transition: opacity 0.6s ease, transform 0.9s var(--sp-ease);
+  }
+
+  .sp-note[data-in] { opacity: 1; transform: translateY(0); transition-timing-function: ease, cubic-bezier(0.25, 0.8, 0.25, 1); }
+
+  /* The payout sits below its source on the phone; type remains at design size. */
+  & .ss-stage[data-layout='compact'] .sp-balance { left: 16px; top: 24px; width: 326px; height: 640px; }
+  & .ss-stage[data-layout='compact'] .sp-balance[data-aside] { --sp-x: 0px; }
+  & .ss-stage[data-layout='compact'] .sp-instant { left: 40px; top: 302px; width: 302px; }
+  & .ss-stage[data-layout='compact'] .sp-row:nth-last-child(-n + 2) { display: none; }
+}
+
+/* The Check on a filled button: a white ring and arc while sending, then a
+   white disc with the tick in the button's green */
+.sp-button .ss-check__ring { stroke: rgb(255 255 255 / 0.45); }
+.sp-button .ss-check__arc { stroke: #fff; }
+.sp-button .ss-check__fill { fill: #fff; }
+.sp-button .ss-check__tick { stroke: var(--ss-success); }
+
+/* The label trimmed to cap height, so the Check centers on the letters, not
+   on a line box that sits system-ui capitals low */
+.sp-button .ss-swap { text-box: trim-both cap alphabetic; }
