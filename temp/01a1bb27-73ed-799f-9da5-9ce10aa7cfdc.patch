@@ -0,0 +1,62 @@
+import type { Hotkey } from "@maus-inc/types";
+import { getHotkeyRepo } from "../../repos";
+import { getAppState, produceAppState } from "../../store";
+import {
+  enqueueHotkeyWrite,
+  optimisticHotkeyRevision,
+} from "../../utils/hotkey-write-queue";
+import {
+  SWITCH_TO_STYLE_HOTKEY_PREFIX,
+  syncHotkeyCombosToNative,
+} from "../../utils/keyboard.utils";
+import { withLocalDataWrite } from "../../utils/local-data-write-gate";
+import { applyReplacedStyleHotkeys } from "../../utils/style-hotkey";
+
+export const saveStyleHotkeys = (
+  next: Hotkey[],
+  expected?: Hotkey[],
+): Promise<void> => {
+  const prefix = SWITCH_TO_STYLE_HOTKEY_PREFIX;
+  const before = Object.values(getAppState().hotkeyById).filter((hotkey) =>
+    hotkey.actionName.startsWith(prefix),
+  );
+  const revision = optimisticHotkeyRevision(prefix);
+  return withLocalDataWrite((lease) =>
+    enqueueHotkeyWrite(async () => {
+      const saved = await getHotkeyRepo().replaceStyleHotkeys(
+        prefix,
+        next,
+        lease,
+        expected,
+      );
+      const state = getAppState();
+      const changedSinceStart = optimisticHotkeyRevision(prefix) !== revision;
+      const changed = changedSinceStart
+        ? Object.values(state.hotkeyById).filter(
+            (item) =>
+              item.actionName.startsWith(prefix) && !before.includes(item),
+          )
+        : [];
+      const removed = changedSinceStart
+        ? new Set(
+            before
+              .filter((item) => !state.hotkeyById[item.id])
+              .map((item) => item.id),
+          )
+        : new Set<string>();
+      produceAppState((draft) => {
+        applyReplacedStyleHotkeys(
+          draft,
+          prefix,
+          saved.filter((item) => !removed.has(item.id)),
+        );
+        for (const item of changed) {
+          draft.hotkeyById[item.id] = item;
+          if (!draft.settings.hotkeyIds.includes(item.id))
+            draft.settings.hotkeyIds.push(item.id);
+        }
+      }, lease);
+      await syncHotkeyCombosToNative();
+    }),
+  );
+};
