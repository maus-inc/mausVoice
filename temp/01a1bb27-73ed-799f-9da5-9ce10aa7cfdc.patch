@@ -0,0 +1,64 @@
+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { IntlProvider } from "react-intl";
+import { expect, it, vi } from "vitest";
+import { ensureUiHarness } from "../../../test/helpers/jsdom-ui-harness";
+import { TonePreviewResult } from "./TonePreviewResult";
+import type { useTonePreview } from "./useTonePreview";
+
+vi.mock("react-intl", async (importOriginal) => {
+  const { reactIntlWithIdsModule } =
+    await import("../../../test/helpers/react-intl-mock");
+  return reactIntlWithIdsModule(importOriginal);
+});
+ensureUiHarness();
+
+it.each([
+  ["idle", ""],
+  ["running", "Styling the sample..."],
+  ["done", "styled output"],
+  ["error", "Preview failed."],
+  ["unavailable", "No text-generation provider is configured"],
+] as const)("renders the %s preview state", async (status, expected) => {
+  const host = document.createElement("div");
+  document.body.append(host);
+  const root = createRoot(host);
+  const preview: ReturnType<typeof useTonePreview> = {
+    status,
+    output: "styled output",
+    error: "provider error",
+    run: vi.fn(),
+    cancel: vi.fn(),
+  };
+  try {
+    await act(async () =>
+      root.render(
+        <IntlProvider locale="en">
+          <TonePreviewResult preview={preview} />
+        </IntlProvider>,
+      ),
+    );
+    expect(host.textContent).toContain(expected);
+    if (status === "error")
+      expect(host.textContent).toContain("provider error");
+    expect(host.textContent).not.toContain(
+      "You can create this style without a preview.",
+    );
+    if (status === "unavailable") {
+      await act(async () =>
+        root.render(
+          <IntlProvider locale="en">
+            <TonePreviewResult preview={preview} creation />
+          </IntlProvider>,
+        ),
+      );
+      expect(host.textContent).toContain(
+        "You can create this style without a preview.",
+      );
+    }
+  } finally {
+    act(() => root.unmount());
+    host.remove();
+  }
+});
