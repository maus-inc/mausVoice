+import {
+  getToolAlwaysAllow,
+  setToolAlwaysAllow,
+} from "../utils/tool-permission.utils";
+import { BaseTool } from "./base.tool";
+
+/** Tools that persist scoped grants share the same permission policy. */
+export abstract class PersistedPermissionTool extends BaseTool {
+  getAlwaysAllow(_params: Record<string, unknown>, scope = "global"): boolean {
+    return getToolAlwaysAllow(this.info.id, scope);
+  }
+
+  setAlwaysAllow(
+    _params: Record<string, unknown>,
+    allowed: boolean,
+    scope = "global",
+  ): void {
+    setToolAlwaysAllow(this.info.id, allowed, scope);
+  }
+}
