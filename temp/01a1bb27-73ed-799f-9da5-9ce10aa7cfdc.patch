+  --wk-sans: -apple-system, 'Helvetica Neue', Arial, sans-serif;
+  overflow: hidden;
+  background: var(--ss-well);
+}
+
+.wk-window {
+  position: absolute;
+  top: var(--gutter);
+  left: var(--gutter);
+  right: var(--gutter);
+  height: 640px;
+  background: #fff;
+  border-radius: 10px;
+  box-shadow: var(--ss-shadow-hero);
+}
+
+.wk-page {
+  display: flex;
+  flex-direction: column;
