@@ -0,0 +1,50 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { ToolInfo } from "@maus-inc/types";
+
+const permissions = vi.hoisted(() => ({
+  get: vi.fn(() => false),
+  set: vi.fn(),
+}));
+vi.mock("../utils/tool-permission.utils", () => ({
+  getToolAlwaysAllow: permissions.get,
+  setToolAlwaysAllow: permissions.set,
+}));
+
+import { GetAccessibilityInfoTool } from "./get-accessibility-info.tool";
+import { PasteTool } from "./paste.tool";
+import { RunTerminalCommandTool } from "./run-terminal-command.tool";
+import { EndConversationTool } from "./end-conversation.tool";
+
+const info = { id: "tool-id" } as ToolInfo;
+
+describe.each([GetAccessibilityInfoTool, PasteTool, RunTerminalCommandTool])(
+  "%s scoped permissions",
+  (Tool) => {
+    beforeEach(() => vi.clearAllMocks());
+
+    it("uses the tool identity and default or provided scope", () => {
+      const tool = new Tool(info);
+      tool.getAlwaysAllow({});
+      tool.setAlwaysAllow({}, true);
+      tool.getAlwaysAllow({}, "conversation");
+      tool.setAlwaysAllow({}, false, "conversation");
+      expect(permissions.get.mock.calls).toEqual([
+        ["tool-id", "global"],
+        ["tool-id", "conversation"],
+      ]);
+      expect(permissions.set.mock.calls).toEqual([
+        ["tool-id", true, "global"],
+        ["tool-id", false, "conversation"],
+      ]);
+    });
+  },
+);
+
+it("keeps end-conversation inherently allowed without persisting a grant", () => {
+  vi.clearAllMocks();
+  const tool = new EndConversationTool(info);
+  expect(tool.getAlwaysAllow({}, "conversation")).toBe(true);
+  tool.setAlwaysAllow({}, true, "conversation");
+  expect(permissions.get).not.toHaveBeenCalled();
+  expect(permissions.set).not.toHaveBeenCalled();
+});
