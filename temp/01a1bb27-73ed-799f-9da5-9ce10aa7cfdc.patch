+        let mut f = sys::FIXTURE.lock().unwrap();
+        f.pid = -1;
+        f.returned = std::mem::size_of::<sys::pid_t>() as u32;
+        f.get_status = 0;
+        f.set_status = 0;
+        f.get_count = 0;
+        f.set_count = 0;
+        f.set_size = 0;
+        f.set_value = 0;
+        f.next = 123;
+    }
