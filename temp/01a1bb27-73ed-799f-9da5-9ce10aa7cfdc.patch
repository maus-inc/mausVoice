+import { afterEach, expect, it, vi } from "vitest";
+import { aldeaTranscribeAudio } from "./aldea.utils";
+import { exactAudioBuffer } from "./audio-bytes.utils";
+import { deepgramTranscribeAudio } from "./deepgram.utils";
+import { elevenlabsTranscribeAudio } from "./elevenlabs.utils";
+import { xaiTranscribeAudio } from "./xai.utils";
+
+const view = () => Buffer.from([99, 1, 2, 3, 88]).subarray(1, 4);
+const response = () =>
+  new Response(
+    JSON.stringify({
+      text: "hello",
+      results: { channels: [{ alternatives: [{ transcript: "hello" }] }] },
+    }),
+    { status: 200 },
+  );
+
+afterEach(() => vi.unstubAllGlobals());
+
+it("returns ArrayBuffers unchanged and copies only a Buffer's visible region", () => {
+  const full = new ArrayBuffer(4);
+  expect(exactAudioBuffer(full)).toBe(full);
+  const source = view();
+  const actual = exactAudioBuffer(source);
+  expect([...new Uint8Array(actual)]).toEqual([1, 2, 3]);
+  source[0] = 0;
+  expect([...new Uint8Array(actual)]).toEqual([1, 2, 3]);
+  expect(exactAudioBuffer(source.subarray(0, 0)).byteLength).toBe(0);
+});
+
+it.each(["deepgram", "aldea", "elevenlabs", "xai"] as const)(
+  "sends only supplied Buffer bytes to %s",
+  async (provider) => {
+    const fetcher = vi.fn(
+      async (_url: RequestInfo | URL, _init?: RequestInit) => response(),
+    );
+    const args = { apiKey: "key", blob: view(), ext: "wav" };
+    if (provider === "aldea") {
+      vi.stubGlobal("fetch", fetcher);
+      await aldeaTranscribeAudio(args);
+    } else if (provider === "deepgram") {
+      await deepgramTranscribeAudio({ ...args, customFetch: fetcher });
+    } else if (provider === "elevenlabs") {
+      await elevenlabsTranscribeAudio({ ...args, customFetch: fetcher });
+    } else {
+      await xaiTranscribeAudio({ ...args, customFetch: fetcher });
+    }
+    const body = fetcher.mock.calls[0]?.[1]?.body;
+    const payload =
+      body instanceof FormData
+        ? await (body.get("file") as Blob).arrayBuffer()
+        : (body as ArrayBuffer);
+    expect([...new Uint8Array(payload)]).toEqual([1, 2, 3]);
+  },
+);
