+// @vitest-environment jsdom
+import { act, createElement } from "react";
+import { createRoot } from "react-dom/client";
+import { IntlProvider } from "react-intl";
+import { afterEach, expect, it, vi } from "vitest";
+import { ensureUiHarness } from "../../../test/helpers/jsdom-ui-harness";
+import de from "../../i18n/locales/de.json";
+import { INITIAL_APP_STATE } from "../../state/app.state";
+import { setAppState } from "../../store";
+
+const { check } = vi.hoisted(() => ({
+  check: vi.fn(() => Promise.resolve(false)),
+}));
+vi.mock("@tauri-apps/api/app", () => ({
+  getVersion: () => Promise.resolve("1.0.0"),
+}));
+vi.mock("../../actions/updater.actions", () => ({ checkForAppUpdates: check }));
+vi.mock("react-intl", async (importOriginal) => {
+  const { reactIntlWithIdsModule } =
+    await import("../../../test/helpers/react-intl-mock");
+  return reactIntlWithIdsModule(importOriginal);
+});
+import { UpdateSettingSection } from "./UpdateSettingSection";
+
+ensureUiHarness();
+afterEach(() => {
+  vi.clearAllMocks();
+  document.body.innerHTML = "";
+});
+
+it.each([
+  ["downloading", true, true],
+  ["installing", false, true],
+  ["installing", true, false],
+] as const)(
+  "gates check-now for %s, manual=%s",
+  async (status, manual, disabled) => {
+    const state = structuredClone(INITIAL_APP_STATE);
+    state.updater.status = status;
+    state.updater.requiresManualInstall = manual;
+    setAppState(state, true);
+    const container = document.createElement("div");
+    document.body.appendChild(container);
+    const root = createRoot(container);
+    try {
+      await act(async () =>
+        root.render(
+          createElement(
+            IntlProvider,
+            { locale: "en", messages: {} },
+            createElement(UpdateSettingSection),
+          ),
+        ),
+      );
+      const button = Array.from(container.querySelectorAll("button")).find(
+        (element) => element.textContent?.includes("Check now"),
+      );
+      expect(button?.disabled).toBe(disabled);
+      if (!disabled) {
+        await act(async () => button?.click());
+        expect(check).toHaveBeenCalledWith({ userInitiated: true });
+      }
+    } finally {
+      act(() => root.unmount());
+      container.remove();
+    }
+  },
+);
+
+it("shows a general update error in the real German catalog", async () => {
+  const state = structuredClone(INITIAL_APP_STATE);
+  state.updater.status = "error";
+  state.updater.errorMessage = "restart failed";
+  setAppState(state, true);
+  const container = document.createElement("div");
+  document.body.appendChild(container);
+  const root = createRoot(container);
+  try {
+    await act(async () =>
+      root.render(
+        createElement(
+          IntlProvider,
+          { locale: "de", messages: de },
+          createElement(UpdateSettingSection),
+        ),
+      ),
+    );
+    expect(container.textContent).toContain(de.an_update_error_occurred);
+  } finally {
+    act(() => root.unmount());
+    container.remove();
+  }
+});
