@@ -0,0 +1,462 @@
+/* Messages (messages.tsx): Thread, Bubble, Stamp, Receipt and the chat look. */
+
+@layer stageshow {
+  .ss-thread {
+    --ss-thread-size: 15px;
+    --ss-me: #0a84ff;
+    --ss-me-text: #fff;
+    --ss-them: #e9e9eb;
+    --ss-them-text: #000;
+    /* One curve for everything that scrolls, so the thread moves as one */
+    --ss-scroll: 0.55s cubic-bezier(0.25, 1, 0.5, 1);
+    display: flex;
+    flex-direction: column;
+    justify-content: flex-end;
+    gap: 3px;
+    /* Never grows past the room it's given: a full conversation overflows its
+       top (under the header) instead of pushing the composer and keyboard down */
+    min-height: 0;
+    /* Clips only what scrolls off the top: a bubble forming out of the composer
+       below, or a tail or badge at the sides, stays visible */
+    clip-path: inset(0 -100vw -100vh -100vw);
+    font-size: var(--ss-thread-size);
+    line-height: 1.3;
+    letter-spacing: -0.01em;
+  }
+
+  /* Inside a phone, messages are at true iOS size */
+  .ss-phone__content .ss-thread {
+    --ss-thread-size: 17px;
+  }
+
+  /* Inside a phone the stamps and receipts scale with the bubbles: a phone
+     keeps them readable (iOS draws them at 11pt, which under a 300px phone
+     falls below 10px on the page) */
+  .ss-phone__content .ss-stamp,
+  .ss-phone__content .ss-receipt {
+    font-size: 14px;
+  }
+
+  .ss-thread[data-app="sms"] {
+    --ss-me: #34c759;
+  }
+
+  .ss-stage[data-theme="dark"] .ss-thread,
+  .ss-phone[data-dark] .ss-thread {
+    --ss-them: #26252a;
+    --ss-them-text: #fff;
+  }
+
+  /* Rows glide on top, each on a layer it keeps, so a bubble and its words
+     move as one picture (alone, the words step whole pixels inside the
+     gliding bubble). top is set (not auto) because auto can't be animated */
+  .ss-bubble-row {
+    position: relative;
+    top: 0;
+    will-change: transform;
+    display: flex;
+    flex: none;
+    transition: top var(--ss-scroll);
+  }
+
+  .ss-bubble-row[data-from="me"] {
+    justify-content: flex-end;
+  }
+
+  /* A gap between runs, a hairline within one */
+  .ss-bubble-row[data-from="me"] + .ss-bubble-row[data-from="them"],
+  .ss-bubble-row[data-from="them"] + .ss-bubble-row[data-from="me"] {
+    margin-top: 8px;
+  }
+
+  .ss-bubble {
+    position: relative;
+    max-width: 75%;
+    padding: 0.42em 0.76em;
+    top: 0;
+    left: 0;
+    border-radius: 1.06em;
+    isolation: isolate;
+    color: var(--t);
+    overflow-wrap: break-word;
+    transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1), height 0.35s cubic-bezier(0.22, 1, 0.36, 1);
+  }
+
+  /* The fill is its own layer, so it can grow from the tail corner while the
+     text only rises and fades: text that ends a scale hops as it lands */
+  .ss-bubble::before {
+    content: '';
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    border-radius: inherit;
+    background: var(--b);
+    transform-origin: inherit;
