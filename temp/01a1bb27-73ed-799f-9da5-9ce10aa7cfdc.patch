+}
+
+.ln-who__swap[data-assigned] .ln-who__me::before {
+  scale: 1;
+}
+
+.ln-who__swap[data-assigned] .ln-unassigned {
+  opacity: 0;
+  scale: 0.8;
+}
+
+/* ---- Command menu ---- */
+
+.ln-scrim {
+  position: absolute;
+  inset: 0;
+  z-index: 20;
+  background: var(--ln-scrim);
+  opacity: 0;
+  transition: opacity 0.2s ease;
+  pointer-events: none;
+}
+
+.ln-scrim[data-show] {
+  opacity: 1;
+}
+
+.ln-cmd {
+  top: 128px;
+  left: 190px;
+  width: 560px;
+  padding: 0;
+  border-radius: 12px;
+  --ss-popover-bg: var(--ss-raised);
+  --ss-popover-shadow: var(--ln-cmd-shadow);
+}
+
+[data-layout="compact"] .ln-cmd {
+  top: 66px;
+  left: 30px;
+  width: 360px;
+}
+
+.ln-cmd__context {
+  display: flex;
+  padding: 14px 16px 0;
+}
+
+.ln-cmd__chip {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  height: 22px;
+  padding: 0 8px;
+  border-radius: 6px;
+  background: var(--ln-cmd-chip);
+  font-size: 11.5px;
+  font-weight: 500;
+  color: var(--ss-text);
+}
+
+.ln-cmd__chip-title {
+  color: var(--ln-cmd-chip-title);
+}
+
+/* The menu's input is the menu's own line, not a field: no box, no ring */
+.ln-cmd__field .ss-field__box,
+.ln-cmd__field[data-focused] .ss-field__box {
+  height: 50px;
+  padding: 0 18px;
+  border-radius: 0;
+  background: transparent;
+  box-shadow: none;
+  border-bottom: 1px solid var(--ln-cmd-line);
+  font-size: 15px;
+}
+
+.ln-cmd__field .ss-field__caret {
+  height: 18px;
+  background: var(--ln-caret);
+}
+
+.ln-cmd__list {
+  padding: 6px 6px 8px;
+}
+
+/* Rows ride up as the ones above collapse: a kept layer, so their text
+   moves with the box instead of snapping to whole pixels inside it */
+.ln-cmd__item {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  height: 40px;
+  padding: 0 12px;
+  border-radius: 7px;
+  font-size: 13.5px;
+  color: var(--ln-cmd-text);
+  transition: background-color 0.12s ease;
+  will-change: transform;
+}
+
+.ln-cmd__item[data-active] {
+  background: var(--ln-cmd-active);
+  color: var(--ss-text-strong);
+}
+
+.ln-cmd__icon {
+  display: grid;
+  place-items: center;
+  width: 16px;
+  color: var(--ss-icon);
+}
+
+.ln-cmd__item[data-active] .ln-cmd__icon {
+  color: var(--ss-text-strong);
+}
+
+.ln-cmd__label {
+  flex: 1;
+}
+
+.ln-cmd__key {
+  display: grid;
+  place-items: center;
+  min-width: 20px;
+  height: 20px;
+  padding: 0 5px;
+  border-radius: 5px;
+  box-shadow: inset 0 0 0 1px var(--ln-key-line);
+  font-size: 11px;
+  font-weight: 500;
+  color: var(--ss-text);
+}
+
+.ln-cmd__item[data-active] .ln-cmd__key {
+  box-shadow: inset 0 0 0 1px var(--ln-key-active);
+}
+
+.ln-st {
+  display: grid;
+  width: 14px;
+  height: 14px;
+}
+
+/* Compact: the menu has to fit the shorter stage, a gutter from its bottom */
+[data-layout="compact"] .ln-cmd__item {
+  height: 36px;
+}
+
+[data-layout="compact"] .ln-cmd__field .ss-field__box {
+  height: 46px;
+}
