+  --ss-accent-soft: rgba(94, 106, 210, 0.16);
+
+  --ln-nav-text: #5c5c59;
+  --ln-nav-active: #e9e9e7;
+  --ln-row-hover: #f3f3f2;
+  --ln-tile: #1d1d1c;
+  --ln-tile-text: #fdfdfc;
+  --ln-team-tile: #e4e4e2;
+  --ln-team-text: #4a4a47;
+  --ln-tab-active: #efefee;
+  --ln-chip-line: #e3e3e1;
+  --ln-pri-off: #cfcfcc;
+  --ln-pri-on: #6c6c69;
+  --ln-ring-todo: #a8a8a4;
+  --ln-ring-backlog: #b4b4b0;
+  --ln-progress: #e5b400;
+  --ln-done: #5e6ad2;
+  --ln-done-mark: #fdfdfc;
+  --ln-unassigned: #b0b0ac;
+  --ln-scrim: rgba(28, 28, 26, 0.06);
+  --ln-cmd-line: #ececea;
+  --ln-cmd-active: #f1f1f0;
+  --ln-cmd-text: #3a3a38;
+  --ln-cmd-chip: #f1f1f0;
+  --ln-cmd-chip-title: #3a3a38;
+  --ln-key-line: #e3e3e1;
+  --ln-key-active: #e6e6e4;
+  --ln-caret: #1d1d1c;
+  --ln-cmd-shadow: 0 0 0 1px rgba(0, 0, 0, 0.07), 0 24px 56px -16px rgba(0, 0, 0, 0.16), 0 8px 18px -8px rgba(0, 0, 0, 0.08);
+  --ln-panel-shadow: 0 0 0 1px var(--ss-line), 0 1px 2px rgba(0, 0, 0, 0.03);
+
+  overflow: hidden;
