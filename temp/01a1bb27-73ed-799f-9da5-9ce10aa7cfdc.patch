+/* Exercise the ALSA POLLERR/XRUN path against an isolated null device. */
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <poll.h>
+#include <stdatomic.h>
+
+static atomic_int active;
+static atomic_int preparations;
