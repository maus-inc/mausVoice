+
+  .fx-art--sand {
+    background:
+      radial-gradient(70% 90% at 85% 10%, #e6d6be 0%, transparent 60%),
+      linear-gradient(160deg, #c8b293 0%, #a48d6d 60%, #85704f 100%);
+  }
+
+  .fx-tabs {
+    position: absolute;
+    right: 0;
+    bottom: 0;
+    left: 0;
+    display: flex;
+    justify-content: space-around;
+    height: 83px;
+    padding: 10px 24px 0;
