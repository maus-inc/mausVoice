+const intl = getIntl("en");
+
+describe("transcript correction feedback", () => {
+  it("reports a partially saved glossary and privacy suppression together", () => {
+    expect(
+      correctionFeedback(intl, {
+        learnedTerms: ["Soniya"],
+        failedTerms: 0,
+        dictionarySuppressed: true,
+      }),
+    ).toEqual({
+      message:
+        "Privacy mode interrupted dictionary learning. Added 1 word to your dictionary; remaining words were skipped.",
+      mode: "success",
+    });
+  });
+
+  it("reports failures as well as privacy suppression", () => {
+    const { message, mode } = correctionFeedback(intl, {
+      learnedTerms: ["Soniya"],
+      failedTerms: 1,
+      dictionarySuppressed: true,
+    });
+    expect(message).toContain("1 word");
+    expect(message).toContain("1 failed");
+    expect(message).toContain("Privacy mode");
+    expect(mode).toBe("error");
+  });
+
+  it("does not claim incognito is on for an ephemeral session", () => {
+    expect(
+      correctionFeedback(intl, {
+        learnedTerms: [],
+        failedTerms: 0,
+        dictionarySuppressed: true,
+      }).message,
+    ).toContain("Privacy mode");
+  });
+
+  it("reports an unexpected learning error without pretending the correction failed", () => {
+    expect(
+      correctionFeedback(intl, {
+        learnedTerms: [],
+        failedTerms: 0,
+        dictionarySuppressed: false,
+        learningIncomplete: true,
+      }),
+    ).toEqual({
+      message:
+        "Transcript updated, but dictionary learning could not be completed.",
+      mode: "error",
+    });
+  });
+
+  it("keeps ordinary success and failure feedback", () => {
+    expect(
+      correctionFeedback(intl, {
+        learnedTerms: ["Soniya"],
+        failedTerms: 0,
+        dictionarySuppressed: false,
+      }).message,
+    ).toBe('Added "Soniya" to your dictionary');
+    expect(
+      correctionFeedback(intl, {
+        learnedTerms: [],
+        failedTerms: 1,
+        dictionarySuppressed: false,
+      }).mode,
+    ).toBe("error");
+  });
+});
