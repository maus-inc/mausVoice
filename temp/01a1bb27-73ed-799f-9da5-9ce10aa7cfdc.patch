+  mocks.stop.mockResolvedValue(status(false));
+  mocks.start.mockResolvedValue(status(true));
+  let finish!: (loaded: boolean) => void;
+  mocks.load.mockReturnValueOnce(
+    new Promise<boolean>((resolve) => {
+      finish = resolve;
+    }),
