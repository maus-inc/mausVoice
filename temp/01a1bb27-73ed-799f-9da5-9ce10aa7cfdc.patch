+    "unused_dep_count": 3,
+    "unused_deps_per_k_files": 6.2,
+    "unit_size_profile": {
+      "low_risk": 82.1,
+      "medium_risk": 11.4,
+      "high_risk": 4.3,
+      "very_high_risk": 2.2
+    },
+    "functions_over_60_loc_per_k": 22.0,
+    "unit_interfacing_profile": {
+      "low_risk": 95.6,
