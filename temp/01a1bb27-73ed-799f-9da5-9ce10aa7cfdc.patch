+/* Google Calendar, week view (Material 3). One cool neutral family: the
+   app's #f8fafd ground, white grid panel, #dde3ea rules. The accent (Google
+   blue) is spent on today and on the new event. */
+
+.gc-stage .ss-stage {
+  --gc-ground: #f8fafd;
+  --gc-line: #dde3ea;
+  --gc-text: #1f1f1f;
+  --gc-text-2: #444746;
+  --gc-text-3: #70757a;
+  --gc-blue: #0b57d0;
+  --gc-event: #039be5;
+  --gc-tint: #cbe8f8;
+  --gc-tint-bar: #93cdee;
+  --gc-past: #e4f2fb;
+  --gc-past-bar: #bfe0f3;
+  --ss-icon: #444746;
+  overflow: hidden;
+  background: #e9edf2;
+  color: var(--gc-text);
+  font-family: "Google Sans", "Roboto", system-ui, -apple-system, sans-serif;
+}
+
+.gc-icon {
+  display: block;
+  flex-shrink: 0;
+  color: var(--ss-icon);
+}
+
+/* ---- Window ---- */
+
+.gc-window {
+  position: absolute;
+  left: 36px;
+  top: 36px;
+  width: 860px;
+  height: 560px;
+  background: var(--gc-ground);
+  box-shadow: var(--ss-shadow-hero);
+}
+
+.gc-window[data-layout="compact"] {
+  left: 16px;
+  top: 16px;
+  width: 440px;
+  height: 420px;
+}
+
+.gc-window .ss-window__url {
+  font-size: 11px;
+  color: var(--gc-text-3);
+}
+
+.gc-app {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  background: var(--gc-ground);
+}
+
+/* ---- Header ---- */
+
+.gc-header {
+  display: flex;
+  flex-shrink: 0;
+  align-items: center;
+  height: 56px;
+  padding: 0 12px 0 8px;
+}
+
+.gc-window[data-layout="compact"] .gc-header {
+  height: 50px;
+}
+
+.gc-brand {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  width: 196px;
+}
+
+.gc-window[data-layout="compact"] .gc-brand {
+  width: auto;
+  margin-right: 12px;
+}
+
+.gc-brand-name {
+  font-size: 18px;
+  color: var(--gc-text-2);
+  letter-spacing: -0.1px;
+}
+
+.gc-iconbtn {
+  display: grid;
+  place-items: center;
+  width: 36px;
+  height: 36px;
+  border-radius: 50%;
+}
+
+.gc-iconbtn.sm {
+  width: 28px;
+  height: 28px;
+}
+
+.gc-mark {
+  display: block;
+  flex-shrink: 0;
+  filter: drop-shadow(0 0.5px 0.5px rgba(0, 0, 0, 0.2));
+}
+
+.gc-today {
+  display: grid;
+  place-items: center;
+  height: 34px;
+  padding: 0 16px;
+  border: 1px solid #747775;
+  border-radius: 17px;
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--gc-text);
+}
+
+.gc-arrows {
+  display: flex;
+  gap: 2px;
+  margin: 0 10px 0 12px;
+}
+
+.gc-month {
+  font-size: 21px;
+  color: var(--gc-text);
+  letter-spacing: -0.2px;
+}
+
+.gc-window[data-layout="compact"] .gc-month {
+  font-size: 16px;
+}
+
+.gc-tools {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  margin-left: auto;
+}
+
+.gc-view {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  height: 34px;
+  margin: 0 6px;
+  padding: 0 8px 0 16px;
+  border: 1px solid #747775;
+  border-radius: 17px;
+  font-size: 13px;
+  font-weight: 500;
+}
+
+.gc-avatar {
+  width: 30px;
+  height: 30px;
+  margin-left: 4px;
+  border-radius: 50%;
+  background: #c7d7e8;
+}
+
+/* ---- Body: sidebar + grid panel ---- */
+
+.gc-main {
