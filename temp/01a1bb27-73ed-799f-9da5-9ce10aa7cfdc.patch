+/* Wikipedia (Vector 2022) in a browser on a docs plate. Pinned with a 32px
+   gutter on the left, right and top; the window runs off the bottom. Colors
+   and the search menu's geometry are Codex's own values (measured on
+   en.wikipedia.org, October 2026), all one cool neutral family. */
+
+.wk-stage .ss-stage {
+  --gutter: 32px;
+  --wk-text: #202122;
+  --wk-subtle: #54595d;
+  --wk-placeholder: #72777d;
+  --wk-link: #36c;
+  --wk-border: #a2a9b1;
+  --wk-border-soft: #c8ccd1;
+  --wk-soft: #f8f9fa;
