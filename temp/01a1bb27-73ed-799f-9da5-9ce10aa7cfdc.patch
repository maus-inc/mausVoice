+import { HttpError } from "@maus-inc/utilities";
+import { describe, expect, it, vi } from "vitest";
+import {
+  assertSuccessfulResponse,
+  readRequiredTranscript,
+} from "./http-response.utils";
+
+describe("assertSuccessfulResponse", () => {
+  it("leaves a successful response body unread", async () => {
+    const response = new Response("result");
+    const prefix = vi.fn(() => "failed: ");
+    await assertSuccessfulResponse(response, prefix);
+    expect(prefix).not.toHaveBeenCalled();
+    expect(await response.text()).toBe("result");
+  });
+
+  it("preserves status, response detail and retry hint", async () => {
+    const response = new Response("overloaded", {
+      status: 503,
+      headers: { "retry-after": "2" },
+    });
+    const error = await assertSuccessfulResponse(
+      response,
+      (status) => `provider ${status}: `,
+    ).catch((caught: unknown) => caught);
+    expect(error).toBeInstanceOf(HttpError);
+    expect(error).toMatchObject({
+      status: 503,
+      message: "provider 503: overloaded",
+      retryAfterMs: 2000,
+    });
+  });
+
+  it("uses the existing fallback when the response body cannot be read", async () => {
+    const response = new Response("ignored", { status: 400 });
+    vi.spyOn(response, "text").mockRejectedValue(new Error("read failed"));
+    await expect(
+      assertSuccessfulResponse(response, (status) => `provider ${status}: `),
+    ).rejects.toThrow("provider 400: Unknown error");
+  });
+});
+
+describe("readRequiredTranscript", () => {
+  it("returns the original untrimmed text", async () => {
+    await expect(
+      readRequiredTranscript(
+        new Response(JSON.stringify({ text: "  hello  " })),
+        "missing",
+      ),
+    ).resolves.toBe("  hello  ");
+  });
+
+  it.each([null, {}, { text: "" }])(
+    "uses the caller's message for absent text: %s",
+    async (body) => {
+      await expect(
+        readRequiredTranscript(
+          new Response(JSON.stringify(body)),
+          "provider missing text",
+        ),
+      ).rejects.toThrow("provider missing text");
+    },
+  );
+
+  it("propagates invalid JSON", async () => {
+    await expect(
+      readRequiredTranscript(new Response("{"), "missing"),
+    ).rejects.toBeInstanceOf(SyntaxError);
+  });
+});
diff --git a/packages/voice-ai/src/http-response.utils.ts b/packages/voice-ai/src/http-response.utils.ts
new file mode 100644
index 00000000..ab1bfc16
--- /dev/null
+++ b/packages/voice-ai/src/http-response.utils.ts
@@ -0,0 +1,40 @@
+import { HttpError } from "@maus-inc/utilities";
+
+/** Preserve provider-specific wording while carrying status and retry hints. */
+export const assertSuccessfulResponse = async (
+  response: Response,
+  messagePrefix: (status: number) => string,
+): Promise<void> => {
+  if (response.ok) return;
+  const detail = await response.text().catch(() => "Unknown error");
+  throw new HttpError(
+    response.status,
+    `${messagePrefix(response.status)}${detail}`,
+    { retryAfter: response.headers.get("retry-after") },
+  );
+};
+
+export const readRequiredTranscript = async (
+  response: Response,
+  missingTextMessage: string,
+): Promise<string> => {
+  const data = (await response.json()) as { text?: string } | null;
+  const transcript = data?.text;
+  if (!transcript) throw new Error(missingTextMessage);
+  return transcript;
+};
+
+export const assertSuccessfulIntegrationResponse = async (
+  response: Response,
+  provider: string,
+): Promise<void> => {
+  if (response.ok) return;
+  const detail = await response.text().catch(() => "");
+  throw new HttpError(
+    response.status,
+    detail
+      ? `${provider} responded ${response.status}: ${detail}`
+      : `${provider} responded with status ${response.status}`,
+    { retryAfter: response.headers.get("retry-after") },
+  );
+};
