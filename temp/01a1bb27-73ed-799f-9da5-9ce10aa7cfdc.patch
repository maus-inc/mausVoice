+++ b/patches/cpal-0.15.3/src/host/alsa/enumerate.rs
@@ -0,0 +1,70 @@
+use super::alsa;
+use super::{Device, DeviceHandles};
+use crate::{BackendSpecificError, DevicesError};
+use std::sync::{Arc, Mutex};
+
+/// ALSA's implementation for `Devices`.
+pub struct Devices {
+    hint_iter: alsa::device_name::HintIter,
+}
+
+impl Devices {
+    pub fn new() -> Result<Self, DevicesError> {
+        Ok(Devices {
+            hint_iter: alsa::device_name::HintIter::new_str(None, "pcm")?,
+        })
+    }
+}
+
+unsafe impl Send for Devices {}
+unsafe impl Sync for Devices {}
+
+impl Iterator for Devices {
+    type Item = Device;
+
+    fn next(&mut self) -> Option<Device> {
+        loop {
+            match self.hint_iter.next() {
+                None => return None,
+                Some(hint) => {
+                    let name = match hint.name {
+                        None => continue,
+                        // Ignoring the `null` device.
+                        Some(name) if name == "null" => continue,
+                        Some(name) => name,
+                    };
+
+                    if let Ok(handles) = DeviceHandles::open(&name) {
+                        return Some(Device {
+                            name,
+                            handles: Arc::new(Mutex::new(handles)),
+                        });
+                    }
+                }
+            }
+        }
+    }
+}
+
+#[inline]
+pub fn default_input_device() -> Option<Device> {
+    Some(Device {
+        name: "default".to_owned(),
+        handles: Arc::new(Mutex::new(Default::default())),
+    })
+}
+
+#[inline]
+pub fn default_output_device() -> Option<Device> {
+    Some(Device {
+        name: "default".to_owned(),
+        handles: Arc::new(Mutex::new(Default::default())),
+    })
+}
+
+impl From<alsa::Error> for DevicesError {
+    fn from(err: alsa::Error) -> Self {
+        let err: BackendSpecificError = err.into();
+        err.into()
+    }
+}
diff --git a/patches/cpal-0.15.3/src/host/alsa/input_probe.rs b/patches/cpal-0.15.3/src/host/alsa/input_probe.rs
new file mode 100644
index 00000000..a73ba375
--- /dev/null
+++ b/patches/cpal-0.15.3/src/host/alsa/input_probe.rs
@@ -0,0 +1,249 @@
+//! Serialize ALSA capture probes with stream construction and latch uncertain cleanup.
+use std::collections::HashSet;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::{Mutex, MutexGuard, OnceLock};
+
+pub(super) struct CaptureGate {
+    lock: Mutex<()>,
+    uncertain: AtomicBool,
+}
+
+impl CaptureGate {
+    pub(super) const fn new() -> Self {
+        Self {
+            lock: Mutex::new(()),
+            uncertain: AtomicBool::new(false),
+        }
+    }
+
+    pub(super) fn enter(&self) -> Result<CaptureGuard<'_>, ()> {
+        let lock = self.lock.lock().map_err(|_| {
+            self.uncertain.store(true, Ordering::SeqCst);
+        })?;
+        if self.uncertain.load(Ordering::SeqCst) {
+            return Err(());
+        }
+        Ok(CaptureGuard {
+            gate: self,
+            _lock: lock,
+            armed: false,
+        })
+    }
+
+    pub(super) fn lock_for_cleanup(&self) -> MutexGuard<'_, ()> {
+        self.lock.lock().unwrap_or_else(|error| {
+            self.mark_uncertain();
+            error.into_inner()
+        })
+    }
+
+    pub(super) fn is_uncertain(&self) -> bool {
+        self.uncertain.load(Ordering::SeqCst)
+    }
+
+    pub(super) fn mark_uncertain(&self) {
+        self.uncertain.store(true, Ordering::SeqCst);
+    }
+}
+
+pub(super) struct CaptureGuard<'a> {
+    gate: &'a CaptureGate,
+    _lock: MutexGuard<'a, ()>,
+    armed: bool,
+}
+
+impl CaptureGuard<'_> {
+    /// Mark the period in which unwinding would leave cleanup unconfirmed.
+    pub(super) fn arm(&mut self) {
+        self.armed = true;
+    }
+
+    /// Call only after a checked close or transfer to an owned stream.
+    pub(super) fn confirmed(&mut self) {
+        self.armed = false;
+    }
+
+    pub(super) fn uncertain(&mut self) {
+        self.gate.uncertain.store(true, Ordering::SeqCst);
+        self.armed = false;
+    }
+}
+
+impl Drop for CaptureGuard<'_> {
+    fn drop(&mut self) {
+        if self.armed {
+            self.gate.uncertain.store(true, Ordering::SeqCst);
+        }
+    }
+}
+
+/// Number of capture streams this process currently owns.
+///
+/// Probing a capture device opens and closes a PCM. Doing that while a stream
+/// is live contends for the device, can fail with `EBUSY` on hardware, and a
+/// probe whose close fails poisons the gate that admits every later capture.
+/// Device discovery therefore reports that capabilities are unavailable
+/// instead of opening a device another live stream owns.
+static LIVE_CAPTURE_STREAMS: AtomicUsize = AtomicUsize::new(0);
+
+/// Device names a capture probe or an admitted stream has already opened.
+static CAPTURE_CAPABLE: OnceLock<Mutex<HashSet<String>>> = OnceLock::new();
+
+fn capable_names() -> &'static Mutex<HashSet<String>> {
+    CAPTURE_CAPABLE.get_or_init(|| Mutex::new(HashSet::new()))
+}
+
+/// Whether any capture stream currently owns a device in this process.
+pub(super) fn capture_stream_is_live() -> bool {
+    LIVE_CAPTURE_STREAMS.load(Ordering::Acquire) > 0
+}
+
+/// Remember that `name` accepted a capture open.
+pub(super) fn record_capture_capable(name: &str) {
+    if let Ok(mut names) = capable_names().lock() {
+        names.insert(name.to_owned());
+    }
+}
+
+/// Forget a capability when a checked capture open reports a missing device.
+///
+/// The cache is only a previous observation: transient open failures and
+/// failures after opening do not disprove it. Enumeration can probe again
+/// once no capture stream is live.
+pub(super) fn forget_capture_capable(name: &str) {
+    if let Ok(mut names) = capable_names().lock() {
+        names.remove(name);
+    }
+}
+
+/// Whether a previous probe or stream already proved `name` can capture.
+///
+/// Enumeration uses this while a stream is live so a capture-only device stays
+/// listed without opening it again.
+pub(super) fn is_known_capture_capable(name: &str) -> bool {
+    capable_names()
+        .lock()
+        .map(|names| names.contains(name))
+        .unwrap_or(false)
+}
+
+/// Claimed by an owned capture stream for as long as it can hold the device.
+pub(super) struct CaptureSlot(());
+
+impl CaptureSlot {
+    pub(super) fn claim() -> Self {
+        LIVE_CAPTURE_STREAMS.fetch_add(1, Ordering::AcqRel);
+        Self(())
+    }
+}
+
+impl Drop for CaptureSlot {
+    fn drop(&mut self) {
+        // A slot is dropped exactly once, so this cannot underflow, but a
+        // wrap-around would silently re-enable probing.
+        let _ = LIVE_CAPTURE_STREAMS.fetch_update(Ordering::AcqRel, Ordering::Acquire, |live| {
+            live.checked_sub(1)
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{
+        capture_stream_is_live, forget_capture_capable, is_known_capture_capable,
+        record_capture_capable, CaptureGate, CaptureSlot,
+    };
+    use std::sync::{mpsc, Arc};
+    use std::time::Duration;
+
+    #[test]
+    fn uncertain_cleanup_and_unwind_permanently_block_admission() {
+        for panic in [false, true] {
+            let gate = CaptureGate::new();
+            let result = std::panic::catch_unwind(|| {
+                let mut guard = gate.enter().unwrap();
+                guard.arm();
+                if panic {
+                    panic!("probe panic");
+                }
+                guard.uncertain();
+            });
+            assert_eq!(result.is_err(), panic);
+            assert!(gate.is_uncertain());
+            assert!(gate.enter().is_err());
+        }
+    }
+
+    #[test]
+    fn checked_release_allows_the_next_admission() {
+        let gate = CaptureGate::new();
+        let mut guard = gate.enter().unwrap();
+        guard.arm();
+        guard.confirmed();
+        drop(guard);
+        assert!(!gate.is_uncertain());
+        assert!(gate.enter().is_ok());
+    }
+
+    #[test]
+    fn failure_from_an_active_stream_blocks_later_admission() {
+        let gate = CaptureGate::new();
+        let cleanup = gate.lock_for_cleanup();
+        gate.mark_uncertain();
+        drop(cleanup);
+        assert!(gate.is_uncertain());
+        assert!(gate.enter().is_err());
+    }
+
+    #[test]
+    fn opening_waits_until_a_probe_has_finished_closing() {
+        let gate = Arc::new(CaptureGate::new());
+        let mut guard = gate.enter().unwrap();
+        guard.arm();
+        let (attempt_tx, attempt_rx) = mpsc::channel();
+        let (done_tx, done_rx) = mpsc::channel();
+        let other = Arc::clone(&gate);
+        let worker = std::thread::spawn(move || {
+            attempt_tx.send(()).unwrap();
+            let accepted = other.enter().is_ok();
+            done_tx.send(accepted).unwrap();
+        });
+        attempt_rx.recv().unwrap();
+        assert!(done_rx.recv_timeout(Duration::from_millis(30)).is_err());
+        guard.uncertain();
+        drop(guard);
+        assert!(!done_rx.recv_timeout(Duration::from_secs(1)).unwrap());
+        worker.join().unwrap();
+    }
+
+    #[test]
+    fn a_live_capture_stream_is_visible_until_the_last_claim_is_dropped() {
+        assert!(!capture_stream_is_live());
+        let first = CaptureSlot::claim();
+        assert!(capture_stream_is_live());
+        let second = CaptureSlot::claim();
+        drop(first);
+        assert!(capture_stream_is_live());
+        drop(second);
+        assert!(!capture_stream_is_live());
+    }
+
+    #[test]
+    fn a_recorded_capability_survives_without_a_live_stream() {
+        assert!(!is_known_capture_capable("maus-test-never-opened"));
+        record_capture_capable("maus-test-never-opened");
+        assert!(is_known_capture_capable("maus-test-never-opened"));
+    }
+
+    /// Explicit invalidation removes the observation used during recording.
+    #[test]
+    fn a_failed_open_forgets_a_recorded_capability() {
+        record_capture_capable("maus-test-opened-then-failed");
+        assert!(is_known_capture_capable("maus-test-opened-then-failed"));
+        forget_capture_capable("maus-test-opened-then-failed");
+        assert!(!is_known_capture_capable("maus-test-opened-then-failed"));
+        // Forgetting an unknown name is a no-op.
+        forget_capture_capable("maus-test-opened-then-failed");
+        assert!(!is_known_capture_capable("maus-test-opened-then-failed"));
+    }
+}
diff --git a/patches/cpal-0.15.3/src/host/alsa/input_start.rs b/patches/cpal-0.15.3/src/host/alsa/input_start.rs
new file mode 100644
index 00000000..d8cf9dbb
--- /dev/null
+++ b/patches/cpal-0.15.3/src/host/alsa/input_start.rs
@@ -0,0 +1,632 @@
+//! Serialize capture start, pause, read, recovery and retirement.
+use std::sync::{Condvar, Mutex};
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum State {
+    Prepared,
+    Started,
+    Pausing,
+    Paused,
+    Failed,
+    Retired,
+}
+
+struct Inner {
+    state: State,
+    cycle_active: bool,
+    generation: u64,
+}
+
+pub(super) struct InputStart {
+    state: Mutex<Inner>,
+    changed: Condvar,
+}
+
+struct NotifyOnDrop<'a>(&'a Condvar);
+
+impl Drop for NotifyOnDrop<'_> {
+    fn drop(&mut self) {
+        self.0.notify_all();
+    }
+}
+
+/// Join a retired capture worker, recording a panic instead of propagating it.
+///
+/// The worker runs the consumer's data callback, so a panic there is that
+/// consumer's failure to report, not a reason to abort the process from
+/// `drop`. The checked stop and the drop path both call this, so a panicked
+/// worker is recorded the same way in each.
+pub(super) fn join_capture_worker(thread: std::thread::JoinHandle<()>, worker_failed: &mut bool) {
+    if thread.join().is_err() {
+        *worker_failed = true;
+    }
+}
+
+/// Covers a worker read through delivery or error handling, not just readi.
+pub(super) struct InputCycle<'a>(&'a InputStart);
+
+impl Drop for InputCycle<'_> {
+    fn drop(&mut self) {
+        let mut inner = self
+            .0
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        inner.cycle_active = false;
+        if std::thread::panicking() && inner.state != State::Retired {
+            inner.state = State::Failed;
+        }
+        self.0.changed.notify_all();
+    }
+}
+
+impl InputStart {
+    pub(super) fn new() -> Self {
+        Self {
+            state: Mutex::new(Inner {
+                state: State::Prepared,
+                cycle_active: false,
+                generation: 0,
+            }),
+            changed: Condvar::new(),
+        }
+    }
+
+    /// The first start happens before the worker can read from the device.
+    pub(super) fn start(&self, start: impl FnOnce() -> Result<(), String>) -> Result<bool, String> {
+        let mut inner = self
+            .state
+            .lock()
+            .map_err(|_| "ALSA input state is poisoned")?;
+        match inner.state {
+            State::Prepared => {
+                inner.state = State::Failed;
+                let _notify = NotifyOnDrop(&self.changed);
+                let result = start();
+                if result.is_ok() {
+                    inner.state = State::Started;
+                }
+                self.changed.notify_all();
+                result.map(|()| true)
+            }
+            State::Started | State::Paused => Ok(false),
+            State::Pausing => Err("ALSA input is pausing".into()),
+            State::Failed => Err("ALSA input state is uncertain and must be retired".into()),
+            State::Retired => Err("ALSA input has been retired".into()),
+        }
+    }
+
+    pub(super) fn pause(&self, pause: impl FnOnce() -> Result<(), String>) -> Result<(), String> {
+        self.pause_impl(false, pause)
+    }
+
+    /// Prevent another read and wait for the current read's callback to finish.
+    /// Callers must not invoke this from, or wait on it inside, that callback.
+    pub(super) fn pause_draining(
+        &self,
+        pause: impl FnOnce() -> Result<(), String>,
+    ) -> Result<(), String> {
+        self.pause_impl(true, pause)
+    }
+
+    fn pause_impl(
+        &self,
+        drain: bool,
+        pause: impl FnOnce() -> Result<(), String>,
+    ) -> Result<(), String> {
+        let mut inner = self
+            .state
+            .lock()
+            .map_err(|_| "ALSA input state is poisoned")?;
+        match inner.state {
+            State::Started => {
+                // A readiness result from before this pause must never drive
+                // a read or XRUN recovery after a later resume.
+                inner.generation = match inner.generation.checked_add(1) {
+                    Some(next) => next,
+                    None => {
+                        inner.state = State::Failed;
+                        self.changed.notify_all();
+                        return Err("ALSA input generation exhausted".into());
+                    }
+                };
+                if drain {
+                    inner.state = State::Pausing;
+                    inner = self
+                        .changed
+                        .wait_while(inner, |inner| {
+                            inner.state == State::Pausing && inner.cycle_active
+                        })
+                        .map_err(|_| "ALSA input state is poisoned")?;
+                    if inner.state != State::Pausing {
+                        return Err("ALSA input changed while pausing".into());
+                    }
+                }
+                // A failed native call is not proof that the state did not change.
+                inner.state = State::Failed;
+                let _notify = NotifyOnDrop(&self.changed);
+                let result = pause();
+                if result.is_ok() {
+                    inner.state = State::Paused;
+                }
+                self.changed.notify_all();
+                result
+            }
+            State::Paused if drain => {
+                inner = self
+                    .changed
+                    .wait_while(inner, |inner| {
+                        inner.state == State::Paused && inner.cycle_active
+                    })
+                    .map_err(|_| "ALSA input state is poisoned")?;
+                if inner.state == State::Paused {
+                    Ok(())
+                } else {
+                    Err("ALSA input changed while draining".into())
+                }
+            }
+            State::Paused => Ok(()),
+            State::Pausing => Err("ALSA input is pausing".into()),
+            State::Prepared => Err("ALSA input has not started".into()),
+            State::Failed => Err("ALSA input state is uncertain and must be retired".into()),
+            State::Retired => Err("ALSA input has been retired".into()),
+        }
+    }
+
+    pub(super) fn resume(&self, resume: impl FnOnce() -> Result<(), String>) -> Result<(), String> {
+        let mut inner = self
+            .state
+            .lock()
+            .map_err(|_| "ALSA input state is poisoned")?;
+        match inner.state {
+            State::Paused => {
+                inner.state = State::Failed;
+                let _notify = NotifyOnDrop(&self.changed);
+                let result = resume();
+                if result.is_ok() {
+                    inner.state = State::Started;
+                }
+                self.changed.notify_all();
+                result
+            }
+            State::Started => Ok(()),
+            State::Pausing => Err("ALSA input is pausing".into()),
+            State::Prepared => Err("ALSA input has not started".into()),
+            State::Failed => Err("ALSA input state is uncertain and must be retired".into()),
+            State::Retired => Err("ALSA input has been retired".into()),
+        }
+    }
+
+    pub(super) fn running_generation(&self) -> Result<Option<u64>, ()> {
+        let inner = self.state.lock().map_err(|_| ())?;
+        Ok((inner.state == State::Started).then_some(inner.generation))
+    }
+
+    pub(super) fn begin_cycle(&self, generation: u64) -> Result<Option<InputCycle<'_>>, ()> {
+        let mut inner = self.state.lock().map_err(|_| ())?;
+        if inner.state != State::Started || inner.generation != generation {
+            return Ok(None);
+        }
+        if inner.cycle_active {
+            return Err(());
+        }
+        inner.cycle_active = true;
+        Ok(Some(InputCycle(self)))
+    }
+
+    /// Serialize the native read with pause and retirement, but never hold this
+    /// lock while invoking the consumer's callback.
+    pub(super) fn read_if_running<T>(&self, read: impl FnOnce() -> T) -> Result<Option<T>, ()> {
+        let inner = self.state.lock().map_err(|_| ())?;
+        Ok(if inner.state == State::Started {
+            Some(read())
+        } else {
+            None
+        })
+    }
+
+    /// Recovery must not restart a stream after pause or retirement.
+    pub(super) fn recover(
+        &self,
+        recover: impl FnOnce() -> Result<(), String>,
+    ) -> Result<(), String> {
+        let mut inner = self
+            .state
+            .lock()
+            .map_err(|_| "ALSA input state is poisoned")?;
+        if inner.state != State::Started {
+            return Ok(());
+        }
+        inner.state = State::Failed;
+        recover()?;
+        inner.state = State::Started;
+        Ok(())
+    }
+
+    pub(super) fn wait_until_started(&self) -> bool {
+        let inner = match self.state.lock() {
+            Ok(inner) => inner,
+            Err(_) => return false,
+        };
+        let inner = self.changed.wait_while(inner, |inner| {
+            matches!(
+                inner.state,
+                State::Prepared | State::Pausing | State::Paused
+            )
+        });
+        matches!(inner, Ok(inner) if inner.state == State::Started)
+    }
+
+    pub(super) fn retire(&self) -> Result<(), ()> {
+        // A poisoned lock means a panic happened while the state was held, not
+        // that the device must stay reserved. Refusing to retire would make the
+        // caller retain a stream it can never release, so the state is retired
+        // through the poison guard the way `retire_on_drop` already does.
+        let mut inner = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        inner.state = State::Retired;
+        self.changed.notify_all();
+        Ok(())
+    }
+
+    pub(super) fn retire_on_drop(&self) {
+        let mut inner = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        inner.state = State::Retired;
+        self.changed.notify_all();
+    }
+}
