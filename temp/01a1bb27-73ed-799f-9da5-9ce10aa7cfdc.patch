+/* ---- List ---- */
+
+.ln-list {
+  display: flex;
+  flex-direction: column;
+  padding: 6px;
+}
+
+/* One column template, so ids, circles, avatars and dates line up */
+.ln-row {
+  display: grid;
+  grid-template-columns: 14px 54px 14px minmax(0, 1fr) 96px 18px 44px;
+  align-items: center;
+  column-gap: 12px;
