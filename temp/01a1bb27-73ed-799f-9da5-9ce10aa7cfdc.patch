+}
+
+.ln-group {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+
+.ln-section {
+  display: flex;
+  align-items: center;
+  height: 24px;
+  padding: 0 8px;
+}
+
+.ln-nav {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  height: 28px;
+  padding: 0 8px;
