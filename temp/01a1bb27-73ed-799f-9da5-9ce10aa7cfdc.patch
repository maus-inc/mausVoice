+++ b/scripts/ci/verify-release-tag.mjs
@@ -0,0 +1,87 @@
+#!/usr/bin/env node
+
+import { spawnSync } from "node:child_process";
+import { pathToFileURL } from "node:url";
+
+const parseRemoteTagRefs = (output, ref) => {
+  const refs = new Map();
+  for (const line of output.split("\n")) {
+    if (!line) continue;
+    const parts = line.split("\t");
+    if (
+      parts.length !== 2 ||
+      !/^(?:[a-f0-9]{40}|[a-f0-9]{64})$/i.test(parts[0]) ||
+      (parts[1] !== ref && parts[1] !== `${ref}^{}`) ||
+      refs.has(parts[1])
+    ) {
+      throw new Error("Unexpected remote tag response");
+    }
+    refs.set(parts[1], parts[0].toLowerCase());
+  }
+  return refs;
+};
+
+// This is a preflight, not an atomic reservation: repository tag protection is
+// still needed to prevent a ref being created or moved after the check.
+export const verifyReleaseTag = ({ tag, expectedSha, cwd = process.cwd() }) => {
+  if (
+    typeof tag !== "string" ||
+    !tag ||
+    tag.startsWith("-") ||
+    tag.includes("\0") ||
+    spawnSync("git", ["check-ref-format", `refs/tags/${tag}`], { cwd })
+      .status !== 0
+  ) {
+    throw new Error("Invalid release tag");
+  }
+  if (
+    typeof expectedSha !== "string" ||
+    !/^(?:[a-f0-9]{40}|[a-f0-9]{64})$/i.test(expectedSha)
+  ) {
+    throw new Error("Invalid dispatch commit SHA");
+  }
+  const ref = `refs/tags/${tag}`;
+  const result = spawnSync(
+    "git",
+    ["ls-remote", "--tags", "origin", ref, `${ref}^{}`],
+    {
+      cwd,
+      encoding: "utf8",
+    },
+  );
+  if (result.error || result.status !== 0 || result.signal) {
+    throw new Error("Cannot inspect the remote release tag");
+  }
+
+  const refs = parseRemoteTagRefs(result.stdout, ref);
+  const direct = refs.get(ref);
+  const peeled = refs.get(`${ref}^{}`);
+  if (!direct && peeled) throw new Error("Unexpected remote tag response");
+  if (!direct) return "absent";
+  if ((peeled ?? direct) !== expectedSha.toLowerCase()) {
+    throw new Error(
+      "Existing release tag does not resolve to the dispatch commit",
+    );
+  }
+  return "matched";
+};
+
+if (
+  process.argv[1] &&
+  import.meta.url === pathToFileURL(process.argv[1]).href
+) {
+  try {
+    const status = verifyReleaseTag({
+      tag: process.env.RELEASE_TAG,
+      expectedSha: process.env.RELEASE_SHA,
+    });
+    console.log(
+      status === "matched"
+        ? "Existing release tag matches the dispatch commit"
+        : "Release tag does not yet exist",
+    );
+  } catch (error) {
+    console.error(error instanceof Error ? error.message : String(error));
+    process.exit(1);
+  }
+}
