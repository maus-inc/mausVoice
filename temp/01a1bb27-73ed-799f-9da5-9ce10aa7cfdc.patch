+
+  .ms-field__ph[data-hide] {
+    opacity: 0;
+  }
+
+  .ms-send {
+    display: grid;
+    flex: none;
+    place-items: center;
+    width: 28px;
+    height: 28px;
+    border-radius: 50%;
+    background: #0a84ff;
+    color: #fff;
+    opacity: 0;
+    transform: scale(0.5);
+    transition: scale .12s ease, opacity 0.18s ease, transform 0.25s cubic-bezier(0.3, 0.75, 0.1, 1);
+  }
+
+  .ms-send[data-show] {
+    opacity: 1;
+    transform: none;
+  }
+}
