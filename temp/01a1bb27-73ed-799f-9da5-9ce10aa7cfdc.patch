+
+it("does not replace a newer poll with an older poll response", async () => {
+  let finish!: (value: RemoteReceiverStatus) => void;
+  mocks.get
+    .mockReturnValueOnce(
+      new Promise<RemoteReceiverStatus>((resolve) => {
+        finish = resolve;
+      }),
+    )
+    .mockResolvedValueOnce(status(true));
+  const earlier = refreshRemoteReceiverStatus();
+  await refreshRemoteReceiverStatus();
+  finish(status(false));
+  await earlier;
+  expect(getAppState().remoteReceiverStatus?.enabled).toBe(true);
+});
+
+it("suppresses polling throughout a pending stop and publishes its completion", async () => {
