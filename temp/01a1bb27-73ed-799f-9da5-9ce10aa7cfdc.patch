@@ -0,0 +1,40 @@
+import { createConversation } from "../actions/chat.actions";
+import { getAppState } from "../store";
+import { createId } from "./id.utils";
+
+// Shared by typed events in this renderer; a failed creation can be retried.
+let pendingCreation: Promise<string> | null = null;
+
+export function getOrCreateTypedPillConversation(
+  title: string,
+): Promise<string> {
+  const selected = getAppState().pillConversationId;
+  if (selected) return Promise.resolve(selected);
+  if (pendingCreation) return pendingCreation;
+
+  const operation = (async () => {
+    const now = new Date().toISOString();
+    const created = await createConversation(
+      { id: createId(), title, createdAt: now, updatedAt: now },
+      undefined,
+      {
+        isCurrent: () => getAppState().pillConversationId === null,
+        onRegister: (draft, conversation) => {
+          draft.pillConversationId = conversation.id;
+        },
+      },
+    );
+    if (!created) throw new Error("Pill conversation selection changed.");
+    return created.id;
+  })();
+  pendingCreation = operation;
+  void operation.then(
+    () => {
+      if (pendingCreation === operation) pendingCreation = null;
+    },
+    () => {
+      if (pendingCreation === operation) pendingCreation = null;
+    },
+  );
+  return operation;
+}
