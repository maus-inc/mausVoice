+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { verifyReleaseTag } from "./verify-release-tag.mjs";
+
+const git = (cwd, ...args) =>
+  execFileSync("git", args, {
+    cwd,
+    encoding: "utf8",
+    stdio: ["ignore", "pipe", "pipe"],
+  }).trim();
+const fixture = (run) => {
+  const root = mkdtempSync(join(tmpdir(), "release-tag-"));
+  try {
+    const remote = join(root, "remote.git");
+    const local = join(root, "local");
+    git(root, "init", "--bare", remote);
+    git(root, "init", local);
+    git(local, "config", "user.email", "test@example.test");
+    git(local, "config", "user.name", "Test");
+    git(local, "remote", "add", "origin", remote);
+    writeFileSync(join(local, "file"), "one");
+    git(local, "add", "file");
+    git(local, "commit", "-m", "first");
+    const first = git(local, "rev-parse", "HEAD");
+    writeFileSync(join(local, "file"), "two");
+    git(local, "commit", "-am", "second");
+    const second = git(local, "rev-parse", "HEAD");
+    run({ local, remote, first, second });
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+};
+
+describe("release tag preflight", () => {
+  it("allows a tag that does not exist", () =>
+    fixture(({ local, first }) => {
+      assert.equal(
+        verifyReleaseTag({ cwd: local, tag: "new-tag", expectedSha: first }),
+        "absent",
+      );
+    }));
+
+  it("checks lightweight and annotated tags by their peeled commit", () =>
+    fixture(({ local, first, second }) => {
+      git(local, "tag", "light", first);
+      git(local, "tag", "-a", "annotated", first, "-m", "tag");
+      git(local, "push", "origin", "refs/tags/light", "refs/tags/annotated");
+      for (const tag of ["light", "annotated"]) {
+        assert.equal(
+          verifyReleaseTag({ cwd: local, tag, expectedSha: first }),
+          "matched",
+        );
+        assert.throws(
+          () => verifyReleaseTag({ cwd: local, tag, expectedSha: second }),
+          /does not resolve/,
+        );
+      }
+    }));
+
+  it("fails closed if the remote cannot be inspected", () =>
+    fixture(({ local, first }) => {
+      git(
+        local,
+        "remote",
+        "set-url",
+        "origin",
+        join(local, "missing-repository"),
+      );
+      assert.throws(
+        () =>
+          verifyReleaseTag({ cwd: local, tag: "new-tag", expectedSha: first }),
+        /Cannot inspect/,
+      );
+    }));
+
+  it("rejects invalid tags and commit identifiers", () =>
+    fixture(({ local, first }) => {
+      for (const tag of ["", "-bad", "bad\nref", "a..b", "a*"]) {
+        assert.throws(
+          () => verifyReleaseTag({ cwd: local, tag, expectedSha: first }),
+          /Invalid release tag/,
+        );
+      }
+      assert.throws(
+        () =>
+          verifyReleaseTag({ cwd: local, tag: "valid", expectedSha: "main" }),
+        /Invalid dispatch commit/,
+      );
+    }));
+});
