+  const lines = [...found.values()].sort((p, q) => p.t - q.t)
+  const kept = []
+  for (const l of lines) {
+    if (kept.some((s) => s.id === l.parent && Math.abs(s.t - l.t) < 40 && s.k === l.k && Math.abs(s.d - l.d) < 0.6)) continue
