+
+  .fx-tab[data-on] .fx-tab__icon {
+    background: var(--ss-accent);
+  }
+
+  /* ---- The card that becomes the detail ---- */
+
+  /* Press and expansion have separate owners: Expand's inline clip transition
+     must not replace the card's transform feedback. */
+  .fx-press {
+    position: absolute;
+    inset: 0;
+    transition: transform 0.2s ease;
+    will-change: transform;
+  }
+
+  .fx-detail {
+    position: absolute;
+    inset: 0;
+    overflow: hidden;
