+/* Camera */
+
+@property --ss-feather {
+  syntax: '<length>';
+  inherits: false;
+  initial-value: 0px;
+}
+
+@layer stageshow {
+  /* The camera's frame: clips the zoomed scene and feathers its edges while
+     zoomed (the feather eases in and out with the move) */
+  .ss-camera-view {
+    position: absolute;
+    inset: 0;
+    overflow: clip;
+    mask-image:
+      linear-gradient(to right, transparent, #000 var(--ss-feather), #000 calc(100% - var(--ss-feather)), transparent),
+      linear-gradient(to bottom, transparent, #000 var(--ss-feather), #000 calc(100% - var(--ss-feather)), transparent);
+    mask-composite: intersect;
+  }
+
+  .ss-camera {
+    position: absolute;
+    inset: 0;
+    transform-origin: 0 0;
+  }
+}
diff --git a/.agents/skills/stageshow/kit/motion/Camera.tsx b/.agents/skills/stageshow/kit/motion/Camera.tsx
new file mode 100644
index 00000000..8eeff566
--- /dev/null
+++ b/.agents/skills/stageshow/kit/motion/Camera.tsx
@@ -0,0 +1,51 @@
+import { useLayoutEffect, useRef, useState, type ReactNode } from 'react'
+import { useReducedMotion } from '../reduced-motion'
+import type { Rect } from '../measure'
+import { css, type Bezier, type EaseName } from '../ease'
+import './Camera.css'
+
+/**
+ * Moves the view in on part of the scene and back out, pushing in on a
+ * detail. Wrap the scene in it and set `focus` to a rect in
+ * stage pixels, measured with `a.rect(name, { layout: true })` (the layout
+ * rect, so the zoom itself never feeds back in); null shows everything. The
+ * view never leaves the scene's edges. Keep the cursor still while the camera
+ * moves, or put it where it is going only once it has settled. The view is
+ * its own frame: zoomed in, its edges feather so the scene passes under a
+ * soft edge instead of running hard into the stage's (`feather`, in px).
+ * Everything inside moves with the zoom, and `a.rect()` of a target inside
+ * reports where it is on screen now; give the cursor's rest point in stage
+ * pixels, outside the Camera, or it lands somewhere else once zoomed.
+ * `ease` takes a named curve from kit/ease.ts ('house' for a video-paced move).
+ */
+export function Camera({ focus, pad = 32, max = 2, duration = 1100, feather = 28, ease: curve = 'camera', children, className }: { focus: Rect | null; pad?: number; max?: number; duration?: number; feather?: number; ease?: EaseName | Bezier; children: ReactNode; className?: string }) {
+  const ref = useRef<HTMLDivElement>(null)
+  const [size, setSize] = useState({ w: 0, h: 0 })
+  const reduced = useReducedMotion()
+  // Followed, not read once: a Stage switching to its compact design (or any
+  // resize) changes the frame the zoom is worked out in
+  useLayoutEffect(() => {
+    const p = ref.current?.parentElement?.parentElement
+    if (!p) return
+    const read = () => setSize((was) => (was.w === p.offsetWidth && was.h === p.offsetHeight ? was : { w: p.offsetWidth, h: p.offsetHeight }))
+    read()
+    const ro = new ResizeObserver(read)
+    ro.observe(p)
+    return () => ro.disconnect()
+  }, [])
+  let transform = 'none'
+  if (focus && size.w) {
+    const s = Math.max(1, Math.min(max, size.w / (focus.width + pad * 2), size.h / (focus.height + pad * 2)))
+    const tx = Math.min(0, Math.max(size.w - size.w * s, size.w / 2 - (focus.x + focus.width / 2) * s))
+    const ty = Math.min(0, Math.max(size.h - size.h * s, size.h / 2 - (focus.y + focus.height / 2) * s))
+    transform = `translate(${tx}px, ${ty}px) scale(${s})`
+  }
+  const ease = `${reduced ? 0 : duration}ms ${css(curve)}`
+  return (
+    <div className="ss-camera-view" data-zoomed={transform === 'none' ? undefined : true} data-focus={transform === 'none' || !focus ? undefined : `${focus.x},${focus.y},${focus.width},${focus.height}`} data-feather={feather} style={{ ['--ss-feather' as string]: `${transform === 'none' ? 0 : feather}px`, transition: `--ss-feather ${ease}` }}>
+      <div ref={ref} className={`ss-camera${className ? ` ${className}` : ''}`} style={{ transform, transition: `transform ${ease}` }}>
+        {children}
+      </div>
+    </div>
+  )
+}
diff --git a/.agents/skills/stageshow/kit/motion/Collapse.css b/.agents/skills/stageshow/kit/motion/Collapse.css
new file mode 100644
index 00000000..768938ab
--- /dev/null
+++ b/.agents/skills/stageshow/kit/motion/Collapse.css
@@ -0,0 +1,104 @@
+/* Collapse */
+
+@layer stageshow {
+  /* The space and the content move together, so there's never an empty band
+     where a row was or is about to be. Closing, the content dims fast (to a
+     third in the first 100ms, before the closing edge reaches it) and then
+     dissolves over the rest of the height's travel, so it is faint while
+     the edge passes and still there while the space closes: the fade and
+     the height overlap to the end and no empty box is shown. A fade that
+     finished before the height had moved left a blank band for about 100ms.
+     Opening, the content comes in as the edge passes it. No mask, so no
+     gradient wash. */
+  .ss-collapse {
+    display: grid;
+    grid-template-rows: 0fr;
+    opacity: 0;
+    transition: grid-template-rows 0.42s cubic-bezier(0.4, 0, 0.2, 1) 0.05s, opacity 0.42s cubic-bezier(0, 0.8, 0.5, 1);
+  }
+
+  .ss-collapse[data-open] {
+    grid-template-rows: 1fr;
+    opacity: 1;
+    transition: grid-template-rows 0.46s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.24s ease-out 0.15s;
+  }
+
+  /* solid: a surface unlike the ground opens and closes without fading
+     (a dark panel would pass through gray); only the height moves */
+  .ss-collapse[data-solid],
+  .ss-collapse[data-solid][data-open] {
+    opacity: 1;
+  }
+
+  .ss-collapse__inner {
+    min-height: 0;
+    overflow: clip;
+    overflow-clip-margin: 3px;
+  }
+
+  /* A clip reveal unfolds from the content's middle line: the space clips it
+     equally above and below, so a row's text (in its middle) is whole by about
+     half the height and can be seen early without ever looking sliced. Closing
+     folds back into that line. */
+  .ss-collapse[data-reveal='clip'] > .ss-collapse__inner {
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    /* Thin rows side by side: a margin would let their windows overlap */
+    overflow-clip-margin: 0;
+  }
+
+  /* Taller than a row (a comment, a card): it reveals from the top, and its
+     content comes in as the space finishes opening, so no line is seen cut.
+     Cards and messages read better with reveal="drop". */
+  .ss-collapse[data-reveal='clip'][data-tall] > .ss-collapse__inner {
+    justify-content: flex-start;
+  }
+
+  .ss-collapse[data-reveal='clip'][data-tall][data-open] {
+    transition: grid-template-rows 0.46s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.24s ease-out 0.3s;
+  }
+
+  /* Settled open, nothing clips: a toolbar or popover can hang off a row */
+  .ss-collapse[data-open]:not([data-moving]) > .ss-collapse__inner {
+    overflow: visible;
+  }
+
+  /* drop: nothing clips; the content arrives whole into the opening space */
+  .ss-collapse[data-reveal='drop'] > .ss-collapse__inner {
+    overflow: visible;
+  }
+
+  /* The glide is a transform on a layer the content keeps for good. Moved by
+     layout (top), text steps whole pixels while its box glides, so a count in
+     a pill hops inside it; and text that ends a transform without a layer of
+     its own is redrawn snapped and hops as it lands. On a lasting layer it
+     moves as one picture and rests drawn exactly as it moved. It sits on a
+     wrapper of the kit's own, so a transition set on the content (a card
+     fading on resolve) can't replace it and make the glide snap. */
+  .ss-collapse__glide {
+    display: grid;
+    min-width: 0;
+  }
+
+  .ss-collapse[data-reveal='drop'] > .ss-collapse__inner > .ss-collapse__glide {
+    transform: translateY(-10px);
+    will-change: transform;
+    transition: transform 0.3s ease;
+  }
+
+  .ss-collapse[data-reveal='drop'][data-from='below'] > .ss-collapse__inner > .ss-collapse__glide {
+    transform: translateY(10px);
+  }
+
+  .ss-collapse[data-reveal='drop'][data-open] > .ss-collapse__inner > .ss-collapse__glide {
+    transform: none;
+    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.2s;
+  }
+
+  /* Drop content is whole and unclipped, so it waits for most of its space:
+     shown early, it would hang over whatever sits below the opening gap */
+  .ss-collapse[data-reveal='drop'][data-open] {
+    transition: grid-template-rows 0.5s cubic-bezier(0.45, 0, 0.2, 1), opacity 0.3s ease 0.24s;
+  }
+}
diff --git a/.agents/skills/stageshow/kit/motion/Collapse.tsx b/.agents/skills/stageshow/kit/motion/Collapse.tsx
new file mode 100644
index 00000000..df209366
--- /dev/null
+++ b/.agents/skills/stageshow/kit/motion/Collapse.tsx
@@ -0,0 +1,83 @@
+import { useLayoutEffect, useRef, useState, type HTMLAttributes, type ReactNode } from 'react'
+import './Collapse.css'
+
+/**
+ * Opens and closes its content's height, so what comes after moves with it:
+ * a row leaving a list, a log panel opening under a status. Closing dims the
+ * content fast and dissolves it over the whole of the height's travel, so a
+ * row is faint by the time the edge reaches it and the space is never seen
+ * empty; opening brings the content with its height. Children can have any height or
+ * padding. The inner box is a deliberate crop (film.mjs skips it) and clips
+ * 3px wide, so rings and shadows on the content aren't shaved.
+ *
+ * Closing, it holds its children as they were open until the height has
+ * settled, so a state reset in the same beat (a thread's rows going back to
+ * their empty draft as the thread folds) never shows mid-fold. The flip side:
+ * a change made in the same set as `open: false` won't show either; make it
+ * in one set and close in the next.
+ */
+export function Collapse({ open, reveal = 'clip', from = 'above', solid = false, children, className, ...rest }: HTMLAttributes<HTMLDivElement> & {
+  open: boolean
+  /**
+   * clip: the opening space uncovers the content, for rows and text. The
+   * content is faint while the edge passes it, so nothing is ever seen sliced.
+   * drop: the space opens and the content arrives whole, gliding into place.
+   * For cards and messages: a notification, a toast, a chat message.
+   */
+  reveal?: 'clip' | 'drop'
+  /** Where drop content comes from: 'above' (a notification), or 'below' (a chat message landing at the bottom of a feed). */
+  from?: 'above' | 'below'
+  /**
+   * Opaque throughout: the height opens and closes over the content without
+   * fading it. For a surface unlike the ground (a dark log panel on a light
+   * window), which would otherwise pass through gray. Its content is there
+   * from the first frame: open it with what it shows, never empty.
+   */
+  solid?: boolean
+  children: ReactNode
+}) {
+  // Marked moving from the frame open changes until the height settles
+  const [moving, setMoving] = useState(false)
+  // Taller than a row: unfolding from the middle would cut its first line
+  // while it's already visible, so it reveals from the top and fades in late
+  const [tall, setTall] = useState(false)
+  const inner = useRef<HTMLDivElement>(null)
+  const first = useRef(true)
+  // What it showed while open, held through the close (decided while
+  // rendering, so the first closing frame already shows it)
+  const held = useRef<ReactNode>(children)
+  const [released, setReleased] = useState(true)
+  if (open) held.current = children
+  useLayoutEffect(() => {
+    const h = inner.current?.scrollHeight ?? 0
+    if (h) setTall(h > 44)
+    if (first.current) return void (first.current = false)
+    setMoving(true)
+    if (!open) setReleased(false)
+    // No transitionend without a transition (reduced motion): never leave it moving
+    const t = setTimeout(() => { setMoving(false); setReleased(true) }, 900)
+    return () => clearTimeout(t)
+  }, [open])
+  return (
+    <div
+      {...rest}
+      className={`ss-collapse${className ? ` ${className}` : ''}`}
+      data-open={open || undefined}
+      data-reveal={reveal}
+      data-solid={solid || undefined}
+      data-from={reveal === 'drop' ? from : undefined}
+      data-moving={moving || undefined}
+      data-tall={tall || undefined}
+      onTransitionEnd={(e) => {
+        if (e.target === e.currentTarget && e.propertyName === 'grid-template-rows') { setMoving(false); setReleased(true) }
+        rest.onTransitionEnd?.(e)
+      }}
+    >
+      <div ref={inner} className="ss-collapse__inner" data-crop={reveal === 'clip' || undefined}>
+        {reveal === 'drop'
+          ? <div className="ss-collapse__glide">{open || released ? children : held.current}</div>
+          : open || released ? children : held.current}
+      </div>
+    </div>
+  )
+}
diff --git a/.agents/skills/stageshow/kit/motion/Connector.css b/.agents/skills/stageshow/kit/motion/Connector.css
