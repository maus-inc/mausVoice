+.aic .ss-stage {
+  overflow: hidden;
+  background: var(--ss-well);
+}
+
+/* Pinned top and sides, off the bottom just under the composer */
+.aic-win {
+  position: absolute;
+  top: 28px;
+  left: 40px;
+  width: 560px;
+  height: 540px;
+}
+
+.aic-body {
+  display: grid;
+  grid-template-rows: 1fr auto;
+  height: 100%;
+  padding: 16px 20px 56px;
+  background: var(--ss-surface);
+}
+
+/* Anchored at the bottom over the composer; the earlier turn goes up out of
+   the window as the cards open */
+.aic-thread {
+  display: flex;
+  flex-direction: column;
+  justify-content: flex-end;
+  gap: 14px;
+  min-height: 0;
+  padding-bottom: 20px;
+  overflow: hidden;
+  /* The earlier turns fade as they go up out of the window, never sliced
+     by its edge */
+  mask-image: linear-gradient(to bottom, transparent, #000 24px);
+}
+
+/* Everything in the thread rides up as the cards open: each keeps a layer
+   of its own, so its words don't step on whole pixels as it moves */
