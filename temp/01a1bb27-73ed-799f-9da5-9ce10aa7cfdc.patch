+fn polldir(o: Option<Direction>) -> c_short {
+    match o {
+        None => poll::Flags::IN | poll::Flags::OUT,
+        Some(Direction::Playback) => poll::Flags::OUT,
+        Some(Direction::Capture) => poll::Flags::IN,
+    }.bits()
