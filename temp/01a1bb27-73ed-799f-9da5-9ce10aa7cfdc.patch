diff --git a/scripts/ci/skill-hash.mjs b/scripts/ci/skill-hash.mjs
new file mode 100644
index 00000000..fdd1833a
--- /dev/null
+++ b/scripts/ci/skill-hash.mjs
@@ -0,0 +1,45 @@
+import { createHash } from "node:crypto";
+import { lstatSync, readdirSync, readFileSync } from "node:fs";
+import { join, relative, sep } from "node:path";
+
+function collectFiles(root, dir, out, paths) {
+  for (const entry of readdirSync(dir, { withFileTypes: true })) {
+    const full = join(dir, entry.name);
+    if (entry.isDirectory()) {
+      collectFiles(root, full, out, paths);
+    } else if (entry.isFile()) {
+      out.push({
+        relativePath: paths.relative(root, full).split(paths.sep).join("/"),
+        content: readFileSync(full),
+      });
+    } else {
+      // The upstream hash format has no representation for links or special
+      // files. Ignoring them would let extra content pass the integrity check.
+      throw new Error(`Unsupported entry in locked skill: ${full}`);
+    }
+  }
+}
+
+export function listSkillFiles(skillDir, paths = { relative, sep }) {
+  const root = lstatSync(skillDir);
+  if (!root.isDirectory() || root.isSymbolicLink()) {
+    throw new Error(`Unsupported locked skill root: ${skillDir}`);
+  }
+  const files = [];
+  collectFiles(skillDir, skillDir, files, paths);
+  files.sort((a, b) => a.relativePath.localeCompare(b.relativePath));
+  return files;
+}
+
+export function hashSkillFiles(files) {
+  const hash = createHash("sha256");
+  for (const file of files) {
+    hash.update(file.relativePath);
+    hash.update(file.content);
+  }
+  return hash.digest("hex");
+}
+
+export function computeSkillFolderHash(skillDir, paths = { relative, sep }) {
+  return hashSkillFiles(listSkillFiles(skillDir, paths));
+}
