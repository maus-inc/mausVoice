+.an-stream-route[data-active] .an-stream-reveal { stroke-dashoffset: 0; }
+.an-stream-underlay { stroke: #d8e3e5; stroke-width: 1; }
+.an-stream-phase { stroke: #0d9488; stroke-width: 1.5; stroke-dasharray: .1 3.9; stroke-linecap: round; opacity: 0; transition: opacity 250ms ease; }
+.an-stream-arrow { stroke: #0d9488; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; opacity: 0; transition: opacity 250ms ease; }
+.an-stream-route[data-active] .an-stream-phase { opacity: 1; animation: an-stream-phase 1800ms linear infinite; }
+.an-stream-route[data-arrived] .an-stream-arrow { opacity: 1; }
+.an-stream-rate { position: absolute; font-size: 11px; line-height: 16px; color: #397767; opacity: 0; transition: opacity 250ms ease; white-space: nowrap; }
+.an-stream-rate[data-visible] { opacity: 1; }
+.an-stream-rest { position: absolute; width: 20px; height: 20px; }
+@keyframes an-stream-phase { to { stroke-dashoffset: -24; } }
+@media (prefers-reduced-motion: reduce) {
+  .an-gallery *, .an-gallery *::before, .an-gallery *::after { transition-duration: 0s !important; transition-delay: 0s !important; }
+  .an-stream-route[data-active] .an-stream-phase { animation: none; }
+}
+
+/* At the narrowest canvas, reserve space for the whole measurement, not
+   just its card. The label interrupts its guide instead of crowding the edge. */
+.an-measure--narrow .an-height-guide { left: calc(100% + 12px); }
+.an-measure--narrow .an-height-guide > span { left: 3px; padding: 0 4px; background: #fafbfd; transform: translate(-50%, -50%); }
+
+.an-composed-rest { position: absolute; width: 20px; height: 20px; }
