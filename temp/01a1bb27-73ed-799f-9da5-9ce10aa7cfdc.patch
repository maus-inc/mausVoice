+
+.ln-workspace__tile,
+.ln-team__tile {
+  display: grid;
+  flex-shrink: 0;
+  place-items: center;
+  width: 18px;
+  height: 18px;
+  border-radius: 5px;
+  background: var(--ln-tile);
+  color: var(--ln-tile-text);
+  font-size: 10.5px;
+  font-weight: 600;
+  line-height: 1;
+}
+
+/* Team icons lost their colored backgrounds in the refresh */
+.ln-team__tile {
+  width: 16px;
+  height: 16px;
+  border-radius: 4px;
+  background: var(--ln-team-tile);
+  color: var(--ln-team-text);
