diff --git a/apps/desktop/src/actions/openrouter-providers.concurrent.test.ts b/apps/desktop/src/actions/openrouter-providers.concurrent.test.ts
new file mode 100644
index 00000000..5498286f
--- /dev/null
+++ b/apps/desktop/src/actions/openrouter-providers.concurrent.test.ts
@@ -0,0 +1,90 @@
+import { beforeEach, expect, it, vi } from "vitest";
+import { INITIAL_APP_STATE } from "../state/app.state";
+import { getAppState, setAppState } from "../store";
+import {
+  beginLocalDataClear,
+  LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY,
+} from "../utils/local-data-write-gate";
+
+const fetchProviders = vi.hoisted(() => vi.fn());
+vi.mock("@maus-inc/voice-ai", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@maus-inc/voice-ai")>()),
+  openrouterFetchProviders: fetchProviders,
+}));
+import { loadOpenRouterProviders } from "./openrouter.actions";
+
+const deferred = <T>() => {
+  let resolve!: (value: T) => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<T>((r, j) => {
+    resolve = r;
+    reject = j;
+  });
+  return { promise, resolve, reject };
+};
+beforeEach(() => {
+  setAppState(structuredClone(INITIAL_APP_STATE), true);
+  fetchProviders.mockReset();
+});
+
+it("does not let an older error replace the latest provider list", async () => {
+  const first = deferred<{ providers: { name: string; slug: string }[] }>();
+  fetchProviders
+    .mockReturnValueOnce(first.promise)
+    .mockResolvedValueOnce({ providers: [{ name: "New", slug: "new" }] });
+  const old = loadOpenRouterProviders();
+  await loadOpenRouterProviders();
+  first.reject(new Error("stale"));
+  await old;
+  expect(getAppState().settings.openRouterProvidersStatus).toBe("success");
+  expect(getAppState().settings.openRouterProviders).toEqual([
+    { name: "New", slug: "new" },
+  ]);
+});
+
+it("does not let an older success replace the latest provider list", async () => {
+  const first = deferred<{ providers: { name: string; slug: string }[] }>();
+  fetchProviders.mockReturnValueOnce(first.promise).mockResolvedValueOnce({
+    providers: [{ name: "New", slug: "new" }],
+  });
+  const old = loadOpenRouterProviders();
+  await loadOpenRouterProviders();
+  first.resolve({ providers: [{ name: "Old", slug: "old" }] });
+  await old;
+  expect(getAppState().settings.openRouterProviders).toEqual([
+    { name: "New", slug: "new" },
+  ]);
+});
+
+it("does not publish a provider list after a local clear", async () => {
+  const pending = deferred<{ providers: { name: string; slug: string }[] }>();
+  fetchProviders.mockReturnValueOnce(pending.promise);
+  const loading = loadOpenRouterProviders();
+  const release = await beginLocalDataClear();
+  localStorage.removeItem(LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY);
+  release();
+  pending.resolve({ providers: [{ name: "Old", slug: "old" }] });
+  await loading;
+  expect(getAppState().settings.openRouterProviders).toEqual([]);
+  expect(getAppState().settings.openRouterProvidersStatus).not.toBe("success");
+});
+
+it("does not start during a pending clear or log raw errors", async () => {
+  localStorage.setItem(LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY, "pending");
+  try {
+    await loadOpenRouterProviders();
+    expect(fetchProviders).not.toHaveBeenCalled();
+  } finally {
+    localStorage.removeItem(LOCAL_DATA_CLEAR_PENDING_STORAGE_KEY);
+  }
+  const log = vi.spyOn(console, "error").mockImplementation(() => {});
+  try {
+    fetchProviders.mockRejectedValueOnce(new Error("private response"));
+    await loadOpenRouterProviders();
+    expect(log).toHaveBeenCalledWith("Failed to load OpenRouter providers.");
+    expect(JSON.stringify(log.mock.calls)).not.toContain("private response");
+    expect(getAppState().settings.openRouterProvidersStatus).toBe("error");
+  } finally {
+    log.mockRestore();
+  }
+});
