--- /dev/null
+++ b/patches/coreaudio-rs-0.11.3/src/audio_unit/macos_device_name.rs
@@ -0,0 +1,77 @@
+//! CoreAudio device-name property reads.
+use super::macos_property_limits::MAX_PROPERTY_BYTES;
+use super::{listener_sys as sys, name_cf as cf, ListenerError as Error};
+use cf::{kCFStringEncodingUTF8, CFStringRef};
+use std::{convert::TryFrom, ffi::CStr, mem, ptr};
+use sys::{
+    kAudioDevicePropertyDeviceNameCFString, kAudioDevicePropertyScopeOutput,
+    kAudioObjectPropertyElementMaster, AudioDeviceID, AudioObjectPropertyAddress,
+};
+
+struct OwnedName(CFStringRef);
+impl Drop for OwnedName {
+    fn drop(&mut self) {
+        unsafe { cf::CFRelease(self.0.cast()) }
+    }
+}
+
+/// Get the name of a device.
+pub fn get_device_name(device_id: AudioDeviceID) -> Result<String, Error> {
+    let address = AudioObjectPropertyAddress {
+        mSelector: kAudioDevicePropertyDeviceNameCFString,
+        mScope: kAudioDevicePropertyScopeOutput,
+        mElement: kAudioObjectPropertyElementMaster,
+    };
+    let mut name: CFStringRef = ptr::null();
+    let mut size = mem::size_of::<CFStringRef>() as u32;
+    let status = unsafe {
+        sys::AudioObjectGetPropertyData(
+            device_id,
+            &address,
+            0,
+            ptr::null(),
+            &mut size,
+            (&mut name as *mut CFStringRef).cast(),
+        )
+    };
+    Error::from_os_status(status)?;
+    if size != mem::size_of::<CFStringRef>() as u32 || name.is_null() {
+        return Err(Error::Unspecified);
+    }
+    let _owned = OwnedName(name);
+    let length = unsafe { cf::CFStringGetLength(name) };
+    if length < 0 {
+        return Err(Error::Unspecified);
+    }
+    let max = unsafe { cf::CFStringGetMaximumSizeForEncoding(length, kCFStringEncodingUTF8) };
+    let capacity = usize::try_from(max)
+        .ok()
+        .and_then(|n| n.checked_add(1))
+        .filter(|&n| n <= MAX_PROPERTY_BYTES)
+        .ok_or(Error::Unspecified)?;
+    let direct = unsafe { cf::CFStringGetCStringPtr(name, kCFStringEncodingUTF8) };
+    if !direct.is_null() {
+        return Ok(unsafe { CStr::from_ptr(direct) }
+            .to_string_lossy()
+            .into_owned());
+    }
+    let cf_capacity = isize::try_from(capacity).map_err(|_| Error::Unspecified)?;
+    let mut buffer = Vec::<u8>::new();
+    buffer
+        .try_reserve_exact(capacity)
+        .map_err(|_| Error::Unspecified)?;
+    buffer.resize(capacity, 0);
+    let converted = unsafe {
+        cf::CFStringGetCString(
+            name,
+            buffer.as_mut_ptr().cast(),
+            cf_capacity,
+            kCFStringEncodingUTF8,
+        )
+    };
+    if converted == 0 {
+        return Err(Error::Unspecified);
+    }
+    let value = CStr::from_bytes_until_nul(&buffer).map_err(|_| Error::Unspecified)?;
+    Ok(value.to_string_lossy().into_owned())
+}
diff --git a/patches/coreaudio-rs-0.11.3/src/audio_unit/macos_device_scope.rs b/patches/coreaudio-rs-0.11.3/src/audio_unit/macos_device_scope.rs
new file mode 100644
index 00000000..7fc021f2
--- /dev/null
+++ b/patches/coreaudio-rs-0.11.3/src/audio_unit/macos_device_scope.rs
@@ -0,0 +1,89 @@
+//! Bounded CoreAudio stream-configuration reads.
+use super::macos_property_limits::MAX_PROPERTY_BYTES;
+use super::{listener_sys as sys, ListenerError as Error, Scope};
+use std::{mem, ptr};
+use sys::{
+    kAudioDevicePropertyStreamConfiguration, kAudioObjectPropertyElementWildcard,
+    kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyScopeInput,
+    kAudioObjectPropertyScopeOutput, AudioBuffer, AudioBufferList, AudioDeviceID,
+    AudioObjectPropertyAddress, AudioObjectPropertyScope,
+};
+
+/// Does this device support input/output on the requested scope?
+pub fn get_audio_device_supports_scope(
+    device_id: AudioDeviceID,
+    scope: Scope,
+) -> Result<bool, Error> {
+    let dev_scope: AudioObjectPropertyScope = match scope {
+        Scope::Input => kAudioObjectPropertyScopeInput,
+        Scope::Output => kAudioObjectPropertyScopeOutput,
+        _ => kAudioObjectPropertyScopeGlobal,
+    };
+    let address = AudioObjectPropertyAddress {
+        mSelector: kAudioDevicePropertyStreamConfiguration,
+        mScope: dev_scope,
+        mElement: kAudioObjectPropertyElementWildcard,
+    };
+    let mut size = 0_u32;
+    let status = unsafe {
+        sys::AudioObjectGetPropertyDataSize(device_id, &address, 0, ptr::null(), &mut size)
+    };
+    Error::from_os_status(status)?;
+
+    // `AudioBufferList` has a variable-length trailing array. Allocate initialized
+    // native-word storage, and ensure that its alignment satisfies the ABI before
+    // handing it to CoreAudio. Do not construct Rust references to the list or to
+    // the flexible array: parse only the checked integer fields from the bytes.
+    if mem::align_of::<usize>() < mem::align_of::<AudioBufferList>() {
+        return Err(Error::Unspecified);
+    }
+    let header = mem::offset_of!(AudioBufferList, mBuffers);
+    let capacity = size as usize;
+    if capacity < header || capacity > MAX_PROPERTY_BYTES {
+        return Err(Error::Unspecified);
+    }
+    let word_size = mem::size_of::<usize>();
+    let words = capacity
+        .checked_add(word_size - 1)
+        .ok_or(Error::Unspecified)?
+        / word_size;
+    let mut storage = Vec::<usize>::new();
+    storage
+        .try_reserve_exact(words)
+        .map_err(|_| Error::Unspecified)?;
+    storage.resize(words, 0);
+    let status = unsafe {
+        sys::AudioObjectGetPropertyData(
+            device_id,
+            &address,
+            0,
+            ptr::null(),
+            &mut size,
+            storage.as_mut_ptr().cast(),
+        )
+    };
+    Error::from_os_status(status)?;
+    let returned = size as usize;
+    if returned > capacity || returned < header {
+        return Err(Error::Unspecified);
+    }
+    let bytes = storage.as_ptr().cast::<u8>();
+    let count_offset = mem::offset_of!(AudioBufferList, mNumberBuffers);
+    let count = unsafe { ptr::read_unaligned(bytes.add(count_offset).cast::<u32>()) } as usize;
+    let required = count
+        .checked_mul(mem::size_of::<AudioBuffer>())
+        .and_then(|n| header.checked_add(n))
+        .ok_or(Error::Unspecified)?;
+    if required > returned {
+        return Err(Error::Unspecified);
+    }
+    let channel_offset = mem::offset_of!(AudioBuffer, mNumberChannels);
+    for index in 0..count {
+        let offset = header + index * mem::size_of::<AudioBuffer>() + channel_offset;
+        let channels = unsafe { ptr::read_unaligned(bytes.add(offset).cast::<u32>()) };
+        if channels > 0 {
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
diff --git a/patches/coreaudio-rs-0.11.3/src/audio_unit/macos_devices.rs b/patches/coreaudio-rs-0.11.3/src/audio_unit/macos_devices.rs
new file mode 100644
index 00000000..cf691f8e
--- /dev/null
+++ b/patches/coreaudio-rs-0.11.3/src/audio_unit/macos_devices.rs
@@ -0,0 +1,113 @@
+//! Device ID queries with CoreAudio-owned output lengths.
+use super::macos_device_scope::get_audio_device_supports_scope;
+use super::macos_property_limits::MAX_PROPERTY_BYTES;
+use super::{listener_sys as sys, ListenerError as Error, Scope};
+use std::mem;
+use std::ptr::null;
+use sys::{
+    kAudioHardwareNoError, kAudioHardwarePropertyDefaultInputDevice,
+    kAudioHardwarePropertyDefaultOutputDevice, kAudioHardwarePropertyDevices,
+    kAudioObjectPropertyElementMaster, kAudioObjectPropertyScopeGlobal, kAudioObjectSystemObject,
+    AudioDeviceID, AudioObjectPropertyAddress,
+};
+
+/// Get the default input or output device identifier.
+pub fn get_default_device_id(input: bool) -> Option<AudioDeviceID> {
+    let selector = if input {
+        kAudioHardwarePropertyDefaultInputDevice
+    } else {
+        kAudioHardwarePropertyDefaultOutputDevice
+    };
+    let address = AudioObjectPropertyAddress {
+        mSelector: selector,
+        mScope: kAudioObjectPropertyScopeGlobal,
+        mElement: kAudioObjectPropertyElementMaster,
+    };
+    let mut id: AudioDeviceID = 0;
+    let mut size = mem::size_of::<AudioDeviceID>() as u32;
+    let status = unsafe {
+        sys::AudioObjectGetPropertyData(
+            kAudioObjectSystemObject,
+            &address,
+            0,
+            null(),
+            &mut size,
+            &mut id as *mut _ as *mut _,
+        )
+    };
+    if status != kAudioHardwareNoError as i32 || size != mem::size_of::<AudioDeviceID>() as u32 {
+        return None;
+    }
+    Some(id)
+}
+
+/// List device identifiers, filtering input or output scopes by device capability.
+/// Other scopes return the global list, as before.
+pub fn get_audio_device_ids_for_scope(scope: Scope) -> Result<Vec<AudioDeviceID>, Error> {
+    // The system object's device-list property is global. Input/output are
+    // device scopes, not scopes of the system object's enumeration property.
+    let address = AudioObjectPropertyAddress {
+        mSelector: kAudioHardwarePropertyDevices,
+        mScope: kAudioObjectPropertyScopeGlobal,
+        mElement: kAudioObjectPropertyElementMaster,
+    };
+    let mut size = 0_u32;
+    let status = unsafe {
+        sys::AudioObjectGetPropertyDataSize(
+            kAudioObjectSystemObject,
+            &address,
+            0,
+            null(),
+            &mut size,
+        )
+    };
+    if status != kAudioHardwareNoError as i32 {
+        return Err(Error::Unknown(status));
+    }
+    let item_size = mem::size_of::<AudioDeviceID>() as u32;
+    if size as usize > MAX_PROPERTY_BYTES || size % item_size != 0 {
+        return Err(Error::Unspecified);
+    }
+    if size == 0 {
+        return Ok(Vec::new());
+    }
+    let capacity = size;
+    let count = (size / item_size) as usize;
+    let mut devices: Vec<AudioDeviceID> = Vec::new();
+    devices
+        .try_reserve_exact(count)
+        .map_err(|_| Error::Unspecified)?;
+    devices.resize(count, 0);
+    let status = unsafe {
+        sys::AudioObjectGetPropertyData(
+            kAudioObjectSystemObject,
+            &address,
+            0,
+            null(),
+            &mut size,
+            devices.as_mut_ptr().cast(),
+        )
+    };
+    if status != kAudioHardwareNoError as i32 {
+        return Err(Error::Unknown(status));
+    }
+    if size > capacity || size % item_size != 0 {
+        return Err(Error::Unspecified);
+    }
+    devices.truncate((size / item_size) as usize);
+    if matches!(scope, Scope::Input | Scope::Output) {
+        let mut scoped = Vec::new();
+        for device in devices {
+            if get_audio_device_supports_scope(device, scope)? {
+                scoped.push(device);
+            }
+        }
+        return Ok(scoped);
+    }
+    Ok(devices)
+}
+
+/// List all audio device identifiers.
+pub fn get_audio_device_ids() -> Result<Vec<AudioDeviceID>, Error> {
+    get_audio_device_ids_for_scope(Scope::Global)
+}
