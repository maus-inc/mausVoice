+import { beforeEach, expect, it } from "vitest";
+import { INITIAL_APP_STATE } from "../state/app.state";
+import { getAppState, setAppState } from "../store";
+import { beginLocalDataWrite } from "../utils/local-data-write-gate";
+import { publishOptimisticHotkey } from "./hotkey-state.actions";
+
+beforeEach(() => setAppState(structuredClone(INITIAL_APP_STATE), true));
+
+it("publishes and updates a shortcut once, and refuses a released lease", () => {
+  const release = beginLocalDataWrite();
+  if (!release) throw new Error("Expected a write lease");
+  const first = { id: "shortcut", actionName: "dictate", keys: ["A"] };
+  try {
+    publishOptimisticHotkey(first, release.lease);
+    publishOptimisticHotkey({ ...first, keys: ["B"] }, release.lease);
+    expect(
+      getAppState().settings.hotkeyIds.filter((id) => id === first.id),
+    ).toEqual([first.id]);
+    expect(getAppState().hotkeyById[first.id].keys).toEqual(["B"]);
+    expect(getAppState().settings.hotkeysStatus).toBe("success");
+  } finally {
+    release();
+  }
+  expect(() => publishOptimisticHotkey(first, release.lease)).toThrow(
+    "lease is no longer active",
+  );
+  expect(getAppState().hotkeyById[first.id].keys).toEqual(["B"]);
+});
