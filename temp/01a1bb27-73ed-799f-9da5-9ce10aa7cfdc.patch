+const toneMutations = createAsyncMutationTracker();
+const toneWrites = new Map<string, Promise<void>>();
+const pendingToneDeletes = new Map<string, Promise<void>>();
+
+const enqueueToneWrite = <T>(
+  id: string,
+  operation: (lease: LocalDataWriteLease) => Promise<T>,
+): Promise<T> =>
+  withLocalDataWrite((lease) => {
+    const previous = toneWrites.get(id) ?? Promise.resolve();
+    const result = toneMutations.track(() =>
+      previous.then(() => operation(lease)),
+    );
+    const settled = result.then(
+      () => undefined,
+      () => undefined,
+    );
+    toneWrites.set(id, settled);
+    void settled.then(() => {
+      if (toneWrites.get(id) === settled) toneWrites.delete(id);
+    });
+    return result;
   });
+
+let toneLoadRevision = 0;
+
+export const loadTones = async (): Promise<void> => {
+  const generation = getLocalDataClearGeneration();
+  const request = ++toneLoadRevision;
+  const isCurrent = () =>
+    generation === getLocalDataClearGeneration() &&
+    !isLocalDataClearRequested() &&
+    request === toneLoadRevision;
+  while (isCurrent()) {
+    const beforeWait = toneMutations.revision();
+    await toneMutations.wait();
+    if (!isCurrent()) return;
+    const revision = toneMutations.revision();
+    if (revision !== beforeWait) continue;
+    const tones = await getToneRepo().listTones();
+    if (!isCurrent()) return;
+    if (revision !== toneMutations.revision()) continue;
+    produceAppState((draft) => {
+      registerTones(draft, tones);
+    });
+    return;
+  }
