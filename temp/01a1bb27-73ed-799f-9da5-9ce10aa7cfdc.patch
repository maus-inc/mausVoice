+
+  /* ---- List ---- */
+
+  .fx-list {
+    position: absolute;
+    inset: 0;
+    background: #f2f2f7;
+    /* Recedes by dimming only: a scale would land its text with a hop */
+    transition: opacity 0.6s ease;
