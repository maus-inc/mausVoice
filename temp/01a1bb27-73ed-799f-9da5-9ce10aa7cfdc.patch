@@ -0,0 +1,534 @@
+/* All rules belong to this example, including its responsive variants. */
+.staggered-bento {
+  /* Wayline's features section: a staggered pair on white. Everything nests
+     under &. Two columns of rounded tiles on a gap, tall and
+     short alternating so the rows never line up across the columns. Each
+     picture is its own Stage at 1:1, pinned to its tile's bottom. */
+    --pad: 30px;
+    --gap: 18px;
+    --tile: #f5f5f7;
+    --ink: #1d1d1f;
+    --ink-2: #6e6e73;
+    --accent: #f2643b;
+    --short: 310px;
+    --tall: 518px;
+    container-type: inline-size;
+    /* No padding of its own: on a page, the tiles span the content column */
+    box-sizing: border-box;
+    background: #fff;
+    font-family: var(--sg-font, inherit);
+    -webkit-font-smoothing: antialiased;
+
+  & .sg-grid {
+    display: grid;
+    gap: var(--gap);
+    max-width: 984px;
+    margin: 0 auto;
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  /* Narrow: one column, the tiles in reading order, hero first */
+  & .sg-col {
+    display: contents;
+  }
+
+  & .sg-tile--coast { order: 1; height: 460px; }
+  & .sg-tile--private { order: 2; height: 230px; }
+  & .sg-tile--stat { order: 3; height: 250px; }
+  & .sg-tile--voice { order: 4; height: 310px; }
+  & .sg-tile--book { order: 5; height: 300px; }
+  & .sg-tile--day { order: 6; height: 500px; }
+
+  /* Two columns: tall, short, short on the left; short, short, tall on the right */
+  @container (min-width: 600px) {
+    & .sg-grid {
+      grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+
+    & .sg-col {
+      display: flex;
+      flex-direction: column;
+      gap: var(--gap);
+    }
+
+    & .sg-tile { height: var(--short); }
+    & .sg-tile--coast,
+    & .sg-tile--day { height: var(--tall); }
+  }
+
+  @container (min-width: 900px) {
+    & .sg-grid {
+      --pad: 36px;
+      --gap: 20px;
+      --short: 320px;
+      --tall: 560px;
+    }
+  }
+
+  @container (max-width: 599px) {
+    & .sg-grid {
+      --pad: 26px;
+    }
+  }
+
+  /* ---- The tile: one frame for all six ---- */
+
+  & .sg-tile {
+    position: relative;
+    overflow: hidden;
+    border-radius: 28px;
+    background: var(--tile);
+  }
+
+  & .sg-copy {
+    position: relative;
+    z-index: 1;
+    max-width: 380px;
+    margin: 0;
+    padding: 30px var(--pad) 0;
+    font-size: 19px;
+    line-height: 26px;
+    letter-spacing: -0.016em;
+    font-weight: 500;
+    color: var(--ink-2);
+    text-wrap: pretty;
+  }
+
+  & .sg-copy b {
+    font-weight: 600;
+    color: var(--ink);
+  }
+
+  /* Over the photo's sky */
+  & .sg-tile[data-photo] .sg-copy {
+    color: rgba(255, 255, 255, 0.72);
+  }
+
+  & .sg-tile[data-photo] .sg-copy b {
+    color: #fff;
+  }
+
+  /* ---- Pictures: pinned to the tile's bottom ---- */
+
+  & .sg-picture {
+    position: absolute;
+    bottom: 0;
+  }
+
+  & .sg-picture--coast {
+    left: 50%;
+    width: 600px;
+    margin-left: -300px;
+  }
+
+  & .sg-picture--small,
+  & .sg-picture--phone {
+    left: 0;
+    width: 100%;
+  }
+
+  & .sg-stage .ss-stage {
+    overflow: hidden;
+    background: transparent;
+  }
+
+  /* ---- Coast (the still hero picture) ---- */
+
+  & .sg-art {
+    position: absolute;
+    inset: 0;
+  }
+
+  & .sg-art__svg {
+    position: absolute;
+    inset: 0;
+    display: block;
+  }
+
+  /* One column: the copy wraps to more lines, so the drawn takes sit lower
+     (their bottoms are open water and more tiles, which can go) */
+  @container (max-width: 599px) {
+    & .sg-picture--coast {
+      bottom: -40px;
+    }
+  }
+
+  /* The tile's ground matches the picture's top, so nothing shows round it */
+  & .sg-tile--coast:has([data-art='azulejo']) { background: #1f3f8f; }
+
+  /* ---- Private (statement) ---- */
+
+  & .sg-statement {
+    display: flex;
+    flex-direction: column;
+    justify-content: space-between;
+    box-sizing: border-box;
+    height: 100%;
+    padding: 30px var(--pad) 32px;
+  }
+
+  & .sg-lock {
+    color: #0a7cff;
+  }
+
+  & .sg-statement__text {
+    max-width: 340px;
+    margin: 0;
+    font-size: 30px;
+    line-height: 34px;
+    letter-spacing: -0.024em;
+    font-weight: 600;
