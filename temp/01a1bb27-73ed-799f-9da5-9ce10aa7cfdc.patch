@@ -0,0 +1,35 @@
+/* Card */
+
+@layer stageshow {
+  .ss-card {
+    --ss-card-pad: 16px;
+    --ss-card-radius: calc(var(--ss-radius-md) + 4px);
+    --ss-card-inner: max(4px, calc(var(--ss-card-radius) - var(--ss-card-pad)));
+
+    display: grid;
+    align-content: start;
+    gap: var(--ss-card-gap, 12px);
+    box-sizing: border-box;
+    min-width: 0;
+    padding: var(--ss-card-pad);
+    border-radius: var(--ss-card-radius);
+    background: var(--ss-surface);
+    /* The ring is drawn inside, so it never adds to the padding */
+    box-shadow: inset 0 0 0 1px var(--ss-line), var(--ss-shadow-card);
+  }
+
+  .ss-card[data-pad="small"] { --ss-card-pad: 12px; --ss-card-radius: var(--ss-radius-lg); }
+  .ss-card[data-pad="large"] { --ss-card-pad: 20px; --ss-card-radius: calc(var(--ss-radius-lg) + 6px); }
+
+  .ss-card[data-tone="sunken"] { background: var(--ss-ink-1); box-shadow: none; }
+  .ss-card[data-lift] { box-shadow: inset 0 0 0 1px var(--ss-line), var(--ss-shadow-satellite); }
+
+  /* Sectioned: the children carry the padding and the rules run edge to edge */
+  .ss-card[data-flush] { padding: 0; gap: 0; }
+  .ss-card[data-flush] > * { padding: var(--ss-card-pad); }
+  .ss-card[data-flush] > * + * { border-top: 1px solid var(--ss-line); }
+
+  /* Spacing comes from the gap; a child's own margin would pad one side twice */
+  .ss-card > :first-child { margin-top: 0; }
+  .ss-card > :last-child { margin-bottom: 0; }
+}
diff --git a/.agents/skills/stageshow/kit/parts/Card.tsx b/.agents/skills/stageshow/kit/parts/Card.tsx
new file mode 100644
index 00000000..5e9d8cae
--- /dev/null
+++ b/.agents/skills/stageshow/kit/parts/Card.tsx
@@ -0,0 +1,40 @@
+import type { CSSProperties, HTMLAttributes } from 'react'
+import './Card.css'
+
+/**
+ * A surface that holds content: a comment, a receipt, a settings group.
+ * Its padding is one value on every side, so it can never come out uneven,
+ * and its children are spaced by `gap`, never by their own margins (the
+ * first and last child's margins are dropped, so nothing pads the bottom
+ * twice). A rounded box inside it takes `var(--ss-card-inner)` as its radius:
+ * the card's radius less its padding, so the two curves stay parallel.
+ *
+ * `flush` makes a sectioned card (a header, a list, a footer): the card
+ * itself has no padding or gap, each direct child takes the padding instead,
+ * and a full-width hairline runs between children. Use it whenever rows are
+ * split by rules that reach both edges, rather than hand-building a box.
+ */
+export function Card({ pad = 'medium', gap = 12, tone = 'surface', lift, flush, className, style, ...rest }: HTMLAttributes<HTMLDivElement> & {
+  /** small 12px, medium 16px (the default), large 20px, on every side. */
+  pad?: 'small' | 'medium' | 'large'
+  /** Space between children, in px. */
+  gap?: number
+  /** surface: white with a hairline ring. sunken: a quiet gray fill, no ring, for a group inside a surface. */
+  tone?: 'surface' | 'sunken'
+  /** A soft shadow, for a card that sits over the ground rather than in a window. */
+  lift?: boolean
+  /** Sections: each direct child is padded by `pad`, with a full-width hairline between them. `gap` is ignored. */
+  flush?: boolean
+}) {
+  return (
+    <div
+      {...rest}
+      className={`ss-card${className ? ` ${className}` : ''}`}
+      data-pad={pad}
+      data-tone={tone}
+      data-lift={lift || undefined}
+      data-flush={flush || undefined}
+      style={{ ...style, '--ss-card-gap': `${gap}px` } as CSSProperties}
+    />
+  )
+}
