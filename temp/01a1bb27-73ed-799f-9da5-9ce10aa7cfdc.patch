+  gap: 2px;
+}
+
+.up-view {
+  display: grid;
+  place-items: center;
+  width: 28px;
+  height: 24px;
+  border-radius: 6px;
+}
+
+.up-view[data-on] {
+  background: var(--ss-ink-2);
+  color: var(--ss-text-strong);
+}
+
+/* ---- List ---- */
+
+.up-body {
+  overflow: hidden;
+}
+
+.up-list {
+  padding: 4px 10px 0;
+  font-size: 14px;
+}
+
+.up-head,
+.up-row {
+  display: grid;
+  grid-template-columns: var(--cols);
+  align-items: center;
+}
+
+.up-head {
+  height: 30px;
+  white-space: nowrap;
+  font-size: 12px;
+  font-weight: 500;
+  color: var(--ss-text);
+}
+
+.up-head > span,
+.up-row > * {
+  padding-left: 12px;
+}
+
+.up-head > span + span {
+  border-left: 1px solid var(--ss-line);
+  line-height: 15px;
+}
+
+.up-row > .ss-bar {
+  margin-left: 12px;
+  padding: 0;
+}
+
+.up-rows {
+  position: relative;
+  min-height: 600px;
+  border-radius: 8px;
+  transition: box-shadow 0.15s ease, background-color 0.15s ease;
+}
+
+/* The list lights up while a file is carried over it */
+.up-rows[data-over] {
+  background: color-mix(in srgb, var(--ss-accent) 5%, transparent);
+  box-shadow: inset 0 0 0 2px var(--ss-accent);
+}
+
+.up-row {
+  position: relative;
+  height: 38px;
+  border-radius: 7px;
+  color: var(--ss-text-strong);
+}
+
+.up-name {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-width: 0;
+}
+
+.up-name__text {
+  white-space: nowrap;
+  font-weight: 500;
+}
+
+.up-folder {
+  flex-shrink: 0;
+  color: #4fa6ea;
+  fill: #8ccaf6;
+}
+
+.up-doc {
+  flex-shrink: 0;
+  color: #a9a9ae;
+  fill: #fff;
+}
+
+/* ---- The upload row: tinted while it uploads, plain once it lands ---- */
+
+.up-new {
+  background: color-mix(in srgb, var(--ss-accent) 7%, #fff);
+  transition: background-color 0.6s ease;
+}
+
+.up-new[data-done] {
+  background: transparent;
+}
+
+.up-new > .ss-states {
+  padding-left: 12px;
+}
+
+.up-track {
+  width: 110px;
+  background: color-mix(in srgb, var(--ss-accent) 18%, #fff);
+}
+
+.up-list[data-compact] .up-track {
+  width: 64px;
+}
+
+/* The kit Meter, flat accent, eased to keep pace with the size counting up */
+.up-track .ss-meter__fill {
+  background: var(--ss-accent);
+  transition-duration: 0.6s;
+  transition-timing-function: cubic-bezier(0.3, 0.6, 0.3, 1);
+}
+
+.up-size {
+  white-space: nowrap;
+  font-variant-numeric: tabular-nums;
+}
+
+/* ---- The file on the desktop: icon over its name, as macOS draws it ---- */
+
+.up-desk {
+  position: absolute;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 7px;
+  width: 104px;
+  font-size: 12px;
+  transition: opacity 0.2s ease;
+}
+
+.up-desk[data-lifted] {
+  opacity: 0.45;
+}
+
+.up-desk__name {
+  padding: 1px 5px;
+  line-height: 1.35;
+  font-weight: 500;
+  color: var(--ss-text-strong);
+  white-space: nowrap;
+}
+
+.up-pdf {
+  position: relative;
+  display: block;
+  width: 44px;
+  height: 56px;
+  border-radius: 3px;
+  background: #fff;
+  box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.16), 0 2px 6px -2px rgba(0, 0, 0, 0.22);
+  clip-path: polygon(0 0, 70% 0, 100% 23%, 100% 100%, 0 100%);
+}
+
+.up-pdf::before {
+  content: '';
+  position: absolute;
+  top: 0;
+  right: 0;
+  width: 30%;
+  height: 23%;
+  background: linear-gradient(225deg, transparent 50%, #e4e4e7 50%);
+}
+
+.up-pdf__band {
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: 10px;
+  padding: 2px 0;
+  background: #e5484d;
+  color: #fff;
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  line-height: 13px;
+  text-align: center;
+}
+
+.up-pdf[data-small] {
+  flex-shrink: 0;
+  width: 15px;
+  height: 19px;
+  border-radius: 2px;
+  box-shadow: inset 0 0 0 1px #c9c9ce;
+  clip-path: none;
+}
+
+.up-pdf[data-small]::before {
+  display: none;
+}
+
+.up-pdf[data-small] .up-pdf__band {
+  bottom: 4px;
+  height: 5px;
+  padding: 0;
+}
+
+/* ---- The drag image: the icon and its name on a selection pill ---- */
+
+.up-drag {
+  position: absolute;
+  top: 0;
+  left: 0;
+  z-index: 30;
+  pointer-events: none;
+  opacity: 0;
+  will-change: transform;
+}
+
+.up-drag[data-show] {
+  opacity: 0.85;
+}
+
+.up-drag__inner {
+  /* Laid out exactly as the desktop icon, so the pickup never doubles it */
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 7px;
+  width: 104px;
+  font-size: 12px;
+  will-change: transform;
+}
+
+.up-drag[data-dropped] {
+  opacity: 0;
+  transition: opacity 0.22s ease-in;
+}
+
+.up-drag[data-dropped] .up-drag__inner {
+  transform: scale(0.5);
+  transition: transform 0.24s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.up-drag__name {
+  padding: 1px 5px;
+  border-radius: 4px;
+  background: var(--ss-accent);
+  color: #fff;
+  white-space: nowrap;
+  line-height: 1.35;
+}
