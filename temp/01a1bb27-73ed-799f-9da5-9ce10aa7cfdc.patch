+  display: flex;
+  flex-direction: column;
+  flex: 1;
+  min-width: 0;
+}
+
+.sl-channel__head {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex-shrink: 0;
+  height: 49px;
+  padding: 0 12px 0 18px;
+}
+
+.sl-channel__title {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  font-size: 17px;
+  font-weight: 800;
+  color: var(--sl-ink);
+}
+
+.sl-channel__title .sl-i:last-child {
+  margin-left: 2px;
+  color: var(--sl-ink-2);
+}
+
+.sl-members {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  height: 28px;
+  padding: 0 8px 0 4px;
+  border: 1px solid var(--sl-line-2);
+  border-radius: 6px;
+}
+
+.sl-members__faces {
+  display: flex;
+}
+
+.sl-members__faces .sl-face {
+  font-size: 9px !important;
+  box-shadow: 0 0 0 2px #fff;
+}
+
+.sl-members__faces .sl-face + .sl-face {
+  margin-left: -5px;
+}
+
+.sl-members__count {
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--sl-ink-2);
+}
+
+.sl-headbtn {
+  display: grid;
+  place-items: center;
+  width: 28px;
+  height: 28px;
+  border: 1px solid var(--sl-line-2);
+  border-radius: 6px;
+  color: var(--sl-ink-2);
+  transition: background 0.12s ease;
+}
+
+.sl-headbtn[data-hover] {
+  background: var(--sl-hover);
+}
+
+.sl-tabs {
+  display: flex;
+  gap: 20px;
+  flex-shrink: 0;
+  height: 36px;
+  padding: 0 20px;
+  border-bottom: 1px solid var(--sl-line);
+}
+
+.sl-tab {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--sl-ink-2);
+}
+
+.sl-tab[data-active] {
+  color: var(--sl-ink);
+  box-shadow: inset 0 -2px 0 var(--sl-aub);
+}
+
+.sl-tab__glyph {
+  width: 14px;
+  height: 14px;
+  border-radius: 4px;
+  background: var(--ss-ink-2);
+}
+
+.sl-feed {
+  display: flex;
+  flex-direction: column;
+  justify-content: flex-end;
+  flex: 1;
+  min-height: 0;
+  overflow: hidden;
+  padding-bottom: 6px;
+}
+
+.sl-divider {
+  position: relative;
+  display: flex;
+  justify-content: center;
+  margin: 4px 0 6px;
+}
+
+.sl-divider::before {
+  content: '';
+  position: absolute;
+  left: 20px;
+  right: 20px;
+  top: 50%;
+  border-top: 1px solid var(--sl-line);
