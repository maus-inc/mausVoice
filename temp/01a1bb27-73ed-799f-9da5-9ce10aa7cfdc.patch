index 00000000..6297292b
--- /dev/null
+++ b/apps/desktop/src/utils/remote-receiver-intent.utils.ts
@@ -0,0 +1,22 @@
+// Renderer-local intent tracking, independent of the preference write queue.
+// A startup task must not use a preference value from before a pending edit.
+let preferenceVersion = 0;
+let activePreferenceMutations = 0;
+
+export const getReceiverPreferenceVersion = (): number => preferenceVersion;
+
+export const isReceiverPreferenceVersionCurrent = (version: number): boolean =>
+  version === preferenceVersion && activePreferenceMutations === 0;
+
+export const withReceiverPreferenceMutation = async <T>(
+  operation: () => Promise<T>,
+): Promise<T> => {
+  preferenceVersion++;
+  activePreferenceMutations++;
+  try {
+    return await operation();
+  } finally {
+    activePreferenceMutations--;
+    preferenceVersion++;
+  }
+};
