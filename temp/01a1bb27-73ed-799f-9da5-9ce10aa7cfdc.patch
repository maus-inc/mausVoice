+        pub set_status: i32,
+        pub get_count: usize,
+        pub set_count: usize,
+        pub set_size: u32,
+        pub set_value: pid_t,
+        pub next: pid_t,
+    }
+    pub static FIXTURE: Mutex<Fixture> = Mutex::new(Fixture {
+        pid: -1,
+        returned: 4,
+        get_status: 0,
+        set_status: 0,
+        get_count: 0,
+        set_count: 0,
+        set_size: 0,
+        set_value: 0,
+        next: 123,
+    });
+    pub unsafe fn AudioObjectGetPropertyData(
+        _: u32,
+        _: *const AudioObjectPropertyAddress,
+        _: u32,
+        _: *const c_void,
+        size: *mut u32,
+        out: *mut c_void,
+    ) -> i32 {
+        let mut f = FIXTURE.lock().unwrap();
+        f.get_count += 1;
+        if f.get_status != 0 {
+            return f.get_status;
+        }
+        *(out as *mut pid_t) = f.pid;
+        *size = f.returned;
+        0
+    }
+    pub unsafe fn AudioObjectSetPropertyData(
+        _: u32,
+        _: *const AudioObjectPropertyAddress,
+        _: u32,
+        _: *const c_void,
+        size: u32,
+        data: *const c_void,
+    ) -> i32 {
+        let mut f = FIXTURE.lock().unwrap();
+        f.set_count += 1;
+        f.set_size = size;
+        f.set_value = *(data as *const pid_t);
+        if f.set_status != 0 {
+            return f.set_status;
+        }
+        f.pid = f.next;
+        0
+    }
