+/* Tooltip */
+
+@layer stageshow {
+  .ss-tooltip {
+    position: absolute;
+    z-index: 20;
+    display: flex;
+    align-items: center;
+    height: 22px;
+    padding: 0 8px;
+    border-radius: var(--ss-radius-sm);
+    background: #26262a;
+    color: #fff;
+    font-size: 11px;
+    font-weight: 500;
+    white-space: nowrap;
+    pointer-events: none;
+    opacity: 0;
+    transform: translate(-50%, -2px);
+    transition: opacity 0.1s ease, transform 0.1s ease;
+  }
+
+  .ss-tooltip[data-side='above'] {
+    transform: translate(-50%, calc(-100% + 2px));
+  }
+
+  .ss-tooltip[data-show] {
+    opacity: 1;
+    transform: translate(-50%, 0);
+    transition-duration: 0.15s;
+  }
+
+  .ss-tooltip[data-side='above'][data-show] {
+    transform: translate(-50%, -100%);
+  }
+
+  /* Centered on its letters, not its line box */
+  .ss-tooltip__label {
+    display: block;
+    text-box: trim-both cap alphabetic;
+  }
+}
diff --git a/.agents/skills/stageshow/kit/parts/Tooltip.tsx b/.agents/skills/stageshow/kit/parts/Tooltip.tsx
