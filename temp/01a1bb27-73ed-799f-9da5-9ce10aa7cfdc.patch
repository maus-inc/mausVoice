+/* All rules belong to this example, including its responsive variants. */
+.db-card {
+  /* The card is the stage. One gutter for every edge something sits near:
+     the window's top, and the satellite's left and bottom. */
+  & .ss-stage {
+    --gutter: 22px;
+    /* One cool neutral family throughout: card, window, sidebar, satellite */
+    --ss-well: #111113;
+    --ss-canvas: #151517;
+    --ss-surface: #1b1b1e;
+    --ss-chrome: #1b1b1e;
+    overflow: hidden;
+    border-radius: 18px;
+    background:
+      radial-gradient(120% 90% at 70% -10%, rgba(255, 255, 255, 0.06), transparent 60%),
+      var(--ss-well);
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
+  }
+
+  /* Pinned top-left, a gutter from the top; runs about a third past the right
+     and off the bottom. The left inset leaves room for the satellite. */
+  .db-window {
+    position: absolute;
+    top: var(--gutter);
+    left: 88px;
+    width: 400px;
+    height: 300px;
+    background: var(--ss-surface);
+    border-radius: 12px;
+    box-shadow: var(--ss-shadow-hero);
+  }
+
+  .db-window .ss-window__body {
+    display: flex;
+  }
+
+  .db-sidebar {
+    display: flex;
+    flex-direction: column;
+    flex-shrink: 0;
+    gap: 4px;
+    width: 92px;
+    padding: 14px 8px;
+    border-right: 1px solid var(--ss-line);
+    background: var(--ss-canvas);
+  }
+
+  .db-nav {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    height: 22px;
+    padding: 0 4px;
+  }
+
+  .db-main {
+    flex: 1;
+    min-width: 0;
+    padding: 16px 16px 0;
+  }
+
+  .db-header {
+    display: flex;
+    align-items: flex-end;
+    gap: 12px;
+    margin-bottom: 16px;
+  }
+
+  .db-heading {
+    display: flex;
+    flex-direction: column;
+    gap: 8px;
+    padding-bottom: 2px;
+  }
+
+  .db-title {
+    font-size: 14px;
+    font-weight: 600;
+    letter-spacing: -0.01em;
+    line-height: 1.3;
+    white-space: nowrap;
+    color: var(--ss-text-strong);
+  }
+
+  /* ---- Album art: grayscale only, a little light in each so it reads as
+     a printed sleeve rather than a gray box ---- */
+
+  .db-art {
+    display: block;
+    flex-shrink: 0;
+    border-radius: 4px;
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
+  }
+
+  .db-art--1 { background: radial-gradient(circle at 30% 30%, #6a6a6e, #2a2a2d 70%); }
+  .db-art--2 { background: linear-gradient(160deg, #3c3c40 0%, #1f1f22 100%); }
+  .db-art--3 { background: radial-gradient(circle at 50% 120%, #d9d9dc 0%, #8a8a8e 28%, #2c2c30 70%); }
+  .db-art--4 { background: linear-gradient(200deg, #55555a, #232326 60%); }
+  .db-art--5 { background: radial-gradient(circle at 75% 25%, #4a4a4e, #1d1d20 65%); }
+
+  /* The playlist cover: four sleeves, the way a shared mix shows its parts */
+  .db-art--cover {
+    width: 48px;
+    height: 48px;
+    border-radius: 6px;
+    background:
+      radial-gradient(circle at 50% 120%, #d9d9dc 0%, #8a8a8e 28%, #2c2c30 70%) 0 0 / 50% 50% no-repeat,
+      radial-gradient(circle at 30% 30%, #6a6a6e, #2a2a2d 70%) 100% 0 / 50% 50% no-repeat,
+      linear-gradient(200deg, #55555a, #232326 60%) 0 100% / 50% 50% no-repeat,
+      radial-gradient(circle at 75% 25%, #4a4a4e, #1d1d20 65%) 100% 100% / 50% 50% no-repeat;
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 6px 14px -6px rgba(0, 0, 0, 0.6);
+  }
+
+  .db-art--tiny { width: 12px; height: 12px; border-radius: 3px; }
+  .db-art--row { width: 26px; height: 26px; }
+  .db-art--detail { width: 32px; height: 32px; border-radius: 6px; }
+
+  /* ---- Faces: who the playlist is shared with ---- */
