+vi.mock("groq-sdk/index", () => ({
+  default: class {
+    audio = { transcriptions: { create: mocks.create } };
+    constructor(options: unknown) {
+      mocks.config(options);
+    }
+  },
+}));
+vi.mock("openai", () => ({
+  default: class {},
+  toFile: mocks.toFile,
+}));
+
+import { groqTranscribeAudio } from "./groq.utils";
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.toFile.mockResolvedValue({ name: "audio.wav" });
+  mocks.create.mockResolvedValue({ text: "hello world", segments: [] });
+});
+
+describe("Groq transcription upload", () => {
+  it("creates the upload once and retains provider-specific options", async () => {
+    const blob = new ArrayBuffer(8);
+    const output = await groqTranscribeAudio({
+      apiKey: " key ",
+      blob,
+      ext: "wav",
+      prompt: "context",
+      language: "auto",
+    });
+    expect(mocks.config).toHaveBeenCalledWith(
+      expect.objectContaining({ apiKey: "key", maxRetries: 0 }),
+    );
+    expect(mocks.toFile).toHaveBeenCalledOnce();
+    expect(mocks.toFile).toHaveBeenCalledWith(blob, "audio.wav");
+    expect(mocks.create).toHaveBeenCalledWith({
+      file: { name: "audio.wav" },
+      model: "whisper-large-v3-turbo",
+      prompt: "context",
+      language: undefined,
+      response_format: "verbose_json",
+    });
+    expect(output.text).toBe("hello world");
+  });
+
+  it("does not retry conversion failures as provider requests", async () => {
+    mocks.toFile.mockRejectedValue(new Error("upload conversion failed"));
+    await expect(
+      groqTranscribeAudio({
+        apiKey: "key",
+        blob: new ArrayBuffer(0),
+        ext: "wav",
+      }),
+    ).rejects.toThrow("upload conversion failed");
+    expect(mocks.toFile).toHaveBeenCalledOnce();
+    expect(mocks.create).not.toHaveBeenCalled();
+  });
+});
