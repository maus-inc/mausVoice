+    ) -> Option<RecordingRetry> {
+        let mut owner = self
+            .owner
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        match owner.as_mut() {
+            Some(owner)
+                if Arc::ptr_eq(&owner.window, window)
+                    && owner.release_requested
+                    && !owner.retrying =>
+            {
+                owner.retrying = true;
+                Some(RecordingRetry(
+                    Arc::clone(&owner.identity),
+                    owner.admission.clone(),
+                ))
