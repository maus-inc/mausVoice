+
+.sl-thread__title {
+  font-size: 16px;
+  font-weight: 800;
+  color: var(--sl-ink);
+}
+
+.sl-thread__where {
+  display: flex;
+  align-items: center;
+  gap: 1px;
+  font-size: 12.5px;
+  color: var(--sl-ink-2);
+}
+
+.sl-thread__body {
+  padding: 10px 0;
+}
+
+.sl-thread__count {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 4px 20px 4px;
+  font-size: 12.5px;
+  color: var(--sl-ink-2);
+}
+
+.sl-thread__rule {
+  flex: 1;
+  border-top: 1px solid var(--sl-line);
+}
+
+.sl-thread__compose {
+  padding: 8px 16px 0;
+}
+
+/* The live message's toolbar floats half above the row, as Slack's does, so
+   its Collapse clips wider than the kit's 3px */
+.sl-live > .ss-collapse__inner {
+  overflow-clip-margin: 24px;
+}
+
+/* ---- Compact: the channel alone, for an article column ----
+   The rail and sidebar go, the window runs off the bottom, and the thread
+   slides over the channel from the right instead of squeezing it. Open, it
+   covers the channel whole: a strip of channel beside it would show its
+   words sliced at the thread's edge. */
+
+.ss-stage[data-layout='compact'] .sl-win {
+  left: 20px;
+  top: 20px;
+  width: 400px;
+  height: 460px;
+}
+
+.ss-stage[data-layout='compact'] .sl-rail,
+.ss-stage[data-layout='compact'] .sl-side,
+.ss-stage[data-layout='compact'] .sl-top__nav {
+  display: none;
+}
+
+.ss-stage[data-layout='compact'] .sl-panel {
+  position: relative;
+  margin-left: 6px;
+}
+
+.ss-stage[data-layout='compact'] .sl-thread-wrap {
+  position: absolute;
+  top: 0;
+  right: 0;
+  bottom: 0;
+  z-index: 2;
+  box-shadow: -12px 0 24px -16px rgba(0, 0, 0, 0.25);
+}
+
+.ss-stage[data-layout='compact'] .sl-thread-wrap {
+  /* A real slide: the whole panel moves in from the right edge, so no word is
+     ever wiped or cut by a growing edge */
+  width: 388px;
+  translate: 100% 0;
+  transition: translate 0.6s cubic-bezier(0.3, 0.75, 0.1, 1);
+}
+
+.ss-stage[data-layout='compact'] .sl-thread-wrap[data-open] {
+  width: 388px;
+  translate: 0 0;
+}
+
+.ss-stage[data-layout='compact'] .sl-thread {
+  width: 388px;
+}
+
+.ss-stage[data-layout='compact'] .sl-top__search {
+  width: 280px;
+  margin-left: -140px;
+}
+
+/* The compact feed keeps one older message, so Maya's arrival, its reaction
+   and its reply line fit without pushing anything under the tabs */
+.ss-stage[data-layout='compact'] .sl-feed > .sl-divider + .sl-msg {
+  display: none;
+}
