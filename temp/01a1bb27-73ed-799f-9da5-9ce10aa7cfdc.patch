+    position: absolute;
+    top: var(--gutter);
+    left: 104px;
+    width: 460px;
+    height: 320px;
+    background: var(--ss-surface);
+    border-radius: 10px;
+    box-shadow: var(--ss-shadow-hero);
+  }
+
+  /* Keep the selected customer whole in the narrow crop; only filler bleeds. */
+  & [data-layout="compact"] .sc-window { left: 68px; }
+
+  .sc-window .ss-window__body {
+    display: flex;
+  }
+
+  .sc-sidebar {
+    display: flex;
+    flex-direction: column;
+    flex-shrink: 0;
+    gap: 4px;
+    width: 120px;
+    padding: 16px 10px;
+    border-right: 1px solid var(--ss-line);
+    background: var(--ss-canvas);
+  }
+
+  .sc-nav {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    height: 24px;
+    padding: 0 6px;
+    border-radius: 6px;
+  }
+
+  .sc-main {
+    flex: 1;
+    min-width: 0;
+    padding: 16px 18px;
+  }
+
+  .sc-header {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    margin-bottom: 12px;
+  }
+
+  .sc-title {
+    font-size: 13px;
+    font-weight: 600;
+    color: var(--ss-text-strong);
+  }
+
+  .sc-list {
+    display: flex;
+    flex-direction: column;
+  }
+
+  /* Kit Rows at this list's pitch: a hairline between, the selection inset */
+  .sc-row {
