+  padding: 4px 12px 0 12px;
+}
+
+.gc-create {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  align-self: flex-start;
+  height: 52px;
+  padding: 0 14px 0 14px;
+  border-radius: 16px;
