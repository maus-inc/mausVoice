+import type { StopRecordingResponse } from "../types/transcription-session.types";
+import { getLogger } from "../utils/log.utils";
+import type {
+  PauseChunkedPretranscriber,
+  PretranscriptionResult,
+} from "./pause-chunked-pretranscriber";
+
+/** Finish only a pretranscriber with completed spans; an unusable result falls back. */
+export const finishSessionPretranscription = async (
+  pretranscriber: PauseChunkedPretranscriber | null,
+  audio: StopRecordingResponse,
+  label: "batch" | "local-session",
+): Promise<PretranscriptionResult | null> => {
+  if (!pretranscriber || pretranscriber.chunkCount === 0) return null;
+  // finish seals the stream before awaiting its tail.
+  const started = performance.now();
+  const result = await pretranscriber.finish(audio);
+  if (!result) {
+    const prefix = label === "batch" ? "Batch session:" : "[local-session]";
+    getLogger().warning(
+      `${prefix} pretranscription unusable, transcribing the whole recording`,
+    );
+    return null;
+  }
+  getLogger().info(
+    `[${label}] pretranscribed ${result.chunkCount} spans; post-stop wait ${Math.round(performance.now() - started)}ms (${result.text.length} chars)`,
+  );
+  return result;
+};
