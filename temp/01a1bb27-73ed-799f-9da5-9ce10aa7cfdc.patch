+/** Pad a nonempty forced final chunk without changing the original buffer. */
+export const padFinalAudioChunk = (
+  chunk: Float32Array,
+  minimum: number,
+  force: boolean,
+): Float32Array => {
+  if (!force || chunk.length === 0 || chunk.length >= minimum) return chunk;
