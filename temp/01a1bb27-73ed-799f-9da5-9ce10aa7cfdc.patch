+/* All rules belong to this example, including its responsive variants. */
+.fx {
+  & .ss-stage {
+    --ss-accent: #ff5a1f;
+    --ss-accent-2: #ff8a3d;
+    --ss-accent-soft: rgba(255, 90, 31, 0.12);
+    /* The card opening: quick off the tap, long soft settle, as iOS does */
+    --fx-open: cubic-bezier(0.3, 0.75, 0.1, 1);
