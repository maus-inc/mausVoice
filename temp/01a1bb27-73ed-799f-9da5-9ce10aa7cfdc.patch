@@ -0,0 +1,68 @@
+/* Count */
+
+@layer stageshow {
+  .ss-count {
+    display: inline-flex;
+    align-items: baseline;
+    font-variant-numeric: tabular-nums;
+    white-space: nowrap;
+  }
+
+  .ss-count__char {
+    display: inline-block;
+  }
+
+  /* A unit after the figure keeps a box of its own, a hair from the last
+     digit (a word space when the format writes one), so "21°" and "240ms"
+     read as one figure without the unit sitting on the digit. Restyle it
+     here (a smaller, lighter degree sign); widen the hair with the token */
+  .ss-count__unit {
+    display: inline-block;
+    margin-left: var(--ss-count-unit-gap, 0.08em);
+  }
+
+  .ss-count__unit[data-space] {
+    margin-left: 0.28em;
+  }
+
+  /* One digit: a window one line tall over a strip of 0 to 9. The strip
+     slides to the figure it shows; a change rolls it through the figures
+     in between, so 4 to 9 passes 5, 6, 7 and 8 */
+  .ss-count__digit {
+    display: inline-block;
+    /* Sized by its figures, so the number's letter-spacing counts as it does
+       in plain text; a fixed 1ch box set tracked figures wider than the text */
+    height: 1em;
+    overflow: hidden;
+    line-height: 1;
+    vertical-align: baseline;
+    /* The window's edges soften a touch, so a figure passing them is never
+       sliced; the figure at rest sits inside the clear middle */
+    mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
+  }
+
+  .ss-count__strip {
+    display: flex;
+    flex-direction: column;
+    will-change: transform;
+    transition-property: transform;
+    transition-timing-function: cubic-bezier(0.3, 0.75, 0.1, 1);
+  }
+
+  .ss-count__strip > span {
+    display: block;
+    height: 1em;
+    line-height: 1;
+    text-align: left; /* a digit sits on its cell's left like set type; centered, a leading 1 drifts off the column */
+  }
+
+  .ss-count[data-snap] .ss-count__strip {
+    transition: none;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    .ss-count__strip {
+      transition: none;
+    }
+  }
+}
