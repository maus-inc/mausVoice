+/* The iOS keyboard (ios.tsx). */
+
+@layer stageshow {
+  /* ---- iOS keyboard (ios.tsx) ----
+     iOS 27, at true points inside a Phone. Measured from iOS 27 screenshots:
+     keys 31.8 × 41.6 with 5.8 gaps on a 52.6 row pitch, special keys the
+     letters' color, a 123 / space / return row of 88 / 182 / 88. */
+  .ss-kb {
+    --ss-kb-sheet: #e3e4e9;
+    --ss-kb-key: #fff;
+    --ss-kb-down: #c4c6cd;
+    --ss-kb-ink: #000;
+    --ss-kb-faint: #3c3c43;
+    /* Nearly the screen's full width: 3pt in from each edge */
+    position: relative;
+    flex: none;
+    margin: 0 3px 4px;
+    padding: 0 3px 0;
+    border-radius: 28px 28px 52px 52px;
+    background: color-mix(in srgb, var(--ss-kb-sheet) 94%, transparent);
+    box-shadow: inset 0 0.5px 0 rgba(255, 255, 255, 0.7), 0 -0.5px 0 rgba(0, 0, 0, 0.06);
+    color: var(--ss-kb-ink);
+    font-family: -apple-system, 'SF Pro Text', system-ui, sans-serif;
+    user-select: none;
+  }
+
+  .ss-kb[data-dark] {
+    --ss-kb-sheet: #2a2a2c;
+    --ss-kb-key: #4a4a4c;
+    --ss-kb-down: #6b6b6e;
+    --ss-kb-ink: #fff;
+    --ss-kb-faint: #ebebf5;
+    box-shadow: inset 0 0.5px 0 rgba(255, 255, 255, 0.1);
+  }
+
+  .ss-kb__suggest {
+    display: grid;
+    grid-template-columns: repeat(3, 1fr);
+    align-items: center;
+    height: 50px;
+    font-size: 17px;
+    letter-spacing: -0.01em;
+    text-align: center;
+  }
+
+  .ss-kb__suggest span + span {
+    border-left: 1px solid color-mix(in srgb, var(--ss-kb-faint) 22%, transparent);
+  }
+
+  .ss-kb__row {
+    /* One key: ten keys and nine gaps fill the row, on every row */
+    --k: calc((100% - 54px) / 10);
+    display: flex;
+    justify-content: center;
+    gap: 6px;
+    height: 42.5px;
+    margin-bottom: 11px;
+  }
+
+  .ss-kb__key {
+    position: relative;
+    display: grid;
+    flex: none;
+    place-items: center;
+    width: var(--k);
+    border-radius: 8.5px;
+    background: var(--ss-kb-key);
+    font-size: 23px;
+    line-height: 1;
+    transition: background-color 0.12s ease;
+  }
+
+  .ss-kb[data-dark] .ss-kb__key {
+    font-weight: 400;
+  }
+
+  .ss-kb__key[data-down] {
+    background: var(--ss-kb-down);
+    transition: none;
+  }
+
+  /* Letters show their callout instead of darkening */
+  .ss-kb__row:not(.ss-kb__row--bottom) .ss-kb__key:not(.ss-kb__key--wide)[data-down] {
+    background: var(--ss-kb-key);
+  }
+
+  .ss-kb__key--wide {
+    width: calc(var(--k) * 1.36);
+  }
+
+  .ss-kb__row[data-row="2"] > .ss-kb__key--wide:first-child {
+    margin-right: 7.2px;
+  }
+
+  .ss-kb__row[data-row="2"] > .ss-kb__key--wide:last-child {
+    margin-left: 7.2px;
+  }
+
+  .ss-kb__key--mode {
+    width: calc(var(--k) * 2.78);
+    font-size: 17px;
+  }
+
+  .ss-kb__key--space {
+    flex: 1;
+    width: auto;
+  }
+
+  /* The magnified letter that rises out of a pressed key */
+  .ss-kb__callout {
+    position: absolute;
+    bottom: 30px;
+    left: 50%;
+    display: grid;
+    place-items: center;
+    width: 145%;
+    height: 54px;
+    padding-bottom: 6px;
+    border-radius: 12px;
+    background: var(--ss-kb-key);
+    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.16);
+    font-size: 34px;
+    transform: translateX(-50%);
+    pointer-events: none;
+    z-index: 2;
+  }
+
+  /* Joins the balloon to its key, over the balloon's shadow */
+  .ss-kb__callout::after {
+    content: '';
+    position: absolute;
+    top: 100%;
+    left: 50%;
+    /* The key's own width (the balloon is 145% of it) */
+    width: 69%;
+    height: 14px;
+    margin-top: -4px;
+    background: var(--ss-kb-key);
+    transform: translateX(-50%);
+  }
+
+  .ss-kb__row:first-of-type .ss-kb__key:first-child .ss-kb__callout,
+  .ss-kb__row[data-row="0"] .ss-kb__key:first-child .ss-kb__callout {
+    left: 0;
+    transform: none;
+  }
+
+  .ss-kb__row[data-row="0"] .ss-kb__key:first-child .ss-kb__callout::after {
+    left: 0;
+    transform: none;
+  }
+
+  .ss-kb__row[data-row="0"] .ss-kb__key:last-child .ss-kb__callout {
+    left: auto;
+    right: 0;
+    transform: none;
+  }
+
+  .ss-kb__row[data-row="0"] .ss-kb__key:last-child .ss-kb__callout::after {
+    left: auto;
+    right: 0;
+    transform: none;
+  }
+
+  .ss-kb__row--bottom {
+    margin-bottom: 0;
+  }
+
+  .ss-kb__below {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    height: 72px;
+    padding: 0 22px 6px;
+    color: var(--ss-kb-faint);
+  }
+}
diff --git a/.agents/skills/stageshow/kit/ios.tsx b/.agents/skills/stageshow/kit/ios.tsx
new file mode 100644
index 00000000..22a4ed8c
--- /dev/null
+++ b/.agents/skills/stageshow/kit/ios.tsx
@@ -0,0 +1,137 @@
+import { useEffect, useRef, useState, type CSSProperties } from 'react'
+import './ios.css'
+
+// The iOS 27 keyboard, at true points inside a Phone: the Liquid Glass sheet
+// with its predictive bar, softly rounded keys with wide gaps, special keys
+// the same color as the letters, a ↵ return key, and the emoji and dictation
+// buttons below the keys. Measured from iOS 27 screenshots.
+
+const ROWS = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm']
+
+export interface KeyboardProps {
+  /**
+   * The text typed so far. Each new character pops its key, and shift follows
+   * iOS's auto-capitalisation (on at the start and after a sentence ends).
+   */
+  typed?: string
+  /** Force shift on or off instead of following the text. */
+  shift?: boolean
+  /** The three words in the predictive bar. */
+  suggestions?: [string, string, string]
+  /** A key held down: a letter, or 'shift', 'delete', 'return', 'space', '123'. */
+  pressed?: string | null
+  dark?: boolean
+  className?: string
+  style?: CSSProperties
+}
+
+function Glyph({ name }: { name: 'shift' | 'shift-on' | 'delete' | 'return' | 'emoji' | 'mic' }) {
+  const common = { fill: 'none', stroke: 'currentColor', strokeWidth: 1.6, strokeLinejoin: 'round' as const, strokeLinecap: 'round' as const }
+  switch (name) {
+    case 'shift':
+    case 'shift-on':
+      return (
+        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden>
+          <path d="M12 3.6 3.4 12.4H8v7.4h8v-7.4h4.6Z" {...common} fill={name === 'shift-on' ? 'currentColor' : 'none'} />
+        </svg>
+      )
+    case 'delete':
+      return (
+        <svg viewBox="0 0 26 24" width="24" height="22" aria-hidden>
+          <path d="M8.6 4.5h13.2a2.2 2.2 0 0 1 2.2 2.2v10.6a2.2 2.2 0 0 1-2.2 2.2H8.6L2 12Z" {...common} />
+          <path d="m11.4 8.6 6.8 6.8m0-6.8-6.8 6.8" {...common} />
+        </svg>
+      )
+    case 'return':
+      return (
+        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden>
+          <path d="M19.5 5.5v6.2a2.3 2.3 0 0 1-2.3 2.3H5" {...common} />
+          <path d="m9.2 9.6-4.4 4.4 4.4 4.4" {...common} />
+        </svg>
+      )
+    case 'emoji':
+      return (
+        <svg viewBox="0 0 28 28" width="28" height="28" aria-hidden>
+          <circle cx="14" cy="14" r="12.5" fill="currentColor" />
+          <ellipse cx="10" cy="10.6" rx="1.5" ry="2.1" fill="var(--ss-kb-sheet)" />
+          <ellipse cx="18" cy="10.6" rx="1.5" ry="2.1" fill="var(--ss-kb-sheet)" />
+          <path d="M7.4 15.2c.9 3.6 3.6 5.8 6.6 5.8s5.7-2.2 6.6-5.8Z" fill="var(--ss-kb-sheet)" />
+        </svg>
+      )
+    case 'mic':
+      return (
+        <svg viewBox="0 0 24 28" width="22" height="26" aria-hidden>
+          <rect x="7.6" y="2" width="8.8" height="15" rx="4.4" fill="currentColor" />
+          <path d="M4.2 12.8a7.8 7.8 0 0 0 15.6 0M12 20.6V26M8 26h8" {...common} strokeWidth={1.9} />
+        </svg>
+      )
+  }
+}
+
+/**
+ * The iOS keyboard. Put it at the bottom of a Phone's screen, under the
+ * composer; pass `typed` and it pops each key as the text grows.
+ */
+export function Keyboard({ typed = '', shift, suggestions = ['I', 'The', 'I’m'], pressed, dark, className, style }: KeyboardProps) {
+  // The key that just landed, shown in its callout for a moment
+  const [pop, setPop] = useState<{ ch: string; n: number } | null>(null)
+  const last = useRef(typed)
+  useEffect(() => {
+    const was = last.current
+    last.current = typed
+    if (typed.length <= was.length || !typed.startsWith(was)) return
+    const ch = typed[typed.length - 1].toLowerCase()
+    setPop((p) => ({ ch, n: (p?.n ?? 0) + 1 }))
+    const id = setTimeout(() => setPop(null), 140)
+    return () => clearTimeout(id)
+  }, [typed])
+  const auto = typed === '' || /[.!?]\s$/.test(typed)
+  const upper = shift ?? auto
+  const down = (k: string) => pressed === k || (k.length === 1 && pop?.ch === k)
+  return (
+    <div className={`ss-kb${className ? ` ${className}` : ''}`} data-dark={dark || undefined} style={style}>
+      <div className="ss-kb__suggest">
+        {suggestions.map((w, i) => (
+          <span key={i}>{w}</span>
+        ))}
+      </div>
+      {ROWS.map((row, r) => (
+        <div key={r} className="ss-kb__row" data-row={r}>
+          {r === 2 && (
+            <span className="ss-kb__key ss-kb__key--wide" data-down={down('shift') || undefined}>
+              <Glyph name={upper ? 'shift-on' : 'shift'} />
+            </span>
+          )}
+          {row.split('').map((k) => (
+            <span key={k} className="ss-kb__key" data-down={down(k) || undefined}>
+              {upper ? k.toUpperCase() : k}
+              {pop?.ch === k && (
+                <span key={pop.n} className="ss-kb__callout" aria-hidden>
+                  {upper ? k.toUpperCase() : k}
+                </span>
+              )}
+            </span>
+          ))}
+          {r === 2 && (
+            <span className="ss-kb__key ss-kb__key--wide" data-down={down('delete') || undefined}>
+              <Glyph name="delete" />
+            </span>
+          )}
+        </div>
+      ))}
+      <div className="ss-kb__row ss-kb__row--bottom">
+        <span className="ss-kb__key ss-kb__key--mode" data-down={down('123') || undefined}>
+          123
+        </span>
+        <span className="ss-kb__key ss-kb__key--space" data-down={down('space') || down(' ') || undefined} />
+        <span className="ss-kb__key ss-kb__key--mode" data-down={down('return') || undefined}>
+          <Glyph name="return" />
+        </span>
+      </div>
+      <div className="ss-kb__below">
+        <Glyph name="emoji" />
+        <Glyph name="mic" />
+      </div>
+    </div>
+  )
+}
