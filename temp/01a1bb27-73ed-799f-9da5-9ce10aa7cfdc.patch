+import type { Hotkey } from "@maus-inc/types";
+import { produceAppState } from "../store";
+import { registerHotkeys } from "../utils/app.utils";
+import type { LocalDataWriteLease } from "../utils/local-data-write-gate";
+
+/** Publish an optimistic hotkey only under the caller's local-data lease. */
+export const publishOptimisticHotkey = (
+  value: Hotkey,
+  lease: LocalDataWriteLease,
+): void => {
+  produceAppState((draft) => {
+    registerHotkeys(draft, [value]);
+    if (!draft.settings.hotkeyIds.includes(value.id)) {
+      draft.settings.hotkeyIds.push(value.id);
+    }
+    draft.settings.hotkeysStatus = "success";
+  }, lease);
+};
