+import { LlmProviderInputZod, SttProviderInputZod } from "@maus-inc/types";
+import { describe, expect, it } from "vitest";
+
+const input = {
+  provider: "custom",
+  name: "Example",
+  url: "https://example.test",
+  model: "model",
+  tier: 1,
+};
+
+describe.each([
+  ["STT", SttProviderInputZod],
+  ["LLM", LlmProviderInputZod],
+] as const)("%s provider input", (_name, schema) => {
+  it("defaults an omitted API key and preserves an explicit ID", () => {
+    expect(schema.parse({ ...input, id: "id" })).toEqual({
+      ...input,
+      id: "id",
+      apiKey: "",
+    });
+    expect(schema.parse({ ...input, apiKey: "secret" }).apiKey).toBe("secret");
+  });
+
+  it("rejects extra fields, non-integer tiers, and missing required fields", () => {
+    expect(schema.safeParse({ ...input, extra: true }).success).toBe(false);
+    expect(schema.safeParse({ ...input, tier: 1.5 }).success).toBe(false);
+    expect(schema.safeParse({ ...input, model: undefined }).success).toBe(
+      false,
+    );
+  });
+});
+
+it("keeps provider schemas as separate instances", () => {
+  expect(LlmProviderInputZod).not.toBe(SttProviderInputZod);
+});
