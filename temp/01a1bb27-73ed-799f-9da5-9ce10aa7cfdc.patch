+    --gutter: 24px;
+    overflow: hidden;
+    border-radius: 16px;
+    background: var(--ss-well);
+  }
+
+  /* Pinned top-left with a gutter on the left for the detail card; runs about
+     a third past the right edge and off the bottom. */
