+            (1633889587, _) => Some(AudioFormat::AC3),
+            (1667326771, Some(i)) => {
+                Some(AudioFormat::F60958AC3(StandardFlags::from_bits_truncate(i)))
+            }
+            (1768775988, _) => Some(AudioFormat::AppleIMA4),
+            (1633772320, Some(i)) => Some(AudioFormat::MPEG4AAC(
