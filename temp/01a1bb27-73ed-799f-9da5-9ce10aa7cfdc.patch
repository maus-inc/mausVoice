+    transform: translateY(-8px);
+  }
+
+  .fx-stats {
+    display: grid;
+    grid-template-columns: repeat(3, 1fr);
+    padding-bottom: 20px;
+    border-bottom: 0.5px solid rgba(0, 0, 0, 0.1);
+  }
+
+  .fx-stat {
+    display: grid;
+    gap: 9px;
+    justify-items: start;
+  }
+
+  .fx-desc {
+    display: grid;
+    gap: 11px;
+  }
+
+  .fx-timer {
+    display: grid;
+    align-content: start;
+    gap: 4px;
+    opacity: 0;
+    transform: translateY(10px);
+  }
+
+  .fx-timer[data-show] {
+    opacity: 1;
+    transform: translateY(0);
+    transition-delay: 0.12s;
+  }
+
+  .fx-timer__label {
+    font-size: 15px;
+    font-weight: 600;
+    line-height: 20px;
+    color: var(--ss-accent);
