+import type { TranscribeAudioResult } from "../actions/transcribe.actions";
+import type { TranscriptionSessionResult } from "../types/transcription-session.types";
+import { getLogger } from "../utils/log.utils";
+
+export const hasRecordingAudio = (
+  samples: number[] | Float32Array,
+  sampleRate: number | undefined,
+): sampleRate is number =>
+  sampleRate != null && !(sampleRate <= 0) && samples.length > 0;
+
+export const wholeRecordingResult = (
+  result: TranscribeAudioResult,
+  warnings: string[],
+  source: "batch" | "local",
+): TranscriptionSessionResult => {
+  const count = result.rawTranscript.length;
+  getLogger().info(
+    source === "batch"
+      ? `Batch transcription result: ${count} chars`
+      : `[local-session] transcription complete (${count} chars)`,
+  );
+  return {
+    rawTranscript: result.rawTranscript,
+    metadata: result.metadata,
+    warnings: [...warnings, ...result.warnings],
+  };
+};
