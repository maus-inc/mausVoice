+it("shares an in-flight creation across typed events", async () => {
+  let finish!: () => void;
+  mocks.create.mockImplementationOnce(
+    (value: Conversation) =>
+      new Promise<Conversation>((resolve) => {
+        finish = () => resolve(value);
+      }),
+  );
+  const first = getOrCreateTypedPillConversation("New conversation");
+  const second = getOrCreateTypedPillConversation("New conversation");
+  await vi.waitFor(() => expect(mocks.create).toHaveBeenCalledOnce());
+  finish();
+  const [a, b] = await Promise.all([first, second]);
+  expect(a).toBe(b);
+  expect(getAppState().chat.conversationIds).toEqual([a]);
+  expect(getAppState().pillConversationId).toBe(a);
+});
+
+it("shares a failure and permits retry", async () => {
+  mocks.create.mockRejectedValueOnce(new Error("disk failure"));
+  const results = await Promise.allSettled([
+    getOrCreateTypedPillConversation("New"),
+    getOrCreateTypedPillConversation("New"),
+  ]);
+  expect(results.map((result) => result.status)).toEqual([
+    "rejected",
+    "rejected",
+  ]);
+  await getOrCreateTypedPillConversation("New");
+  expect(mocks.create).toHaveBeenCalledTimes(2);
+});
+
+it("discards a pending typed creation rather than overwrite a newer selection", async () => {
+  let finish!: () => void;
+  let created!: Conversation;
+  mocks.create.mockImplementationOnce((value: Conversation) => {
+    created = value;
+    return new Promise<Conversation>((resolve) => {
+      finish = () => resolve(value);
+    });
+  });
+  const pending = getOrCreateTypedPillConversation("New");
+  await vi.waitFor(() => expect(mocks.create).toHaveBeenCalledOnce());
+  setAppState({ pillConversationId: "other" });
+  finish();
+  await expect(pending).rejects.toThrow("selection changed");
+  expect(getAppState().pillConversationId).toBe("other");
+  expect(mocks.remove).toHaveBeenCalledWith(created.id, expect.anything());
+});
+
+it("does not replace a concurrently completed agent conversation", async () => {
+  let finish!: () => void;
+  let created!: Conversation;
+  mocks.create.mockImplementationOnce((value: Conversation) => {
+    created = value;
+    return new Promise<Conversation>((resolve) => {
+      finish = () => resolve(value);
+    });
+  });
+  const pending = getOrCreateTypedPillConversation("New");
+  await vi.waitFor(() => expect(mocks.create).toHaveBeenCalledOnce());
+  const agent = new AgentStrategy();
+  await agent.onBeforeStart();
+  const selected = getAppState().pillConversationId;
+  finish();
+  await expect(pending).rejects.toThrow("selection changed");
+  expect(getAppState().pillConversationId).toBe(selected);
+  expect(mocks.remove).toHaveBeenCalledWith(created.id, expect.anything());
+});
+
+it("uses an existing selection without creating a row", async () => {
+  setAppState({ pillConversationId: "existing" });
+  await expect(getOrCreateTypedPillConversation("New")).resolves.toBe(
+    "existing",
+  );
+  expect(mocks.create).not.toHaveBeenCalled();
+});
+
+it("a typed conversation winning an overlap cancels the pending agent creation", async () => {
+  let finish!: () => void;
+  let created!: Conversation;
+  mocks.create.mockImplementationOnce((value: Conversation) => {
