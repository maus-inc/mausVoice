+// @vitest-environment jsdom
+import { act, createElement } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { ensureUiHarness } from "../../../test/helpers/jsdom-ui-harness";
+
+const fetchMock = vi.hoisted(() => vi.fn());
+vi.mock("../../utils/secure-fetch.utils", () => ({ secureFetch: fetchMock }));
+vi.mock("react-intl", () => ({
+  FormattedMessage: ({ defaultMessage }: { defaultMessage: string }) =>
+    defaultMessage,
+}));
+vi.mock("./FreeSoloModelAutocomplete", () => ({
+  FreeSoloModelAutocomplete: ({ models }: { models: string[] }) =>
+    models.join(","),
+}));
+import { GroqModelPicker } from "./GroqModelPicker";
+
+ensureUiHarness();
+let container: HTMLDivElement;
+let root: Root;
+const render = (apiKey: string | null) =>
+  act(() =>
+    root.render(
+      createElement(GroqModelPicker, {
+        apiKey,
+        selectedModel: null,
+        onModelSelect: vi.fn(),
+      }),
+    ),
+  );
+const response = (model: string) => ({
+  ok: true,
+  json: async () => ({ data: [{ id: model }] }),
+});
+beforeEach(() => {
+  fetchMock.mockReset();
+  container = document.createElement("div");
+  document.body.appendChild(container);
+  root = createRoot(container);
+});
+afterEach(() => {
+  act(() => root.unmount());
+  container.remove();
+  vi.useRealTimers();
+});
+
+it("retires a previous credential's response, including when switching back", async () => {
+  let finish!: (value: unknown) => void;
+  fetchMock.mockResolvedValueOnce(response("first-model"));
+  render("first");
+  await act(async () => {
+    await Promise.resolve();
+    await Promise.resolve();
+  });
+  expect(container.textContent).toContain("first-model");
+  fetchMock.mockImplementationOnce(
+    () =>
+      new Promise((resolve) => {
+        finish = resolve;
+      }),
+  );
+  render("second");
+  const secondSignal = fetchMock.mock.calls[1]![1].signal as AbortSignal;
+  expect(container.textContent).not.toContain("first-model");
+  fetchMock.mockImplementationOnce(() => new Promise(() => {}));
+  render("first");
+  expect(secondSignal.aborted).toBe(true);
+  expect(container.textContent).toContain("Loading models");
+  expect(container.textContent).not.toContain("first-model");
+  await act(async () => {
+    finish(response("stale-model"));
+    await Promise.resolve();
+  });
+  expect(container.textContent).not.toContain("stale-model");
+});
+
+it("times out a stalled body and ignores its late response", async () => {
+  vi.useFakeTimers();
+  let finish!: (value: unknown) => void;
+  fetchMock.mockResolvedValueOnce({
+    ok: true,
+    json: () =>
+      new Promise((resolve) => {
+        finish = resolve;
+      }),
+  });
+  render("key");
+  await act(async () => {
+    await Promise.resolve();
+  });
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(10_000);
+  });
+  expect(fetchMock.mock.calls[0]![1].signal.aborted).toBe(true);
+  expect(container.textContent).toContain("Unable to fetch models");
+  await act(async () => {
+    finish({ data: [{ id: "late" }] });
+    await Promise.resolve();
+  });
+  expect(container.textContent).not.toContain("late");
+});
+
+it("does not log the raw request error", async () => {
+  const log = vi.spyOn(console, "error").mockImplementation(() => {});
+  try {
+    fetchMock.mockRejectedValueOnce(new Error("opaque-credential-value"));
+    render("key");
+    await act(async () => {
+      await Promise.resolve();
+    });
+    expect(log).toHaveBeenCalledWith("Failed to fetch Groq models");
+    expect(JSON.stringify(log.mock.calls)).not.toContain(
+      "opaque-credential-value",
+    );
+  } finally {
+    log.mockRestore();
+  }
+});
