+        assert!(rx.recv_timeout(Duration::from_millis(30)).is_err());
+        assert!(gate.resume(|| Err("resume failed".into())).is_err());
+        assert!(!rx.recv_timeout(Duration::from_secs(1)).unwrap());
+        worker.join().unwrap();
