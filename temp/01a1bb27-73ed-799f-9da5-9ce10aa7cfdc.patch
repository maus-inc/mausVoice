+.fg-window {
+  position: absolute;
+  left: 40px;
+  top: 40px;
+  width: 780px;
+  height: 540px;
+  box-shadow: var(--ss-shadow-hero);
+}
+
+/* Narrow, the window keeps its size and runs off the left by 58px, so it
+   draws at true scale; the canvas takes the crop, the panel stays whole */
+.fg-window[data-layout="compact"] {
+  left: -58px;
+  top: 20px;
+  width: 400px;
+  height: 500px;
+}
+
+.fg-icon {
