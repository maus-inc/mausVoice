+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+}
+
+/* The refine crossfades each row in place: the new row starts to show as the
+   old one leaves, so no row is ever empty (the kit's Swap holds the new text
+   back for its first 30%, which leaves a blank row mid-swap) */
+.wk-swap .ss-swap__in {
+  animation-name: wk-row-in;
+}
+
+.wk-swap .ss-swap__out {
+  animation-name: wk-row-out;
+}
+
+@keyframes wk-row-in { from { opacity: 0; } to { opacity: 1; } }
+
+@keyframes wk-row-out { to { opacity: 0; } }
+
+.wk-h2 {
+  margin: 18px 0 8px;
+  padding-bottom: 2px;
+  border-bottom: 1px solid var(--wk-border);
+  font-family: var(--wk-serif);
+  font-size: 21px;
+  font-weight: 400;
+  line-height: 1.375;
+}
+
+/* Vector's collapsed page tools are a vertical ellipsis */
+.wk-kebab {
+  transform: rotate(90deg);
+}
+.ss-stage[data-layout="compact"] .wk-header > .wk-spacer {
+  display: none;
+}
+
+/* Picking a result navigates, so the menu goes quickly rather than hanging
+   half-faded over the article underneath (the kit's 0.3s close) */
+.wk-menu.ss-popover:not([data-show]) {
