@@ -0,0 +1,487 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  acquireLocalBrowserRecording,
+  releaseLocalBrowserRecording,
+} from "./local-recording-activity";
+import {
+  beginNativeRecording,
+  currentNativeRecording,
+  discardNativeRecording,
+  invokeStopRecording,
+  pauseNativeRecording,
+  resetNativeRecordingSession,
+  resumeNativeRecording,
+  stopNativeRecording,
+  type NativeRecordingHandle,
+} from "./native-recording-session";
+
+type Call = [string, unknown?];
+
+const recorderTransport = (
+  overrides: Record<string, (args?: unknown) => Promise<unknown>> = {},
+) => {
+  let generation = 0;
+  const calls: Call[] = [];
+  const invoke = vi.fn((command: string, args?: unknown) => {
+    calls.push([command, args]);
+    if (overrides[command]) return overrides[command](args);
+    switch (command) {
+      case "recording_generation":
+        generation += 1;
+        return Promise.resolve(generation);
+      case "start_recording":
+        return Promise.resolve({ sampleRate: 16_000 });
+      case "stop_recording":
+        return Promise.resolve(new ArrayBuffer(4));
+      default:
+        return Promise.resolve(undefined);
+    }
+  });
+  return { invoke, calls };
+};
+
+beforeEach(() => resetNativeRecordingSession());
+
+describe("beginNativeRecording", () => {
+  it("exposes the admission before native capture can emit chunks", async () => {
+    let admitted: NativeRecordingHandle | null = null;
+    const { invoke } = recorderTransport({
+      start_recording: (args) => {
+        expect(admitted).not.toBeNull();
+        expect(args).toMatchObject({
+          ownerId: admitted!.ownerId,
+          generation: admitted!.generation,
+        });
+        return Promise.resolve({ sampleRate: 16_000 });
+      },
+    });
+    const { handle } = await beginNativeRecording(
+      null,
+      {
+        onAdmission: (next) => {
+          admitted = next;
+        },
+      },
+      invoke,
+    );
+    expect(admitted).toBe(handle);
+    await handle.discard();
+  });
+
+  it("cleans up an admission callback failure without opening capture", async () => {
+    const { invoke, calls } = recorderTransport();
+    await expect(
+      beginNativeRecording(
+        null,
+        {
+          onAdmission: () => {
+            throw new Error("admission setup failed");
+          },
+        },
+        invoke,
+      ),
+    ).rejects.toThrow("admission setup failed");
+    expect(calls.some(([command]) => command === "start_recording")).toBe(
+      false,
+    );
+    expect(calls.some(([command]) => command === "discard_recording")).toBe(
+      true,
+    );
+    expect(currentNativeRecording()).toBeNull();
+    const browserOwner = {};
+    expect(acquireLocalBrowserRecording(invoke, browserOwner)).toBe(true);
+    releaseLocalBrowserRecording(invoke, browserOwner);
+  });
+
+  it("reserves a generation and starts under it", async () => {
+    const { invoke, calls } = recorderTransport();
+    const { sampleRate, handle } = await beginNativeRecording(
+      "mic-1",
+      {},
+      invoke,
+    );
+
+    expect(sampleRate).toBe(16_000);
+    expect(handle.generation).toBe(1);
+    expect(calls).toEqual([
+      ["recording_generation", { ownerId: handle.ownerId }],
+      [
+        "start_recording",
+        {
+          ownerId: handle.ownerId,
+          generation: 1,
+          args: { preferredMicrophone: "mic-1" },
+        },
+      ],
+    ]);
+    expect(currentNativeRecording()).toBe(handle);
+  });
+
+  it("passes waitForRelease through to the start", async () => {
+    const { invoke, calls } = recorderTransport();
+    await beginNativeRecording(null, { waitForRelease: true }, invoke);
+    expect(calls[1]?.[1]).toMatchObject({
+      args: { preferredMicrophone: null, waitForRelease: true },
+    });
+  });
+
+  it("rejects a generation the transport did not really hand out", async () => {
+    const { invoke } = recorderTransport({
+      recording_generation: () => Promise.resolve(undefined),
+    });
+    await expect(beginNativeRecording(null, {}, invoke)).rejects.toThrow(
+      "Invalid recording generation",
+    );
+    expect(currentNativeRecording()).toBeNull();
+  });
+
+  it("discards a superseded recording before admitting a new one", async () => {
+    const { invoke, calls } = recorderTransport();
+    const first = await beginNativeRecording(null, {}, invoke);
+    const second = await beginNativeRecording(null, {}, invoke);
+
+    expect(calls.map(([command]) => command)).toEqual([
+      "recording_generation",
+      "start_recording",
+      // The superseded stream is released before a second admission exists.
+      "discard_recording",
+      "recording_generation",
+      "start_recording",
+    ]);
+    expect(calls[2]?.[1]).toEqual({
+      ownerId: first.handle.ownerId,
+      generation: first.handle.generation,
+    });
+    expect(currentNativeRecording()).toBe(second.handle);
+  });
+
+  it("refuses another start while the first admission is pending", async () => {
+    let releaseGeneration!: (generation: number) => void;
+    const pendingGeneration = new Promise<number>((resolve) => {
+      releaseGeneration = resolve;
+    });
+    let requests = 0;
+    const { invoke } = recorderTransport({
+      recording_generation: () =>
+        ++requests === 1 ? pendingGeneration : Promise.resolve(2),
+    });
+
+    const first = beginNativeRecording(null, {}, invoke);
+    const second = beginNativeRecording(null, {}, invoke);
+    await expect(second).rejects.toThrow(
+      "A recording start is already in progress",
+    );
+    releaseGeneration(1);
+    const { handle } = await first;
+    expect(currentNativeRecording()).toBe(handle);
+    expect(handle.isLive()).toBe(true);
+    await handle.discard();
+  });
+
+  it("keeps the start guard through cleanup and releases it after failure", async () => {
+    let rejectStart!: (error: Error) => void;
+    let releaseDiscard!: () => void;
+    const start = new Promise<unknown>((_, reject) => {
+      rejectStart = reject;
+    });
+    const discard = new Promise<void>((resolve) => {
+      releaseDiscard = resolve;
+    });
+    const { invoke } = recorderTransport({
+      start_recording: () => start,
+      discard_recording: () => discard,
+    });
+
+    const first = beginNativeRecording(null, {}, invoke);
+    const firstFailure = expect(first).rejects.toThrow("no mic");
+    await vi.waitFor(() =>
+      expect(invoke).toHaveBeenCalledWith("start_recording", expect.anything()),
+    );
+    rejectStart(new Error("no mic"));
+    await vi.waitFor(() =>
+      expect(invoke).toHaveBeenCalledWith(
+        "discard_recording",
+        expect.anything(),
+      ),
+    );
+    await expect(beginNativeRecording(null, {}, invoke)).rejects.toThrow(
+      "A recording start is already in progress",
+    );
+    releaseDiscard();
+    await firstFailure;
+    const next = recorderTransport();
+    const { handle } = await beginNativeRecording(null, {}, next.invoke);
+    expect(handle.isLive()).toBe(true);
+    await handle.discard();
+  });
+
+  it("releases the recorder when the start fails", async () => {
+    const { invoke, calls } = recorderTransport({
+      start_recording: () => Promise.reject(new Error("no mic")),
+    });
+    await expect(beginNativeRecording(null, {}, invoke)).rejects.toThrow(
+      "no mic",
+    );
+    expect(calls.map(([command]) => command)).toContain("discard_recording");
+    expect(currentNativeRecording()).toBeNull();
+  });
+
+  it("rejects an unusable start reply and releases the recorder", async () => {
+    const { invoke, calls } = recorderTransport({
+      start_recording: () => Promise.resolve({}),
+    });
+    await expect(beginNativeRecording(null, {}, invoke)).rejects.toThrow(
+      "Invalid recording start response",
+    );
+    expect(calls.map(([command]) => command)).toContain("discard_recording");
+  });
+});
+
+describe("stopping", () => {
+  it("presents the admission and acknowledges the audio", async () => {
+    const { invoke, calls } = recorderTransport();
+    const { handle } = await beginNativeRecording(null, {}, invoke);
+
+    await stopNativeRecording(invoke);
+
+    expect(calls.slice(2)).toEqual([
+      [
+        "stop_recording",
+        { ownerId: handle.ownerId, generation: handle.generation },
+      ],
+      [
+        "acknowledge_recording",
+        { ownerId: handle.ownerId, generation: handle.generation },
+      ],
+    ]);
+    expect(currentNativeRecording()).toBeNull();
+  });
+
+  it("a stalled acknowledgement does not hold the admission", async () => {
+    // CodeAnt Major: acknowledge_recording only drops native's recovery copy.
+    // If it never settles, the stop must still resolve and free the local
+    // admission so a later start cannot wait on it forever.
+    const { invoke, calls } = recorderTransport({
+      acknowledge_recording: () => new Promise<never>(() => {}),
+    });
+    await beginNativeRecording(null, {}, invoke);
+
+    const stopping = await Promise.race([
+      stopNativeRecording(invoke).then(() => "settled" as const),
+      new Promise<"stalled">((resolve) =>
+        setTimeout(() => resolve("stalled"), 500),
+      ),
+    ]);
+    expect(stopping).toBe("settled");
+
+    const starting = await Promise.race([
+      beginNativeRecording(null, {}, invoke).then(() => "started" as const),
+      new Promise<"stalled">((resolve) =>
+        setTimeout(() => resolve("stalled"), 500),
+      ),
+    ]);
+    expect(starting).toBe("started");
+    expect(calls.map(([command]) => command)).toContain(
+      "acknowledge_recording",
+    );
+  });
+
+  it("drops the audio and its admission on discard", async () => {
+    const { invoke, calls } = recorderTransport();
+    const { handle } = await beginNativeRecording(null, {}, invoke);
+
+    await discardNativeRecording();
+
+    expect(calls.at(-1)).toEqual([
+      "discard_recording",
+      { ownerId: handle.ownerId, generation: handle.generation },
+    ]);
+    expect(currentNativeRecording()).toBeNull();
+  });
+
+  it("does nothing when no recording is live", async () => {
+    const { invoke } = recorderTransport();
+    await expect(stopNativeRecording(invoke)).resolves.toEqual({
+      samples: new Float32Array(0),
+      sampleRate: 0,
+    });
+    expect(invoke).not.toHaveBeenCalled();
+  });
+
+  it("waits for the older stop before admitting a successor", async () => {
+    let resolveStop!: (payload: ArrayBuffer) => void;
+    const stop = new Promise<ArrayBuffer>((resolve) => {
+      resolveStop = resolve;
+    });
+    const { invoke, calls } = recorderTransport({ stop_recording: () => stop });
+    await beginNativeRecording(null, {}, invoke);
+    const stopping = stopNativeRecording(invoke);
+    const starting = beginNativeRecording(null, {}, invoke);
+    await Promise.resolve();
+    expect(
+      calls.filter(([command]) => command === "recording_generation"),
+    ).toHaveLength(1);
+
+    resolveStop(new ArrayBuffer(4));
+    await stopping;
+    const { handle: successor } = await starting;
+    expect(currentNativeRecording()).toBe(successor);
+    expect(acquireLocalBrowserRecording(invoke, {})).toBe(false);
+    await successor.discard();
+    const browserOwner = {};
+    expect(acquireLocalBrowserRecording(invoke, browserOwner)).toBe(true);
+    releaseLocalBrowserRecording(invoke, browserOwner);
+  });
+
+  it("shares a pending stop instead of reporting an empty recording", async () => {
+    let resolveStop!: (payload: ArrayBuffer) => void;
+    const stop = new Promise<ArrayBuffer>((resolve) => {
+      resolveStop = resolve;
+    });
+    const { invoke, calls } = recorderTransport({ stop_recording: () => stop });
+    await beginNativeRecording(null, {}, invoke);
+    const first = stopNativeRecording(invoke);
+    const second = stopNativeRecording(invoke);
+    resolveStop(new ArrayBuffer(4));
+    expect(await first).toEqual(await second);
+    expect(
+      calls.filter(([command]) => command === "stop_recording"),
+    ).toHaveLength(1);
+  });
+
+  it("clears the in-flight stop when a transport throws synchronously", async () => {
+    const { invoke } = recorderTransport();
+    const { handle } = await beginNativeRecording(null, {}, invoke);
+    const throwing = () => {
+      throw new Error("synchronous failure");
+    };
+    await expect(stopNativeRecording(throwing)).rejects.toThrow(
+      "synchronous failure",
+    );
+    expect(currentNativeRecording()).toBe(handle);
+    await stopNativeRecording(invoke);
+    const browserOwner = {};
+    expect(acquireLocalBrowserRecording(invoke, browserOwner)).toBe(true);
+    releaseLocalBrowserRecording(invoke, browserOwner);
+  });
+
+  it("does not orphan a failed stop when a successor begins", async () => {
+    let rejectStop!: (error: Error) => void;
+    const stop = new Promise<ArrayBuffer>((_, reject) => {
+      rejectStop = reject;
+    });
+    let stopCalls = 0;
+    const { invoke } = recorderTransport({
+      stop_recording: () =>
+        ++stopCalls === 1 ? stop : Promise.resolve(new ArrayBuffer(4)),
+    });
+    const { handle } = await beginNativeRecording(null, {}, invoke);
+    const stopping = stopNativeRecording(invoke);
+    const stopFailure = expect(stopping).rejects.toThrow("transport down");
+    const successor = beginNativeRecording(null, {}, invoke);
+    const successorFailure =
+      expect(successor).rejects.toThrow("transport down");
+    rejectStop(new Error("transport down"));
+    await stopFailure;
+    await successorFailure;
+    expect(currentNativeRecording()).toBe(handle);
+    await stopNativeRecording(invoke);
+    const browserOwner = {};
+    expect(acquireLocalBrowserRecording(invoke, browserOwner)).toBe(true);
+    releaseLocalBrowserRecording(invoke, browserOwner);
+  });
+
+  it("discards the same admission if a pending stop fails during abort", async () => {
+    let rejectStop!: (error: Error) => void;
+    const stop = new Promise<ArrayBuffer>((_, reject) => {
+      rejectStop = reject;
+    });
+    const { invoke, calls } = recorderTransport({ stop_recording: () => stop });
+    const { handle } = await beginNativeRecording(null, {}, invoke);
+    const stopping = stopNativeRecording(invoke);
+    const failure = expect(stopping).rejects.toThrow("stop failed");
+    const discarding = discardNativeRecording();
+    rejectStop(new Error("stop failed"));
+    await failure;
+    await discarding;
+    expect(
+      calls.filter(([command]) => command === "discard_recording"),
+    ).toEqual([
+      [
+        "discard_recording",
+        { ownerId: handle.ownerId, generation: handle.generation },
+      ],
+    ]);
+    expect(currentNativeRecording()).toBeNull();
+  });
+
+  it("does not discard a successor if the pending stop succeeds", async () => {
+    let resolveStop!: (payload: ArrayBuffer) => void;
+    const stop = new Promise<ArrayBuffer>((resolve) => {
+      resolveStop = resolve;
+    });
+    const { invoke, calls } = recorderTransport({ stop_recording: () => stop });
+    await beginNativeRecording(null, {}, invoke);
+    const stopping = stopNativeRecording(invoke);
+    const starting = beginNativeRecording(null, {}, invoke);
+    const discarding = discardNativeRecording();
+    resolveStop(new ArrayBuffer(4));
+    await stopping;
+    const { handle: successor } = await starting;
+    await discarding;
+    expect(currentNativeRecording()).toBe(successor);
+    expect(
+      calls.filter(([command]) => command === "discard_recording"),
+    ).toHaveLength(0);
+    await successor.discard();
+  });
+
+  it("keeps a failed stop addressable for a later retry", async () => {
+    const { invoke } = recorderTransport();
+    const { handle } = await beginNativeRecording(null, {}, invoke);
+    const failing = recorderTransport({
+      stop_recording: () => Promise.reject(new Error("transport down")),
+    });
+
+    await expect(stopNativeRecording(failing.invoke)).rejects.toThrow(
+      "transport down",
+    );
+    expect(currentNativeRecording()).toBe(handle);
+  });
+});
+
+describe("pause and resume", () => {
+  it("addresses the live admission", async () => {
+    const { invoke, calls } = recorderTransport();
+    const { handle } = await beginNativeRecording(null, {}, invoke);
+
+    await pauseNativeRecording(invoke);
+    await resumeNativeRecording(invoke);
+
+    expect(calls.slice(2)).toEqual([
+      ["pause_recording", { ownerId: handle.ownerId, generation: 1 }],
+      ["resume_recording", { ownerId: handle.ownerId, generation: 1 }],
+    ]);
+  });
+
+  it("refuses to control a recorder it does not own", async () => {
+    const { invoke } = recorderTransport();
+    await expect(pauseNativeRecording(invoke)).rejects.toThrow(
+      "No native recording is active",
+    );
+  });
+});
+
+describe("invokeStopRecording", () => {
+  it("decodes what an injected transport returned", async () => {
+    const payload = new Uint8Array(8);
+    new DataView(payload.buffer).setUint32(0, 16_000, true);
+    new DataView(payload.buffer).setFloat32(4, 0.5, true);
+    const invokeFn = vi.fn(() => Promise.resolve(payload));
+
+    const decoded = await invokeStopRecording(invokeFn);
+
+    expect(invokeFn).toHaveBeenCalledWith("stop_recording");
+    expect(Array.from(decoded.samples)).toEqual([0.5]);
+  });
+});
diff --git a/apps/desktop/src/utils/native-recording-session.ts b/apps/desktop/src/utils/native-recording-session.ts
new file mode 100644
index 00000000..54180a89
--- /dev/null
+++ b/apps/desktop/src/utils/native-recording-session.ts
@@ -0,0 +1,332 @@
+import { invoke } from "@tauri-apps/api/core";
+import type { StopRecordingResponse } from "../types/transcription-session.types";
+import { createId } from "./id.utils";
+import { getLogger } from "./log.utils";
+import {
+  acquireLocalNativeRecording,
+  releaseLocalNativeRecording,
+} from "./local-recording-activity";
+import { decodeStopRecordingPayload } from "./recorded-audio.utils";
+
+export type RecordingInvoke = (
+  command: string,
+  args?: Record<string, unknown>,
+) => Promise<unknown>;
+
+/**
+ * One recording the native recorder has admitted.
+ *
+ * Native hands out a `(ownerId, generation)` admission and refuses every
+ * command that touches the recorder unless it presents that same pair. Holding
+ * the pair on the handle means a component that stops late — after an abort, a
+ * restart, or an unmount — can only ever address the stream it opened: native
+ * answers a stale pair with a mismatch instead of cutting a newer recording's
+ * stream.
+ */
+export type NativeRecordingHandle = {
+  readonly ownerId: string;
+  readonly generation: number;
+  /** Stop the recorder and return its audio. */
+  stop: () => Promise<StopRecordingResponse>;
+  /** Stop the recorder and throw its audio away. */
+  discard: () => Promise<void>;
+  pause: () => Promise<void>;
+  resume: () => Promise<void>;
+  /** Whether this handle is still the one the recorder is owned by. */
+  isLive: () => boolean;
+};
+
+export type NativeRecordingStartOptions = {
+  waitForRelease?: boolean;
+  /** Called after reserving an owner, before capture can emit its first chunk. */
+  onAdmission?: (handle: NativeRecordingHandle) => void;
+};
+
+// The generation is a `u64` on the Rust side; `Number.MAX_SAFE_INTEGER` is the
+// largest value a JS number carries exactly.
+const MAX_SAFE_GENERATION = Number.MAX_SAFE_INTEGER;
+
+const EMPTY_RESULT = (): StopRecordingResponse => ({
+  samples: new Float32Array(0),
+  sampleRate: 0,
+});
+
+/** The recorder this module owns, if a recording is live. */
+let liveHandle: NativeRecordingHandle | null = null;
+
+/** The in-webview slot token and transport that live handle holds, if any. */
+let liveLocalOwner: { owner: object; transport: RecordingInvoke } | null = null;
+
+let beginInFlight = false;
+let stopInFlight: Promise<StopRecordingResponse> | null = null;
+let stoppingHandle: NativeRecordingHandle | null = null;
+
+/** The recorder this module currently owns, if any. */
+export const currentNativeRecording = (): NativeRecordingHandle | null =>
+  liveHandle;
+
+/** Test seam: forget the tracked recording without touching native. */
+export const resetNativeRecordingSession = (): void => {
+  liveHandle = null;
+  liveLocalOwner = null;
+  stopInFlight = null;
+  stoppingHandle = null;
+};
+
+const isSafeGeneration = (value: unknown): value is number =>
+  typeof value === "number" &&
+  Number.isInteger(value) &&
+  value >= 0 &&
+  value <= MAX_SAFE_GENERATION;
+
+const sampleRateFromStartResponse = (result: unknown): number => {
+  if (!result || typeof result !== "object" || !("sampleRate" in result)) {
+    throw new Error("Invalid recording start response");
+  }
+  const { sampleRate } = result as { sampleRate: unknown };
+  if (!isSafeGeneration(sampleRate) || sampleRate === 0) {
+    throw new Error("Invalid recording start response");
+  }
+  return sampleRate;
+};
+
+/**
+ * Open the microphone under a fresh native admission.
+ *
+ * A recording left live by a superseded start is discarded first: native admits
+ * one owner at a time, and inheriting the old stream is the bug the admission
+ * exists to prevent.
+ */
+export const beginNativeRecording = async (
+  preferredMicrophone: string | null,
+  options: NativeRecordingStartOptions = {},
+  invokeFn: RecordingInvoke = invoke,
+): Promise<{ sampleRate: number; handle: NativeRecordingHandle }> => {
+  if (beginInFlight)
+    throw new Error("A recording start is already in progress");
+  beginInFlight = true;
+  try {
+    return await beginNativeRecordingOwned(
+      preferredMicrophone,
+      options,
+      invokeFn,
+    );
+  } finally {
+    beginInFlight = false;
+  }
+};
+
+const beginNativeRecordingOwned = async (
+  preferredMicrophone: string | null,
+  options: NativeRecordingStartOptions,
+  invokeFn: RecordingInvoke,
+): Promise<{ sampleRate: number; handle: NativeRecordingHandle }> => {
+  // A stop may still fail after the native command was sent. Wait for its
+  // result before replacing the only handle that can retry that admission.
+  if (stopInFlight) await stopInFlight;
+  const superseded = liveHandle;
+  if (superseded) {
+    await superseded.discard().catch((error: unknown) => {
+      getLogger().warning(`Failed to discard a superseded recording: ${error}`);
+    });
+  }
+
+  // The browser recognizer holds the same in-webview slot, so a dictation
+  // started while it listens is refused here instead of opening a second
+  // capture beside it.
+  const localOwner = {};
+  if (!acquireLocalNativeRecording(invokeFn, localOwner)) {
+    throw new Error("A recording is already in progress");
+  }
+  const releaseLocal = () => {
+    releaseLocalNativeRecording(invokeFn, localOwner);
+    if (liveLocalOwner?.owner === localOwner) liveLocalOwner = null;
+  };
+  const ownerId = createId();
+  let reserved: unknown;
+  try {
+    reserved = await invokeFn("recording_generation", { ownerId });
+  } catch (error) {
+    releaseLocal();
+    throw error;
+  }
+  if (!isSafeGeneration(reserved)) {
+    releaseLocal();
+    throw new Error("Invalid recording generation");
+  }
+
+  let settled = false;
+  const handle: NativeRecordingHandle = {
+    ownerId,
+    generation: reserved,
+    isLive: () => liveHandle === handle && !settled,
+    stop: async () => {
+      const payload = await invokeFn("stop_recording", {
+        ownerId,
+        generation: reserved,
+      });
+      settled = true;
+      if (liveHandle === handle) liveHandle = null;
+      const decoded = decodeStopRecordingPayload(payload);
+      releaseLocal();
+      // Acknowledging only drops the recovery copy native kept for a lost
+      // reply; it never stops the recorder, so a failure here costs a retained
+      // buffer, not audio. Issue it detached: a stalled acknowledgement must
+      // not hold the local admission, and native expires an unacknowledged
+      // copy on its own.
+      void invokeFn("acknowledge_recording", {
+        ownerId,
+        generation: reserved,
+      }).catch((error: unknown) => {
+        getLogger().verbose(`acknowledge_recording failed: ${error}`);
+      });
+      return decoded;
+    },
+    discard: async () => {
+      settled = true;
+      if (liveHandle === handle) liveHandle = null;
+      try {
+        await invokeFn("discard_recording", { ownerId, generation: reserved });
+      } finally {
+        // Native answers a refused discard with a mismatch, so the slot is
+        // released here even when the call failed: a stale handle is exactly
+        // what a browser-recognition start must not be blocked by.
+        releaseLocal();
+      }
+    },
+    pause: async () => {
+      await invokeFn("pause_recording", { ownerId, generation: reserved });
+    },
+    resume: async () => {
+      await invokeFn("resume_recording", { ownerId, generation: reserved });
+    },
+  };
+
+  liveHandle = handle;
+  liveLocalOwner = { owner: localOwner, transport: invokeFn };
+  try {
+    options.onAdmission?.(handle);
+    const response = await invokeFn("start_recording", {
+      ownerId,
+      generation: reserved,
+      args: {
+        preferredMicrophone,
+        ...(options.waitForRelease ? { waitForRelease: true } : {}),
+      },
+    });
+    return { sampleRate: sampleRateFromStartResponse(response), handle };
+  } catch (error) {
+    // The start may have opened the device before it failed; a discard is the
+    // only call that proves the recorder is released again.
+    await handle.discard().catch(() => undefined);
+    releaseLocal();
+    throw error;
+  }
+};
+
+/**
+ * Stop the live recording and return its audio.
+ *
+ * These are the teardown paths that have no handle in scope (a clear request,
+ * an unmount, a settings action). They deliberately address whatever recording
+ * is live rather than a specific owner.
+ */
+export const stopNativeRecording = (
+  invokeFn: RecordingInvoke = invoke,
+): Promise<StopRecordingResponse> => {
+  if (stopInFlight) return stopInFlight;
+  const handle = liveHandle;
+  if (!handle) return Promise.resolve(EMPTY_RESULT());
+  const localOwner = liveLocalOwner;
+  liveHandle = null;
+  // Defer invoking the transport until the in-flight promise is published,
+  // including when a test or preview transport throws synchronously.
+  const operation = Promise.resolve().then(async () => {
+    try {
+      const payload = await invokeFn("stop_recording", {
+        ownerId: handle.ownerId,
+        generation: handle.generation,
+      });
+      const decoded = decodeStopRecordingPayload(payload);
+      if (localOwner) {
+        releaseLocalNativeRecording(localOwner.transport, localOwner.owner);
+        if (liveLocalOwner === localOwner) liveLocalOwner = null;
+      }
+      // The acknowledgement only drops native's recovery copy, and native
+      // expires it on its own: a stalled ack must not keep stopInFlight set,
+      // or every later start would wait on it forever.
+      void invokeFn("acknowledge_recording", {
+        ownerId: handle.ownerId,
+        generation: handle.generation,
+      }).catch((error: unknown) => {
+        getLogger().verbose(`acknowledge_recording failed: ${error}`);
+      });
+      return decoded;
+    } catch (error) {
+      // Keep the handle addressable so a retry can still release the recorder.
+      liveHandle = liveHandle ?? handle;
+      throw error;
+    }
+  });
+  stopInFlight = operation;
+  stoppingHandle = handle;
+  return operation.finally(() => {
+    if (stopInFlight === operation) {
+      stopInFlight = null;
+      stoppingHandle = null;
+    }
+  });
+};
+
+/** Stop the live recording and throw its audio away. */
+export const discardNativeRecording = async (): Promise<void> => {
+  const pendingStop = stopInFlight;
+  const stoppedHandle = stoppingHandle;
+  if (pendingStop) {
+    try {
+      await pendingStop;
+      // A successful stop has released this admission. Never discard a newer one.
+      return;
+    } catch {
+      // The failed stop restores its handle, but it must still be the same
+      // admission when this abort resumes.
+      if (!stoppedHandle || liveHandle !== stoppedHandle) return;
+    }
+  }
+  const handle = liveHandle;
+  if (!handle) return;
+  liveHandle = null;
+  await handle.discard().catch((error: unknown) => {
+    getLogger().verbose(`discard_recording failed: ${error}`);
+  });
+};
+
+/**
+ * Stop the live recording and decode its reply, or, when a caller injects its
+ * own transport (tests, preview), just decode what that transport returned.
+ */
+export const invokeStopRecording = async (
+  invokeFn?: RecordingInvoke,
+): Promise<StopRecordingResponse> =>
+  invokeFn
+    ? decodeStopRecordingPayload(await invokeFn("stop_recording"))
+    : stopNativeRecording();
+
+const controlLive = async (invokeFn: RecordingInvoke, command: string) => {
+  const handle = liveHandle;
+  if (!handle) {
+    throw new Error("No native recording is active");
+  }
+  await invokeFn(command, {
+    ownerId: handle.ownerId,
+    generation: handle.generation,
+  });
+};
+
+export const pauseNativeRecording = (
+  invokeFn: RecordingInvoke = invoke,
+): Promise<void> => controlLive(invokeFn, "pause_recording");
+
+export const resumeNativeRecording = (
+  invokeFn: RecordingInvoke = invoke,
+): Promise<void> => controlLive(invokeFn, "resume_recording");
