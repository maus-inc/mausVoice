+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { Observable, of } from "rxjs";
+import { expect, it, vi } from "vitest";
+import { useStream } from "./stream.hooks";
+
+it("does not subscribe when an asynchronous builder resolves after unmount", async () => {
+  let resolve!: (stream: Observable<string>) => void;
+  const builder = () =>
+    new Promise<Observable<string>>((r) => {
+      resolve = r;
+    });
+  const subscribe = vi.fn();
+  const Probe = () => {
+    useStream(builder, []);
+    return null;
+  };
+  const container = document.createElement("div");
+  const root = createRoot(container);
+  await act(async () => root.render(<Probe />));
+  await act(async () => root.unmount());
+  await act(async () =>
+    resolve(
+      new Observable<string>(() => {
+        subscribe();
+      }),
+    ),
+  );
+  expect(subscribe).not.toHaveBeenCalled();
+});
+
+it("ignores a rejected builder superseded by a newer stream", async () => {
+  let reject!: (reason: Error) => void;
+  const pending = new Promise<Observable<string>>((_resolve, r) => {
+    reject = r;
+  });
+  let result: ReturnType<typeof useStream<string>> | undefined;
+  const Probe = ({ version }: { version: number }) => {
+    result = useStream(() => (version === 1 ? pending : of("new")), [version]);
+    return null;
+  };
+  const root = createRoot(document.createElement("div"));
+  await act(async () => root.render(<Probe version={1} />));
+  await act(async () => root.render(<Probe version={2} />));
+  await act(async () => reject(new Error("stale")));
+  expect(result).toEqual({ status: "success", data: "new" });
+  await act(async () => root.unmount());
+});
