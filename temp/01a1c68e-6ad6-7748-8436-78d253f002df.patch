+    const request = vi.fn(async (input: RequestInfo | URL) => {
+      const url = String(input);
+      if (url.endsWith("/upload"))
+        return Response.json({ upload_url: "https://upload.test/audio" });
+      if (url.endsWith("/transcript")) return Response.json({ id: "123" });
+      return Response.json({ status: "completed", text: "hello" });
+    });
+    await expect(
+      assemblyaiTranscribeAudio({
+        apiKey: "key",
+        blob: new ArrayBuffer(1),
+        customFetch: request,
+        timeoutMs: 2_147_483_648,
+      }),
+    ).rejects.toThrow(
