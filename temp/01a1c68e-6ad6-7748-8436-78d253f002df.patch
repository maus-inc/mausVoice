+name: Test Python Developer Tools
+
+on:
+  push:
+    paths:
+      - "scripts/prompts.py"
+      - "scripts/translate.py"
+      - "scripts/urlcheck.py"
+      - "scripts/tests/**"
+      - "req.txt"
+      - ".github/workflows/test-python-tools.yml"
+  pull_request:
+    paths:
+      - "scripts/prompts.py"
+      - "scripts/translate.py"
+      - "scripts/urlcheck.py"
+      - "scripts/tests/**"
+      - "req.txt"
+      - ".github/workflows/test-python-tools.yml"
+  workflow_dispatch:
+
+permissions: {}
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
+    steps:
+      - name: Checkout source
+        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
+      - name: Set up Python
+        uses: actions/setup-python@e797f83bcb11b83ae66e0230d6156d7c80228e7c # v6.0.0
+        with:
+          python-version: "3.11"
+      - name: Install pinned developer-tool dependencies
+        run: python -m pip install -r req.txt
+      - name: Test developer tools without credentials
+        env:
+          PYTHON_DOTENV_DISABLED: "1"
+        run: python -m unittest discover -s scripts/tests -p 'test_*.py' -v
