+import io
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+SCRIPTS = Path(__file__).resolve().parents[1]
+os.environ["PYTHON_DOTENV_DISABLED"] = "1"
+sys.path.insert(0, str(SCRIPTS))
+
+import translate  # noqa: E402
+
+
+class DeveloperToolSmokeTests(unittest.TestCase):
+    def test_cli_help_and_model_list_need_no_credentials(self):
+        env = os.environ.copy()
+        env.pop("GROQ_API_KEY", None)
+        env.pop("OPENAI_API_KEY", None)
+        for script, args, expected in (
+            ("prompts.py", ["--help"], "usage:"),
+            ("prompts.py", ["list"], "Ollama models:"),
+            ("translate.py", ["--help"], "usage:"),
+            ("urlcheck.py", [], "ok"),
+        ):
+            with self.subTest(script=script, args=args):
+                result = subprocess.run(
+                    [sys.executable, str(SCRIPTS / script), *args],
+                    capture_output=True,
+                    text=True,
+                    env=env,
+                    timeout=15,
+                    check=False,
+                )
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertIn(expected, result.stdout)
+
+    def test_translation_retries_non_string_and_blank_results(self):
+        messages = [
+            SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(content=content))])
+            for content in ('{"translation": 7}', '{"translation": "   "}', '{"translation": "Hallo"}')
+        ]
+        create = Mock(side_effect=messages)
+        client = SimpleNamespace(chat=SimpleNamespace(completions=SimpleNamespace(create=create)))
+        with patch("builtins.print"):
+            result = translate.translate_text(client, "Hello", "German")
+        self.assertEqual(result, "Hallo")
+        self.assertEqual(create.call_count, 3)
+
+    def test_translation_errors_do_not_echo_provider_exception_secrets(self):
+        secret = "sk-private-test-value"
+        create = Mock(side_effect=RuntimeError(f"request failed with api_key={secret}"))
+        client = SimpleNamespace(chat=SimpleNamespace(completions=SimpleNamespace(create=create)))
+        output = io.StringIO()
+        with redirect_stdout(output), self.assertRaises(RuntimeError) as caught:
+            translate.translate_text(client, "Hello", "German", max_retries=2)
+        self.assertNotIn(secret, output.getvalue())
+        self.assertNotIn(secret, str(caught.exception))
+        self.assertEqual(create.call_count, 2)
+        self.assertIn("API error", str(caught.exception))
+
+    def test_dry_run_never_extracts_or_requires_credentials(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            (root / "en.json").write_text('{"hello": "Hello"}\n', encoding="utf-8")
+            (root / "de.json").write_text('{"hello": "Hallo"}\n', encoding="utf-8")
+            config = {"app_dir": root, "locales_dir": root, "i18n_command": ["pnpm", "run", "i18n"], "format": "json"}
+            original = {p.name: p.read_bytes() for p in root.iterdir()}
+            for api_key in ("", "test-key"):
+                with self.subTest(api_key_present=bool(api_key)):
+                    output = io.StringIO()
+                    with patch.dict(translate.APP_CONFIGS, {"desktop": config}), \
+                         patch.dict(os.environ, {"GROQ_API_KEY": api_key}), \
+                         patch.object(sys, "argv", ["translate.py", "desktop", "--dry-run"]), \
+                         patch.object(translate.subprocess, "run") as run, \
+                         patch.object(translate, "Groq") as groq, redirect_stdout(output):
+                        translate.main()
+                    run.assert_not_called()
+                    groq.assert_not_called()
+                    self.assertEqual({p.name: p.read_bytes() for p in root.iterdir()}, original)
+                    self.assertIn("exact", output.getvalue().lower())
+                    self.assertIn("i18n", output.getvalue().lower())
+
+    def test_web_dry_run_lists_existing_untranslated_keys_without_credentials(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            (root / "en.ts").write_text('export const en = { greeting: "Hello" } as const satisfies Messages;', encoding="utf-8")
+            (root / "de.ts").write_text('export const de = { greeting: "Hello" } as const satisfies Messages;', encoding="utf-8")
+            config = {"app_dir": root, "locales_dir": root, "i18n_command": None, "format": "ts"}
+            original = {p.name: p.read_bytes() for p in root.iterdir()}
+            output = io.StringIO()
+            with patch.dict(translate.APP_CONFIGS, {"web": config}), \
+                 patch.dict(os.environ, {"GROQ_API_KEY": ""}), \
+                 patch.object(sys, "argv", ["translate.py", "web", "--dry-run"]), \
+                 patch.object(translate, "Groq") as groq, redirect_stdout(output):
+                translate.main()
+            groq.assert_not_called()
+            self.assertEqual({p.name: p.read_bytes() for p in root.iterdir()}, original)
+            self.assertIn("greeting", output.getvalue())
+
+    def test_failed_translation_reports_failure_without_losing_successes(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            en_path = root / "en.json"
+            de_path = root / "de.json"
+            en_path.write_text(json.dumps({"good": "Hello", "bad": "Goodbye"}), encoding="utf-8")
+            de_path.write_text(json.dumps({"good": "Alt", "bad": "Alt"}), encoding="utf-8")
+            config = {"app_dir": root, "locales_dir": root, "i18n_command": ["pnpm", "run", "i18n"], "format": "json"}
+            def extract(*_args, **_kwargs):
+                de_path.write_text(en_path.read_text(encoding="utf-8"), encoding="utf-8")
+            output = io.StringIO()
+            with patch.dict(translate.APP_CONFIGS, {"desktop": config}), \
+                 patch.dict(os.environ, {"GROQ_API_KEY": "test-key"}), \
+                 patch.object(sys, "argv", ["translate.py", "desktop"]), \
+                 patch.object(translate.subprocess, "run", side_effect=extract), \
+                 patch.object(translate, "Groq"), \
+                 patch.object(translate, "translate_text", side_effect=["Hallo", RuntimeError("failed")]), \
+                 redirect_stdout(output):
+                with self.assertRaises(SystemExit) as exited:
+                    translate.main()
+            self.assertEqual(exited.exception.code, 1)
+            self.assertEqual(json.loads(de_path.read_text(encoding="utf-8")), {"good": "Hallo", "bad": "Goodbye"})
+            self.assertIn("incomplete", output.getvalue().lower())
+            self.assertIn("de: bad", output.getvalue())
+            self.assertIn("--retry-untranslated", output.getvalue())
+
+    def test_json_retry_untranslated_selects_english_fallbacks_without_new_changes(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            (root / "en.json").write_text(json.dumps({"pending": "Goodbye", "done": "Hello"}), encoding="utf-8")
+            target = root / "de.json"
+            target.write_text(json.dumps({"pending": "Goodbye", "done": "Hallo"}), encoding="utf-8")
+            config = {"app_dir": root, "locales_dir": root, "i18n_command": ["pnpm", "run", "i18n"], "format": "json"}
+            output = io.StringIO()
+            with patch.dict(translate.APP_CONFIGS, {"desktop": config}), \
+                 patch.dict(os.environ, {"GROQ_API_KEY": "test-key"}), \
+                 patch.object(sys, "argv", ["translate.py", "desktop", "--retry-untranslated"]), \
+                 patch.object(translate.subprocess, "run"), \
+                 patch.object(translate, "Groq"), \
+                 patch.object(translate, "translate_text", return_value="Auf Wiedersehen") as request, \
+                 redirect_stdout(output):
+                translate.main()
+            request.assert_called_once()
+            self.assertEqual(json.loads(target.read_text(encoding="utf-8")), {"pending": "Auf Wiedersehen", "done": "Hallo"})
+
