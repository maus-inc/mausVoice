+import OpenAI from "openai";
+import { describe, expect, it, vi } from "vitest";
+import { cerebrasGenerateTextResponse } from "./cerebras.utils";
+import { deepseekGenerateTextResponse } from "./deepseek.utils";
+import {
+  openaiCompatibleStreamChat,
+  openaiGenerateTextResponse,
+} from "./openai.utils";
+
+const completion = () =>
+  new Response(
+    JSON.stringify({ choices: [{ message: { content: '{"result":"ok"}' } }] }),
+    { status: 200, headers: { "content-type": "application/json" } },
+  );
+
+describe("OpenAI-compatible provider request contracts", () => {
+  it.each([
+    ["Cerebras", cerebrasGenerateTextResponse],
+    ["DeepSeek", deepseekGenerateTextResponse],
+  ] as const)(
+    "%s sends the schema and preserves the original prompt",
+    async (_name, generate) => {
+      const customFetch = vi.fn(
+        (_input: string | URL | Request, _init?: RequestInit) =>
+          Promise.resolve(completion()),
+      );
+      const schema = {
+        type: "object",
+        properties: { result: { type: "string" } },
+        required: ["result"],
+        additionalProperties: false,
+      };
+
+      await generate({
+        apiKey: "test-key",
+        system: "Follow the system instruction",
+        prompt: "Rewrite this",
+        jsonResponse: { name: "result", schema },
+        customFetch,
+      });
+
+      expect(customFetch).toHaveBeenCalledOnce();
+      const init = customFetch.mock.calls[0]?.[1];
+      expect(typeof init?.body).toBe("string");
+      const body = JSON.parse(init?.body as string);
+      expect(body.response_format).toEqual({ type: "json_object" });
+      expect(body.messages).toEqual([
+        { role: "system", content: "Follow the system instruction" },
+        {
+          role: "user",
+          content: [
+            {
+              type: "text",
+              text: `Rewrite this\n\nRespond with valid JSON matching this schema: ${JSON.stringify(schema)}`,
+            },
+          ],
+        },
+      ]);
+    },
+  );
+});
+
+describe("OpenAI-compatible streaming usage", () => {
+  it.each([
+    {
+      nextUsage: { completion_tokens: 8 },
+      expected: { promptTokens: 11, completionTokens: 8 },
+    },
+    {
+      nextUsage: { prompt_tokens: 0 },
+      expected: { promptTokens: 0, completionTokens: 2 },
+    },
+  ])("merges partial usage $nextUsage", async ({ nextUsage, expected }) => {
+    const events = [
+      {
+        choices: [
+          { index: 0, delta: { content: "hello" }, finish_reason: null },
+        ],
+        usage: { prompt_tokens: 11, completion_tokens: 2 },
+      },
+      {
+        choices: [{ index: 0, delta: {}, finish_reason: "stop" }],
+        usage: nextUsage,
+      },
+    ];
+    const data =
+      events.map((event) => `data: ${JSON.stringify(event)}\n\n`).join("") +
+      "data: [DONE]\n\n";
+    const customFetch = vi.fn(() =>
+      Promise.resolve(
+        new Response(data, {
+          headers: { "content-type": "text/event-stream" },
+        }),
+      ),
+    );
+    const client = new OpenAI({ apiKey: "test-key", fetch: customFetch });
+    const output = [];
+    for await (const event of openaiCompatibleStreamChat(client, "test-model", {
+      messages: [{ role: "user", content: "hello" }],
+    })) {
+      output.push(event);
+    }
+    expect(output).toEqual([
+      { type: "text-delta", text: "hello" },
+      {
+        type: "finish",
+        finishReason: "stop",
+        modelId: undefined,
+        usage: expected,
+      },
+    ]);
+  });
+});
+
+describe("OpenAI-compatible streamed tool calls", () => {
+  it("keeps interleaved indexed argument fragments with their original calls", async () => {
+    const chunks = [
+      {
+        choices: [
+          {
+            index: 0,
+            delta: {
+              tool_calls: [
+                {
+                  index: 1,
+                  id: "second",
+                  type: "function",
+                  function: { name: "write", arguments: '{"x":' },
+                },
+                {
+                  index: 0,
+                  id: "first",
+                  type: "function",
+                  function: { name: "read", arguments: '{"y":' },
+                },
+              ],
+            },
+            finish_reason: null,
+          },
+        ],
+      },
+      {
+        choices: [
+          {
+            index: 0,
+            delta: {
+              tool_calls: [
+                { index: 0, function: { arguments: "1}" } },
+                { index: 1, function: { arguments: "2}" } },
+              ],
+            },
+            finish_reason: "tool_calls",
+          },
+        ],
+      },
+      { choices: [], usage: { prompt_tokens: 5, completion_tokens: 3 } },
+    ];
+    const data =
+      chunks.map((chunk) => `data: ${JSON.stringify(chunk)}\n\n`).join("") +
+      "data: [DONE]\n\n";
+    const client = new OpenAI({
+      apiKey: "test-key",
+      fetch: vi.fn(() =>
+        Promise.resolve(
+          new Response(data, {
+            headers: { "content-type": "text/event-stream" },
+          }),
+        ),
+      ),
+    });
+    const output = [];
+    for await (const event of openaiCompatibleStreamChat(client, "test-model", {
+      messages: [{ role: "user", content: "hello" }],
+    }))
+      output.push(event);
+    expect(output).toEqual([
+      { type: "tool-call", id: "first", name: "read", arguments: '{"y":1}' },
+      { type: "tool-call", id: "second", name: "write", arguments: '{"x":2}' },
+      {
+        type: "finish",
+        finishReason: "tool-calls",
+        modelId: undefined,
+        usage: { promptTokens: 5, completionTokens: 3 },
+      },
+    ]);
+  });
+});
+
+describe("SDK rate-limit retry", () => {
+  it("waits for the response hint before resending a request", async () => {
+    vi.useFakeTimers();
+    try {
+      const customFetch = vi
+        .fn()
+        .mockResolvedValueOnce(
+          new Response(JSON.stringify({ error: { message: "slow down" } }), {
+            status: 429,
+            headers: { "content-type": "application/json", "retry-after": "1" },
+          }),
+        )
+        .mockImplementation(() => Promise.resolve(completion()));
+      const result = openaiGenerateTextResponse({
+        apiKey: "test-key",
+        prompt: "hello",
+        customFetch,
+      });
+      await vi.advanceTimersByTimeAsync(0);
+      expect(customFetch).toHaveBeenCalledTimes(1);
+      await vi.advanceTimersByTimeAsync(999);
+      expect(customFetch).toHaveBeenCalledTimes(1);
+      await vi.advanceTimersByTimeAsync(1);
+      await expect(result).resolves.toMatchObject({ text: '{"result":"ok"}' });
+      expect(customFetch).toHaveBeenCalledTimes(2);
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+});
