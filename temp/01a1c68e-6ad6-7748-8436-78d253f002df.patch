diff --git a/scripts/ci/linux-transcription-toolchain.test.mjs b/scripts/ci/linux-transcription-toolchain.test.mjs
new file mode 100644
index 0000000..740236d
--- /dev/null
+++ b/scripts/ci/linux-transcription-toolchain.test.mjs
@@ -0,0 +1,97 @@
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { test } from "node:test";
+import { fileURLToPath } from "node:url";
+
+const toolchain = fileURLToPath(
+  new URL(
+    "../../packages/rust_transcription/cmake/linux-ci-toolchain.cmake",
+    import.meta.url,
+  ),
+);
+
+test("Linux CMake toolchain scopes the old string ABI to the pinned x86-64 GNU target", () => {
+  const root = mkdtempSync(join(tmpdir(), "maus-cmake-abi-"));
+  try {
+    writeFileSync(
+      join(root, "CMakeLists.txt"),
+      "cmake_minimum_required(VERSION 3.15)\nproject(abi_check LANGUAGES CXX)\nadd_executable(abi_check main.cpp)\n",
+    );
+    writeFileSync(join(root, "main.cpp"), "int main() { return 0; }\n");
+    for (const [target, expected] of [
+      ["x86_64-unknown-linux-gnu", true],
+      ["aarch64-unknown-linux-gnu", false],
+      ["x86_64-unknown-linux-musl", false],
+      ["", false],
+    ]) {
+      const build = resolve(root, `build-${target || "unset"}`);
+      const env = { ...process.env, TARGET: target };
+      const result = spawnSync(
+        "cmake",
+        [
+          "-S",
+          root,
+          "-B",
+          build,
+          `-DCMAKE_TOOLCHAIN_FILE=${toolchain}`,
+          "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
+        ],
+        { encoding: "utf8", env },
+      );
+      if (result.error) throw result.error;
+      assert.equal(result.status, 0, result.stderr);
+      const commands = JSON.parse(
+        readFileSync(join(build, "compile_commands.json"), "utf8"),
+      );
+      assert.equal(commands.length, 1);
+      assert.equal(
+        commands[0].command.includes("-D_GLIBCXX_USE_CXX11_ABI=0"),
+        expected,
+        target || "unset target",
+      );
+    }
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("the Linux ABI selection wins over conflicting global C++ flags", () => {
+  const root = mkdtempSync(join(tmpdir(), "maus-cmake-abi-conflict-"));
+  try {
+    writeFileSync(
+      join(root, "CMakeLists.txt"),
+      "cmake_minimum_required(VERSION 3.15)\nproject(abi_check LANGUAGES CXX)\nadd_executable(abi_check main.cpp)\n",
+    );
+    writeFileSync(
+      join(root, "main.cpp"),
+      "#include <string>\n#if _GLIBCXX_USE_CXX11_ABI != 0\n#error wrong ABI\n#endif\nint main() { return 0; }\n",
+    );
+    const build = join(root, "build");
+    const env = { ...process.env, TARGET: "x86_64-unknown-linux-gnu" };
+    const configure = spawnSync(
+      "cmake",
+      [
+        "-S",
+        root,
+        "-B",
+        build,
+        `-DCMAKE_TOOLCHAIN_FILE=${toolchain}`,
+        "-DCMAKE_CXX_FLAGS=-D_GLIBCXX_USE_CXX11_ABI=1",
+      ],
+      { encoding: "utf8", env },
+    );
+    if (configure.error) throw configure.error;
+    assert.equal(configure.status, 0, configure.stderr);
+    const compile = spawnSync("cmake", ["--build", build], {
+      encoding: "utf8",
+      env,
+    });
+    if (compile.error) throw compile.error;
+    assert.equal(compile.status, 0, compile.stderr);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
diff --git a/scripts/ci/run-transcription-e2e.sh b/scripts/ci/run-transcription-e2e.sh
new file mode 100644
index 0000000..d8d3e87
--- /dev/null
+++ b/scripts/ci/run-transcription-e2e.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if (($# == 0)); then
+  echo "Provide at least one exact sidecar integration test name." >&2
+  exit 2
+fi
+
+for test_name in "$@"; do
+  selected=$(cargo test --locked --manifest-path packages/rust_transcription/Cargo.toml --test sidecar_integration "$test_name" -- --ignored --exact --list)
+  if ! printf '%s\n' "$selected" | tr -d '\r' | grep -Fx -- "$test_name: test" >/dev/null; then
+    echo "Ignored integration test not found: $test_name" >&2
+    exit 1
+  fi
+  cargo test --locked --manifest-path packages/rust_transcription/Cargo.toml --test sidecar_integration "$test_name" -- --ignored --exact --nocapture
+done
diff --git a/scripts/ci/run-transcription-e2e.test.mjs b/scripts/ci/run-transcription-e2e.test.mjs
new file mode 100644
index 0000000..49cf116
--- /dev/null
+++ b/scripts/ci/run-transcription-e2e.test.mjs
@@ -0,0 +1,90 @@
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { delimiter, join } from "node:path";
+import { test } from "node:test";
+import { fileURLToPath } from "node:url";
+
+const runner = fileURLToPath(
+  new URL("./run-transcription-e2e.sh", import.meta.url),
+);
+
+function runWithCargo(args, cargoBody) {
+  const dir = mkdtempSync(join(tmpdir(), "transcription-e2e-"));
+  try {
+    const log = join(dir, "calls");
+    writeFileSync(join(dir, "cargo"), `#!/usr/bin/env bash\n${cargoBody}\n`, {
+      mode: 0o755,
+    });
+    const result = spawnSync("bash", [runner, ...args], {
+      encoding: "utf8",
+      env: {
+        ...process.env,
+        PATH: `${dir}${delimiter}${process.env.PATH}`,
+        LOG: log,
+      },
+    });
+    if (result.error) throw result.error;
+    return { ...result, calls: readFileSync(log, "utf8").trim().split("\n") };
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+const fakeCargo = `
+printf '%s\\n' "$*" >> "$LOG"
+if [[ "$*" == *--list* ]]; then
+  printf '%s\\n' 'case_one: test' 'case_two: test'
+fi
+`;
+
+test("requires test names without invoking cargo", () => {
+  const result = spawnSync("bash", [runner], { encoding: "utf8" });
+  assert.equal(result.status, 2);
+  assert.match(result.stderr, /at least one/);
+});
+
+test("lists and runs each exact ignored test", () => {
+  const result = runWithCargo(["case_one", "case_two"], fakeCargo);
+  assert.equal(result.status, 0, result.stderr);
+  assert.equal(result.calls.length, 4);
+  assert.match(result.calls[0], /case_one -- --ignored --exact --list/);
+  assert.match(result.calls[1], /case_one -- --ignored --exact --nocapture/);
+  assert.match(result.calls[2], /case_two -- --ignored --exact --list/);
+  assert.match(result.calls[3], /case_two -- --ignored --exact --nocapture/);
+});
+
+test("accepts CRLF output from the test listing", () => {
+  const result = runWithCargo(
+    ["case_one"],
+    `printf '%s\\n' "$*" >> "$LOG"; if [[ "$*" == *--list* ]]; then printf 'case_one: test\\r\\n'; fi`,
+  );
+  assert.equal(result.status, 0, result.stderr);
+  assert.equal(result.calls.length, 2);
+});
+
+test("fails closed when cargo selects zero tests", () => {
+  const result = runWithCargo(["missing"], fakeCargo);
+  assert.notEqual(result.status, 0);
+  assert.match(result.stderr, /Ignored integration test not found: missing/);
+  assert.equal(result.calls.length, 1);
+});
+
+test("propagates a failing cargo listing", () => {
+  const result = runWithCargo(
+    ["case_one"],
+    `printf '%s\\n' "$*" >> "$LOG"; exit 19`,
+  );
+  assert.equal(result.status, 19);
+  assert.equal(result.calls.length, 1);
+});
+
+test("propagates a failing test and stops before the next", () => {
+  const result = runWithCargo(
+    ["case_one", "case_two"],
+    `${fakeCargo}\nif [[ "$*" != *--list* ]]; then exit 17; fi`,
