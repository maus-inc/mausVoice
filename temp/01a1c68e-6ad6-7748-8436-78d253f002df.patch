+      "path": "apps/desktop/src/sessions/gladia-transcription-session.ts",
+      "reason": "Startup cancellation while waiting for provider readiness still depends on caller cleanup to unblock the internal ready promise. Verify lifecycle ownership across SDK and frontend before changing behavior."
+    },
+    {
+      "path": "apps/desktop/src/sessions/local-transcription-session.ts",
+      "reason": "Cleanup during asynchronous listener registration/model warm may allow late startup to attach resources or create a pretranscriber after disposal; requires recording-lifecycle ownership review with early hooks and overlapping starts."
+    },
+    {
+      "path": "apps/desktop/src/sessions/pause-chunked-pretranscriber.ts",
+      "reason": "32-bit checksum has possible collisions; prolonged continuous speech grows buffer without bound and slow serialized spans can accumulate queued audio. Changes affect incremental transcription costs and memory and need workload/integration validation."
+    },
+    {
+      "path": "apps/desktop/src/sessions/local-transcription-session.ts",
+      "reason": "Early hook awaits model warm despite comment claiming it occurs while recording; actual caller timing and download UX should be validated before changing startup sequencing."
+    },
+    {
+      "path": "apps/desktop/src/hooks/async.hooks.ts",
+      "reason": "useAsyncEffect has no rejection handler; an effect or cleanup rejection can prevent later effects from running and produce an unhandled rejection. Define error and cleanup ownership contract before changing."
+    },
+    {
+      "path": "apps/desktop/src/hooks/helper.hooks.ts",
+      "reason": "Debounced effect ignores returned cleanup; debounced callback has no unmount cancellation; modifier state on requirement changes is not tracked. Review consumers and hook contracts before altering behavior."
+    },
+    {
+      "path": "apps/desktop/src/hooks/navigation.hooks.ts",
+      "reason": "Dependency lists use comma-joined values, so distinct arrays containing commas or null/empty strings may collide; initial URL/store mismatch is not reconciled. Needs router/store integration coverage and precedence decision."
+    },
+    {
+      "path": "apps/desktop/src/hooks/system-capabilities.hooks.ts",
+      "reason": "Failed capability load caches null for the lifetime of the process, preventing retry after transient IPC failure; align retry behavior and logging with consumers."
+    },
+    {
+      "path": "apps/desktop/src/hooks/use-saved-number-field.ts",
+      "reason": "Value-based ownership cannot distinguish external updates equal to pending writes, and coalesced same-value saves may never trigger an arrival; robust solution needs operation IDs or serialized store contract."
+    },
+    {
+      "path": "apps/desktop/src/preview/tauri/event.ts",
+      "reason": "Preview event dispatch invokes listeners synchronously and stops when a handler throws, which may differ from native Tauri event delivery. Establish native behavior and mock fidelity requirements before changing."
+    },
+    {
+      "path": "apps/desktop/src/preview/scenarios.ts",
+      "reason": "Scenario timestamps and activity dates are frozen at module load, so a long-lived preview reset across midnight can seed stale dates. Decide deterministic capture versus current-time reset contract before changing."
+    },
+    {
+      "path": "apps/desktop/src/preview/runtime.ts",
+      "reason": "Several native commands are intentionally simulated/no-ops, paired devices are not persisted, and history updates may upsert instead of matching native SQL errors; broaden preview/native contract tests before changing mock fidelity."
+    },
+    {
+      "path": "apps/desktop/src/sidecars/base.sidecar.ts",
+      "reason": "dispose during pending startup does not invalidate or kill a subsequently created runtime; close during health probing and concurrent resets can publish stale state. Coordinate process ownership with sidecar facade and native integration before changing."
+    },
+    {
+      "path": "apps/desktop/src/sidecars/sidecar.utils.ts",
+      "reason": "Timeout races fetch but does not abort underlying request; retries of mutating endpoints may overlap and have ambiguous idempotency. Needs native protocol and cancellation tests."
+    },
+    {
+      "path": "apps/desktop/src/sidecars/local-transcription.sidecar.ts",
+      "reason": "Abort during model readiness/session creation is not propagated to those phases; model readiness invalidation can race in-flight verification. Requires model-download ownership and cancellation design."
+    },
+    {
+      "path": "apps/desktop/src/sidecars/index.ts",
+      "reason": "GPU detection caches a transient failed enumeration permanently and parallel download owners can race resolution; retry and ownership behavior requires sidecar integration coverage."
+    },
+    {
+      "path": "apps/desktop/src/store/index.ts",
+      "reason": "Local persisted values are shallowly merged without field-level schema validation; malformed nested values can disrupt consumers. Migration-compatible validation needs an explicit schema and tests."
+    },
+    {
+      "path": "apps/desktop/src/agents/run-agent.ts",
+      "reason": "A run superseded after assistant streaming stops but during an unfinished tool call may retain an incomplete in-memory turn; replay filters it but teardown and persistence ownership need end-to-end review."
+    },
+    {
+      "path": "apps/desktop/src/agents/run-agent.ts",
+      "reason": "safeSideEffect logs arbitrary error text and catch stores String(error) in transient agent state, potentially including user content or secrets; scrub policy and useful diagnostics need coordinated review."
+    },
+    {
+      "path": "apps/desktop/src/tools/paste.tool.ts",
+      "reason": "Clipboard fallback returns an empty success object indistinguishable from an insertion to the agent, and review cancellation may finish after its owning run is stopped; adjust tool result/cancellation semantics with agent and native UI integration tests."
+    },
+    {
+      "path": "apps/desktop/src/actions/transcriptions.actions.ts",
+      "reason": "performRetranscribe snapshots the row before provider work and writes it before checking run generation, so superseded/deleted/edited rows can be overwritten or resurrected. Needs coordinated row-version/delete ownership and native persistence tests."
+    },
+    {
+      "path": "apps/desktop/src/actions/transcriptions.actions.ts",
+      "reason": "Import/recovery work spanning local-data clear and persistence-mode changes can finish under a new generation; automatic retry claim/settle updates lack unified transactional ownership. Address as a single privacy/lifecycle change with native tests."
+    }
+  ]
+}
