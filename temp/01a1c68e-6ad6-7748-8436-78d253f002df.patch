+import { describe, expect, it, vi } from "vitest";
+import { aldeaTestIntegration, aldeaTranscribeAudio } from "./aldea.utils";
+import {
+  assemblyaiTestIntegration,
+  assemblyaiTranscribeAudio,
+} from "./assemblyai.utils";
+import { deepgramTranscribeAudio } from "./deepgram.utils";
+import {
+  xaiGenerateSpeech,
+  xaiTestIntegration,
+  xaiTranscribeAudio,
+} from "./xai.utils";
+import type { CustomFetch } from "./types";
+
+const audio = new Uint8Array([1, 2]).buffer;
+const response = () =>
+  new Response(
+    JSON.stringify({
+      text: "hello",
+      results: { channels: [{ alternatives: [{ transcript: "hello" }] }] },
+      upload_url: "https://cdn.assemblyai.com/audio/abc",
+      id: "transcript-id",
+      status: "completed",
+    }),
+    { status: 200, headers: { "content-type": "application/json" } },
+  );
+
+const cases: Array<[string, (fetch: CustomFetch) => Promise<unknown>, number]> =
+  [
+    [
+      "Deepgram audio",
+      (customFetch) =>
+        deepgramTranscribeAudio({
+          apiKey: "key",
+          blob: audio,
+          ext: "wav",
+          customFetch,
+        }),
+      1,
+    ],
+    [
+      "xAI models",
+      (customFetch) => xaiTestIntegration({ apiKey: "key", customFetch }),
+      1,
+    ],
+    [
+      "xAI audio",
+      (customFetch) =>
+        xaiTranscribeAudio({
+          apiKey: "key",
+          blob: audio,
+          ext: "wav",
+          customFetch,
+        }),
+      1,
+    ],
+    [
+      "xAI speech",
+      (customFetch) =>
+        xaiGenerateSpeech({ apiKey: "key", text: "private", customFetch }),
+      1,
+    ],
+    [
+      "AssemblyAI integration",
+      (customFetch) =>
+        assemblyaiTestIntegration({ apiKey: "key", customFetch }),
+      1,
+    ],
+    [
+      "AssemblyAI upload/create/poll",
+      (customFetch) =>
+        assemblyaiTranscribeAudio({
+          apiKey: "key",
+          blob: audio,
+          pollIntervalMs: 1,
+          customFetch,
+        }),
+      3,
+    ],
+    [
+      "Aldea audio",
+      () => aldeaTranscribeAudio({ apiKey: "key", blob: audio }),
+      1,
+    ],
+    ["Aldea integration", () => aldeaTestIntegration({ apiKey: "key" }), 1],
+  ];
+
+describe("credential-bearing provider REST requests", () => {
+  it.each(cases)(
+    "refuses redirects for %s",
+    async (_name, run, expectedCalls) => {
+      const customFetch = vi.fn(
+        (_url: string | URL | Request, _init?: RequestInit) =>
+          Promise.resolve(response()),
+      );
+      vi.stubGlobal("fetch", customFetch);
+      try {
+        await run(customFetch);
+        expect(customFetch).toHaveBeenCalledTimes(expectedCalls);
+        for (const [, init] of customFetch.mock.calls) {
+          expect(init?.redirect).toBe("error");
+        }
+      } finally {
+        vi.unstubAllGlobals();
+      }
+    },
+  );
+});
