new file mode 100644
index 0000000..ed658b5
--- /dev/null
+++ b/apps/desktop/src/i18n/icu-catalog.contract.test.ts
@@ -0,0 +1,130 @@
+import { readFileSync } from "node:fs";
+import {
+  parse,
+  TYPE,
+  type MessageFormatElement,
+} from "@formatjs/icu-messageformat-parser";
+import { describe, expect, it } from "vitest";
+import manifest from "./manifest.json";
+
+type Catalog = Record<string, string>;
+
+const messageInputs = (message: string): string[] => {
+  const inputs = new Set<string>();
+  const visit = (elements: MessageFormatElement[]) => {
+    for (const element of elements) {
+      switch (element.type) {
+        case TYPE.literal:
+        case TYPE.pound:
+          break;
+        case TYPE.tag:
+          inputs.add(`tag:${element.value}`);
+          visit(element.children);
+          break;
+        case TYPE.plural:
+        case TYPE.select:
+          inputs.add(`value:${element.value}`);
+          for (const option of Object.values(element.options))
+            visit(option.value);
+          break;
+        default:
+          inputs.add(`value:${element.value}`);
+      }
+    }
+  };
+  visit(parse(message));
+  return [...inputs].sort();
+};
+
+const catalogIssues = (base: Catalog, translated: Catalog): string[] => {
+  const issues: string[] = [];
+  for (const key of new Set([
+    ...Object.keys(base),
+    ...Object.keys(translated),
+  ])) {
+    const source = base[key];
+    const target = translated[key];
+    if (typeof source !== "string" || typeof target !== "string") {
+      issues.push(`${key}: missing or non-string message`);
+      continue;
+    }
+    if (!source.trim() || !target.trim()) {
+      issues.push(`${key}: blank message`);
+      continue;
+    }
+    try {
+      const expected = messageInputs(source);
+      const actual = messageInputs(target);
+      if (JSON.stringify(expected) !== JSON.stringify(actual)) {
+        issues.push(
+          `${key}: expected ${expected.join(", ")}; got ${actual.join(", ")}`,
+        );
+      }
+    } catch (error) {
+      issues.push(`${key}: invalid ICU message (${String(error)})`);
+    }
+  }
+  return issues;
+};
+
+describe("ICU catalog contract", () => {
+  it("detects malformed messages, missing and extra inputs, and nested placeholders", () => {
+    const base = {
+      greeting: "Hello {name}",
+      items:
+        "{count, plural, one {<b>{owner}</b> has one} other {<b>{owner}</b> has #}}",
+      broken: "Hello {name}",
+    };
+    const target = {
+      greeting: "Hallo {other}",
+      items: "{count, plural, other {<b>hat #</b>}}",
+      broken: "Hallo {name",
+    };
+    const issues = catalogIssues(base, target);
+    expect(issues).toHaveLength(3);
+    expect(issues[0]).toContain("value:name");
+    expect(issues[0]).toContain("value:other");
+    expect(issues[1]).toContain("value:owner");
+    expect(issues[2]).toContain("invalid ICU message");
+  });
+
+  it("rejects blank messages even when neither contains placeholders", () => {
+    expect(catalogIssues({ greeting: "Hello" }, { greeting: "   " })).toEqual([
+      "greeting: blank message",
+    ]);
+    expect(catalogIssues({ greeting: "" }, { greeting: "Hallo" })).toEqual([
+      "greeting: blank message",
+    ]);
+  });
+
+  it("allows locale-specific plural categories and an uninflected count", () => {
+    expect(
+      catalogIssues(
+        { items: "{count, plural, one {# item} other {# items}}" },
+        { items: "{count} 项" },
+      ),
+    ).toEqual([]);
+  });
+
+  it("keeps every supported catalog parseable with the English input names", () => {
+    const catalogs = Object.fromEntries(
+      manifest.supportedLocales.map((locale) => [
+        locale,
+        JSON.parse(
+          readFileSync(
+            new URL(`./locales/${locale}.json`, import.meta.url),
+            "utf8",
+          ),
+        ) as Catalog,
+      ]),
+    );
+    const base = catalogs[manifest.defaultLocale];
+    expect(base).toBeDefined();
+    const issues = manifest.supportedLocales.flatMap((locale) =>
+      catalogIssues(base!, catalogs[locale]!).map(
+        (issue) => `${locale}: ${issue}`,
+      ),
+    );
+    expect(issues).toEqual([]);
+  });
+});
