+import { describe, expect, it, vi } from "vitest";
+import { aldeaTranscribeAudio } from "./aldea.utils";
+import { deepgramTranscribeAudio } from "./deepgram.utils";
+import { elevenlabsTranscribeAudio } from "./elevenlabs.utils";
+import { xaiTranscribeAudio } from "./xai.utils";
+import type { CustomFetch } from "./types";
+
+const response = () =>
+  new Response(
+    JSON.stringify({
+      text: "hello",
+      results: { channels: [{ alternatives: [{ transcript: "hello" }] }] },
+    }),
+    { status: 200 },
+  );
+
+const cases: Array<
+  [string, (blob: Buffer, fetch: CustomFetch) => Promise<unknown>]
+> = [
+  [
+    "Deepgram",
+    (blob, customFetch) =>
+      deepgramTranscribeAudio({ apiKey: "k", blob, ext: "wav", customFetch }),
+  ],
+  [
+    "ElevenLabs",
+    (blob, customFetch) =>
+      elevenlabsTranscribeAudio({ apiKey: "k", blob, ext: "wav", customFetch }),
+  ],
+  [
+    "xAI",
+    (blob, customFetch) =>
+      xaiTranscribeAudio({ apiKey: "k", blob, ext: "wav", customFetch }),
+  ],
+  ["Aldea", (blob) => aldeaTranscribeAudio({ apiKey: "k", blob })],
+];
+
+describe("audio Buffer views", () => {
+  it.each(cases)(
+    "sends only the requested Buffer slice to %s",
+    async (_name, run) => {
+      const buffer = Buffer.from([101, 11, 22, 102]);
+      const slice = buffer.subarray(1, 3);
+      const customFetch = vi.fn(
+        (_url: string | URL | Request, _init?: RequestInit) =>
+          Promise.resolve(response()),
+      );
+      vi.stubGlobal("fetch", customFetch);
+      try {
+        await run(slice, customFetch);
+        const body = customFetch.mock.calls[0]?.[1]?.body;
+        const bytes =
+          body instanceof FormData
+            ? await (body.get("file") as Blob).arrayBuffer()
+            : (body as ArrayBuffer);
+        expect(Array.from(new Uint8Array(bytes))).toEqual([11, 22]);
+      } finally {
+        vi.unstubAllGlobals();
+      }
+    },
+  );
+});
