@@ -0,0 +1,43 @@
+import { describe, expect, it } from "vitest";
+import {
+  isGroqAccountScopedError,
+  isGroqModelUnavailableError,
+} from "./groq.utils";
+import { normalizeCerebrasError } from "./cerebras.utils";
+
+describe("provider classification with unreadable optional metadata", () => {
+  it("uses a Groq response status when the outer status getter throws", () => {
+    const error = {
+      get status(): never {
+        throw new Error("unreadable");
+      },
+      response: { status: 401 },
+    };
+    expect(isGroqAccountScopedError(error)).toBe(true);
+  });
+
+  it("classifies a Groq missing model using a nested code", () => {
+    const error = {
+      status: 404,
+      get code(): never {
+        throw new Error("unreadable");
+      },
+      error: { code: "model_not_found" },
+    };
+    expect(isGroqModelUnavailableError(error)).toBe(true);
+  });
+
+  it("uses a Cerebras response status when the outer status getter throws", () => {
+    const error = Object.assign(new Error("provider refused"), {
+      response: { status: 402 },
+    });
+    Object.defineProperty(error, "status", {
+      get: () => {
+        throw new Error("unreadable");
+      },
+    });
+    const normalized = normalizeCerebrasError(error);
+    expect(normalized.message).toContain("Cerebras");
+    expect(normalized).toHaveProperty("status", 402);
+  });
+});
