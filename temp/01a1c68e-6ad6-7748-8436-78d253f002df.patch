+import { describe, expect, it } from "vitest";
+import { audioBufferToArrayBuffer } from "./audio-buffer.utils";
+
+describe("audioBufferToArrayBuffer", () => {
+  it("reuses a full ArrayBuffer without copying", () => {
+    const bytes = new ArrayBuffer(3);
+    expect(audioBufferToArrayBuffer(bytes)).toBe(bytes);
+  });
+
+  it("copies exactly a view, including shared-memory and empty views", () => {
+    const shared = new Uint8Array(new SharedArrayBuffer(4));
+    shared.set([9, 1, 2, 8]);
+    const output = audioBufferToArrayBuffer(shared.subarray(1, 3));
+    expect(output).toBeInstanceOf(ArrayBuffer);
+    expect(Array.from(new Uint8Array(output))).toEqual([1, 2]);
+    shared[1] = 7;
+    expect(Array.from(new Uint8Array(output))).toEqual([1, 2]);
+    expect(audioBufferToArrayBuffer(shared.subarray(2, 2)).byteLength).toBe(0);
+  });
+});
diff --git a/packages/voice-ai/src/audio-buffer.utils.ts b/packages/voice-ai/src/audio-buffer.utils.ts
new file mode 100644
index 0000000..73afb59
--- /dev/null
+++ b/packages/voice-ai/src/audio-buffer.utils.ts
@@ -0,0 +1,9 @@
+/** Return exactly the supplied bytes; a Buffer can be a view into a larger pool. */
+export const audioBufferToArrayBuffer = (
+  audio: ArrayBuffer | Uint8Array,
+): ArrayBuffer => {
+  if (audio instanceof ArrayBuffer) return audio;
+  const copy = new Uint8Array(audio.byteLength);
+  copy.set(audio);
+  return copy.buffer;
+};
