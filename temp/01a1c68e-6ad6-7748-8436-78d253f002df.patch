+  const first = await listen("replacement", () => {});
+  first();
+  const handler = vi.fn();
+  const second = await listen("replacement", handler);
+  first();
+  await emit("replacement");
+  expect(handler).toHaveBeenCalledOnce();
+  second();
+});
+
+it("keeps duplicate handler registrations independent", async () => {
+  const handler = vi.fn();
+  const first = await listen("duplicate", handler);
+  const second = await listen("duplicate", handler);
+  await emit("duplicate");
+  expect(handler).toHaveBeenCalledTimes(2);
+  first();
+  await emit("duplicate");
+  expect(handler).toHaveBeenCalledTimes(3);
+  second();
+});
