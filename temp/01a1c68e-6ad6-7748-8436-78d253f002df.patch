diff --git a/scripts/ci/build-desktop.test.mjs b/scripts/ci/build-desktop.test.mjs
new file mode 100644
index 0000000..db4bae0
--- /dev/null
+++ b/scripts/ci/build-desktop.test.mjs
@@ -0,0 +1,77 @@
+import { strict as assert } from "node:assert";
+import { spawnSync } from "node:child_process";
+import {
+  chmodSync,
+  copyFileSync,
+  mkdtempSync,
+  mkdirSync,
+  readFileSync,
+  rmSync,
+  writeFileSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+
+function runWithStaleExecutable(pnpmScript) {
+  const root = mkdtempSync(join(tmpdir(), "maus-build-test-"));
+  try {
+    mkdirSync(join(root, "scripts"));
+    copyFileSync(
+      "scripts/build-desktop.sh",
+      join(root, "scripts/build-desktop.sh"),
+    );
+    const release = join(root, "apps/desktop/src-tauri/target/release");
+    mkdirSync(release, { recursive: true });
+    const stale = join(release, "mausVoice (prod)");
+    writeFileSync(stale, "old executable");
+    chmodSync(stale, 0o755);
+    const bin = join(root, "bin");
+    mkdirSync(bin);
+    const pnpm = join(bin, "pnpm");
+    writeFileSync(pnpm, `#!/bin/sh\n${pnpmScript}\n`);
+    chmodSync(pnpm, 0o755);
+    return spawnSync("bash", [join(root, "scripts/build-desktop.sh"), "dev"], {
+      env: { ...process.env, PATH: `${bin}:${process.env.PATH}` },
+      encoding: "utf8",
+    });
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+}
+
+test("desktop wrapper passes build as the pnpm script's first argument", () => {
+  const result = runWithStaleExecutable(`
+    if [ "$1" != "--fail-if-no-match" ] || [ "$2" != "--filter" ] || [ "$3" != "desktop" ] || [ "$4" != "run" ] || [ "$5" != "tauri" ] || [ "$6" != "build" ]; then
+      printf 'unexpected pnpm arguments: %s\n' "$*" >&2
+      exit 31
+    fi
+  `);
+  assert.equal(result.status, 0, result.stderr);
+});
+
+test("PowerShell wrapper passes build as the pnpm script's first argument", () => {
+  const source = readFileSync("scripts/build-desktop.ps1", "utf8");
+  assert.match(
+    source,
+    /^pnpm --fail-if-no-match --filter desktop run tauri build --no-bundle /m,
+  );
+});
+
+test("desktop build cannot succeed from an old executable after pnpm fails", () => {
+  const result = runWithStaleExecutable("exit 42");
+  assert.equal(result.status, 42, result.stderr);
+  assert.doesNotMatch(result.stdout, /Build complete/);
+});
+
+test("desktop build does not replace Tauri's output path with a stale binary", () => {
+  const result = runWithStaleExecutable(
+    'echo "Built application at: /custom/target/mausVoice (dev)"',
+  );
+  assert.equal(result.status, 0, result.stderr);
+  assert.match(
+    result.stdout,
+    /Built application at: \/custom\/target\/mausVoice \(dev\)/,
+  );
+  assert.doesNotMatch(result.stdout, /EXE:.*mausVoice \(prod\)/);
+});
