+test("rust-cache workspace targets resolve relative to their crate roots", () => {
+  // Swatinem/rust-cache v2 joins each RHS to the workspace root. Naming the
+  // repository-relative path on the RHS doubles it; an absolute Windows path
+  // is also joined, not resolved. Check the relevant literal workspace entries.
+  const files = [
+    "build-desktop.yml",
+    "release.yml",
+    "test-desktop-unit.yml",
+    "test-package-rust-transcription.yml",
+  ];
+  for (const file of files) {
+    const text = readFileSync(
+      fileURLToPath(
+        new URL(`../../.github/workflows/${file}`, import.meta.url),
+      ),
+      "utf8",
+    );
+    for (const match of text.matchAll(
+      /^\s+(apps\/desktop\/src-tauri|packages\/rust_[\w]+)\s*->\s*(.+)$/gm,
+    )) {
+      assert.equal(match[2].trim(), "target", `${file}: ${match[0].trim()}`);
+    }
+  }
+  for (const [file, required] of [
+    ["build-desktop.yml", { rust_transcription: 1 }],
+    [
+      "release.yml",
+      { rust_transcription: 2, rust_pill_shared: 1, rust_gtk_pill: 1 },
