+        apiKey: "key",
+        blob: new ArrayBuffer(1),
+        customFetch: request,
+        timeoutMs: 1000,
+      });
+      let settled = false;
+      let failure: unknown;
+      void pending.then(
+        () => {
+          settled = true;
+        },
+        (error: unknown) => {
+          settled = true;
+          failure = error;
+        },
