+/** Stop waiting for a provider that does not observe its abort signal. */
+async function* abortableStream(
+  stream: AsyncGenerator<LlmStreamEvent>,
+  controller: AbortController,
+): AsyncGenerator<LlmStreamEvent> {
+  const signal = controller.signal;
+  let completed = false;
+  try {
+    while (!signal.aborted) {
+      let onAbort: () => void = () => {};
+      const aborted = new Promise<null>((resolve) => {
+        onAbort = () => resolve(null);
+        signal.addEventListener("abort", onAbort, { once: true });
+        if (signal.aborted) onAbort();
+      });
+      let next: IteratorResult<LlmStreamEvent> | null;
+      try {
+        next = await Promise.race([stream.next(), aborted]);
+      } finally {
+        signal.removeEventListener("abort", onAbort);
+      }
+      if (next === null || signal.aborted) return;
+      if (next.done) {
+        completed = true;
+        return;
+      }
+      yield next.value;
+    }
+  } finally {
+    // A provider's return may never settle, even after it receives cancellation.
+    if (!completed) {
+      controller.abort();
+      void stream.return(undefined).catch(() => {});
+    }
+  }
+}
