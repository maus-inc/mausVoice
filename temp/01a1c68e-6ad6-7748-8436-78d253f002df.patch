@@ -0,0 +1,385 @@
+import { HttpError } from "@maus-inc/utilities";
+import { describe, expect, it, vi } from "vitest";
+import { aldeaTranscribeAudio } from "./aldea.utils";
+import { deepgramTranscribeAudio } from "./deepgram.utils";
+import { elevenlabsTranscribeAudio } from "./elevenlabs.utils";
+import { xaiTranscribeAudio } from "./xai.utils";
+import { runSdkTranscription } from "./transcription.utils";
+import { openaiTranscribeAudio } from "./openai.utils";
+import { groqTranscribeAudio } from "./groq.utils";
+import { openaiCompatibleTranscribeAudio } from "./openai-compatible-transcribe.utils";
+
+const cases = [
+  {
+    name: "Aldea",
+    start: (signal: AbortSignal) => {
+      const request = vi.fn(
+        async () =>
+          new Response("rate limited", {
+            status: 429,
+            headers: { "retry-after": "2" },
+          }),
+      );
+      vi.stubGlobal("fetch", request);
+      return {
+        request,
+        pending: aldeaTranscribeAudio({
+          apiKey: "key",
+          blob: new ArrayBuffer(1),
+          signal,
+        }),
+      };
+    },
+  },
+  ...[
+    { name: "Deepgram", run: deepgramTranscribeAudio },
+    { name: "ElevenLabs", run: elevenlabsTranscribeAudio },
+    { name: "xAI", run: xaiTranscribeAudio },
+  ].map(({ name, run }) => ({
+    name,
+    start: (signal: AbortSignal) => {
+      const request = vi.fn(
+        async () =>
+          new Response("rate limited", {
+            status: 429,
+            headers: { "retry-after": "2" },
+          }),
+      );
+      const args = {
+        apiKey: "key",
+        blob: new ArrayBuffer(1),
+        ext: "wav",
+        customFetch: request,
+        signal,
+      };
+      return { request, pending: run(args) };
+    },
+  })),
+  {
+    name: "shared SDK transcription",
+    start: (signal: AbortSignal) => {
+      const request = vi.fn(async () => {
+        throw new HttpError(429, "rate limited", { retryAfter: "2" });
+      });
+      return {
+        request,
+        pending: runSdkTranscription(
+          request,
+          { file: {}, model: "model", response_format: "json" },
+          signal,
+        ),
+      };
+    },
+  },
+  {
+    name: "OpenAI-compatible transcription",
+    start: (signal: AbortSignal) => {
+      const request = vi.fn(async () => {
+        throw new HttpError(429, "rate limited", { retryAfter: "2" });
+      });
+      return {
+        request,
+        pending: openaiCompatibleTranscribeAudio({
+          client: { audio: { transcriptions: { create: request } } },
+          blob: new ArrayBuffer(1),
+          model: "model",
+          ext: "wav",
+          signal,
+        }),
+      };
+    },
+  },
+];
+
+describe("transcription dispatch cancellation", () => {
+  const providers = [
+    { name: "Deepgram", run: deepgramTranscribeAudio },
+    { name: "ElevenLabs", run: elevenlabsTranscribeAudio },
+    { name: "xAI", run: xaiTranscribeAudio },
+    { name: "OpenAI", run: openaiTranscribeAudio },
+    { name: "Groq", run: groqTranscribeAudio },
+  ];
+  it.each(providers)(
+    "does not send $name audio when already aborted",
+    async ({ run }) => {
+      const controller = new AbortController();
+      const reason = new Error("cancelled before upload");
+      controller.abort(reason);
+      const request = vi.fn<typeof fetch>();
+      const args = {
+        apiKey: "key",
+        blob: new ArrayBuffer(1),
+        ext: "wav",
+        customFetch: request,
+        signal: controller.signal,
+      };
+      await expect(run(args)).rejects.toBe(reason);
+      expect(request).not.toHaveBeenCalled();
+    },
+  );
+
+  it.each(providers.slice(0, 3))(
+    "stops waiting for a stalled $name response body",
+    async ({ run }) => {
+      const controller = new AbortController();
+      const reason = new Error("cancelled during response");
+      let release!: () => void;
+      let started!: () => void;
+      const entered = new Promise<void>((resolve) => {
+        started = resolve;
+      });
+      const gate = new Promise<void>((resolve) => {
+        release = resolve;
+      });
+      const response = Response.json({});
+      vi.spyOn(response, "json").mockImplementation(async () => {
+        started();
+        await gate;
+        return {};
+      });
+      const request = vi.fn<typeof fetch>(async () => response);
+      const pending = run({
+        apiKey: "key",
+        blob: new ArrayBuffer(1),
+        ext: "wav",
+        customFetch: request,
+        signal: controller.signal,
+      });
+      const outcome = pending.then(
+        () => "unexpected success",
+        (error: unknown) => error,
+      );
+      let timer: ReturnType<typeof setTimeout> | undefined;
+      try {
+        await entered;
+        controller.abort(reason);
+        const result = await Promise.race([
+          outcome,
+          new Promise<string>((resolve) => {
+            timer = setTimeout(() => resolve("still waiting"), 100);
+          }),
+        ]);
+        expect(result).toBe(reason);
+      } finally {
+        clearTimeout(timer);
+        release();
+        await outcome;
+      }
+    },
+  );
+
+  it.each(providers)(
+    "forwards cancellation to $name transport",
+    async ({ run }) => {
+      const controller = new AbortController();
+      let observed: AbortSignal | null | undefined;
+      let release!: () => void;
+      let started!: () => void;
+      const entered = new Promise<void>((resolve) => {
+        started = resolve;
+      });
+      const gate = new Promise<void>((resolve) => {
+        release = resolve;
+      });
+      const request = vi.fn<typeof fetch>(async (input, init) => {
+        observed =
+          init?.signal ?? (input instanceof Request ? input.signal : undefined);
+        started();
+        await gate;
+        return Response.json({
+          text: "hello",
+          results: { channels: [{ alternatives: [{ transcript: "hello" }] }] },
+        });
+      });
+      const args = {
+        apiKey: "key",
+        blob: new ArrayBuffer(1),
+        ext: "wav",
+        customFetch: request,
+        signal: controller.signal,
+      };
+      const pending = run(args);
+      const outcome = pending.then(
+        () => "unexpected success",
+        (error: unknown) => error,
+      );
+      const reason = new Error("cancelled during upload");
+      let timer: ReturnType<typeof setTimeout> | undefined;
+      try {
+        await entered;
+        controller.abort(reason);
+        expect(observed?.aborted).toBe(true);
+        const result = await Promise.race([
+          outcome,
+          new Promise<string>((resolve) => {
+            timer = setTimeout(() => resolve("still waiting"), 100);
+          }),
+        ]);
+        expect(result).toBe(reason);
+      } finally {
+        clearTimeout(timer);
+        release();
+        await outcome;
+      }
+    },
+  );
+});
+
+describe("Aldea cancellation", () => {
+  it.each(["request", "success body", "error body"])(
+    "stops waiting for an uncooperative %s",
+    async (stage) => {
+      const controller = new AbortController();
+      const reason = new Error("cancelled Aldea request");
+      let release!: () => void;
+      let started!: () => void;
+      const entered = new Promise<void>((resolve) => {
+        started = resolve;
+      });
+      const gate = new Promise<void>((resolve) => {
+        release = resolve;
+      });
+      const response =
+        stage === "error body"
+          ? new Response("bad", { status: 503 })
+          : Response.json({
+              results: {
+                channels: [{ alternatives: [{ transcript: "hello" }] }],
+              },
+            });
+      if (stage === "success body") {
+        vi.spyOn(response, "json").mockImplementation(async () => {
+          started();
+          await gate;
+          return {};
+        });
+      } else if (stage === "error body") {
+        vi.spyOn(response, "text").mockImplementation(async () => {
+          started();
+          await gate;
+          return "bad";
+        });
+      }
+      const request = vi.fn(async () => {
+        if (stage === "request") {
+          started();
+          await gate;
+        }
+        return response;
+      });
+      vi.stubGlobal("fetch", request);
+      const pending = aldeaTranscribeAudio({
+        apiKey: "key",
+        blob: new ArrayBuffer(1),
+        signal: controller.signal,
+      });
+      const outcome = pending.then(
+        () => "unexpected success",
+        (error: unknown) => error,
+      );
+      let timer: ReturnType<typeof setTimeout> | undefined;
+      try {
+        await entered;
+        controller.abort(reason);
+        const result = await Promise.race([
+          outcome,
+          new Promise<string>((resolve) => {
+            timer = setTimeout(() => resolve("still waiting"), 100);
+          }),
+        ]);
+        expect(result).toBe(reason);
+        expect(request).toHaveBeenCalledOnce();
+      } finally {
+        clearTimeout(timer);
+        release();
+        await outcome;
+        vi.unstubAllGlobals();
+      }
+    },
+  );
+});
+
+describe("OpenAI-compatible SDK cancellation", () => {
+  it("stops waiting for a client that ignores cancellation", async () => {
+    const controller = new AbortController();
+    const reason = new Error("cancelled during request");
+    let release!: () => void;
+    let started!: () => void;
+    const entered = new Promise<void>((resolve) => {
+      started = resolve;
+    });
+    const gate = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const request = vi.fn(async () => {
+      started();
+      await gate;
+      return { text: "late" };
+    });
+    const pending = openaiCompatibleTranscribeAudio({
+      client: { audio: { transcriptions: { create: request } } },
+      blob: new ArrayBuffer(1),
+      model: "model",
+      ext: "wav",
+      signal: controller.signal,
+    });
+    const outcome = pending.then(
+      () => "unexpected success",
+      (error: unknown) => error,
+    );
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    try {
+      await entered;
+      controller.abort(reason);
+      const result = await Promise.race([
+        outcome,
+        new Promise<string>((resolve) => {
+          timer = setTimeout(() => resolve("still waiting"), 100);
+        }),
+      ]);
+      expect(result).toBe(reason);
+      expect(request).toHaveBeenCalledOnce();
+    } finally {
+      clearTimeout(timer);
+      release();
+      await outcome;
+    }
+  });
+});
+
+describe("transcription retry cancellation", () => {
+  it.each(cases)("stops $name retry waits on abort", async ({ start }) => {
+    vi.useFakeTimers();
+    const controller = new AbortController();
+    const reason = new Error("cancelled by caller");
+    const { request, pending } = start(controller.signal);
+    let result: unknown;
+    let settled = false;
+    void pending.then(
+      (value) => {
+        result = value;
+        settled = true;
+      },
+      (error: unknown) => {
+        result = error;
+        settled = true;
+      },
+    );
+    try {
+      await vi.advanceTimersByTimeAsync(0);
+      expect(request).toHaveBeenCalledOnce();
+      expect(vi.getTimerCount()).toBe(1);
+      controller.abort(reason);
+      await vi.advanceTimersByTimeAsync(0);
+      expect(settled).toBe(true);
+      expect(result).toBe(reason);
+      expect(request).toHaveBeenCalledOnce();
+      expect(vi.getTimerCount()).toBe(0);
+    } finally {
+      await vi.runAllTimersAsync();
+      await pending.catch(() => undefined);
+      vi.useRealTimers();
+      vi.unstubAllGlobals();
+    }
+  });
+});
