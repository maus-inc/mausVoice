+    const text = readFileSync(
+      fileURLToPath(
+        new URL(`../../.github/workflows/${file}`, import.meta.url),
+      ),
+      "utf8",
+    );
+    for (const [crate, count] of Object.entries(required)) {
+      const pattern = new RegExp(
+        `^\\s+packages/${crate}\\s*->\\s*target$`,
+        "gm",
+      );
+      assert.equal(
+        [...text.matchAll(pattern)].length,
+        count,
+        `${file}: ${crate}`,
+      );
+    }
+  }
+});
