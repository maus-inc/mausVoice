+++ b/apps/desktop/scripts/react-chunk-guard.mjs
@@ -0,0 +1,43 @@
+/**
+ * Return a static import cycle through the React chunk, if one exists.
+ * Dynamic imports are excluded because they do not create the same eager
+ * module-initialization dependency as static imports.
+ *
+ * @param {Record<string, {type: string, name?: string, imports?: string[]}>} bundle
+ * @returns {string[] | undefined}
+ */
+export function findReactChunkCycle(bundle) {
+  const roots = Object.entries(bundle)
+    .filter(([, item]) => item.type === "chunk" && item.name === "react")
+    .map(([fileName]) => fileName);
+  if (roots.length !== 1) {
+    throw new Error(`expected exactly one React chunk, found ${roots.length}`);
+  }
+
+  const root = roots[0];
+  const visited = new Set([root]);
+  const pending = [{ fileName: root, path: [root] }];
+  while (pending.length > 0) {
+    const { fileName, path } = pending.pop();
+    for (const dependency of bundle[fileName]?.imports ?? []) {
+      if (dependency === root) return [...path, root];
+      if (bundle[dependency]?.type !== "chunk" || visited.has(dependency))
+        continue;
+      visited.add(dependency);
+      pending.push({ fileName: dependency, path: [...path, dependency] });
+    }
+  }
+  return undefined;
+}
+
+/** @returns {import('vite').Plugin} */
+export function guardReactChunk() {
+  return {
+    name: "guard-react-chunk-cycle",
+    generateBundle(_options, bundle) {
+      const cycle = findReactChunkCycle(bundle);
+      if (cycle)
+        this.error(`Static React chunk import cycle: ${cycle.join(" -> ")}`);
+    },
+  };
+}
diff --git a/apps/desktop/scripts/react-chunk-guard.test.mjs b/apps/desktop/scripts/react-chunk-guard.test.mjs
new file mode 100644
index 0000000..28c864b
--- /dev/null
+++ b/apps/desktop/scripts/react-chunk-guard.test.mjs
@@ -0,0 +1,82 @@
+import { describe, expect, it } from "vitest";
+import { findReactChunkCycle, guardReactChunk } from "./react-chunk-guard.mjs";
+
+const chunk = (name, imports = [], dynamicImports = []) => ({
+  type: "chunk",
+  name,
+  imports,
+  dynamicImports,
+});
+
+const fail = (message) => {
+  throw new Error(message);
+};
+
+const runGuard = (bundle) =>
+  guardReactChunk().generateBundle.call({ error: fail }, {}, bundle);
+
+describe("production React chunk guard", () => {
+  it.each(["production", "preview"])(
+    "is wired into the %s Vite build",
+    async (mode) => {
+      const { default: createConfig } = await import("../vite.config.ts");
+      const config = await createConfig({ command: "build", mode });
+      expect(config.plugins.map((plugin) => plugin.name)).toContain(
+        "guard-react-chunk-cycle",
+      );
+    },
+  );
+
+  it("rejects a static cycle through the React chunk", () => {
+    const bundle = {
+      "react.js": chunk("react", ["intl.js"]),
+      "intl.js": chunk("intl", ["react.js"]),
+    };
+    expect(findReactChunkCycle(bundle)).toEqual([
+      "react.js",
+      "intl.js",
+      "react.js",
+    ]);
+    expect(() => runGuard(bundle)).toThrow(
+      "Static React chunk import cycle: react.js -> intl.js -> react.js",
+    );
+  });
+
+  it("detects longer cycles and self imports", () => {
+    expect(
+      findReactChunkCycle({
+        "react.js": chunk("react", ["a.js"]),
+        "a.js": chunk("a", ["b.js"]),
+        "b.js": chunk("b", ["react.js"]),
+      }),
+    ).toEqual(["react.js", "a.js", "b.js", "react.js"]);
+    expect(
+      findReactChunkCycle({ "react.js": chunk("react", ["react.js"]) }),
+    ).toEqual(["react.js", "react.js"]);
+  });
+
+  it("allows unrelated and dynamic cycles, assets and external imports", () => {
+    const bundle = {
+      "react.js": chunk(
+        "react",
+        ["a.js", "external-package", "logo.svg"],
+        ["lazy.js"],
+      ),
+      "a.js": chunk("a", ["b.js"]),
+      "b.js": chunk("b", ["a.js"]),
+      "lazy.js": chunk("lazy", ["react.js"]),
+      "logo.svg": { type: "asset" },
+    };
+    expect(findReactChunkCycle(bundle)).toBeUndefined();
+    expect(() => runGuard(bundle)).not.toThrow();
+  });
+
+  it("fails closed if the React chunk is absent or ambiguous", () => {
+    expect(() => runGuard({ "other.js": chunk("other") })).toThrow(
+      "expected exactly one React chunk, found 0",
+    );
+    expect(() =>
+      runGuard({ "one.js": chunk("react"), "two.js": chunk("react") }),
+    ).toThrow("expected exactly one React chunk, found 2");
+  });
+});
diff --git a/apps/desktop/scripts/sidecar-build-settings.mjs b/apps/desktop/scripts/sidecar-build-settings.mjs
new file mode 100644
index 0000000..e0a43aa
--- /dev/null
+++ b/apps/desktop/scripts/sidecar-build-settings.mjs
@@ -0,0 +1,60 @@
+import { join, resolve } from "node:path";
+
+// whisper-rs-sys does not invalidate its cached CMake build when the
+// toolchain changes. Keep ABI-correct desktop builds separate from old output;
+// bump this namespace when changing the ABI requirements again.
+const ABI_TARGET_NAMESPACE = "mausvoice-sherpa-abi0-v2";
+
+export function sidecarBuildSettings(target, targetDir, environment, repoRoot) {
+  if (target !== "x86_64-unknown-linux-gnu") {
+    return { targetDir, environment, customToolchain: false };
+  }
+
+  const toolchain = join(
+    repoRoot,
+    "packages/rust_transcription/cmake/linux-ci-toolchain.cmake",
+  );
+  // cmake-rs v0.1.58 checks target-specific variables, then HOST_/TARGET_,
+  // before CMAKE_TOOLCHAIN_FILE. A generic setting alone cannot override them.
+  const targetKeys = [
+    `CMAKE_TOOLCHAIN_FILE_${target}`,
+    `CMAKE_TOOLCHAIN_FILE_${target.replaceAll("-", "_")}`,
+  ];
+  const targetKey = targetKeys.find((key) => environment[key] !== undefined);
+  const kindKeys = [
+    "HOST_CMAKE_TOOLCHAIN_FILE",
+    "TARGET_CMAKE_TOOLCHAIN_FILE",
+  ].filter((key) => environment[key] !== undefined);
+  // We may not know rustc's host here. Conservatively preserve both host and
+  // cross-target settings if either is custom rather than overriding a caller.
+  const effectiveKeys = targetKey
+    ? [targetKey]
+    : kindKeys.length
+      ? kindKeys
+      : ["CMAKE_TOOLCHAIN_FILE"];
+  if (
+    effectiveKeys.some((key) => {
+      const value = environment[key];
+      if (
+        value === undefined ||
+        (key === "CMAKE_TOOLCHAIN_FILE" && !value.trim())
+      )
+        return false;
+      return !value.trim() || resolve(repoRoot, value.trim()) !== toolchain;
+    })
+  ) {
+    return { targetDir, environment, customToolchain: true };
+  }
+
+  const isolatedTargetDir = join(targetDir, ABI_TARGET_NAMESPACE);
+  return {
+    targetDir: isolatedTargetDir,
+    environment: {
+      ...environment,
+      CMAKE_TOOLCHAIN_FILE: toolchain,
+      ...Object.fromEntries(effectiveKeys.map((key) => [key, toolchain])),
+      CARGO_TARGET_DIR: isolatedTargetDir,
+    },
+    customToolchain: false,
+  };
+}
