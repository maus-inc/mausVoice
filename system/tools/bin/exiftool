#!/bin/sh
self=$0
case "$self" in */*) : ;; *) self=$(command -v "$self" 2>/dev/null || echo "$self") ;; esac
dir=${self%/*}
p="$dir/../lib/perl5/perl-base:$dir/../lib/perl5/5.36:$dir/../lib/perl5/x86_64-linux-gnu/5.36:$dir/../share/perl5"
export PERL5LIB="$p${PERL5LIB:+:$PERL5LIB}"
exec "$dir/perl" "$dir/exiftool.real" "$@"
