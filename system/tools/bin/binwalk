#!/bin/sh
self=$0
case "$self" in */*) : ;; *) self=$(command -v "$self" 2>/dev/null || echo "$self") ;; esac
dir=${self%/*}
export PYTHONHOME="$dir/.."
export PYTHONPATH="$dir/../lib/python3.11:$dir/../lib/python3.11/dist-packages${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1
exec "$dir/python3.11.real" -c 'from binwalk.__main__ import main; import sys; sys.exit(main())' "$@"
