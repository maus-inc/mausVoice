{
  "extends": "../typescript-config/package-config.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    /* Emit stays ES2020, but sources call ES2022 runtime APIs such as
       Object.hasOwn, so the type library runs ahead of the target. */
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
