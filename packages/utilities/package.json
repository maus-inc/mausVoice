{
  "name": "@maus-inc/utilities",
  "version": "0.3.25",
  "description": "Shared utility functions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mausvoice/mausvoice.git",
    "directory": "packages/utilities"
  },
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
