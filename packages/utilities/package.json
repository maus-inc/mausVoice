    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@maus-inc/types": "workspace:*"
  },
  "devDependencies": {
    "@maus-inc/typescript-config": "workspace:*",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
