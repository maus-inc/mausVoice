{
  "name": "@maus-inc/desktop-utils",
  "version": "0.3.25",
  "description": "Shared React hooks and logic for mausVoice desktop-style clients.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mausvoice/mausvoice.git",
    "directory": "packages/desktop-utils"
  },
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "import": "./src/react.ts",
      "default": "./src/react.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@tauri-apps/api": ">=2.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@tauri-apps/api": "~2.10.1",
    "@types/react": "^19.2.18",
    "@maus-inc/typescript-config": "workspace:*",
    "react": "^19.2.8",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
