{
  "name": "@maus-inc/desktop-native-apis",
  "version": "0.3.25",
  "description": "Type-safe TypeScript wrappers for the mausVoice desktop Tauri commands",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mausvoice/mausvoice.git",
    "directory": "packages/desktop-native-apis"
  },
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "gen:bindings": "bash ../../scripts/bindings.sh",
    "check:bindings": "bash ../../scripts/check-bindings.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.10.1"
  },
  "devDependencies": {
    "@maus-inc/typescript-config": "workspace:*",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
