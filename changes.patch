+        return LocateStep {
+            active: false,
+            elapsed: 0.0,
+            arm_pulse: false,
+        };
+    }
+
+    let next = elapsed + delta_seconds.max(0.0);
+    let arm_pulse = elapsed < LOCATE_FILL_SECONDS && next >= LOCATE_FILL_SECONDS;
+    if !locate_active(next) {
+        return LocateStep {
+            active: false,
+            elapsed: 0.0,
+            arm_pulse,
+        };
+    }
