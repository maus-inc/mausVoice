---
import FigureImage from "./FigureImage.astro";

interface Props {
  title: string;
  image?: string;
  alt?: string;
}

const { title, image, alt } = Astro.props;
---

<li class="mv-step">
  <span class="mv-step__title">{title}</span>
  <span class="mv-step__body"><slot /></span>
  {
    image && (
      <span class="mv-step__figure">
        <FigureImage id={image} alt={alt ?? title} />
      </span>
    )
  }
</li>
