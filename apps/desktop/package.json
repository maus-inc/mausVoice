{
  "name": "desktop",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "prepare:sidecars": "node scripts/prepare-sidecars.mjs",
    "dev": "node scripts/select-platform-dev.mjs",
    "dev:mac": "cross-env TAURI_PLATFORM=macos pnpm run dev:tauri",
    "dev:linux": "cross-env TAURI_PLATFORM=linux pnpm run dev:tauri",
    "dev:windows": "cross-env TAURI_PLATFORM=windows pnpm run dev:tauri",
    "dev:tauri": "pnpm run prepare:sidecars && node -e \"const c=process.env.TAURI_DEV_CONFIG||'src-tauri/tauri.local.conf.json';require('child_process').execSync('pnpm tauri dev --config '+c,{stdio:'inherit'})\"",
    "dev:vite": "node scripts/run-vite-with-flavor.mjs dev",
    "build:mac:debug": "pnpm run prepare:sidecars && pnpm tauri build --debug --bundles app --config src-tauri/tauri.local.conf.json --no-sign",
    "open:mac:debug": "open \"src-tauri/target/debug/bundle/macos/mausVoice (local).app\"",
    "build": "tsc && node scripts/run-vite-with-flavor.mjs build",
    "preview": "node scripts/run-vite-with-flavor.mjs preview",
    "tauri": "node scripts/run-tauri-with-sidecars.mjs",
    "test:webdriver": "wdio run webdriver/wdio.conf.js",
    "i18n:extract": "node ./scripts/i18n-extract-with-prune.mjs",
    "i18n:sync": "node ./scripts/i18n-sync.mjs",
    "i18n": "pnpm run i18n:extract && pnpm run i18n:sync",
    "lint:fix": "prettier --write src && oxlint --fix src",
    "lint": "prettier --check src && oxlint src",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:integration": "vitest run test/integration",
    "test:evals": "vitest run test/evals"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@maus-inc/desktop-native-apis": "workspace:*",
    "@maus-inc/desktop-utils": "workspace:*",
    "@maus-inc/types": "workspace:*",
    "@maus-inc/utilities": "workspace:*",
    "@maus-inc/voice-ai": "workspace:*",
    "@mui/icons-material": "^9.3.1",
    "@mui/lab": "9.0.0-beta.8",
    "@mui/material": "^9.3.1",
    "@mui/system": "^9.3.0",
    "@repo/agent": "workspace:*",
    "@tauri-apps/api": "~2.10.1",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-http": "~2.5.8",
    "@tauri-apps/plugin-log": "~2.8.0",
    "@tauri-apps/plugin-opener": "~2.5.3",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "firebase": "^12.17.1",
    "framer-motion": "^12.38.0",
    "immer": "^10.2.0",
    "lodash-es": "^4.18.1",
    "lucide": "^1.31.0",
    "mixpanel-browser": "^2.82.0",
    "morphicons": "^1.7.0",
    "react": "^19.2.8",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-intl": "^7.1.14",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "react-transition-group": "^4.4.5",
    "react-virtuoso": "^4.18.11",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "vite-plugin-svgr": "^5.2.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.16.16",
    "@tauri-apps/cli": "~2.10.1",
    "@types/chroma-js": "^3.1.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^5.2.0",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "babel-plugin-formatjs": "^10.5.41",
    "chromedriver": "^152.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
