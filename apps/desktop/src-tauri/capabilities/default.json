{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and any floating-* webview spawned via floating_window_create. The http:default scope allows loopback plus arbitrary http/https hosts: Ollama, OpenAI-compatible, and Speaches endpoints are user-configured base URLs (LAN boxes, reverse proxies) that cannot be enumerated statically, and every SaaS provider host is already subsumed by the https wildcard, so named per-provider entries would be dead configuration. The webview CSP connect-src remains the strict allow-list for in-page fetches; this scope only governs plugin-http calls made from Rust.",
  "windows": ["main", "floating-*"],
  "remote": {
    "urls": [
      "http://localhost",
      "http://localhost/*",
      "http://localhost:*",
      "http://localhost:*/*",
      "http://127.0.0.1",
      "http://127.0.0.1/*",
      "http://127.0.0.1:*",
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "log:default",
    "autostart:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPLOG"
        },
        {
          "path": "$APPLOG/**"
        }
      ]
    },
    "updater:default",
    "process:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/rust-transcription-cpu",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/rust-transcription-gpu",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    "window-state:default",
    "shell:allow-stdin-write",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost"
        },
        {
          "url": "http://localhost/**"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://localhost:*/**"
        },
        {
          "url": "http://127.0.0.1"
        },
        {
          "url": "http://127.0.0.1/**"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://127.0.0.1:*/**"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "http://*:*/**"
        },
        {
          "url": "https://*"
        },
        {
          "url": "https://*/**"
        }
      ]
    }
  ]
}
