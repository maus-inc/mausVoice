{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and any floating-* webview spawned via floating_window_create. The http:default scope names every known SaaS provider host for documentation, and additionally allows arbitrary http/https hosts because Ollama, OpenAI-compatible, and Speaches endpoints are user-configured base URLs (LAN boxes, reverse proxies) that cannot be enumerated statically; the webview CSP connect-src remains the strict boundary for in-page fetches.",
  "windows": ["main", "floating-*"],
  "remote": {
    "urls": [
      "http://localhost",
      "http://localhost/*",
      "http://localhost:*",
      "http://localhost:*/*",
      "http://127.0.0.1",
      "http://127.0.0.1/*",
      "http://127.0.0.1:*",
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "log:default",
    "autostart:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPLOG"
        },
        {
          "path": "$APPLOG/**"
        }
      ]
    },
    "updater:default",
    "process:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/rust-transcription-cpu",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/rust-transcription-gpu",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    "window-state:default",
    "shell:allow-stdin-write",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost" },
        { "url": "http://localhost/**" },
        { "url": "http://localhost:*" },
        { "url": "http://localhost:*/**" },
        { "url": "http://127.0.0.1" },
        { "url": "http://127.0.0.1/**" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://127.0.0.1:*/**" },
        { "url": "https://*.googleapis.com" },
        { "url": "https://*.googleapis.com/**" },
        { "url": "https://accounts.google.com" },
        { "url": "https://accounts.google.com/**" },
        { "url": "https://*.firebaseio.com" },
        { "url": "https://*.firebaseio.com/**" },
        { "url": "https://*.firebase.com" },
        { "url": "https://*.firebase.com/**" },
        { "url": "https://*.firebaseapp.com" },
        { "url": "https://*.firebaseapp.com/**" },
        { "url": "https://*.firebasestorage.app" },
        { "url": "https://*.firebasestorage.app/**" },
        { "url": "https://api.openai.com" },
        { "url": "https://api.openai.com/**" },
        { "url": "https://*.openai.azure.com" },
        { "url": "https://*.openai.azure.com/**" },
        { "url": "https://api.anthropic.com" },
        { "url": "https://api.anthropic.com/**" },
        { "url": "https://api.groq.com" },
        { "url": "https://api.groq.com/**" },
        { "url": "https://api.cerebras.ai" },
        { "url": "https://api.cerebras.ai/**" },
        { "url": "https://api.deepseek.com" },
        { "url": "https://api.deepseek.com/**" },
        { "url": "https://openrouter.ai" },
        { "url": "https://openrouter.ai/**" },
        { "url": "https://api.elevenlabs.io" },
        { "url": "https://api.elevenlabs.io/**" },
        { "url": "https://api.deepgram.com" },
        { "url": "https://api.deepgram.com/**" },
        { "url": "https://github.com" },
        { "url": "https://github.com/**" },
        { "url": "https://objects.githubusercontent.com" },
        { "url": "https://objects.githubusercontent.com/**" },
        { "url": "https://*.ingest.sentry.io" },
        { "url": "https://*.ingest.sentry.io/**" },
        { "url": "https://api.assemblyai.com" },
        { "url": "https://api.assemblyai.com/**" },
        { "url": "https://api.x.ai" },
        { "url": "https://api.x.ai/**" },
        { "url": "https://api.aldea.ai" },
        { "url": "https://api.aldea.ai/**" },
        { "url": "http://*:*" },
        { "url": "http://*:*/**" },
        { "url": "https://*" },
        { "url": "https://*/**" }
      ]
    }
  ]
}
