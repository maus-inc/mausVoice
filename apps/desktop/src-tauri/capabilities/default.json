{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and any floating-* webview spawned via floating_window_create. The webview CSP connect-src stays the strict allow-list for in-page fetches; the http:default scope below only governs plugin-http calls (webview fetch routed through Rust, which the CSP cannot see). Note that remote.urls is a different key and must stay loopback-only: it decides which remote origins may call native commands at all.",
  "windows": ["main", "floating-*"],
  "remote": {
    "urls": [
      "http://localhost",
      "http://localhost/*",
      "http://localhost:*",
      "http://localhost:*/*",
      "http://127.0.0.1",
      "http://127.0.0.1/*",
      "http://127.0.0.1:*",
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "log:default",
    "autostart:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPLOG"
        },
        {
          "path": "$APPLOG/**"
        }
      ]
    },
    "updater:default",
    "process:default",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/rust-transcription-cpu",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/rust-transcription-gpu",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    "window-state:default",
    "shell:allow-stdin-write",
    {
      "identifier": "http:default",
      "description": "Scope for plugin-http (webview fetch executed in Rust). Plain HTTP is limited to loopback, RFC1918, link-local, and *.local so user-configured LAN/self-hosted endpoints (Ollama, Speaches, OpenAI-compatible) still work without granting a global http://*:* exfiltration path. Hosted SaaS providers CAN be enumerated, so https is a curated allow-list mirroring the security.csp connect-src hosts in tauri.conf.json rather than https://* — a wildcard there would let injected page script exfiltrate to any TLS host through Rust, sidestepping the CSP entirely. Tauri rewrites an empty pathname to `*` (see tauri-plugin-http scope tests), so one entry per host covers every path and query. Adding a provider means adding it here AND to connect-src; the csp-connect-src contract test guards the other direction.",
      "allow": [
        {
          "url": "http://localhost"
        },
        {
          "url": "http://localhost/**"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://localhost:*/**"
        },
        {
          "url": "http://127.0.0.1"
        },
        {
          "url": "http://127.0.0.1/**"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://127.0.0.1:*/**"
        },
        {
          "url": "http://10.*:*"
        },
        {
          "url": "http://10.*:*/**"
        },
        {
          "url": "http://192.168.*:*"
        },
        {
          "url": "http://192.168.*:*/**"
        },
        {
