{
  "entry": [
    "apps/desktop/src/preview/tauri/app.ts",
    "apps/desktop/src/preview/tauri/autostart.ts",
    "apps/desktop/src/preview/tauri/core.ts",
    "apps/desktop/src/preview/tauri/event.ts",
    "apps/desktop/src/preview/tauri/http.ts",
    "apps/desktop/src/preview/tauri/log.ts",
    "apps/desktop/src/preview/tauri/opener.ts",
    "apps/desktop/src/preview/tauri/os.ts",
    "apps/desktop/src/preview/tauri/path.ts",
    "apps/desktop/src/preview/tauri/process.ts",
    "apps/desktop/src/preview/tauri/webviewWindow.ts",
    "apps/desktop/src/preview/tauri/window.ts",
    "scripts/ci/check-gitleaks-config.test.mjs",
    "apps/desktop/webdriver/specs/app.render.spec.ts",
    "apps/docs/scripts/make-card-ascii.mjs",
    "docs/assets/badges/source/generate-badges.mjs"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "desktop",
        "patterns": ["apps/desktop/src/**"]
      },
      {
        "name": "preview",
        "patterns": ["apps/preview/src/**"]
      },
      {
        "name": "shared",
        "patterns": ["packages/*/src/**"]
      }
    ],
    "rules": [
      {
        "from": "shared",
        "allow": ["shared"]
      },
      {
        "from": "desktop",
        "allow": ["desktop", "shared"]
      },
      {
        "from": "preview",
        "allow": ["preview", "desktop", "shared"]
      }
    ],
    "calls": {
      "forbidden": [
        {
          "from": "desktop",
          "callee": [
            "eval",
            "globalThis.eval",
            "Function",
            "globalThis.Function"
          ]
        },
        {
          "from": "preview",
          "callee": [
            "eval",
            "globalThis.eval",
            "Function",
            "globalThis.Function"
          ]
        },
        {
          "from": "shared",
          "callee": [
            "eval",
            "globalThis.eval",
            "Function",
            "globalThis.Function"
          ]
        }
      ]
    }
  },
  "ignoreDependencyOverrides": [
    {
      "package": "hono",
      "source": "package.json"
    },
    {
      "package": "@hono/node-server",
      "source": "package.json"
    },
    {
      "package": "@protobufjs/utf8",
      "source": "package.json"
    },
    {
      "package": "qs",
      "source": "package.json"
    }
  ]
}
