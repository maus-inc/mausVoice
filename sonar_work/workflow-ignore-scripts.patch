# AGENT: do not hand-edit this patch. Follow sonar_work/APPLY_WORKFLOW_PATCH.md exactly.
# Required permission: GitHub `workflows` (without it, git push of .github/workflows/* is rejected).
# Commands:
#   git apply --check sonar_work/workflow-ignore-scripts.patch
#   git apply sonar_work/workflow-ignore-scripts.patch
#   node --test scripts/ci/pr28-contracts.test.mjs
# End state: every pnpm install in the five files below has --frozen-lockfile --ignore-scripts
# and the same step runs `node scripts/ci/rebuild-allowlisted.mjs`.
# Do not add # NOSONAR. Do not use a bare `pnpm rebuild`.
#
diff --git a/.github/workflows/build-desktop.yml b/.github/workflows/build-desktop.yml
index c51804b..63056bc 100644
--- a/.github/workflows/build-desktop.yml
+++ b/.github/workflows/build-desktop.yml
@@ -133,7 +133,12 @@ jobs:
           ./.github/scripts/install-desktop-linux-deps.sh
 
       - name: Install dependencies
-        run: pnpm install --frozen-lockfile
+        # --ignore-scripts blocks arbitrary package postinstalls. The helper
+        # then runs `pnpm rebuild` with the explicit onlyBuiltDependencies
+        # names from pnpm-workspace.yaml. A bare `pnpm rebuild` is not used.
+        run: |
+          pnpm install --frozen-lockfile --ignore-scripts
+          node scripts/ci/rebuild-allowlisted.mjs
 
       - name: Build frontend and dependencies
         env:
diff --git a/.github/workflows/lint-desktop.yml b/.github/workflows/lint-desktop.yml
index a48a745..306255c 100644
--- a/.github/workflows/lint-desktop.yml
+++ b/.github/workflows/lint-desktop.yml
@@ -74,7 +74,12 @@ jobs:
             libayatana-appindicator3-dev librsvg2-dev libasound2-dev libxdo-dev \
             libgtk-layer-shell-dev imagemagick
       - name: Install dependencies
-        run: pnpm install --frozen-lockfile
+        # --ignore-scripts blocks arbitrary package postinstalls. The helper
+        # then runs `pnpm rebuild` with the explicit onlyBuiltDependencies
+        # names from pnpm-workspace.yaml. A bare `pnpm rebuild` is not used.
+        run: |
+          pnpm install --frozen-lockfile --ignore-scripts
+          node scripts/ci/rebuild-allowlisted.mjs
       - name: Build dependencies
         run: pnpm exec turbo run build --filter=desktop^... --verbosity=2 --continue
       - name: Lint TypeScript
